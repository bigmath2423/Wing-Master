tpMode = input.string("Equilibre", "Mode TP", options=["Conservateur", "Equilibre", "Agressif"], group=grpE1, tooltip="Moteur 100 % adaptatif : les cibles sont des multiples d'ATR (l'ATR grandit avec le timeframe) calees sur la structure la plus proche (liquidite EQH/EQL, PDH/PDL, PWH/PWL, swings, OB, FVG). Il reconnait le timeframe courant et produit des objectifs realistes sur TOUTES les unites de temps (M1 -> W1) sans reglage. Conservateur : TP plus proches. Equilibre : defaut. Agressif : TP plus eloignes. Aucune valeur en points codee en dur.")
tpPipSize = 0.1  // VERROUILLE : conversion pips uniquement, aucun impact signal (Phase 2)
