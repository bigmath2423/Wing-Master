pfUseAtrFilter = input.bool(true, "ATR: block signals when volatility too low", group=grpE2)
chopFilterOn = input.bool(false, "Anti-consolidation: bloquer les signaux en range / tendance faible (ADX)", group=grpE2, tooltip="Un desk ne trade pas dans le bruit d'un range. ON : aucun signal si l'ADX (force de tendance) est sous le seuil -> on evite les faux signaux en marche sans direction. Distinct du filtre ATR (qui mesure la volatilite, pas la directionnalite). OFF par defaut = comportement d'origine exact ; a activer puis comparer en backtest. N'affecte NI le score NI les TP/SL : filtre uniquement l'emission du signal, les deux sens.")
chopAdxLen = input.int(14, "Anti-consolidation - longueur ADX", minval=2, group=grpPF, tooltip="Longueur de calcul du DI/ADX. 14 = standard institutionnel.")
chopAdxMin = input.float(20.0, "Anti-consolidation - ADX minimum", minval=0.0, maxval=100.0, step=1.0, group=grpPF, tooltip="Seuil de force de tendance. ADX < seuil = consolidation -> signal bloque (si filtre ON). 20 = seuil classique tendance/range ; 25 = plus strict (moins de trades, plus propres).")
pfAtrLen = input.int(50, "ATR average length", minval=2, group=grpPF)
pfAtrMinMult = input.float(0.7, "Min ATR vs its average (x)", minval=0.1, step=0.05, group=grpPF)
pfShowSessions = input.bool(true, "Highlight sessions & kill zones", group=grpPF)
pfSessMode = input.string("Off", "Session filter for signals", options=["Off", "London + New York", "Kill zones only"], group=grpE2)
pfLdnSess = input.session("0800-1700", "London session (Europe/London)", group=grpPF)
pfNySess = input.session("0800-1700", "New York session (America/New_York)", group=grpPF)
pfLdnKz = input.session("0700-1000", "London kill zone (Europe/London)", group=grpPF)
pfNyKz = input.session("0830-1100", "New York kill zone (America/New_York)", group=grpPF)

