//@version=5
// ============================================================================
//  MACRO-INTEL · Overlay macro (tableau d'affichage sur le graphique)
// ----------------------------------------------------------------------------
//  IMPORTANT — limite Pine Script : un indicateur TradingView NE PEUT PAS
//  faire d'appel HTTP sortant. Il ne peut donc pas "tirer" le score macro
//  depuis le backend en direct. Trois options honnêtes :
//
//   (A) Saisie manuelle : vous recopiez le score/biais/risque affichés par le
//       backend (GET /macro/gold/pine) dans les inputs ci-dessous. Simple,
//       fiable, suffisant si vous ne tradez pas H24.
//
//   (B) Automatisation navigateur (userscript/extension) qui lit /macro/latest
//       et met à jour ces inputs via l'API TradingView. (hors dépôt)
//
//   (C) RECOMMANDÉ : ne pas afficher la macro dans Pine du tout, et laisser le
//       backend faire la fusion (voir signal_bridge.pine). Le verdict
//       "renforcé / avertissement" arrive alors sur Telegram/Discord.
//
//  Cet overlay implémente l'option (A) : affichage propre des valeurs macro.
// ============================================================================
indicator("Macro-Intel · Overlay", overlay = true)

// --- Valeurs macro (à mettre à jour depuis GET /macro/gold/pine) ---
macroScore = input.float(0.0,  "MACRO SCORE (-100..+100)", minval = -100, maxval = 100, group = "Macro")
biasTxt    = input.string("NEUTRE", "MACRO BIAS", options = ["HAUSSIER", "BAISSIER", "NEUTRE"], group = "Macro")
confidence = input.float(0.0,  "CONFIANCE %", minval = 0, maxval = 100, group = "Macro")
riskTxt    = input.string("FAIBLE", "RISK LEVEL", options = ["FAIBLE", "MOYEN", "ELEVE"], group = "Macro")

// --- Couleurs dynamiques ---
scoreCol = macroScore > 15 ? color.new(color.green, 0) : macroScore < -15 ? color.new(color.red, 0) : color.new(color.gray, 0)
riskCol  = riskTxt == "ELEVE" ? color.red : riskTxt == "MOYEN" ? color.orange : color.green

var table t = table.new(position.top_right, 2, 5, border_width = 1, frame_color = color.new(color.gray, 60))
if barstate.islast
    table.cell(t, 0, 0, "MACRO-INTEL", text_color = color.white, bgcolor = color.new(color.blue, 20), text_size = size.small)
    table.cell(t, 1, 0, "XAUUSD",     text_color = color.white, bgcolor = color.new(color.blue, 20), text_size = size.small)

    table.cell(t, 0, 1, "SCORE", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 1, (macroScore > 0 ? "+" : "") + str.tostring(macroScore, "#") + "/100", text_color = scoreCol, text_size = size.small)

    table.cell(t, 0, 2, "BIAIS", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 2, biasTxt, text_color = scoreCol, text_size = size.small)

    table.cell(t, 0, 3, "CONF.", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 3, str.tostring(confidence, "#") + "%", text_color = color.white, text_size = size.small)

    table.cell(t, 0, 4, "RISQUE", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 4, riskTxt, text_color = riskCol, text_size = size.small)
