//@version=6
// ============================================================
// XAU/USD — MOMENTUM v13 · SALLE DE MARCHE
// ------------------------------------------------------------
// REFONTE VISUELLE UNIQUEMENT.
//
// La logique de decision est reprise LIGNE POUR LIGNE de la v11 :
// alignLong / alignShort / trigLong / trigShort / buySignal / sellSignal
// sont identiques au caractere pres. Aucun element d'affichage ajoute ici
// n'est lu par une condition d'entree, de sortie ou de taille.
//
// Ce qui change : la hierarchie de l'information.
//   PLAN 1 (fond, discret)  — liquidite, volume, zones
//   PLAN 2 (structure)      — BOS / CHoCH, OB, FVG filtres
//   PLAN 3 (decision)       — panneau compact, multi-timeframe, verdict
//
// HONNETETE DE L'AFFICHAGE. Les modules ne se valent pas, et l'interface le
// dit. Mesure sur 827 trades et 6,3 ans :
//   DECIDENT reellement : biais D1/W1, tendance H1, VWAP de session, POC.
//   NE DECIDENT RIEN    : Order Blocks, FVG, liquidite EQH/EQL, CHoCH.
//     -> effet mesure dont le SIGNE S'INVERSE entre apprentissage et
//        validation, aucun significatif. Ils sont traces parce qu'ils aident
//        a LIRE le graphique, jamais parce qu'ils valident un trade.
// Le panneau separe donc visuellement ces deux familles. Un outil
// professionnel ne presente pas comme une confluence ce qui n'en est pas une.
// ============================================================
indicator("XAU/USD Momentum v13", shorttitle="XAU v13", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ============================================================
// PARAMETRES
// ============================================================
grpS = "① Moteur (ne pas modifier sans mesure)"
swingLen  = input.int(10,  "Longueur de detection des swings", minval=2, group=grpS, display=display.none)
atrLen    = input.int(14,  "Longueur ATR", minval=2, group=grpS, display=display.none)
htfTf     = input.timeframe("60", "Unite de temps superieure", group=grpS, display=display.none)
htfEmaLen = input.int(50,  "EMA de l'unite superieure", minval=2, group=grpS, display=display.none)
cooldown  = input.int(10,  "Barres minimum entre deux signaux", minval=0, group=grpS, display=display.none)

grpF = "② Filtres de decision (mesures)"
useStruct = input.bool(true, "Tendance de structure alignee", group=grpF, tooltip="TAUTOLOGIE avec le declencheur BOS : la tendance est mise a jour PAR le BOS, donc la condition est toujours vraie quand elle est testee. Le retirer ne change rien (615 trades et PF 1.329 avec comme sans). Ne mord qu'avec le declencheur Donchian.", display=display.none)
useHtf    = input.bool(true, "Tendance H1 alignee", group=grpF, tooltip="Effet mesure : +0.016 / +0.096.", display=display.none)
useVwap   = input.bool(true, "Bon cote du VWAP de session", group=grpF, tooltip="Effet mesure : +0.044 / +0.161.", display=display.none)
useBias   = input.bool(true, "Biais journalier + hebdomadaire aligne", group=grpF, tooltip="LE module qui porte le systeme. Esperance +0.064 -> +0.130 R, PF 1.13 -> 1.28, drawdown -28.8 -> -18.8 R.", display=display.none)
biasDLen  = input.int(20, "Biais D1 — EMA", minval=2, group=grpF, display=display.none)
biasWLen  = input.int(10, "Biais W1 — EMA", minval=2, group=grpF, display=display.none)
biasMode  = input.string("D1 EMA20 + W1 EMA10 (actuel)", "Forme du biais journalier", options=["D1 EMA20 + W1 EMA10 (actuel)", "Ruban D1 (5/20/50)"], group=grpF, tooltip="Les deux mesurent la MEME chose : correlation +0.819, recouvrement 86.6 %, ecart d'esperance +0.003 R (p = 0.96). Le ruban le dit en une condition au lieu de deux et laisse passer 38 % de trades en plus. Pas confronte a 2020-2022.", display=display.none)
ribF      = input.int(5,  "Ruban D1 — rapide", minval=2, group=grpF, display=display.none)
ribM      = input.int(20, "Ruban D1 — moyenne", minval=3, group=grpF, display=display.none)
ribS      = input.int(50, "Ruban D1 — lente", minval=5, group=grpF, display=display.none)
useImb    = input.bool(false,"Accepter aussi le displacement seul", group=grpF, tooltip="MESURE : degrade le systeme. PF 1.13 -> 1.08 et stabilite 4/4 -> 2/4. Laisse desactive.", display=display.none)
trigMode  = input.string("BOS (actuel)", "Declencheur", options=["BOS (actuel)", "Cassure Donchian"], group=grpF, tooltip="Les deux mesurent le meme evenement : ecart d'esperance +0.011 R, p = 0.89. Le Donchian l'exprime en une ligne au lieu d'une machine a etats.", display=display.none)
donLen    = input.int(48, "Donchian — nombre de bougies", minval=12, maxval=200, group=grpF, display=display.none)
vUsePoc   = input.bool(true, "Exiger d'etre du bon cote du POC", group=grpF, tooltip="Seul concept de liquidite qui ameliore le systeme. Gain surtout sur le drawdown : -18.8 -> -16.0 R.", display=display.none)

grpMTF = "③ Multi-timeframe (LECTURE SEULE)"
mtfShow = input.bool(true, "Panneau multi-timeframe", group=grpMTF, tooltip="Les unites inferieures (M15, M5) ne creent AUCUN biais et ne declenchent aucun signal. Mesure : le M5 a ete rejete quatre fois par quatre methodes independantes. Elles servent uniquement a savoir si le contexte est aligne au moment ou tu executes.", display=display.none)
mtfEmaF = input.int(50,  "EMA rapide", minval=5, group=grpMTF, display=display.none)
mtfEmaS = input.int(200, "EMA lente", minval=20, group=grpMTF, display=display.none)
mtfStrLen = input.int(20, "Structure — fenetre du milieu de canal", minval=5, group=grpMTF, display=display.none)

grpV = "④ Volume et zones"
vShow    = input.bool(true, "POC et Value Area de la veille", group=grpV, display=display.none)
vBins    = input.int(50, "Finesse du profil", minval=10, maxval=100, group=grpV, display=display.none)
vVaPct   = input.float(70, "Value Area (% du volume)", minval=50, maxval=95, step=5, group=grpV, display=display.none)

grpZ = "⑤ Zones SMC (LECTURE — ne filtrent rien)"
obShow    = input.bool(true, "Order Block — derniere impulsion", group=grpZ, tooltip="AFFICHAGE SEUL. Effet mesure : -0.188 en apprentissage, +0.378 en validation — le signe s'inverse, aucun des deux n'est significatif.\n\nUN SEUL Order Block par cote : celui de la DERNIERE impulsion institutionnelle valide. Il doit remplir trois conditions cumulatives — un deplacement d'au moins obDispAtr derriere lui, une cassure de structure effectivement provoquee, et une zone jamais traversee en cloture. Les MECHES sont incluses : le vrai bord de la zone est l'extreme atteint, pas la limite du corps.", display=display.none)
obHistMax = input.int(4, "Order Blocks valides conserves par cote", minval=0, maxval=10, group=grpZ, tooltip="Un OB supplante par un nouveau CHoCH n'est pas invalide pour autant : il reste affiche tant que le prix ne l'a pas casse. Ce plafond borne l'historique. A 0, seul l'OB du dernier CHoCH est affiche. AFFICHAGE SEUL : le moteur de zones ne lit que l'OB actif.", display=display.none)
bkMax     = input.int(3, "Breaker Blocks conserves par cote", minval=0, maxval=10, group=grpZ, tooltip="Un Order Block casse par une cloture confirmee ne disparait pas : il devient un Breaker Block dans le sens INVERSE, memes bornes et meme bougie d'origine. Ce plafond borne l'historique conserve. A 0, les breakers ne sont pas affiches.", display=display.none)
bkConfBars = input.int(20, "Breaker — fenetre de confirmation (bougies)", minval=1, maxval=200, group=grpZ, tooltip="D2. Une zone cassee attend une cassure de structure DANS LE SENS de la cassure pendant ce nombre de bougies. Sans confirmation, elle expire au lieu de devenir un Breaker : mieux vaut aucun Breaker qu'un Breaker invente. AFFICHAGE SEUL.", display=display.none)
obDispAtr = input.float(1.2, "OB — deplacement minimum (x ATR)", minval=0.3, step=0.1, group=grpZ, display=display.none)
fvgShow   = input.bool(true, "Fair Value Gaps significatifs", group=grpZ, tooltip="AFFICHAGE SEUL. Effet mesure : +0.134 puis -0.028, signe instable. Seuls les FVG avec un vrai deplacement derriere sont traces.", display=display.none)
fvgMinAtr = input.float(0.35, "FVG — taille minimum (x ATR)", minval=0.05, step=0.05, group=grpZ, display=display.none)
fvgDispAtr= input.float(1.0, "FVG — deplacement minimum (x ATR)", minval=0.3, step=0.1, group=grpZ, display=display.none)
fvgMax    = input.int(2, "FVG — nombre garde par cote", minval=1, maxval=4, group=grpZ, display=display.none)
fvgMaxAge = input.int(200, "FVG — duree de vie (bougies)", minval=20, maxval=1000, group=grpZ, tooltip="Un ecart non comble depuis 200 bougies n'est plus un desequilibre, c'est un vestige. Il est retire meme s'il n'a jamais ete traverse.", display=display.none)
brkShow   = input.bool(true, "BOS / CHoCH", group=grpZ, display=display.none)
brkLabels = input.int(2, "Etiquettes sur les N dernieres cassures", minval=0, maxval=6, group=grpZ, display=display.none)

grpL = "⑥ Liquidite (LECTURE — ne filtre rien)"
liqShow   = input.bool(true, "Buy Side / Sell Side, EQH / EQL", group=grpL, tooltip="AFFICHAGE SEUL. Mesure du sweep comme filtre : -0.087 en apprentissage, -0.178 en validation. Il SELECTIONNE les mauvais trades. Trace pour lire ou sont les stops, jamais pour valider une entree.", display=display.none)
liqTolAtr = input.float(0.15, "Tolerance d'egalite (x ATR)", minval=0.02, step=0.05, group=grpL, display=display.none)
liqMax    = input.int(4, "Poches SUIVIES par cote (logique)", minval=1, maxval=8, group=grpL, tooltip="Nombre de poches que le moteur SUIT. Influence la detection des sweeps et les points de liquidite du score : ce n'est PAS un reglage d'affichage. Il avait ete baisse a 2 pour desencombrer le graphique, ce qui reduisait au passage le nombre de sweeps detectables -- un reglage visuel modifiait donc une decision. Remis a 4 ; la lisibilite est desormais geree par le reglage separe ci-dessous.", display=display.none)
liqShowMax = input.int(2, "Poches AFFICHEES par cote (visuel)", minval=1, maxval=8, group=grpL, tooltip="Nombre de poches tracees a l'ecran, les plus recentes. Purement visuel : le moteur continue d'en suivre liqMax. Changer ce reglage ne peut pas modifier un signal.", display=display.none)
sweepShow = input.bool(true, "Marquer les sweeps", group=grpL, display=display.none)
// D4 -- SEUILS DU SWEEP. Le test etait `high > niveau` : UN TICK au-dessus
// suffisait, d'ou les sweeps declenches par de simples meches de bruit. Ces
// deux seuils s'appliquent a la DETECTION, pas seulement a l'etiquette : ils
// reduisent donc volontairement le nombre de zones institutionnelles, le gate
// de creation commencant par `cSweep`. C'est le choix assume de moins de
// setups mais des sweeps reellement exploitables.
sweepMinPen = input.float(0.05, "Sweep — penetration minimum du niveau (x ATR)", minval=0.0, maxval=1.0, step=0.01, group=grpL, tooltip="La meche doit depasser le niveau de liquidite d'au moins cette distance. A 0, le comportement d'origine revient : un tick suffit. AFFECTE LA DETECTION, donc le nombre de zones.", display=display.none)
sweepReject = input.float(0.10, "Sweep — rejet minimum en cloture (x ATR)", minval=0.0, maxval=1.0, step=0.01, group=grpL, tooltip="Apres avoir pris la liquidite, la cloture doit revenir de l'autre cote du niveau d'au moins cette distance. Une cloture a un tick du niveau n'est pas un rejet. AFFECTE LA DETECTION.", display=display.none)

grpW = "⑦ Weekly Institutional Zones (PLANIFICATION — ne declenche aucun trade)"
wzShow      = input.bool(true, "Zones institutionnelles hebdomadaires", group=grpW, tooltip="OUTIL DE PLANIFICATION. Chaque debut de semaine, le module publie le profil de volume de la semaine ECOULEE et en deduit au plus deux zones d'achat et deux zones de vente. Il n'entre dans AUCUNE condition d'entree : buySignal et sellSignal sont inchanges.\n\nCe que le module apporte : decider a l'avance ou tu regardes, ce qui est une discipline reelle. Ce qu'il n'apporte pas : une estimation de probabilite. Sur les 100 points de Confluence, 25 seulement (la structure) reposent sur un module dont l'avantage est mesure — le detail est dans le tableau.", display=display.none)
wzBins      = input.int(50, "Profil hebdomadaire — finesse", minval=20, maxval=100, group=grpW, display=display.none)
wzVaPct     = input.float(70, "Value Area hebdomadaire (%)", minval=50, maxval=95, step=5, group=grpW, display=display.none)
wzWidthAtr  = input.float(0.8, "Epaisseur des zones (x ATR)", minval=0.4, step=0.2, group=grpW, tooltip="Reduit de 1.6 a 0.8 : une zone de 1.6 ATR de haut n'est plus un niveau d'execution, c'est une region. AFFICHAGE SEUL -- les zones ne declenchent aucun trade.", display=display.none)
wzMax       = input.int(1, "Zones maximum par cote", minval=1, maxval=3, group=grpW, tooltip="Reduit de 2 a 1 : une seule zone principale par cote. AFFICHAGE SEUL.", display=display.none)
wzMinScore  = input.int(70, "Confluence minimum pour AFFICHER", minval=50, maxval=95, group=grpW, tooltip="En dessous de ce seuil la zone n'est pas dessinee. 80-90 = premium, 70-80 = interessante. Ce chiffre COMPTE des elements presents ; ce n'est ni une qualite ni une probabilite.", display=display.none)
wzPairGapAtr = input.float(0.5, "Ecart maximum Order Block <-> FVG (x ATR)", minval=0.0, maxval=3.0, step=0.1, group=grpW, tooltip="L'Order Block et le FVG n'ont plus besoin de se chevaucher : il suffit qu'ils soient PROCHES. Dans une impulsion, l'OB precede le mouvement et le FVG est cree par le mouvement -- ils sont donc empiles, pas superposes. A 0, on revient a l'ancien comportement (chevauchement obligatoire).", display=display.none)
wzMaxHeightAtr = input.float(1.5, "Hauteur maximum d'une zone (x ATR)", minval=0.3, maxval=5.0, step=0.1, group=grpW, tooltip="Garde-fou contre les zones enormes. La zone etant l'UNION de l'OB et du FVG, une paire trop ecartee produirait un grand rectangle : au-dela de cette hauteur la paire est REJETEE plutot que dessinee. Mieux vaut aucune zone qu'une zone imprecise.", display=display.none)
wzMaxAnchorAgeH = input.int(72, "Age maximum de l'ancre OB/FVG (heures)", minval=4, maxval=720, group=grpW, tooltip="NON MESURE, valeur de depart raisonnable. Si l'OB ou le FVG qui a donne les 15 points de confluence SMC date de plus de N bougies par rapport a la bougie courante, la zone est retiree meme si techniquement encore intacte -- reponse au cas ou le setup arrive trop tard apres l'impulsion qui l'a cree.", display=display.none)
wzFarAtr    = input.float(3.0, "Distance avant mise en sourdine (x ATR)", minval=1.0, step=0.5, group=grpW, tooltip="NON MESURE, valeur de depart raisonnable. Au-dela de cette distance au prix, la zone reste affichee mais tres transparente -- elle n'est pas supprimee, juste dé-priorisee visuellement.", display=display.none)
wzPlan      = input.bool(true, "Tableau de planification", group=grpW, display=display.none)

slAtrRef = input.float(2.5, "Stop du systeme (x ATR)", minval=0.5, step=0.1, group=grpZ, tooltip="Valeur mesuree. Plateau 2.0-3.0 ATR ; a 1.5 ATR le systeme devient negatif sur deux sous-periodes sur quatre. Sert ici a tracer le stop et a le comparer a l'invalidation structurelle.", display=display.none)

grpU = "⑧ Interface"
panShow  = input.bool(true, "Panneau de decision", group=grpU, display=display.none)
panPos   = input.string("top_right", "Position", options=["top_left","top_right","bottom_left","bottom_right"], group=grpU, display=display.none)
uiTint   = input.bool(true, "Teinte de fond selon le biais", group=grpU, tooltip="Le seul dispositif qui donne le biais sans aucun deplacement du regard. Volontairement a la limite du perceptible.", display=display.none)
showLvls = input.bool(true, "Entree / Stop / Objectifs du setup en cours", group=grpU, display=display.none)
fibShow = input.bool(true, "Niveaux Fibonacci de la zone active", group=grpU, tooltip="Trace 50 / 61.8 / 70.5 / 78.6 sur le swing d'impulsion FIGE dans la zone -- celui que le moteur a reellement utilise pour la juger, pas un swing recalcule a l'affichage. Le niveau 50 % marque la separation premium / discount.", display=display.none)
diagShow = input.bool(true, "Diagnostic du setup (conditions + raison du refus)", group=grpU, tooltip="Affiche l'etat de chaque condition de creation de zone et, quand aucune zone n'existe, la raison exacte du refus. Sert a comprendre un graphique vide sans relire le code.", display=display.none)
zoneMaxBars = input.int(8, "Projection des zones vers la droite (bougies)", minval=0, maxval=100, group=grpU, tooltip="CORRECTIF VISUEL. Une boite etait dessinee depuis sa bougie d'origine jusqu'a maintenant : un FVG vieux de 200 bougies faisait 200 bougies de large, une zone hebdomadaire creee lundi en faisait ~480 le vendredi en M15. Les BORNES DE PRIX etaient deja exactes (le FVG va bien de high[2] a low, l'OB est le high/low d'une seule bougie) -- seule la largeur etait absurde. CORRECTIF DU CORRECTIF : le bord GAUCHE n'est plus tronque du tout, c'etait lui qui detachait les rectangles de leur bougie d'origine. Ce reglage ne commande plus que la PROJECTION VERS LA DROITE, au-dela de la bougie courante. AFFICHAGE SEUL.", display=display.none)

// --- palette : sombre, deux accents, le reste en gris ---
// Les 8 constantes pilotent TOUT l'habillage (panneau, zones, lignes,
// labels) -- changer ces huit valeurs suffit, aucun autre endroit du fichier
// n'a besoin d'y toucher.
// A ASSOCIER au fond de graphique SOMBRE de TradingView (le theme par
// defaut). Variante creme, si besoin de repasser en clair :
//   cUp=rgb(21,128,61) cDn=rgb(191,54,48) cGold=rgb(163,118,22)
//   cBlue=rgb(43,98,165) cPurp=rgb(120,74,156) cMute=rgb(133,124,110)
//   cBg=rgb(250,246,237) cTxt=rgb(42,38,32)
cUp   = color.rgb(38, 166, 109)
cDn   = color.rgb(214, 69, 69)
cGold = color.rgb(212, 175, 55)
cBlue = color.rgb(58, 122, 196)
cPurp = color.rgb(142, 92, 189)
cMute = color.rgb(128, 134, 145)
cBg   = color.rgb(16, 19, 26)
cTxt  = color.rgb(228, 231, 237)

// ============================================================
// MODULES — calcul identique a la v11
// ============================================================
atrV = ta.atr(atrLen)

// --- Structure : swings confirmes puis cassure sur niveau STABLE ---
float ph = ta.pivothigh(high, swingLen, swingLen)
float pl = ta.pivotlow(low, swingLen, swingLen)
var float swingHigh = na
var float swingLow  = na
var int   swingHighBar = na
var int   swingLowBar  = na
if not na(ph)
    swingHigh := ph
    swingHighBar := bar_index - swingLen
if not na(pl)
    swingLow := pl
    swingLowBar := bar_index - swingLen

crossUp = ta.crossover(close, swingHigh) and swingHigh == swingHigh[1]
crossDn = ta.crossunder(close, swingLow) and swingLow == swingLow[1]

var int trend = 0
bullBos = not na(swingHigh) and crossUp
bearBos = not na(swingLow) and crossDn
// GARDE ANTI-REPAINT. trend est un var : une fois ecrit, rien ne le fait
// revenir en arriere tout seul. Sans le garde barstate.isconfirmed, une meche
// intrabougie qui franchit swingHigh puis repart avant la cloture pouvait
// forcer trend a la mauvaise valeur en direct, et cette corruption survivait
// a la bougie suivante. Ce fichier est un indicator(), donc toujours "live"
// des qu'il tourne sur un graphique reel -- c'est ici que le garde compte le plus.
if bullBos and barstate.isconfirmed
    trend := 1
if bearBos and barstate.isconfirmed
    trend := -1

// CHoCH : il faut la tendance AVANT sa mise a jour, donc trend[1].
bullChoch = bullBos and trend[1] == -1
bearChoch = bearBos and trend[1] == 1

// --- Displacement : corps de bougie >= 1.5 ATR ---
bullImb = (close - open) >= 1.5 * atrV
bearImb = (open - close) >= 1.5 * atrV

// --- Tendance de l'unite superieure (bougies CLOTUREES) ---
htfClose = request.security(syminfo.tickerid, htfTf, close[1], lookahead=barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen)[1], lookahead=barmerge.lookahead_off)
htfBull  = not na(htfEma) and htfClose > htfEma
htfBear  = not na(htfEma) and htfClose < htfEma

// --- VWAP de session ---
vwapV     = ta.vwap(hlc3)
aboveVwap = not na(vwapV) and close > vwapV
belowVwap = not na(vwapV) and close < vwapV

// --- Biais journalier et hebdomadaire (bougies CLOTUREES) ---
// L'ECART est renvoye en flottant, pas un booleen : Pine n'accepte pas na()
// sur un booleen issu de request.security, et le flottant propage l'absence
// de donnee tant que l'EMA n'est pas formee. Le SIGNE donne le biais.
biasD = request.security(syminfo.tickerid, "D", close[1] - ta.ema(close, biasDLen)[1], lookahead=barmerge.lookahead_off)
biasW = request.security(syminfo.tickerid, "W", close[1] - ta.ema(close, biasWLen)[1], lookahead=barmerge.lookahead_off)
// Ruban journalier : trois EMA sur les CLOTURES D1, lues sur la bougie
// journaliere precedente. Aucune valeur future, aucun repaint.
ribA = request.security(syminfo.tickerid, "D", ta.ema(close, ribF)[1], lookahead=barmerge.lookahead_off)
ribB = request.security(syminfo.tickerid, "D", ta.ema(close, ribM)[1], lookahead=barmerge.lookahead_off)
ribC = request.security(syminfo.tickerid, "D", ta.ema(close, ribS)[1], lookahead=barmerge.lookahead_off)
bool useRib   = biasMode == "Ruban D1 (5/20/50)"
bool ribReady = not na(ribA) and not na(ribB) and not na(ribC)
biasReady = useRib ? ribReady : (not na(biasD) and not na(biasW))
biasBull  = useRib ? (ribReady and ribA > ribB and ribB > ribC) : (biasReady and biasD > 0 and biasW > 0)
biasBear  = useRib ? (ribReady and ribA < ribB and ribB < ribC) : (biasReady and biasD < 0 and biasW < 0)
biasTxt  = not biasReady ? "—" : biasBull ? "HAUSSIER" : biasBear ? "BAISSIER" : "DIVERGENT"

// --- Profil de volume de la journee PRECEDENTE (POC + Value Area) ---
// Le profil se construit pendant la journee et n'est publie qu'a sa cloture :
// on ne lit jamais que des donnees passees. Aucun repaint.
var array<float> vPx  = array.new<float>()
var array<float> vVol = array.new<float>()
var float pocPrev = na
var float vahPrev = na
var float valPrev = na
var float pdhPrev = na
var float pdlPrev = na
var float dayHi   = na
var float dayLo   = na

newDay = ta.change(time("D")) != 0
if newDay
    if array.size(vPx) > 5
        float lo = array.min(vPx)
        float hi = array.max(vPx)
        if hi > lo
            float step = (hi - lo) / vBins
            array<float> acc = array.new<float>(vBins, 0.0)
            for i = 0 to array.size(vPx) - 1
                int k = math.min(vBins - 1, math.max(0, int((array.get(vPx, i) - lo) / step)))
                array.set(acc, k, array.get(acc, k) + array.get(vVol, i))
            int kMax = 0
            float vMax = -1.0
            float tot = 0.0
            for k = 0 to vBins - 1
                float w = array.get(acc, k)
                tot += w
                if w > vMax
                    vMax := w
                    kMax := k
            pocPrev := lo + (kMax + 0.5) * step
            int a1 = kMax
            int b1 = kMax
            float cum = vMax
            while cum < tot * vVaPct / 100.0 and (a1 > 0 or b1 < vBins - 1)
                float up = b1 < vBins - 1 ? array.get(acc, b1 + 1) : -1.0
                float dn = a1 > 0 ? array.get(acc, a1 - 1) : -1.0
                if up >= dn and b1 < vBins - 1
                    b1 += 1
                    cum += up
                else if a1 > 0
                    a1 -= 1
                    cum += dn
                else
                    break
            vahPrev := lo + (b1 + 1) * step
            valPrev := lo + a1 * step
    pdhPrev := dayHi
    pdlPrev := dayLo
    array.clear(vPx)
    array.clear(vVol)
    dayHi := high
    dayLo := low
else
    dayHi := na(dayHi) ? high : math.max(dayHi, high)
    dayLo := na(dayLo) ? low  : math.min(dayLo, low)
array.push(vPx, hl2)
array.push(vVol, na(volume) ? 1.0 : volume)

abovePoc = not na(pocPrev) and close > pocPrev
belowPoc = not na(pocPrev) and close < pocPrev

// ============================================================
// DECISION — identique a la v11, au caractere pres
// ============================================================
alignLong  = (not useStruct or trend == 1)  and (not useHtf or htfBull) and (not useVwap or aboveVwap) and (not useBias or biasBull) and (not vUsePoc or abovePoc)
alignShort = (not useStruct or trend == -1) and (not useHtf or htfBear) and (not useVwap or belowVwap) and (not useBias or biasBear) and (not vUsePoc or belowPoc)
bool donUp = close > ta.highest(high, donLen)[1]
bool donDn = close < ta.lowest(low, donLen)[1]
bool useDon = trigMode == "Cassure Donchian"
trigLong   = useDon ? donUp : (bullBos or (useImb and bullImb))
trigShort  = useDon ? donDn : (bearBos or (useImb and bearImb))

var int lastLong  = -99999
var int lastShort = -99999
rawLong  = trigLong  and alignLong  and not na(atrV) and atrV > 0
rawShort = trigShort and alignShort and not na(atrV) and atrV > 0
buySignal  = rawLong  and (bar_index - lastLong)  > cooldown and barstate.isconfirmed
sellSignal = rawShort and (bar_index - lastShort) > cooldown and barstate.isconfirmed
if buySignal
    lastLong := bar_index
if sellSignal
    lastShort := bar_index

// ============================================================
// MOTEUR MULTI-TIMEFRAME — LECTURE SEULE
// ------------------------------------------------------------
// Trois votes par unite de temps : prix vs EMA rapide, EMA rapide vs EMA
// lente, et position dans le canal de structure (milieu du plus haut / plus
// bas sur N bougies). Deux votes concordants suffisent a qualifier la tendance.
//
// Tout est lu sur la bougie CLOTUREE de chaque unite ([1] partout) : aucune
// valeur future, aucun repaint. Et surtout : AUCUNE de ces valeurs n'entre
// dans buySignal / sellSignal. Le M5 et le M15 ne creent pas de biais — la
// mesure a rejete le M5 quatre fois par quatre methodes independantes.
// ============================================================
f_mtfScore() =>
    float ef = ta.ema(close, mtfEmaF)[1]
    float es = ta.ema(close, mtfEmaS)[1]
    float c1 = close[1]
    float mid = (ta.highest(high, mtfStrLen)[1] + ta.lowest(low, mtfStrLen)[1]) / 2
    float v1 = na(ef) ? 0.0 : (c1 > ef ? 1.0 : -1.0)
    float v2 = na(ef) or na(es) ? 0.0 : (ef > es ? 1.0 : -1.0)
    float v3 = na(mid) ? 0.0 : (c1 > mid ? 1.0 : -1.0)
    float ok = (na(ef) or na(es) or na(mid)) ? 0.0 : 1.0
    [v1 + v2 + v3, ok]

// PLAFOND INTRABAR — correctif d'un defaut grave de la version precedente.
// Demander une unite INFERIEURE a celle du graphique declenche une requete
// intra-bougie, et TradingView plafonne le total a ~100 000 intra-bougies pour
// TOUT le script. Sur un graphique 1 h, une seule requete M5 coute 12
// intra-bougies par bougie : l'historique entier tombe a 8 333 bougies, soit
// 347 jours. Mesure reelle sur l'export : 331 jours au lieu de 6,3 ans. Le
// backtest etait ampute de 85 % de son historique SANS AUCUN AVERTISSEMENT.
//
// On ne demande donc jamais une unite plus fine que le graphique : dans ce cas
// on interroge le graphique lui-meme (cout nul) et la ligne est marquee comme
// non disponible. Lire le M5 depuis un graphique 1 h coute cinq ans d'historique
// pour une information que le systeme n'utilise pas — le marche n'est pas assez
// genereux pour payer ce prix.
f_tfSafe(string tf) => timeframe.in_seconds(tf) < timeframe.in_seconds() ? timeframe.period : tf
bool m15Avail = timeframe.in_seconds("15") >= timeframe.in_seconds()
bool m5Avail  = timeframe.in_seconds("5")  >= timeframe.in_seconds()

[sD, okD]   = request.security(syminfo.tickerid, f_tfSafe("D"),   f_mtfScore(), lookahead=barmerge.lookahead_off)
[sH4, okH4] = request.security(syminfo.tickerid, f_tfSafe("240"), f_mtfScore(), lookahead=barmerge.lookahead_off)
[sH1, okH1] = request.security(syminfo.tickerid, f_tfSafe("60"),  f_mtfScore(), lookahead=barmerge.lookahead_off)
[sM15, okM15] = request.security(syminfo.tickerid, f_tfSafe("15"), f_mtfScore(), lookahead=barmerge.lookahead_off)
[sM5, okM5]   = request.security(syminfo.tickerid, f_tfSafe("5"),  f_mtfScore(), lookahead=barmerge.lookahead_off)

f_mtfDir(float s, float ok) => na(s) or na(ok) or ok < 0.5 ? 0 : (s >= 2 ? 1 : s <= -2 ? -1 : 0)
dirD   = f_mtfDir(sD,   okD)
dirH4  = f_mtfDir(sH4,  okH4)
dirH1  = f_mtfDir(sH1,  okH1)
dirM15 = m15Avail ? f_mtfDir(sM15, okM15) : 0
dirM5  = m5Avail  ? f_mtfDir(sM5,  okM5)  : 0

f_dirTxt(int d) => d == 1 ? "Bullish" : d == -1 ? "Bearish" : "Neutre"
f_dirCol(int d) => d == 1 ? cUp : d == -1 ? cDn : cMute

// Alignement : on compte les unites qui vont dans le sens du BIAIS PRINCIPAL
// (D1/W1), jamais l'inverse. Une unite basse ne peut pas retourner le biais,
// elle peut seulement confirmer ou non.
int biasDir = biasBull ? 1 : biasBear ? -1 : 0
// L'alignement ne compte que les unites REELLEMENT disponibles : afficher
// 3/5 parce que deux lignes sont inaccessibles serait un faux negatif.
int mtfTot   = 3 + (m15Avail ? 1 : 0) + (m5Avail ? 1 : 0)
int mtfAgree = (dirD == biasDir and biasDir != 0 ? 1 : 0) + (dirH4 == biasDir and biasDir != 0 ? 1 : 0) + (dirH1 == biasDir and biasDir != 0 ? 1 : 0) + (m15Avail and dirM15 == biasDir and biasDir != 0 ? 1 : 0) + (m5Avail and dirM5 == biasDir and biasDir != 0 ? 1 : 0)
string mtfVerdict = biasDir == 0 ? "PAS DE BIAIS" : mtfAgree == mtfTot ? "ALIGNEMENT COMPLET" : mtfAgree >= mtfTot - 1 ? "ALIGNEMENT PARTIEL" : "CONFLUENCE FAIBLE"
color  mtfVCol    = biasDir == 0 ? cMute : mtfAgree == mtfTot ? cUp : mtfAgree >= mtfTot - 1 ? cGold : cDn

// ============================================================
// CONTEXTE DE MARCHE — cinq regimes, LECTURE SEULE
// ------------------------------------------------------------
// Ce classement ne declenche rien. Il ne fait qu'une chose : decider ce qu'il
// est RAISONNABLE d'afficher. Montrer une zone de vente pendant que le marche
// monte franchement, c'est proposer un trade que le systeme ne prendra jamais
// — et c'est exactement ce qui pousse a devier du plan.
//
// Quatre votes, ponderes par ce que la mesure a montre :
//   biais D1+W1  : poids DOUBLE — c'est le module qui porte le systeme
//                  (esperance +0.064 -> +0.130 R a lui seul)
//   tendance H1  : poids 1
//   structure    : poids 1
//   tendance D1  : poids 1
// Somme de -5 a +5.
int ctxScore = (biasBull ? 2 : biasBear ? -2 : 0) + (htfBull ? 1 : htfBear ? -1 : 0) + (trend == 1 ? 1 : trend == -1 ? -1 : 0) + (dirD == 1 ? 1 : dirD == -1 ? -1 : 0)
int ctxCode = ctxScore >= 4 ? 2 : ctxScore >= 2 ? 1 : ctxScore <= -4 ? -2 : ctxScore <= -2 ? -1 : 0
string ctxTxt = ctxCode == 2 ? "STRONG BULLISH" : ctxCode == 1 ? "BULLISH" : ctxCode == -1 ? "BEARISH" : ctxCode == -2 ? "STRONG BEARISH" : "RANGE"
color  ctxCol = ctxCode == 2 ? cUp : ctxCode == 1 ? color.new(cUp, 30) : ctxCode == -1 ? color.new(cDn, 30) : ctxCode == -2 ? cDn : cMute

// Regle d'affichage des zones, deduite du regime :
//   STRONG BULLISH / BULLISH  -> aucune zone de vente
//   RANGE                     -> les deux cotes passent normalement
//   BEARISH / STRONG BEARISH  -> aucune zone d'achat
//
// DURCI cette session : l'ancienne regle ne bloquait qu'au niveau extreme
// (STRONG), avec un simple malus de 15 pts au niveau intermediaire. Un
// rallye rapide reste souvent classe "BULLISH" (pas encore "STRONG") tant que
// les moyennes mobiles qui construisent ctxCode n'ont pas rattrape le
// mouvement -- une zone SELL pouvait donc rester affichee, legale au sens du
// code, en pleine acceleration haussiere. Le malus ne suffisait pas a
// l'empecher, il la rendait juste un peu plus dure a creer. Desormais
// "BULLISH" bloque deja les zones SELL, pas seulement "STRONG BULLISH" --
// f_ctxMalus n'a donc plus de cas ou l'agir : supprime.
f_ctxAllow(bool isBuy) => isBuy ? ctxCode >= 0 : ctxCode <= 0

// ============================================================
// PLAN 1 — LE FOND : liquidite, volume, zones
// Tout ce plan reste en arriere du prix : traits fins, forte transparence,
// aucun bloc opaque. Il doit se lire du coin de l'oeil, jamais capter l'attention.
// ============================================================

// --- Poches de liquidite : EQH / EQL -------------------------------------
// Deux sommets (ou deux creux) quasi egaux : les stops s'y empilent. Une poche
// disparait des qu'elle est prise. AFFICHAGE SEUL — mesure du sweep comme
// filtre : -0.087 apprentissage / -0.178 validation, il selectionne les
// mauvais trades.
var array<float> eqhL = array.new<float>()
var array<int>   eqhB = array.new<int>()
var array<float> eqlL = array.new<float>()
var array<int>   eqlB = array.new<int>()
var array<line>  liqLn = array.new<line>()
var array<label> liqLb = array.new<label>()
var array<label> swLb  = array.new<label>()

// CORRECTIF. La version precedente comparait `ph` a `ph[1]`, c'est-a-dire le
// pivot de CETTE bougie a celui de la bougie PRECEDENTE. Or ta.pivothigh ne
// renvoie une valeur que sur la bougie de confirmation et `na` partout
// ailleurs : il aurait fallu deux pivots sur deux bougies consecutives, ce qui
// n'arrive jamais avec swingLen = 10. La condition n'etait JAMAIS vraie et
// aucune poche de liquidite n'apparaissait.
// On memorise donc les DEUX DERNIERES VALEURS de pivot, pas les deux dernieres
// bougies.
var float phA = na
var float phB = na
var int   phAbar = na
var float plA = na
var float plB = na
var int   plAbar = na
if not na(ph)
    phB := phA
    phA := ph
    phAbar := bar_index - swingLen
if not na(pl)
    plB := plA
    plA := pl
    plAbar := bar_index - swingLen

float liqTol = atrV * liqTolAtr
if not na(ph) and not na(phB) and not na(liqTol)
    if math.abs(phA - phB) <= liqTol
        array.push(eqhL, math.max(phA, phB))
        array.push(eqhB, phAbar)
        if array.size(eqhL) > liqMax
            array.shift(eqhL)
            array.shift(eqhB)
if not na(pl) and not na(plB) and not na(liqTol)
    if math.abs(plA - plB) <= liqTol
        array.push(eqlL, math.min(plA, plB))
        array.push(eqlB, plAbar)
        if array.size(eqlL) > liqMax
            array.shift(eqlL)
            array.shift(eqlB)

// Une poche prise disparait. Si la cloture revient de l'autre cote, c'est un sweep.
//
// CORRECTIF DU SWEEP. Le drapeau hebdomadaire etait leve 244 lignes plus bas,
// par une seconde boucle qui re-parcourait eqhL/eqlL a la recherche de
// `low < niveau and close > niveau`. Or la poche est RETIREE du tableau ici
// meme, sur cette bougie, des que `low < lv`. Quand la seconde boucle
// s'executait, la poche n'existait plus : la condition ne pouvait jamais etre
// vraie et wzSweepDn / wzSweepUp restaient definitivement faux. Le gate de
// creation de zone commencant par `cSweep and ...`, AUCUNE zone ne pouvait
// naitre. Les etiquettes "sweep" s'affichaient malgre tout, puisqu'elles sont
// dessinees ici, avant la suppression -- d'ou la contradiction visible a
// l'ecran entre le graphique et le diagnostic.
//
// Le sweep est donc constate ICI, la ou la poche existe encore. Deux booleens
// de bougie portent l'information jusqu'au bloc hebdomadaire.
//
// Note : le constat ne depend plus de `sweepShow`. Cet interrupteur ne commande
// que l'etiquette ; le laisser conditionner la detection aurait fait dependre
// une decision d'un reglage d'affichage.
// Un seul marqueur SWEEP par bougie et par sens. La boucle parcourt TOUTES
// les poches : une bougie qui en traverse deux proches -- ce qui arrive, les
// poches etant memorisees avec une tolerance -- creait deux etiquettes sur la
// meme bougie, au meme prix a quelques ticks pres. D'ou les doublons.
// L'ancrage, lui, etait deja juste : bar_index est bien la bougie du sweep, et
// high/low bien la meche qui prend la liquidite.
var int swBarUp = na
var int swBarDn = na
bool sweepUpBar = false
bool sweepDnBar = false

// D4 -- UN VRAI SWEEP, PAS UNE MECHE DE BRUIT.
// Trois conditions cumulatives remplacent l'ancien `high > lv` / `close < lv` :
//   1. PENETRATION  -- la meche depasse le niveau d'au moins sweepMinPen x ATR ;
//   2. REJET        -- la cloture revient de l'autre cote d'au moins
//                      sweepReject x ATR, et non d'un tick ;
//   3. CONSOMMATION -- la poche n'est retiree que si la penetration est REELLE.
// Le point 3 est un choix a expliciter : auparavant un simple effleurement d'un
// tick consommait la poche de liquidite. Elle disparaissait alors sans qu'aucun
// sweep n'ait eu lieu, et le vrai sweep qui serait survenu plus tard sur ce
// meme niveau ne pouvait plus etre detecte. Un effleurement n'est ni un sweep
// ni une prise de liquidite : la poche survit.
//
// SENS : sweepUpBar = la liquidite ACHETEUSE au-dessus des EQH est prise puis
// rejetee -- signal baissier. sweepDnBar = la liquidite VENDEUSE sous les EQL
// est prise puis rejetee -- signal haussier. Ce mapping etait deja correct.
//
// D5 -- L'ETIQUETTE EST POSEE AU NIVEAU REELLEMENT PRIS (lv), plus a
// l'extremite de la meche, et porte ce niveau dans son texte : le sweep est
// ainsi rattache visuellement a la liquidite qu'il vient de consommer.
//
// Un seul marqueur SWEEP par bougie et par sens : la boucle parcourt TOUTES les
// poches, et une bougie qui en traverse deux proches -- ce qui arrive, les
// poches etant memorisees avec une tolerance -- creait deux etiquettes.
float swPen = na(atrV) ? na : atrV * sweepMinPen
float swRej = na(atrV) ? na : atrV * sweepReject
if array.size(eqhL) > 0 and not na(swPen) and not na(swRej)
    for i = array.size(eqhL) - 1 to 0
        float lv = array.get(eqhL, i)
        if high >= lv + swPen
            if close <= lv - swRej
                sweepUpBar := true
                if sweepShow and array.size(swLb) < 40 and barstate.isconfirmed and (na(swBarUp) or swBarUp != bar_index)
                    swBarUp := bar_index
                    array.push(swLb, label.new(bar_index, lv, "SWEEP " + str.tostring(lv, format.mintick), style=label.style_label_down, color=color.new(cBg, 100), textcolor=color.new(cDn, 20), size=size.tiny))
            array.remove(eqhL, i)
            array.remove(eqhB, i)
if array.size(eqlL) > 0 and not na(swPen) and not na(swRej)
    for i = array.size(eqlL) - 1 to 0
        float lv = array.get(eqlL, i)
        if low <= lv - swPen
            if close >= lv + swRej
                sweepDnBar := true
                if sweepShow and array.size(swLb) < 40 and barstate.isconfirmed and (na(swBarDn) or swBarDn != bar_index)
                    swBarDn := bar_index
                    array.push(swLb, label.new(bar_index, lv, "SWEEP " + str.tostring(lv, format.mintick), style=label.style_label_up, color=color.new(cBg, 100), textcolor=color.new(cUp, 20), size=size.tiny))
            array.remove(eqlL, i)
            array.remove(eqlB, i)
if array.size(swLb) > 6
    label.delete(array.shift(swLb))

// --- Order Blocks : trois conditions cumulatives --------------------------
// 1. deplacement significatif derriere la zone,
// 2. cassure de structure provoquee (BOS ou CHoCH),
// 3. zone jamais traversee en cloture depuis.
// Sans ces trois filtres, un graphique se couvre de dizaines d'OB sans valeur.
var array<float> obBT = array.new<float>()
var array<float> obBB = array.new<float>()
var array<int>   obBX = array.new<int>()
var array<float> obST = array.new<float>()
var array<float> obSB = array.new<float>()
var array<int>   obSX = array.new<int>()

// D3 -- IDENTITE DE LA ZONE.
// obB*X est la bougie d'ORIGINE : celle qui CONSTITUE l'Order Block, celle a
// laquelle le rectangle est ancre. obB*Cr est la bougie de CREATION : celle du
// CHoCH qui l'a fait naitre. Les deux different toujours et servent a des
// choses differentes -- X ancre le dessin, Cr date l'evenement et sert de
// garde a la mitigation (voir D1 plus bas).
var array<int>   obBCr = array.new<int>()
var array<int>   obSCr = array.new<int>()

// D3 -- ETAT : 0 = FRESH, 1 = MITIGATED, 2 = TESTED.
//   MITIGATED : une MECHE est entree dans la zone.
//   TESTED    : une bougie a CLOTURE a l'interieur sans la casser.
// Les deux etats restants du cycle -- PENDING BREAK et BREAKER -- ne sont
// volontairement PAS des valeurs de ce tableau, mais des tableaux distincts
// (pb*, bk*). Une zone cassee n'est plus un Order Block : elle ne peut donc pas
// porter un etat d'Order Block. L'appartenance au tableau EST l'etat, ce qui
// supprime par construction toute possibilite de contradiction entre les deux.
// Aucun de ces etats n'est lu par une condition de trading : rendu uniquement.
var array<int>   obBSt = array.new<int>()
var array<int>   obSSt = array.new<int>()

// BREAKER BLOCKS, dans des tableaux SEPARES de obB*/obS*. C'est delibere :
// le moteur de zones lit array.get(obBT, 0) et array.size(obBT). Y verser les
// breakers les ferait apparier comme des Order Blocks et modifierait la
// creation des zones -- donc le trading. Separes, le moteur voit exactement ce
// qu'il voyait avant, et aucun CHoCH ulterieur ne peut effacer un breaker
// puisque array.clear ne porte que sur obB*/obS*.
// bkS* = breaker BAISSIER, ne d'un OB haussier casse par le bas (resistance).
// bkB* = breaker HAUSSIER, ne d'un OB baissier casse par le haut (support).
// bk*Tr = bougie de TRANSFORMATION en breaker (D3, identite).
var array<float> bkST = array.new<float>()
var array<float> bkSB = array.new<float>()
var array<int>   bkSX = array.new<int>()
var array<int>   bkSCr = array.new<int>()
var array<int>   bkSTr = array.new<int>()
var array<float> bkBT = array.new<float>()
var array<float> bkBB = array.new<float>()
var array<int>   bkBX = array.new<int>()
var array<int>   bkBCr = array.new<int>()
var array<int>   bkBTr = array.new<int>()

// D2 -- PENDING BREAK : zone cassee, en attente de confirmation structurelle.
// Une cassure ne fabrique plus un Breaker a elle seule. La zone cassee attend
// ICI une cassure de structure DANS LE SENS de la cassure ; sans elle, elle
// expire au bout de bkConfBars bougies sans jamais devenir Breaker.
// pbS* = ex-OB haussier casse par le bas  -> candidat breaker BAISSIER.
// pbB* = ex-OB baissier casse par le haut -> candidat breaker HAUSSIER.
// pb*Bk = bougie de CASSURE (D3, identite ; borne aussi la fenetre d'attente).
var array<float> pbST = array.new<float>()
var array<float> pbSB = array.new<float>()
var array<int>   pbSX = array.new<int>()
var array<int>   pbSCr = array.new<int>()
var array<int>   pbSBk = array.new<int>()
var array<float> pbBT = array.new<float>()
var array<float> pbBB = array.new<float>()
var array<int>   pbBX = array.new<int>()
var array<int>   pbBCr = array.new<int>()
var array<int>   pbBBk = array.new<int>()

// HISTORIQUE DES ORDER BLOCKS ENCORE VALIDES, AFFICHAGE SEUL.
// obBT/obST ne contiennent qu'UN element : celui du dernier CHoCH. C'est ce
// que le moteur de zones lit (array.get(obBT, 0), array.size(obBT)) et cela ne
// doit pas changer -- garder plusieurs elements ferait de l'indice 0 le PLUS
// ANCIEN et modifierait l'appariement OB/FVG, donc le trading.
// Un OB supplante par un nouveau CHoCH n'est pourtant pas invalide : il rejoint
// ces tableaux au lieu d'etre detruit par array.clear, et y poursuit son cycle
// de vie complet (mitigation, test, cassure, attente, transformation).
var array<float> ohBT = array.new<float>()
var array<float> ohBB = array.new<float>()
var array<int>   ohBX = array.new<int>()
var array<int>   ohBCr = array.new<int>()
var array<int>   ohBSt = array.new<int>()
var array<float> ohST = array.new<float>()
var array<float> ohSB = array.new<float>()
var array<int>   ohSX = array.new<int>()
var array<int>   ohSCr = array.new<int>()
var array<int>   ohSSt = array.new<int>()

// UN SEUL Order Block par cote : celui de la derniere impulsion valide.
// Empiler des dizaines d'OB ne renseigne sur rien — seul le dernier a encore
// un sens operationnel. On remplace donc au lieu d'ajouter.
// Les MECHES sont incluses : le bord reel de la zone est l'extreme atteint.
// L'Order Block est fige a l'impulsion qui a produit le CHoCH, c'est-a-dire a
// l'ORIGINE du mouvement.
//
// DEPLACEMENT MESURE SUR L'IMPULSION, plus sur la seule bougie de CHoCH.
// L'accumulation se fait dans la boucle de recherche elle-meme, et non dans une
// boucle imbriquee `for k = 0 to i - 1` : cette forme-la faisait echouer le
// script, la profondeur d'historique de `close[k]` dependant du compteur d'une
// autre boucle. Ici `close[i]` reste borne par swingLen, un input.
// Quantite calculee strictement identique : quand l'OB est trouve a l'indice i,
// les bougies 1..i-1 sont haussieres par construction, donc le maximum
// accumule est bien celui des corps 0..i-1.
if bullChoch and not na(atrV)
    float disp = close - open
    for i = 1 to swingLen
        if close[i] < open[i]
            if disp >= atrV * obDispAtr
                // L'OB precedent n'est pas detruit : il passe a l'historique.
                if array.size(obBT) > 0
                    array.push(ohBT, array.get(obBT, 0))
                    array.push(ohBB, array.get(obBB, 0))
                    array.push(ohBX, array.get(obBX, 0))
                    array.push(ohBCr, array.get(obBCr, 0))
                    array.push(ohBSt, array.get(obBSt, 0))
                array.clear(obBT)
                array.clear(obBB)
                array.clear(obBX)
                array.clear(obBCr)
                array.clear(obBSt)
                array.push(obBT, high[i])
                array.push(obBB, low[i])
                array.push(obBX, bar_index - i)
                array.push(obBCr, bar_index)
                array.push(obBSt, 0)
            break
        disp := math.max(disp, close[i] - open[i])
// Miroir baissier du bloc ci-dessus.
if bearChoch and not na(atrV)
    float disp = open - close
    for i = 1 to swingLen
        if close[i] > open[i]
            if disp >= atrV * obDispAtr
                if array.size(obST) > 0
                    array.push(ohST, array.get(obST, 0))
                    array.push(ohSB, array.get(obSB, 0))
                    array.push(ohSX, array.get(obSX, 0))
                    array.push(ohSCr, array.get(obSCr, 0))
                    array.push(ohSSt, array.get(obSSt, 0))
                array.clear(obST)
                array.clear(obSB)
                array.clear(obSX)
                array.clear(obSCr)
                array.clear(obSSt)
                array.push(obST, high[i])
                array.push(obSB, low[i])
                array.push(obSX, bar_index - i)
                array.push(obSCr, bar_index)
                array.push(obSSt, 0)
            break
        disp := math.max(disp, open[i] - close[i])

// ---- CYCLE DE VIE DES ORDER BLOCKS -------------------------------------
// D1 -- UN OB N'EST JAMAIS MITIGE SUR SA PROPRE BOUGIE DE CREATION.
// Le test porte sur le range de la bougie COURANTE, et ce bloc s'execute sur la
// MEME bougie que la creation, juste au-dessus. L'Order Block se trouvant a une
// a trois bougies en arriere, la bougie de CHoCH chevauchait presque toujours
// la zone qu'elle venait de creer : l'OB naissait deja "mitige" et l'etat FRESH
// n'existait pratiquement jamais a l'ecran. La garde `bar_index > obBCr` ferme
// cette porte sans rien changer d'autre.
//
// MITIGATION (etat 1) : une meche entre dans la zone.
// TEST       (etat 2) : une bougie CLOTURE a l'interieur sans la casser.
// Ni l'un ni l'autre n'est une invalidation. Aucun des deux ne retire l'OB :
// il reste affiche et actif, seule sa transparence change.
if array.size(obBB) > 0
    for i = 0 to array.size(obBB) - 1
        if bar_index > array.get(obBCr, i)
            float t = array.get(obBT, i)
            float b = array.get(obBB, i)
            if low <= t and high >= b and array.get(obBSt, i) < 1
                array.set(obBSt, i, 1)
            if close <= t and close >= b and barstate.isconfirmed and array.get(obBSt, i) < 2
                array.set(obBSt, i, 2)
if array.size(obSB) > 0
    for i = 0 to array.size(obSB) - 1
        if bar_index > array.get(obSCr, i)
            float t = array.get(obST, i)
            float b = array.get(obSB, i)
            if low <= t and high >= b and array.get(obSSt, i) < 1
                array.set(obSSt, i, 1)
            if close <= t and close >= b and barstate.isconfirmed and array.get(obSSt, i) < 2
                array.set(obSSt, i, 2)

// INVALIDATION : cloture CONFIRMEE au-dela du bord oppose. Une meche qui
// traverse ne suffit pas -- le test porte sur close, jamais sur low/high.
//
// D2 -- LA CASSURE NE FABRIQUE PLUS UN BREAKER DIRECTEMENT. La zone quitte
// obB*/obS* exactement au meme instant et sous exactement la meme condition
// qu'avant : c'est ce que lit le moteur de zones, il ne voit donc aucun
// changement. Mais elle atterrit en ATTENTE (pb*), pas en Breaker.
if array.size(obBB) > 0
    for i = array.size(obBB) - 1 to 0
        if close < array.get(obBB, i) and barstate.isconfirmed
            array.push(pbST, array.get(obBT, i))
            array.push(pbSB, array.get(obBB, i))
            array.push(pbSX, array.get(obBX, i))
            array.push(pbSCr, array.get(obBCr, i))
            array.push(pbSBk, bar_index)
            array.remove(obBT, i)
            array.remove(obBB, i)
            array.remove(obBX, i)
            array.remove(obBCr, i)
            array.remove(obBSt, i)
if array.size(obST) > 0
    for i = array.size(obST) - 1 to 0
        if close > array.get(obST, i) and barstate.isconfirmed
            array.push(pbBT, array.get(obST, i))
            array.push(pbBB, array.get(obSB, i))
            array.push(pbBX, array.get(obSX, i))
            array.push(pbBCr, array.get(obSCr, i))
            array.push(pbBBk, bar_index)
            array.remove(obST, i)
            array.remove(obSB, i)
            array.remove(obSX, i)
            array.remove(obSCr, i)
            array.remove(obSSt, i)

// D2 -- PROMOTION EN BREAKER, seulement apres confirmation structurelle.
// Un OB haussier casse par le bas ne devient une resistance que si la structure
// confirme le sens de la cassure : il faut un BOS ou un CHoCH BAISSIER
// POSTERIEUR a la bougie de cassure (bar_index > bkBar, strictement). Une
// simple bougie qui traverse ne suffit plus, et un retournement de tendance
// sans cassure prealable de la zone ne transforme jamais rien -- c'est
// exactement le cas "un OB bullish ne devient pas bearish parce que la tendance
// devient bearish".
// Sans confirmation dans la fenetre, la zone EXPIRE : elle ne devient pas
// Breaker, elle disparait. Mieux vaut aucun Breaker qu'un Breaker invente.
if array.size(pbST) > 0
    for i = array.size(pbST) - 1 to 0
        int bkBar = array.get(pbSBk, i)
        bool conf = (bearBos or bearChoch) and bar_index > bkBar
        bool aged = (bar_index - bkBar) > bkConfBars
        if barstate.isconfirmed and (conf or aged)
            if conf
                array.push(bkST, array.get(pbST, i))
                array.push(bkSB, array.get(pbSB, i))
                array.push(bkSX, array.get(pbSX, i))
                array.push(bkSCr, array.get(pbSCr, i))
                array.push(bkSTr, bar_index)
            array.remove(pbST, i)
            array.remove(pbSB, i)
            array.remove(pbSX, i)
            array.remove(pbSCr, i)
            array.remove(pbSBk, i)
if array.size(pbBT) > 0
    for i = array.size(pbBT) - 1 to 0
        int bkBar = array.get(pbBBk, i)
        bool conf = (bullBos or bullChoch) and bar_index > bkBar
        bool aged = (bar_index - bkBar) > bkConfBars
        if barstate.isconfirmed and (conf or aged)
            if conf
                array.push(bkBT, array.get(pbBT, i))
                array.push(bkBB, array.get(pbBB, i))
                array.push(bkBX, array.get(pbBX, i))
                array.push(bkBCr, array.get(pbBCr, i))
                array.push(bkBTr, bar_index)
            array.remove(pbBT, i)
            array.remove(pbBB, i)
            array.remove(pbBX, i)
            array.remove(pbBCr, i)
            array.remove(pbBBk, i)
while array.size(pbST) > bkMax
    array.shift(pbST)
    array.shift(pbSB)
    array.shift(pbSX)
    array.shift(pbSCr)
    array.shift(pbSBk)
while array.size(pbBT) > bkMax
    array.shift(pbBT)
    array.shift(pbBB)
    array.shift(pbBX)
    array.shift(pbBCr)
    array.shift(pbBBk)

// MORT DU BREAKER : un breaker baissier est une resistance, il meurt sur une
// cloture confirmee AU-DESSUS ; le breaker haussier est un support, il meurt
// sur une cloture SOUS. Plafond d'historique pour eviter l'accumulation.
if array.size(bkST) > 0
    for i = array.size(bkST) - 1 to 0
        if close > array.get(bkST, i) and barstate.isconfirmed
            array.remove(bkST, i)
            array.remove(bkSB, i)
            array.remove(bkSX, i)
            array.remove(bkSCr, i)
            array.remove(bkSTr, i)
if array.size(bkBT) > 0
    for i = array.size(bkBT) - 1 to 0
        if close < array.get(bkBB, i) and barstate.isconfirmed
            array.remove(bkBT, i)
            array.remove(bkBB, i)
            array.remove(bkBX, i)
            array.remove(bkBCr, i)
            array.remove(bkBTr, i)
while array.size(bkST) > bkMax
    array.shift(bkST)
    array.shift(bkSB)
    array.shift(bkSX)
    array.shift(bkSCr)
    array.shift(bkSTr)
while array.size(bkBT) > bkMax
    array.shift(bkBT)
    array.shift(bkBB)
    array.shift(bkBX)
    array.shift(bkBCr)
    array.shift(bkBTr)

// ---- MEME CYCLE DE VIE POUR LES OB DE L'HISTORIQUE ---------------------
// Mitigation, test, cassure vers l'attente, puis plafond. Identique a l'OB
// actif : un OB supplante n'est ni fige ni oublie, il continue simplement sa
// vie hors du champ du moteur de zones. La garde de creation (D1) s'applique
// aussi, meme si elle est toujours vraie ici : la coherence prime.
if array.size(ohBB) > 0
    for i = 0 to array.size(ohBB) - 1
        if bar_index > array.get(ohBCr, i)
            float t = array.get(ohBT, i)
            float b = array.get(ohBB, i)
            if low <= t and high >= b and array.get(ohBSt, i) < 1
                array.set(ohBSt, i, 1)
            if close <= t and close >= b and barstate.isconfirmed and array.get(ohBSt, i) < 2
                array.set(ohBSt, i, 2)
if array.size(ohSB) > 0
    for i = 0 to array.size(ohSB) - 1
        if bar_index > array.get(ohSCr, i)
            float t = array.get(ohST, i)
            float b = array.get(ohSB, i)
            if low <= t and high >= b and array.get(ohSSt, i) < 1
                array.set(ohSSt, i, 1)
            if close <= t and close >= b and barstate.isconfirmed and array.get(ohSSt, i) < 2
                array.set(ohSSt, i, 2)
if array.size(ohBB) > 0
    for i = array.size(ohBB) - 1 to 0
        if close < array.get(ohBB, i) and barstate.isconfirmed
            array.push(pbST, array.get(ohBT, i))
            array.push(pbSB, array.get(ohBB, i))
            array.push(pbSX, array.get(ohBX, i))
            array.push(pbSCr, array.get(ohBCr, i))
            array.push(pbSBk, bar_index)
            array.remove(ohBT, i)
            array.remove(ohBB, i)
            array.remove(ohBX, i)
            array.remove(ohBCr, i)
            array.remove(ohBSt, i)
if array.size(ohST) > 0
    for i = array.size(ohST) - 1 to 0
        if close > array.get(ohST, i) and barstate.isconfirmed
            array.push(pbBT, array.get(ohST, i))
            array.push(pbBB, array.get(ohSB, i))
            array.push(pbBX, array.get(ohSX, i))
            array.push(pbBCr, array.get(ohSCr, i))
            array.push(pbBBk, bar_index)
            array.remove(ohST, i)
            array.remove(ohSB, i)
            array.remove(ohSX, i)
            array.remove(ohSCr, i)
            array.remove(ohSSt, i)
while array.size(ohBT) > obHistMax
    array.shift(ohBT)
    array.shift(ohBB)
    array.shift(ohBX)
    array.shift(ohBCr)
    array.shift(ohBSt)
while array.size(ohST) > obHistMax
    array.shift(ohST)
    array.shift(ohSB)
    array.shift(ohSX)
    array.shift(ohSCr)
    array.shift(ohSSt)

// --- Fair Value Gaps : taille ET deplacement ------------------------------
// Un FVG n'est retenu que si l'ecart depasse fvgMinAtr ET que la bougie qui
// l'a cree porte un vrai corps directionnel. Les micro-gaps sont ignores.
var array<float> fvBT = array.new<float>()
var array<float> fvBB = array.new<float>()
var array<int>   fvBX = array.new<int>()
var array<float> fvST = array.new<float>()
var array<float> fvSB = array.new<float>()
var array<int>   fvSX = array.new<int>()

float gapUp = low - high[2]
float gapDn = low[2] - high
bool  bodyOk = not na(atrV) and math.abs(close[1] - open[1]) >= atrV * fvgDispAtr
if not na(atrV) and gapUp > atrV * fvgMinAtr and bodyOk and close[1] > open[1]
    array.push(fvBT, low)
    array.push(fvBB, high[2])
    array.push(fvBX, bar_index - 2)
    if array.size(fvBT) > fvgMax
        array.shift(fvBT)
        array.shift(fvBB)
        array.shift(fvBX)
if not na(atrV) and gapDn > atrV * fvgMinAtr and bodyOk and close[1] < open[1]
    array.push(fvST, low[2])
    array.push(fvSB, high)
    array.push(fvSX, bar_index - 2)
    if array.size(fvST) > fvgMax
        array.shift(fvST)
        array.shift(fvSB)
        array.shift(fvSX)
// Un FVG disparait quand il est COMBLE (cloture au travers) ou quand il est
// simplement trop vieux : un desequilibre que le marche ignore depuis 200
// bougies n'est plus un desequilibre.
if array.size(fvBB) > 0
    for i = array.size(fvBB) - 1 to 0
        if close < array.get(fvBB, i) or (bar_index - array.get(fvBX, i)) > fvgMaxAge
            array.remove(fvBT, i)
            array.remove(fvBB, i)
            array.remove(fvBX, i)
if array.size(fvST) > 0
    for i = array.size(fvST) - 1 to 0
        if close > array.get(fvST, i) or (bar_index - array.get(fvSX, i)) > fvgMaxAge
            array.remove(fvST, i)
            array.remove(fvSB, i)
            array.remove(fvSX, i)

// ============================================================
// PLAN 2 — LA STRUCTURE : BOS / CHoCH
// Un trait du niveau casse jusqu'a la bougie qui le casse, une pastille sur
// cette bougie, et une etiquette uniquement sur les dernieres cassures. Le
// trait suffit a lire la structure ; au-dela, l'ecran se salit.
// ============================================================
var array<line>  brkLn = array.new<line>()
var array<label> brkLb = array.new<label>()

f_break(bool up, bool choch, float lvl, int fromBar) =>
    if brkShow and not na(lvl) and not na(fromBar)
        // Le CHoCH est un RETOURNEMENT : trait plein et epais, en or.
        // Le BOS est une CONTINUATION : trait fin, dans la couleur du sens.
        color col = choch ? cGold : (up ? cUp : cDn)
        line ln = line.new(fromBar, lvl, bar_index, lvl, color=color.new(col, choch ? 0 : 30), width=choch ? 2 : 1, style=choch ? line.style_solid : line.style_dashed)
        array.push(brkLn, ln)
        if array.size(brkLn) > 14
            line.delete(array.shift(brkLn))
        // CORRECTIF : l'etiquette etait placee sous la bougie, donc detachee de
        // son trait. Elle est desormais AU BOUT du trait, a la hauteur du
        // niveau casse : le trait et son nom se lisent d'un seul regard.
        // La pastille label.style_circle est retiree : meme en size.tiny elle
        // dessine un disque plein tres visible, qui ecrasait le prix. Le trait
        // se termine deja au niveau casse ; un simple point dans le texte
        // marque l'endroit sans rien recouvrir.
        label tag = label.new(bar_index, lvl, choch ? " • CHoCH" : " • BOS", style=label.style_label_left, color=color.new(cBg, 100), textcolor=col, size=size.tiny)
        array.push(brkLb, tag)
        while array.size(brkLb) > math.max(1, brkLabels)
            label.delete(array.shift(brkLb))

if bullBos
    f_break(true,  bullChoch, swingHigh, na(swingHighBar) ? bar_index - swingLen : swingHighBar)
if bearBos
    f_break(false, bearChoch, swingLow,  na(swingLowBar)  ? bar_index - swingLen : swingLowBar)

// ============================================================
// WEEKLY INSTITUTIONAL ZONES — PLANIFICATION ET CONFIRMATION
// ------------------------------------------------------------
// CE MODULE NE GENERE AUCUN TRADE. Aucune de ses variables n'apparait dans
// alignLong / alignShort / trigLong / trigShort / buySignal / sellSignal.
// Il prepare la semaine et affiche l'etat des confirmations ; c'est le systeme
// SMC existant qui decide, comme avant.
//
// ABSENCE DE REPAINT — trois garanties.
//   1. Le profil hebdomadaire est celui de la semaine N-1. Il est publie a la
//      bascule de semaine et ne bouge plus. Un profil en cours de construction
//      changerait a chaque bougie : la zone dessinee lundi ne ressemblerait pas
//      a elle-meme vendredi.
//   2. Le score de Confluence est FIGE a la creation de la zone. Les
//      confirmations SMC (sweep, CHoCH, FVG/OB) evoluent en cours de semaine :
//      elles sont donc affichees a part, comme un ETAT, jamais comme une
//      composante du score.
//   3. Aucune unite de temps inferieure au graphique n'est interrogee.
//
// PERFORMANCE — le profil n'est calcule qu'UNE FOIS par semaine, a la bascule.
// Budget de dessin : 4 zones au maximum, soit 8 objets sur les 500 disponibles.
//
// LE MOT "CONFLUENCE" EST CHOISI. Ce n'est ni une qualite ni une probabilite :
// c'est un COMPTE d'elements presents. Sur les 100 points, 25 seulement (la
// structure) reposent sur un module dont l'avantage est mesure ; les 75 autres
// comptent des elements dont la mesure sur 6,3 ans ne montre aucun pouvoir
// predictif. Le tableau le dit explicitement, ligne par ligne.
// ============================================================
var array<float> wPx  = array.new<float>()
var array<float> wVol = array.new<float>()
var float wPoc = na
var float wVah = na
var float wVal = na
var float wHvnHi = na
var float wHvnLo = na
var float wHi = na
var float wLo = na
var float wHiPrev = na
var float wLoPrev = na
var int   wBias = 0

// Memoire des pivots recents : sert a savoir si le prix a DEJA reagi sur une zone.
var array<float> pvLvl = array.new<float>()
if not na(ph)
    array.push(pvLvl, ph)
    if array.size(pvLvl) > 24
        array.shift(pvLvl)
if not na(pl)
    array.push(pvLvl, pl)
    if array.size(pvLvl) > 24
        array.shift(pvLvl)

// Les zones de la semaine : bornes, score fige, cote, bougie de creation.
// zSmcType/zSmcTop/zSmcBot memorisent EXACTEMENT quel OB ou FVG a donne les 15
// points de confluence SMC, pour pouvoir detecter sa disparition plus tard —
// sans ca, "OB casse" ou "FVG comble" ne seraient pas detectables individuellement.
var array<float> zTop  = array.new<float>()
var array<float> zBot  = array.new<float>()
var array<float> zScr  = array.new<float>()
var array<int>   zSide = array.new<int>()
var array<int>   zBar  = array.new<int>()
var array<int>   zSmcType = array.new<int>()
var array<float> zSmcTop  = array.new<float>()
var array<float> zSmcBot  = array.new<float>()
var array<int>   zSmcBar  = array.new<int>()
// Le swing d'impulsion sur lequel le Fibonacci de CETTE zone est calcule,
// FIGE a sa creation. impHi/impLo sont des trackers glissants qui repartent a
// chaque nouveau pivot : les lire au moment de l'affichage ferait bouger les
// niveaux Fibonacci d'une zone deja creee, donc repeindrait son analyse. En
// les recopiant ici une fois pour toutes, les niveaux affiches restent ceux
// que le systeme a reellement utilises pour juger la zone.
var array<float> zFibHi   = array.new<float>()
var array<float> zFibLo   = array.new<float>()
var array<box>   zBox  = array.new<box>()
var array<label> zLab  = array.new<label>()

newWeek = ta.change(time("W")) != 0

// ---- CHAINE SWEEP -> CHoCH -> BOS, AVEC ORDRE CHRONOLOGIQUE --------------
// POURQUOI DES INDICES DE BOUGIE ET NON DES BOOLEENS.
//
// Dans le code, un CHoCH EST un BOS : bullChoch = bullBos and trend[1] == -1.
// C'est la definition juste -- le CHoCH est la PREMIERE cassure contre la
// tendance etablie, le BOS une cassure DANS le sens de la tendance -- mais
// elle implique que toute bougie de CHoCH allume aussi le drapeau BOS. Avec de
// simples booleens "l'evenement a-t-il eu lieu cette semaine", exiger
// `cChoch and cBos` etait donc une tautologie : le second n'ajoutait
// strictement rien au premier, et le BOS ne confirmait rien du tout.
//
// La sequence demandee est CHRONOLOGIQUE :
//     liquidite prise  ->  PUIS changement de caractere  ->  PUIS confirmation
// On memorise donc la BOUGIE de chaque evenement et on impose un ordre STRICT.
// Comme la bougie du CHoCH inscrit le meme indice dans chochIdx et dans bosIdx,
// l'inegalite stricte `bosIdx > chochIdx` force une SECONDE cassure, posterieure
// -- celle qui confirme reellement la nouvelle structure. Le BOS redevient une
// information distincte du CHoCH, et la sequence du cahier des charges est
// respectee au lieu d'etre seulement affichee.
//
// La fenetre hebdomadaire est remplacee par une FRAICHEUR en heures, reprise de
// wzMaxAnchorAgeH (deja coherente d'une unite de temps a l'autre). Effet de
// bord voulu : plus de point mort le lundi matin, ou les drapeaux repartaient
// tous de zero quel que soit ce que le marche venait de faire.
var int swpDnIdx   = na   // sell side prise -> prerequis d'un setup ACHAT
var int swpUpIdx   = na   // buy side prise  -> prerequis d'un setup VENTE
var int chochUpIdx = na
var int chochDnIdx = na
var int bosUpIdx   = na
var int bosDnIdx   = na
if barstate.isconfirmed
    if sweepDnBar
        swpDnIdx := bar_index
    if sweepUpBar
        swpUpIdx := bar_index
    if bullChoch
        chochUpIdx := bar_index
    if bearChoch
        chochDnIdx := bar_index
    if bullBos
        bosUpIdx := bar_index
    if bearBos
        bosDnIdx := bar_index

int seqMaxBars = math.max(1, int(wzMaxAnchorAgeH * 3600 / timeframe.in_seconds()))
f_seqSweep(bool isBuy) =>
    int sw = isBuy ? swpDnIdx : swpUpIdx
    not na(sw) and (bar_index - sw) <= seqMaxBars
f_seqChoch(bool isBuy) =>
    int sw = isBuy ? swpDnIdx : swpUpIdx
    int ch = isBuy ? chochUpIdx : chochDnIdx
    f_seqSweep(isBuy) and not na(ch) and ch > sw
f_seqBos(bool isBuy) =>
    int ch = isBuy ? chochUpIdx : chochDnIdx
    int bo = isBuy ? bosUpIdx : bosDnIdx
    f_seqChoch(isBuy) and not na(bo) and bo > ch

// ---- IMPULSION DU BOS : la plage sur laquelle le Fibonacci est calcule ----
// Le module existant appelait "fib" un test a 50 % sur le haut/bas de la
// SEMAINE precedente. C'est une mesure de premium/discount du dealing range,
// pas un retracement d'impulsion -- et sur une meme plage, "fib 50 %" et
// "premium/discount" sont litteralement le meme nombre. Les compter tous les
// deux serait une redondance pure.
// On garde donc l'ancien test tel quel pour le PREMIUM/DISCOUNT (plage
// hebdomadaire), et on calcule le Fibonacci sur une plage DIFFERENTE :
// l'impulsion qui a produit le BOS. Deux plages, deux informations.
//
// BUY  : bas = dernier swing low confirme (le creux d'apres le sweep)
//        haut = plus haut atteint depuis ce creux (le sommet de l'impulsion)
// SELL : miroir.
// Anti-repaint : ancre sur des pivots CONFIRMES (ta.pivotlow/high, decalage
// fixe de swingLen) ; l'extreme court ne fait que progresser, il ne revient
// jamais en arriere sur une bougie deja fermee.
var float impLo = na
var float impHi = na
if not na(pl)
    impLo := pl
    impHi := high
else if not na(impLo)
    impHi := na(impHi) ? high : math.max(impHi, high)

var float impHiS = na
var float impLoS = na
if not na(ph)
    impHiS := ph
    impLoS := low
else if not na(impHiS)
    impLoS := na(impLoS) ? low : math.min(impLoS, low)

// Etat du retracement pour un niveau donne : 1 VALID, 0 NEUTRAL, -1 INVALID.
// VALID   = 0.50 a 0.786 -- la poche ou FVG et OB tombent le plus souvent.
// NEUTRAL = 0.382-0.50 et 0.786-0.886 : plausible, sans confluence marquee.
// INVALID = moins de 0.382 (entree trop haute, aucun escompte) ou plus de
//           0.886 (l'impulsion est quasi entierement effacee).
// Volontairement une BANDE et non le point 61.8 exact : exiger le niveau au
// tick pres rejetterait presque tous les setups.
f_fibRetr(bool isBuy, float lvl) =>
    float hi = isBuy ? impHi : impHiS
    float lo = isBuy ? impLo : impLoS
    not na(hi) and not na(lo) and hi > lo and not na(lvl) ? (isBuy ? (hi - lvl) / (hi - lo) : (lvl - lo) / (hi - lo)) : na

f_fibState(bool isBuy, float lvl) =>
    float hi = isBuy ? impHi : impHiS
    float lo = isBuy ? impLo : impLoS
    int st = 0
    if not na(hi) and not na(lo) and hi > lo and not na(lvl)
        float r = isBuy ? (hi - lvl) / (hi - lo) : (lvl - lo) / (hi - lo)
        st := r >= 0.50 and r <= 0.786 ? 1 : (r >= 0.382 and r < 0.50) or (r > 0.786 and r <= 0.886) ? 0 : -1
    st


if newWeek
    // ---- Profil de la semaine ECOULEE : POC, Value Area, noeud de volume ----
    if array.size(wPx) > 20
        float lo = array.min(wPx)
        float hi = array.max(wPx)
        if hi > lo
            float st = (hi - lo) / wzBins
            array<float> acc = array.new<float>(wzBins, 0.0)
            for i = 0 to array.size(wPx) - 1
                int k = math.min(wzBins - 1, math.max(0, int((array.get(wPx, i) - lo) / st)))
                array.set(acc, k, array.get(acc, k) + array.get(wVol, i))
            float mx = array.max(acc)
            int kP = array.indexof(acc, mx)
            float tot = array.sum(acc)
            wPoc := lo + (kP + 0.5) * st
            int a1 = kP
            int b1 = kP
            float cum = mx
            while cum < tot * wzVaPct / 100.0 and (a1 > 0 or b1 < wzBins - 1)
                float u = b1 < wzBins - 1 ? array.get(acc, b1 + 1) : -1.0
                float d = a1 > 0 ? array.get(acc, a1 - 1) : -1.0
                if u >= d and b1 < wzBins - 1
                    b1 += 1
                    cum += u
                else if a1 > 0
                    a1 -= 1
                    cum += d
                else
                    break
            wVah := lo + (b1 + 1) * st
            wVal := lo + a1 * st
            // Noeuds de volume hors Value Area : le HVN bas sert aux zones
            // d'achat, le HVN haut aux zones de vente.
            float mLo = -1.0
            int   iLo = -1
            float mHi = -1.0
            int   iHi = -1
            for k = 0 to wzBins - 1
                float w = array.get(acc, k)
                if k < a1 and w > mLo
                    mLo := w
                    iLo := k
                if k > b1 and w > mHi
                    mHi := w
                    iHi := k
            wHvnLo := iLo >= 0 ? lo + (iLo + 0.5) * st : na
            wHvnHi := iHi >= 0 ? lo + (iHi + 0.5) * st : na
    wHiPrev := wHi
    wLoPrev := wLo
    array.clear(wPx)
    array.clear(wVol)
    wHi := high
    wLo := low
else
    wHi := na(wHi) ? high : math.max(wHi, high)
    wLo := na(wLo) ? low  : math.min(wLo, low)
array.push(wPx, hl2)
array.push(wVol, na(volume) ? 1.0 : volume)

// Biais hebdomadaire, lu sur la semaine CLOTUREE.
wBias := biasBull ? 1 : biasBear ? -1 : 0

// ---- Construction des zones : confluence Order Block x FVG ----------------
// CHANGEMENT DE DECLENCHEUR (affichage uniquement, explique ci-dessous).
//
// AVANT : `if newWeek` -- la zone ne pouvait naitre QU'A la bascule de semaine,
// ancree sur la Value Area hebdomadaire. Sur ~480 bougies M15 par semaine, le
// moteur n'avait donc qu'UNE occasion de creer une zone ; si a cet instant
// precis fibOk + reacted + contexte + score >= seuil n'etaient pas tous vrais
// simultanement, il n'existait aucune zone pendant toute la semaine. C'est la
// raison pour laquelle le panneau affichait "BUY Zone —" et "SELL Zone —" en
// permanence sur M1, M5 et M15 : il n'y avait rien a styliser, le probleme
// n'etait pas visuel.
//
// MAINTENANT : evaluation a CHAQUE bougie cloturee, et la zone naît de la
// confluence reelle Order Block x FVG. Ses bornes sont l'INTERSECTION des deux
// boites -- compacte par construction, et posee exactement la ou le prix est
// attendu pour l'execution. Sans chevauchement OB/FVG, aucune zone n'est
// dessinee : mieux vaut ne rien montrer que relier deux objets sans rapport.
//
// CE BLOC NE TOUCHE AUCUN SIGNAL. Aucune variable de zone n'apparait dans
// alignLong / alignShort / trigLong / trigShort / rawLong / rawShort /
// buySignal / sellSignal, ni dans f_slRisk / f_qty / strategy.entry / exit.
// Anti-repaint : barstate.isconfirmed, et le score est fige a la creation.
bool isBuyBiasNow = biasDir >= 0

var bool   dgSweep = false
var bool   dgChoch = false
var bool   dgBos   = false
var bool   dgFvg   = false
var bool   dgOb    = false
var int    dgFib   = 0
var float  dgFibR  = na
var bool   dgHtf   = false
var bool   dgPd    = false
var float  dgScore = na
var string dgRej   = ""

if wzShow and barstate.isconfirmed and not na(atrV) and atrV > 0
    // Remise a zero du diagnostic : sans OB ou sans FVG on n'entre jamais dans
    // la boucle, et l'ecran garderait sinon l'etat d'un setup deja disparu.
    if isBuyBiasNow
        dgFvg := array.size(fvBT) > 0
        dgOb  := array.size(obBT) > 0
    else
        dgFvg := array.size(fvST) > 0
        dgOb  := array.size(obST) > 0
    if not dgFvg or not dgOb
        dgRej := not dgOb ? "AUCUN ORDER BLOCK" : "AUCUN FVG"
        dgScore := na
    float rgLo = na(wLoPrev) ? wVal : wLoPrev
    float rgHi = na(wHiPrev) ? wVah : wHiPrev
    float mid  = na(rgHi) or na(rgLo) ? na : (rgHi + rgLo) / 2.0

    for side = 0 to 1
        bool isBuy = side == 0
        int want = isBuy ? 1 : -1
        int nOb = isBuy ? array.size(obBT) : array.size(obST)
        int nFv = isBuy ? array.size(fvBT) : array.size(fvST)
        if nOb > 0 and nFv > 0
            float obT = isBuy ? array.get(obBT, 0) : array.get(obST, 0)
            float obB = isBuy ? array.get(obBB, 0) : array.get(obSB, 0)
            int   obX = isBuy ? array.get(obBX, 0) : array.get(obSX, 0)

            // ---- APPARIEMENT ORDER BLOCK <-> FVG -------------------------
            // La version precedente exigeait un CHEVAUCHEMENT STRICT
            // (intersection non vide). Or dans une impulsion haussiere, l'Order
            // Block est la derniere bougie baissiere AVANT le mouvement et le
            // FVG est le gap CREE PAR ce mouvement : ils sont typiquement
            // EMPILES, pas superposes. Exiger l'intersection eliminait donc la
            // configuration ICT normale -- c'etait le second verrou apres le
            // bug du sweep.
            //
            // Desormais les deux doivent seulement etre PROCHES, et la zone est
            // leur UNION : une seule zone qui fusionne les deux, comme demande.
            // Deux garde-fous contre les zones enormes :
            //   - wzPairGapAtr : ecart maximum entre les deux boites ;
            //   - wzMaxHeightAtr : hauteur maximale de l'union. Au-dela, la
            //     paire est REJETEE plutot que dessinee trop large -- mieux
            //     vaut aucune zone qu'une zone imprecise.
            // Parmi tous les FVG candidats, on retient celui qui donne l'union
            // la PLUS SERREE (auparavant : le premier trouve, arbitraire).
            float zT = na
            float zB = na
            int   zX = na
            float bestH = na
            for j = 0 to nFv - 1
                float fT = isBuy ? array.get(fvBT, j) : array.get(fvST, j)
                float fB = isBuy ? array.get(fvBB, j) : array.get(fvSB, j)
                int   fX = isBuy ? array.get(fvBX, j) : array.get(fvSX, j)
                // Ecart entre les deux boites, nul si elles se chevauchent.
                float gap = math.max(0.0, math.max(obB - fT, fB - obT))
                float uT  = math.max(obT, fT)
                float uB  = math.min(obB, fB)
                float uH  = uT - uB
                if gap <= atrV * wzPairGapAtr and uH <= atrV * wzMaxHeightAtr
                    if na(bestH) or uH < bestH
                        bestH := uH
                        zT := uT
                        zB := uB
                        zX := math.min(obX, fX)

            // Diagnostic : OB et FVG presents mais jamais appariables.
            if na(zT) and isBuy == isBuyBiasNow
                dgRej := "OB ET FVG TROP ELOIGNES"
                dgScore := na

            if not na(zT)
                // Epaisseur plancher : une union de quelques ticks
                // serait invisible a l'ecran. wzWidthAtr sert desormais de
                // MINIMUM, plus de largeur imposee.
                float minH = atrV * wzWidthAtr * 0.25
                if zT - zB < minH
                    float ctr = (zT + zB) / 2.0
                    zT := ctr + minH / 2.0
                    zB := ctr - minH / 2.0

                // ---- SCORE DE CONFLUENCE, fige ici et jamais recalcule ------
                // 30 — Volume Profile : la zone tombe dans la Value Area.
                // 30 / 15 / 0 au lieu de 30 / 0. La version tout-ou-rien
                // creait une falaise : une zone a un tick SOUS la VAL marquait
                // 0, la meme zone a un tick au-dessus marquait 30. Ce n'est pas
                // une distinction reelle. Pire, elle rendait le seuil quasi
                // inatteignable : le gate fibOk pousse la zone dans la moitie
                // DISCOUNT de la semaine, donc souvent sous la VAL, et sans ces
                // 30 points le maximum possible tombait a 25+20+15+10 = 70,
                // c'est-a-dire EXACTEMENT le seuil -- il fallait la perfection
                // sur les quatre autres composantes ou rien.
                // Le palier intermediaire recompense le CHEVAUCHEMENT de la
                // Value Area, qui est une condition plus faible mais reelle.
                float sVp = 0.0
                if not na(wVal) and not na(wVah)
                    sVp := zB >= wVal and zT <= wVah ? 30.0 : (zT >= wVal and zB <= wVah ? 15.0 : 0.0)
                // 25 — Structure alignee.
                float sSt = (isBuy ? trend == 1 : trend == -1) ? 25.0 : 0.0
                // 20 — Liquidite non prise AU-DELA de la zone.
                float sLq = 0.0
                if isBuy and array.size(eqlL) > 0
                    for i = 0 to array.size(eqlL) - 1
                        if array.get(eqlL, i) < zB
                            sLq := 20.0
                            break
                if not isBuy and array.size(eqhL) > 0
                    for i = 0 to array.size(eqhL) - 1
                        if array.get(eqhL, i) > zT
                            sLq := 20.0
                            break
                // 15 — FIBONACCI de l'impulsion du BOS, mesure au niveau
                //      d'execution de la zone (haut pour un achat, bas pour une
                //      vente). Ces 15 points etaient auparavant "Zone SMC" -- une
                //      CONSTANTE depuis que la zone EST l'union OB x FVG :
                //      15 points toujours accordes, qui ne discriminaient donc
                //      jamais rien. Ils sont reaffectes ici a une mesure qui,
                //      elle, varie. L'echelle reste sur 100, sans inflation.
                int fibSt = f_fibState(isBuy, isBuy ? zT : zB)
                float sSmc = fibSt == 1 ? 15.0 : fibSt == 0 ? 7.0 : 0.0
                // 10 — Multi-timeframe.
                float sMtf = ((dirD == want ? 1 : 0) + (dirH4 == want ? 1 : 0) + (dirH1 == want ? 1 : 0)) / 3.0 * 10.0
                float score = sVp + sSt + sLq + sSmc + sMtf

                // Discount pour acheter, premium pour vendre.
                bool fibOk = na(mid) or (isBuy ? zB <= mid : zT >= mid)

                // UNE seule zone par cote, remplacee uniquement par MEILLEURE.
                int exI = -1
                if array.size(zSide) > 0
                    for q = 0 to array.size(zSide) - 1
                        if array.get(zSide, q) == want
                            exI := q
                bool same   = exI >= 0 and array.get(zTop, exI) == zT and array.get(zBot, exI) == zB
                bool better = exI < 0 or score > array.get(zScr, exI)

                // ---- LES TROIS CONFIRMATIONS OBLIGATOIRES ------------------
                // Repond directement aux TEST 2/3/4 : jusqu'ici le gate ne
                // contenait NI sweep, NI CHoCH, NI BOS -- une zone pouvait donc
                // naitre sans aucun des trois. Desormais les trois sont exiges,
                // dans le bon sens :
                //   BUY  : sell side liquidity sweepee + CHoCH haussier + BOS haussier
                //   SELL : buy side liquidity sweepee + CHoCH baissier + BOS baissier
                // Ces trois drapeaux sont hebdomadaires et derivent de pivots
                // CONFIRMES (+ trend garde par barstate.isconfirmed) : aucun
                // lookahead, aucun repaint.
                bool cSweep = f_seqSweep(isBuy)
                bool cChoch = f_seqChoch(isBuy)
                bool cBos   = f_seqBos(isBuy)
                // FIB INVALID rejette : c'est la definition meme de INVALID
                // ("le prix est dans une zone de retracement incompatible").
                // NEUTRAL passe, avec moins de points -- le Fibonacci ameliore
                // la selection, il ne bloque pas tout.
                bool fibNotInvalid = fibSt >= 0

                // ---- DIAGNOSTIC : etat de chaque condition + raison du refus --
                // Renseigne pour le cote qui correspond au biais affiche, afin
                // que le panneau puisse expliquer POURQUOI aucune zone n'existe.
                if isBuy == (biasDir >= 0)
                    dgSweep := cSweep
                    dgChoch := cChoch
                    dgBos   := cBos
                    dgFvg   := true
                    dgOb    := true
                    dgFib   := fibSt
                    dgFibR  := f_fibRetr(isBuy, isBuy ? zT : zB)
                    dgHtf   := f_ctxAllow(isBuy)
                    dgPd    := fibOk
                    dgScore := score
                    dgRej := not cSweep ? "SWEEP MANQUANT" : not cChoch ? "CHOCH MANQUANT" : not cBos ? "BOS MANQUANT" : not fibNotInvalid ? "FIBONACCI INVALIDE" : not fibOk ? "CONFLIT PREMIUM/DISCOUNT" : not f_ctxAllow(isBuy) ? "CONTEXTE HTF OPPOSE" : score < wzMinScore ? "CONFLUENCE " + str.tostring(int(math.round(score))) + " < " + str.tostring(wzMinScore) : not better ? "ZONE EXISTANTE MEILLEURE" : ""

                if cSweep and cChoch and cBos and fibNotInvalid and fibOk and f_ctxAllow(isBuy) and score >= wzMinScore and better and not same
                    if exI >= 0
                        box.delete(array.get(zBox, exI))
                        label.delete(array.get(zLab, exI))
                        array.remove(zTop, exI)
                        array.remove(zBot, exI)
                        array.remove(zScr, exI)
                        array.remove(zSide, exI)
                        array.remove(zBar, exI)
                        array.remove(zSmcType, exI)
                        array.remove(zSmcTop, exI)
                        array.remove(zSmcBot, exI)
                        array.remove(zSmcBar, exI)
                        array.remove(zFibHi, exI)
                        array.remove(zFibLo, exI)
                        array.remove(zBox, exI)
                        array.remove(zLab, exI)
                    color bord = isBuy ? color.new(cUp, 25) : color.new(cDn, 25)
                    color fill = isBuy ? color.new(cUp, 90) : color.new(cDn, 90)
                    box   zb = box.new(zX, zT, bar_index, zB, border_color=bord, border_width=2, bgcolor=fill)
                    label zl = label.new(bar_index, isBuy ? zB : zT, (isBuy ? "BUY ZONE  " : "SELL ZONE  ") + str.tostring(int(math.round(score))) + "/100", style=isBuy ? label.style_label_up : label.style_label_down, color=color.new(cBg, 100), textcolor=isBuy ? cUp : cDn, size=size.tiny)
                    array.push(zTop, zT)
                    array.push(zBot, zB)
                    array.push(zScr, score)
                    array.push(zSide, want)
                    array.push(zBar, zX)
                    array.push(zSmcType, 1)
                    array.push(zSmcTop, obT)
                    array.push(zSmcBot, obB)
                    array.push(zSmcBar, obX)
                    array.push(zFibHi, isBuy ? impHi : impHiS)
                    array.push(zFibLo, isBuy ? impLo : impLoS)
                    array.push(zBox, zb)
                    array.push(zLab, zl)

    while array.size(zScr) > wzMax * 2
        box.delete(array.shift(zBox))
        label.delete(array.shift(zLab))
        array.shift(zTop)
        array.shift(zBot)
        array.shift(zScr)
        array.shift(zSide)
        array.shift(zBar)
        array.shift(zSmcType)
        array.shift(zSmcTop)
        array.shift(zSmcBot)
        array.shift(zSmcBar)
        array.shift(zFibHi)
        array.shift(zFibLo)

// ---- INVALIDATION CONTINUE DES ZONES ----------------------------------
// Regle : une condition n'invalide QUE si elle etait vraie — ou garantie —
// au moment de la creation, et qu'un evenement post-creation la rend fausse.
// Rien n'est juge sur un standard qu'il n'a jamais eu a respecter.
//   CONSOMMEE — le prix l'a traversee de part en part : le desequilibre a ete
//               absorbe, il n'y a plus rien a y chercher.
//   CASSEE    — le prix a cloture au-dela de la zone, dans le mauvais sens.
//   OB/FVG    — l'element SMC precis qui a donne les 15 points a disparu
//               (mitige ou trop vieux) : verifiable, puisque sa presence a
//               ete constatee et enregistree au moment meme de la creation.
//   ANCIENNE  — l'ancre OB/FVG date de plus de wzMaxAnchorAgeH heures : le
//               setup arrive trop tard apres l'impulsion qui l'a cree.
//   PERIMEE   — le contexte HTF, qui etait EXIGE favorable a la creation
//               (garde-fou f_ctxAllow), est devenu defavorable depuis.
// Ecarte volontairement : l'alignement de `trend` n'est qu'un BONUS de score
// a la creation (25 pts, non exige) — une zone peut naitre sans lui. Le
// retenir comme cause d'invalidation la jugerait retroactivement sur une
// condition qu'elle n'a jamais eu a remplir. Retire suite a observation en
// backtest : des zones disparaissaient a la bougie suivant leur creation.
var string lastInvReason = "—"
var int    lastInvSide   = 0
var float  lastInvScore  = na
// Vrai UNIQUEMENT sur la bougie ou une zone vient d'etre retiree. Sert au
// verdict "INVALIDE" du panneau, qui doit etre un etat instantane et non un
// souvenir permanent.
bool zInvNow = false

if array.size(zTop) > 0
    for i = array.size(zTop) - 1 to 0
        bool  isB = array.get(zSide, i) == 1
        float tp  = array.get(zTop, i)
        float bt  = array.get(zBot, i)
        int   sT  = array.get(zSmcType, i)
        float sTp = array.get(zSmcTop, i)
        float sBt = array.get(zSmcBot, i)
        int   sBar = array.get(zSmcBar, i)

        bool consommee  = isB ? (low <= bt and close > tp) : (high >= tp and close < bt)
        bool cassee     = isB ? close < bt : close > tp
        bool ancienne   = sT != 0 and not na(sBar) and (bar_index - sBar) * timeframe.in_seconds() / 3600.0 > wzMaxAnchorAgeH
        bool perimee    = not f_ctxAllow(isB)

        bool smcGone = false
        if sT == 1
            smcGone := true
            if isB and array.size(obBB) > 0
                for j = 0 to array.size(obBB) - 1
                    if array.get(obBT, j) == sTp and array.get(obBB, j) == sBt
                        smcGone := false
            if not isB and array.size(obST) > 0
                for j = 0 to array.size(obST) - 1
                    if array.get(obST, j) == sTp and array.get(obSB, j) == sBt
                        smcGone := false
        else if sT == 2
            smcGone := true
            if isB and array.size(fvBB) > 0
                for j = 0 to array.size(fvBB) - 1
                    if array.get(fvBT, j) == sTp and array.get(fvBB, j) == sBt
                        smcGone := false
            if not isB and array.size(fvST) > 0
                for j = 0 to array.size(fvST) - 1
                    if array.get(fvST, j) == sTp and array.get(fvSB, j) == sBt
                        smcGone := false

        string reason = consommee ? "zone consommee" : cassee ? "cloture au travers" : smcGone ? (sT == 1 ? "OB casse" : "FVG comble") : ancienne ? "ancre trop ancienne" : perimee ? "contexte HTF change" : ""

        if reason != ""
            zInvNow := true
            lastInvReason := reason
            lastInvSide   := array.get(zSide, i)
            lastInvScore  := array.get(zScr, i)
            box.delete(array.get(zBox, i))
            label.delete(array.get(zLab, i))
            array.remove(zTop, i)
            array.remove(zBot, i)
            array.remove(zScr, i)
            array.remove(zSide, i)
            array.remove(zBar, i)
            array.remove(zSmcType, i)
            array.remove(zSmcTop, i)
            array.remove(zSmcBot, i)
            array.remove(zSmcBar, i)
            array.remove(zFibHi, i)
            array.remove(zFibLo, i)
            array.remove(zBox, i)
            array.remove(zLab, i)

// Les zones survivantes s'etirent jusqu'a la bougie courante : c'est ce qui
// rend visible, en un coup d'oeil, qu'une zone est TOUJOURS active. Le bord
// GAUCHE est tronque a zoneMaxBars -- sans ca une zone creee lundi couvrait
// ~480 bougies M15 le vendredi. Le label suit le bord droit : il restait
// colle a la bougie de creation, donc hors ecran des le mardi.
if array.size(zBox) > 0
    for i = 0 to array.size(zBox) - 1
        box.set_left(array.get(zBox, i), array.get(zBar, i))
        box.set_right(array.get(zBox, i), bar_index + zoneMaxBars)
        label.set_x(array.get(zLab, i), bar_index + zoneMaxBars)

// Zone trop loin du prix : mise en sourdine, pas supprimee -- l'information
// qu'elle existe reste disponible, mais elle cesse d'attirer l'oeil en
// premier. Repond a "elle est trop eloignee du prix" (section 7) sans
// perdre la trace de la zone comme le ferait une suppression pure.
if array.size(zBox) > 0 and not na(atrV) and atrV > 0
    for i = 0 to array.size(zBox) - 1
        float mid  = (array.get(zTop, i) + array.get(zBot, i)) / 2.0
        float dist = math.abs(close - mid) / atrV
        bool  isB  = array.get(zSide, i) == 1
        bool  far  = dist > wzFarAtr
        box.set_border_color(array.get(zBox, i), isB ? color.new(cUp, far ? 85 : 45) : color.new(cDn, far ? 85 : 45))
        box.set_bgcolor(array.get(zBox, i), isB ? color.new(cUp, far ? 97 : 93) : color.new(cDn, far ? 97 : 93))

// ---- Etat des confirmations SMC. Calcule EN CONTINU, jamais dans le score.
// Une zone atteinte ne suffit pas : le systeme attend le sweep, la cassure et
// la zone SMC. Et meme les trois reunis ne declenchent rien — c'est buySignal
// et sellSignal qui decident, et eux seuls.
int  zHit  = 0
int  zHitI = -1
if array.size(zTop) > 0
    for i = 0 to array.size(zTop) - 1
        if close <= array.get(zTop, i) and close >= array.get(zBot, i)
            zHit  := array.get(zSide, i)
            zHitI := i

bool wzCfSweep = zHit == 1 ? f_seqSweep(true) : zHit == -1 ? f_seqSweep(false) : false
bool wzCfStruc = zHit == 1 ? (bullBos or bullChoch) : zHit == -1 ? (bearBos or bearChoch) : false
bool wzCfSmc   = zHit == 1 ? (array.size(obBB) > 0 or array.size(fvBB) > 0) : zHit == -1 ? (array.size(obST) > 0 or array.size(fvST) > 0) : false
int  wzCfN     = (wzCfSweep ? 1 : 0) + (wzCfStruc ? 1 : 0) + (wzCfSmc ? 1 : 0)
// Le plan est "arme" quand les trois confirmations sont la. Cela reste un ETAT
// AFFICHE : le trade, lui, n'existe que si buySignal ou sellSignal est vrai.
bool wzArmed = zHit != 0 and wzCfN == 3

// ---- SEQUENCE NUMEROTEE DE LA ZONE ACTIVE (1 a 9) --------------------
// Raconte l'histoire de LA zone touchee par le prix en ce moment (zHitI),
// et seulement elle : aucun lien artificiel entre des evenements de zones
// differentes. Une zone qui n'est plus touchee revient a son texte simple
// au bar suivant (voir boucle plus bas) -- rien ne reste mis en avant apres
// que le prix l'ait quittee ou qu'elle ait ete invalidee.
bool step1Liq = false
if zHitI >= 0
    bool sIsB = array.get(zSide, zHitI) == 1
    float sTop = array.get(zTop, zHitI)
    float sBot = array.get(zBot, zHitI)
    if sIsB and array.size(eqlL) > 0
        for i = 0 to array.size(eqlL) - 1
            if array.get(eqlL, i) < sBot
                step1Liq := true
    if not sIsB and array.size(eqhL) > 0
        for i = 0 to array.size(eqhL) - 1
            if array.get(eqhL, i) > sTop
                step1Liq := true
bool step2Sweep = wzCfSweep
bool step3Choch = zHit == 1 ? f_seqChoch(true) : zHit == -1 ? f_seqChoch(false) : false
bool step4Bos   = zHit == 1 ? f_seqBos(true)   : zHit == -1 ? f_seqBos(false)   : false

// Texte de chaque zone : numerote 1-2-3-4-6 pour celle touchee par le prix,
// texte simple pour toutes les autres -- recalcule CHAQUE bougie, donc une
// zone qui cesse d'etre touchee (prix reparti, ou zone invalidee et retiree
// du tableau) ne garde jamais sa numerotation.
if array.size(zLab) > 0
    for i = 0 to array.size(zLab) - 1
        bool  lIsB = array.get(zSide, i) == 1
        string plainTxt = (lIsB ? "BUY  " : "SELL  ") + str.tostring(int(math.round(array.get(zScr, i)))) + "/100"
        if i == zHitI
            string seqTxt = (step1Liq ? "✓1" : "✗1") + " " + (step2Sweep ? "✓2" : "✗2") + " " + (step3Choch ? "✓3" : "✗3") + " " + (step4Bos ? "✓4" : "✗4")
            label.set_text(array.get(zLab, i), "6. " + plainTxt + "\n" + seqTxt)
        else
            label.set_text(array.get(zLab, i), plainTxt)

// ============================================================
// OBJECTIF ET DOUBLE REFERENCE DE STOP — LECTURE SEULE
// ------------------------------------------------------------
// AUCUN ORDRE NE SORT D'ICI. La sortie reelle reste le trailing mesure
// (armement 1.5 R, distance 0.3 R), qui bat les 56 combinaisons stop x TP
// testees. Ce bloc repond a une autre question : « si ca marche, ou est-ce
// que ca peut aller, et ou aurais-je vraiment tort ? »
//
// Pourquoi l'objectif n'est PAS le TP. Mesure sur 1101 journees : au premier
// retour du prix sur un POC, une VAH, une VAL ou une poche de liquidite,
// AUCUN de ces niveaux ne bat un niveau de controle place a la meme distance
// (p entre 0.34 et 0.56). En faire une cible d'ordre reviendrait a troquer un
// mecanisme mesure contre un reperage sans pouvoir d'attraction demontre.
// En revanche, savoir ou se trouve le prochain obstacle aide a decider.
int   objDir = biasBull ? 1 : biasBear ? -1 : 0
float objPx  = na
string objSrc = ""
if objDir != 0 and not na(atrV)
    // On cherche le premier obstacle DEVANT le prix, dans le sens du biais.
    float best = na
    string src = ""
    // liquidite opposee : c'est la que les stops sont empiles
    if objDir == 1 and array.size(eqhL) > 0
        for i = 0 to array.size(eqhL) - 1
            float lv = array.get(eqhL, i)
            if lv > close and (na(best) or lv < best)
                best := lv
                src := "liquidite"
    if objDir == -1 and array.size(eqlL) > 0
        for i = 0 to array.size(eqlL) - 1
            float lv = array.get(eqlL, i)
            if lv < close and (na(best) or lv > best)
                best := lv
                src := "liquidite"
    // POC de la veille et POC hebdomadaire
    if not na(pocPrev) and (objDir == 1 ? pocPrev > close : pocPrev < close) and (na(best) or (objDir == 1 ? pocPrev < best : pocPrev > best))
        best := pocPrev
        src := "POC veille"
    if not na(wPoc) and (objDir == 1 ? wPoc > close : wPoc < close) and (na(best) or (objDir == 1 ? wPoc < best : wPoc > best))
        best := wPoc
        src := "POC hebdo"
    // zone institutionnelle opposee
    if array.size(zTop) > 0
        for i = 0 to array.size(zTop) - 1
            if array.get(zSide, i) == -objDir
                float lv = objDir == 1 ? array.get(zBot, i) : array.get(zTop, i)
                if (objDir == 1 ? lv > close : lv < close) and (na(best) or (objDir == 1 ? lv < best : lv > best))
                    best := lv
                    src := "zone hebdo"
    objPx := best
    objSrc := src

// --- Les deux references de stop, cote a cote ---
// ATR : c'est le stop du systeme, celui qui passe les ordres. Mesure : plateau
//       2.0-3.0 ATR ; a 1.5 ATR le systeme devient negatif sur 2 sous-periodes
//       sur 4. Il ne bouge pas.
// STRUCTUREL : le point ou l'idee est vraiment fausse — sous le dernier creux,
//       sous l'Order Block, sous la liquidite prise. Il n'est PAS utilise comme
//       ordre parce qu'il varie de 0.8 a 5 ATR selon le hasard du dernier
//       Order Block, ce qui fait sortir du plateau sans prevenir.
// L'ECART entre les deux est l'information reelle : quand le stop ATR est
// DEVANT l'invalidation, le trade a une chance elevee d'etre coupe avant
// d'avoir eu tort. Aucun indicateur grand public ne le dit.
float stopAtr = na
float stopStr = na
if objDir != 0 and not na(atrV) and atrV > 0
    stopAtr := objDir == 1 ? close - slAtrRef * atrV : close + slAtrRef * atrV
    float prot = objDir == 1 ? swingLow : swingHigh
    if objDir == 1
        if array.size(obBB) > 0
            prot := na(prot) ? array.get(obBB, 0) : math.min(prot, array.get(obBB, 0))
        if array.size(eqlL) > 0
            for i = 0 to array.size(eqlL) - 1
                float lv = array.get(eqlL, i)
                if lv < close
                    prot := na(prot) ? lv : math.min(prot, lv)
    else
        if array.size(obST) > 0
            prot := na(prot) ? array.get(obST, 0) : math.max(prot, array.get(obST, 0))
        if array.size(eqhL) > 0
            for i = 0 to array.size(eqhL) - 1
                float lv = array.get(eqhL, i)
                if lv > close
                    prot := na(prot) ? lv : math.max(prot, lv)
    stopStr := na(prot) ? na : (objDir == 1 ? prot - atrV * 0.15 : prot + atrV * 0.15)

float riskAtr = na(stopAtr) ? na : math.abs(close - stopAtr)
float riskStr = na(stopStr) ? na : math.abs(close - stopStr)
float rr      = na(objPx) or na(riskAtr) or riskAtr <= 0 ? na : math.abs(objPx - close) / riskAtr
// Le stop du systeme est-il DEVANT le point d'invalidation reelle ?
bool stopDevant = not na(riskStr) and not na(riskAtr) and riskStr > riskAtr * 1.15

// ============================================================
// RENDU — tout ce qui suit est redessine sur la DERNIERE bougie uniquement.
// Cout nul sur l'historique, et surtout : aucune de ces valeurs n'est lue par
// une condition. C'est du dessin, rien d'autre.
// ============================================================
var array<box>   dBx = array.new<box>()
var array<line>  dLn = array.new<line>()
var array<label> dLb = array.new<label>()

f_clear() =>
    if array.size(dBx) > 0
        for i = 0 to array.size(dBx) - 1
            box.delete(array.get(dBx, i))
        array.clear(dBx)
    if array.size(dLn) > 0
        for i = 0 to array.size(dLn) - 1
            line.delete(array.get(dLn, i))
        array.clear(dLn)
    if array.size(dLb) > 0
        for i = 0 to array.size(dLb) - 1
            label.delete(array.get(dLb, i))
        array.clear(dLb)

// Trait COURT, pour la liquidite : elle doit se lire pres du prix sans
// balayer tout l'ecran comme le fait f_lvl (60 bougies).
f_liq(float y, color col, string txt) =>
    if not na(y)
        line l = line.new(bar_index - 18, y, bar_index + 4, y, color=col, width=1, style=line.style_solid)
        array.push(dLn, l)
        label lb = label.new(bar_index + 4, y, txt, style=label.style_label_left, color=color.new(cBg, 100), textcolor=col, size=size.tiny)
        array.push(dLb, lb)

f_lvl(float y, color col, string txt, string sty) =>
    if not na(y)
        line l = line.new(bar_index - 60, y, bar_index + 4, y, color=col, width=1, style=sty)
        array.push(dLn, l)
        if txt != ""
            label lb = label.new(bar_index + 4, y, txt, style=label.style_label_left, color=color.new(cBg, 100), textcolor=col, size=size.tiny)
            array.push(dLb, lb)

// Le bord gauche est tronque a zoneMaxBars : une boite garde son origine
// reelle tant qu'elle est recente, et cesse de balayer tout l'ecran quand
// elle vieillit. Les bornes de PRIX (top/bot) ne sont jamais touchees.
// Une boite OB/FVG appartient-elle au setup en cours ? Vraie si elle
// CHEVAUCHE une zone active. Comme la zone EST l'union OB x FVG, les
// deux ancres de cette zone la chevauchent forcement -- un seul test suffit
// donc pour les deux types, sans avoir a memoriser le FVG separement.
f_nearZone(float t, float b) =>
    bool r = false
    if array.size(zTop) > 0
        for q = 0 to array.size(zTop) - 1
            if math.min(t, array.get(zTop, q)) > math.max(b, array.get(zBot, q))
                r := true
    r

// ANCRAGE AUX BOUGIES. Le bord gauche etait tronque a
// `bar_index - zoneMaxBars` (25) : un Order Block cree 100 bougies plus tot
// voyait son rectangle DEMARRER 25 bougies en arriere au lieu de sa bougie
// d'origine. D'ou l'impression de rectangle flottant, sans rapport visible
// avec les bougies. Ce plafond avait ete ajoute contre les rectangles
// geants ; la bonne reponse etait de borner la PROJECTION A DROITE, pas
// d'amputer l'ancrage a gauche.
// La boite part desormais EXACTEMENT de la bougie qui l'a creee et se
// prolonge vers la droite tant qu'elle reste valide.
f_zone(float top, float bot, int left, color bord, color fill, string txt, color txtc, string bsty) =>
    if not na(top) and not na(bot) and top > bot
        box b = box.new(left, top, bar_index + zoneMaxBars, bot, border_color=bord, border_width=1, border_style=bsty, bgcolor=fill, text=txt, text_color=txtc, text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_top)
        array.push(dBx, b)

if barstate.islast
    f_clear()

    // ---- Liquidite : traits FINS, en arriere-plan, jamais de bloc ----
    // Sommets egaux = BUY SIDE (les stops d'achat sont AU-DESSUS).
    // Creux egaux  = SELL SIDE (les stops de vente sont EN DESSOUS).
    // La version precedente inversait les deux.
    if liqShow
        // Seules les liqShowMax poches les plus RECENTES sont tracees. Le
        // moteur, lui, en suit liqMax : le plafond visuel ne peut donc plus
        // amputer la detection des sweeps ni le score de liquidite.
        if array.size(eqhL) > 0
            for i = math.max(0, array.size(eqhL) - liqShowMax) to array.size(eqhL) - 1
                f_liq(array.get(eqhL, i), color.new(cBlue, 45), "BSL")
        if array.size(eqlL) > 0
            for i = math.max(0, array.size(eqlL) - liqShowMax) to array.size(eqlL) - 1
                f_liq(array.get(eqlL, i), color.new(cDn, 45), "SSL")

    // ---- Profil de la veille : le POC est le SEUL element saillant du fond ----
    if vShow
        // Reference de contexte, pas element de decision : nettement attenues
        // pour cesser de concurrencer les zones et les OB/FVG a l'oeil.
        f_lvl(pocPrev, color.new(cGold, 55), "POC", line.style_solid)
        f_lvl(vahPrev, color.new(cMute, 60), "VAH", line.style_dashed)
        f_lvl(valPrev, color.new(cMute, 60), "VAL", line.style_dashed)

    // ---- Order Blocks retenus ----
    // DEUX COUCHES INDEPENDANTES. Les Order Blocks et les FVG sont des elements
    // de LECTURE du marche : ils s'affichent des que obShow / fvgShow sont
    // coches, qu'ils appartiennent ou non a une zone institutionnelle. La
    // BUY/SELL ZONE est une couche SUPERIEURE de confluence, commandee
    // separement par wzShow.
    // Un reglage "zoneOnly" masquait auparavant tout OB/FVG n'appartenant pas a
    // une zone active. Comme les zones sont rares par conception -- et le sont
    // devenues davantage depuis que l'Order Block est fige au CHoCH -- les deux
    // effets se cumulaient et le graphique se vidait. Le reglage est supprime.
    // Le prefixe "5. " reste, mais il ne fait plus que METTRE EN VALEUR l'OB
    // ancre de la zone active : il ne conditionne plus l'affichage.
    if obShow
        // D3 -- L'ETAT SE LIT DANS LE TEXTE, la palette et les deux niveaux de
        // transparence d'origine sont conserves tels quels.
        //   "OB"    = FRESH, jamais retouche
        //   "OB ·"  = MITIGATED, une meche est entree
        //   "OB ··" = TESTED, une bougie a cloture dedans sans casser
        // Un OB mitige ou teste reste ACTIF et VISIBLE : seule sa transparence
        // change. Il ne disparait que casse, et meme alors il ne disparait pas
        // vraiment -- il passe en attente (voir plus bas).
        if array.size(obBT) > 0
            for i = 0 to array.size(obBT) - 1
                bool obActive = f_nearZone(array.get(obBT, i), array.get(obBB, i))
                int  obSt  = array.get(obBSt, i)
                bool obMit = obSt >= 1
                string obTx = (obActive ? "5. OB" : "OB") + (obSt >= 2 ? " ··" : obSt >= 1 ? " ·" : "")
                f_zone(array.get(obBT, i), array.get(obBB, i), array.get(obBX, i), color.new(cBlue, obMit ? 55 : 40), color.new(cBlue, obMit ? 90 : 85), obTx, color.new(cBlue, 25), line.style_solid)
        if array.size(obST) > 0
            for i = 0 to array.size(obST) - 1
                bool obActive = f_nearZone(array.get(obST, i), array.get(obSB, i))
                int  obSt  = array.get(obSSt, i)
                bool obMit = obSt >= 1
                string obTx = (obActive ? "5. OB" : "OB") + (obSt >= 2 ? " ··" : obSt >= 1 ? " ·" : "")
                f_zone(array.get(obST, i), array.get(obSB, i), array.get(obSX, i), color.new(cPurp, obMit ? 55 : 40), color.new(cPurp, obMit ? 90 : 85), obTx, color.new(cPurp, 25), line.style_solid)

        // Historique : memes couleurs et meme style que l'OB actif -- un OB
        // valide reste un OB valide, qu'il porte ou non le setup en cours.
        if array.size(ohBT) > 0
            for i = 0 to array.size(ohBT) - 1
                int  ohSt  = array.get(ohBSt, i)
                bool ohMit = ohSt >= 1
                f_zone(array.get(ohBT, i), array.get(ohBB, i), array.get(ohBX, i), color.new(cBlue, ohMit ? 55 : 40), color.new(cBlue, ohMit ? 90 : 85), "OB" + (ohSt >= 2 ? " ··" : ohSt >= 1 ? " ·" : ""), color.new(cBlue, 25), line.style_solid)
        if array.size(ohST) > 0
            for i = 0 to array.size(ohST) - 1
                int  ohSt  = array.get(ohSSt, i)
                bool ohMit = ohSt >= 1
                f_zone(array.get(ohST, i), array.get(ohSB, i), array.get(ohSX, i), color.new(cPurp, ohMit ? 55 : 40), color.new(cPurp, ohMit ? 90 : 85), "OB" + (ohSt >= 2 ? " ··" : ohSt >= 1 ? " ·" : ""), color.new(cPurp, 25), line.style_solid)

        // D2 -- ZONES CASSEES EN ATTENTE DE CONFIRMATION. Couleurs du futur
        // Breaker, mais contour POINTILLE et texte "BB?" : la zone est cassee,
        // elle n'est pas encore un Breaker et ne le sera peut-etre jamais.
        // Aucune couleur nouvelle n'est introduite.
        if array.size(pbST) > 0
            for i = 0 to array.size(pbST) - 1
                f_zone(array.get(pbST, i), array.get(pbSB, i), array.get(pbSX, i), color.new(cPurp, 55), color.new(cDn, 93), "BB?", color.new(cPurp, 40), line.style_dashed)
        if array.size(pbBT) > 0
            for i = 0 to array.size(pbBT) - 1
                f_zone(array.get(pbBT, i), array.get(pbBB, i), array.get(pbBX, i), color.new(cBlue, 55), color.new(cUp, 93), "BB?", color.new(cBlue, 40), line.style_dashed)

        // BREAKER BLOCKS CONFIRMES. Meme zone, meme origine, sens inverse.
        // Baissier (ex-OB haussier casse) : contour violet, fond rouge.
        // Haussier (ex-OB baissier casse) : contour bleu, fond vert.
        if array.size(bkST) > 0
            for i = 0 to array.size(bkST) - 1
                f_zone(array.get(bkST, i), array.get(bkSB, i), array.get(bkSX, i), color.new(cPurp, 35), color.new(cDn, 88), "BB", color.new(cPurp, 20), line.style_solid)
        if array.size(bkBT) > 0
            for i = 0 to array.size(bkBT) - 1
                f_zone(array.get(bkBT, i), array.get(bkBB, i), array.get(bkBX, i), color.new(cBlue, 35), color.new(cUp, 88), "BB", color.new(cBlue, 20), line.style_solid)

    // ---- Fair Value Gaps retenus ----
    if fvgShow
        if array.size(fvBT) > 0
            for i = 0 to array.size(fvBT) - 1
                bool fvActive = f_nearZone(array.get(fvBT, i), array.get(fvBB, i))
                f_zone(array.get(fvBT, i), array.get(fvBB, i), array.get(fvBX, i), color.new(cUp, 55), color.new(cUp, 87), (fvActive ? "5. FVG" : "FVG"), color.new(cUp, 30), line.style_dashed)
        if array.size(fvST) > 0
            for i = 0 to array.size(fvST) - 1
                bool fvActive = f_nearZone(array.get(fvST, i), array.get(fvSB, i))
                f_zone(array.get(fvST, i), array.get(fvSB, i), array.get(fvSX, i), color.new(cDn, 55), color.new(cDn, 87), (fvActive ? "5. FVG" : "FVG"), color.new(cDn, 30), line.style_dashed)

    // ---- FIBONACCI DE LA ZONE ACTIVE -------------------------------------
    // Traces a partir du swing FIGE dans la zone, jamais du tracker glissant :
    // les niveaux d'une zone deja creee ne bougent donc plus. Uniquement les
    // quatre niveaux qui servent au jugement (50 / 61.8 / 70.5 / 78.6), plus
    // l'equilibre qui separe premium et discount. Rien d'autre : un eventail
    // complet noierait le graphique pour aucune information supplementaire.
    if fibShow and array.size(zTop) > 0
        for i = 0 to array.size(zTop) - 1
            float fHi = array.get(zFibHi, i)
            float fLo = array.get(zFibLo, i)
            if not na(fHi) and not na(fLo) and fHi > fLo
                bool fIsB = array.get(zSide, i) == 1
                float rng = fHi - fLo
                f_lvl(fIsB ? fHi : fLo,                             color.new(cMute, 80), "0",    line.style_dotted)
                f_lvl(fIsB ? fHi - rng * 0.382 : fLo + rng * 0.382, color.new(cMute, 72), "0.382", line.style_dotted)
                f_lvl(fIsB ? fHi - rng * 0.50  : fLo + rng * 0.50,  color.new(cMute, 62), "0.5",   line.style_dashed)
                f_lvl(fIsB ? fHi - rng * 0.618 : fLo + rng * 0.618, color.new(cGold, 15), "0.618", line.style_solid)
                f_lvl(fIsB ? fHi - rng * 0.705 : fLo + rng * 0.705, color.new(cGold, 15), "0.705", line.style_solid)
                f_lvl(fIsB ? fHi - rng * 0.786 : fLo + rng * 0.786, color.new(cGold, 62), "0.786", line.style_dotted)
                f_lvl(fIsB ? fLo : fHi,                             color.new(cMute, 80), "1",    line.style_dotted)

    // ---- ENTREE PLANIFIEE : le bord de la zone ou l'on attend le prix ----
    // Repond a "l'Entry doit etre DANS ou au bord logique de la zone" -- mais
    // SANS mentir sur l'execution. Ce sont deux choses differentes, donc deux
    // libelles differents :
    //   "ENTRY (plan)" = le bord de la zone active, la ou l'on ATTEND le prix.
    //                    Trace des que la zone existe, avant que le prix y soit.
    //   "7. ENTRY"     = le prix REEL d'execution (close de la bougie de
    //                    signal), trace uniquement quand le signal existe.
    // Melanger les deux afficherait un prix auquel la strategie n'entre jamais.
    if showLvls and not (rawLong or rawShort) and array.size(zTop) > 0
        for i = 0 to array.size(zTop) - 1
            bool pIsB = array.get(zSide, i) == 1
            f_lvl(pIsB ? array.get(zTop, i) : array.get(zBot, i), color.new(pIsB ? cUp : cDn, 45), "ENTRY (plan)", line.style_dotted)

    // ---- Niveaux du setup en cours ----
    if showLvls and (rawLong or rawShort) and not na(atrV)
        // Noms locaux evites : dans la version strategie, ePx et sPx sont des
        // variables GLOBALES du bloc d'execution ; les redeclarer ici les
        // masquerait et Pine refuserait de compiler.
        // Le stop du systeme et le point d'invalidation structurelle sont
        // traces ENSEMBLE, chacun avec sa raison — c'est l'ECART entre les
        // deux qui informe, pas leur valeur prise isolement.
        // "7./8./9." ne prefixent CES niveaux que si le signal du moment
        // appartient reellement a la zone numerotee 1-6 (meme cote, prix
        // dedans) -- un signal qui se declenche hors de toute zone garde ses
        // etiquettes simples, jamais un lien invente avec une zone etrangere.
        bool tiedToZone = zHitI >= 0 and ((rawLong and array.get(zSide, zHitI) == 1) or (rawShort and array.get(zSide, zHitI) == -1))
        f_lvl(close, color.new(cTxt, 30), (tiedToZone ? "7. " : "") + "Entree", line.style_dotted)
        f_lvl(stopAtr, color.new(cDn, 5), (tiedToZone ? "8. " : "") + "SL " + str.tostring(slAtrRef, "#.#") + " ATR", line.style_solid)
        if not na(stopStr)
            f_lvl(stopStr, color.new(cDn, 55), stopDevant ? "Invalidation ⚠" : "Invalidation", line.style_dashed)
        if not na(objPx)
            f_lvl(objPx, color.new(cUp, 25), (tiedToZone ? "9. " : "") + "TP · Objectif (" + objSrc + ")" + (na(rr) ? "" : "  " + str.tostring(rr, "#.#") + "R"), line.style_dashed)

// --- Teinte de fond : le biais sans aucun deplacement du regard ---
bgcolor(uiTint ? (biasBull ? color.new(cUp, 96) : biasBear ? color.new(cDn, 96) : na) : na, title="Biais D1+W1")

// --- Fleches d'entree : les seuls marqueurs opaques du graphique ---
plotshape(buySignal,  title="BUY",  style=shape.triangleup,   location=location.belowbar, color=cUp, size=size.small)
plotshape(sellSignal, title="SELL", style=shape.triangledown, location=location.abovebar, color=cDn, size=size.small)

// ============================================================
// PLAN 3 — LE PANNEAU DE DECISION
// Ordre de lecture impose : biais, multi-timeframe, contexte, verdict.
// Trois familles visuellement separees, parce qu'elles n'ont pas le meme
// statut : ce qui DECIDE, ce qui n'est que CONTEXTE, et la conclusion.
// ============================================================

// ============================================================
// PANNEAU — VERDICT / BIAS / CONFLUENCE / VALIDATION / PLAN
// ------------------------------------------------------------
// Pas de legende a part sur le graphique : chaque zone/OB/FVG porte deja
// son propre texte ("OB", "FVG", "BUY 82/100"...), un decodeur separe
// serait un aveu d'echec de la lisibilite directe.
// Pas de barre basse : elle dupliquait ces memes lignes.
// Chaque ligne repond a une question, dans l'ordre ou elle se pose.
// ============================================================
var table pan = table.new(panPos == "top_left" ? position.top_left : panPos == "top_right" ? position.top_right : panPos == "bottom_left" ? position.bottom_left : position.bottom_right, 2, 17, border_width=0)

// f_cell = ligne CONTEXTE (affichee, ne decide rien). f_cellD = ligne DECIDE
// (participe reellement a buySignal/sellSignal) : meme contenu, fond legerement
// teinte pour separer les deux familles au coup d'oeil, sans reordonner les
// lignes ni toucher a une seule condition.
f_cell(int r, string k, string v, color vc) =>
    table.cell(pan, 0, r, "  " + k, text_color=color.new(cTxt, 35), text_size=size.small, text_halign=text.align_left,  bgcolor=color.new(cBg, 6))
    table.cell(pan, 1, r, v + "  ", text_color=vc, text_size=size.small, text_halign=text.align_right, bgcolor=color.new(cBg, 6))

f_cellD(int r, string k, string v, color vc) =>
    table.cell(pan, 0, r, "  " + k, text_color=color.new(cTxt, 25), text_size=size.small, text_halign=text.align_left,  bgcolor=color.new(cGold, 93))
    table.cell(pan, 1, r, v + "  ", text_color=vc, text_size=size.small, text_halign=text.align_right, bgcolor=color.new(cGold, 93))

f_px2(float p) => na(p) ? "—" : str.tostring(p, format.mintick)

if barstate.islast and panShow
    // 0 — LE VERDICT. La seule ligne a lire si tu n'as que deux secondes.
    bool sL = rawLong
    bool sS = rawShort
    bool dL = biasDir >= 0

    // GRADE A+/A/B/INVALID (voir SETUP_GRADING.md). Calcule ICI, avant le
    // verdict, pour etre affichable a la fois en ligne 0 (resume) et en
    // ligne 3 (detail). Reprend terme a terme alignLong/alignShort, y
    // compris leurs interrupteurs useX : un filtre desactive compte comme
    // satisfait, exactement comme dans alignLong.
    bool gC1 = not useStruct or (dL ? trend == 1 : trend == -1)
    bool gC2 = not useHtf    or (dL ? htfBull : htfBear)
    bool gC3 = not useVwap   or (dL ? aboveVwap : belowVwap)
    bool gC4 = not useBias   or (dL ? biasBull : biasBear)
    bool gC5 = not vUsePoc   or (dL ? abovePoc : belowPoc)
    int gradeN = (gC1 ? 1 : 0) + (gC2 ? 1 : 0) + (gC3 ? 1 : 0) + (gC4 ? 1 : 0) + (gC5 ? 1 : 0)
    bool trigOk = dL ? trigLong : trigShort
    bool exclOk = not na(atrV) and atrV > 0 and barstate.isconfirmed and (dL ? (bar_index - lastLong) > cooldown : (bar_index - lastShort) > cooldown)
    string grade = not trigOk or not exclOk ? "INVALID" : gradeN == 5 ? "A+" : gradeN == 4 ? "A" : gradeN == 3 ? "B" : "INVALID"
    color gradeCol = grade == "A+" ? cUp : grade == "A" ? cGold : grade == "B" ? color.new(cGold, 40) : cMute

    // QUATRE ETATS EXCLUSIFS, dans cet ordre de priorite. Le grade
    // n'accompagne QUE "ENTRER" : ailleurs il produisait des libelles
    // contradictoires du type "ATTENDRE · INVALID" -- deux concepts
    // differents (l'etat du setup, et la note des 5 conditions) colles dans
    // la meme phrase.
    //   ENTRER       : les conditions d'entree sont reunies (rawLong/rawShort)
    //   INVALIDE     : une zone vient d'etre retiree sur CETTE bougie
    //   ATTENDRE     : au moins une zone active existe, mais pas de signal
    //   PAS DE SETUP : aucune zone qualifiee
    int nZ = array.size(zTop)
    // ---- DASHBOARD ------------------------------------------------------
    // Une ligne = une information, un libelle a gauche, une valeur a droite.
    // Le diagnostic detaille, qui occupait cinq lignes denses, est reduit a une
    // ligne STATUS ; le detail des conditions devient une colonne de coches.
    string stat = sL ? "BUY SETUP" : sS ? "SELL SETUP" : zInvNow ? "ZONE INVALIDEE" : nZ > 0 ? "ZONE ACTIVE" : (diagShow and dgRej != "" ? dgRej : "WAITING FOR SETUP")
    color  vc   = sL ? cUp : sS ? cDn : zInvNow ? cDn : nZ > 0 ? cGold : cMute

    // 0 — En-tete.
    table.cell(pan, 0, 0, "  SMC PRO", text_color=color.rgb(12, 14, 18), text_size=size.normal, text_halign=text.align_left, bgcolor=vc)
    table.cell(pan, 1, 0, (sL or sS ? grade + "  " : "  "), text_color=color.rgb(12, 14, 18), text_size=size.small, text_halign=text.align_right, bgcolor=vc)

    f_cell(1, "BIAS", ctxTxt, ctxCol)

    float confScore = na
    if array.size(zTop) > 0
        for i = 0 to array.size(zTop) - 1
            if array.get(zSide, i) == (dL ? 1 : -1)
                confScore := array.get(zScr, i)
                break
    f_cell(2, "SCORE", na(confScore) ? "—" : str.tostring(int(math.round(confScore))) + "/100", na(confScore) ? cMute : (dL ? cUp : cDn))

    int nBuyZ  = 0
    int nSellZ = 0
    if array.size(zSide) > 0
        for i = 0 to array.size(zSide) - 1
            if array.get(zSide, i) == 1
                nBuyZ += 1
            else
                nSellZ += 1
    f_cell(3, "BUY ZONE",  nBuyZ  > 0 ? "✓" : "—", nBuyZ  > 0 ? cUp : cMute)
    f_cell(4, "SELL ZONE", nSellZ > 0 ? "✓" : "—", nSellZ > 0 ? cDn : cMute)

    // Colonne de conditions : une par ligne, verte si remplie, grise sinon.
    // Masquable par diagShow pour un panneau encore plus court.
    if diagShow
        f_cell(5,  "SWEEP", dgSweep ? "✓" : "—", dgSweep ? cUp : cMute)
        f_cell(6,  "CHoCH", dgChoch ? "✓" : "—", dgChoch ? cUp : cMute)
        f_cell(7,  "BOS",   dgBos   ? "✓" : "—", dgBos   ? cUp : cMute)
        f_cell(8,  "OB",    dgOb    ? "✓" : "—", dgOb    ? cUp : cMute)
        f_cell(9,  "FVG",   dgFvg   ? "✓" : "—", dgFvg   ? cUp : cMute)
        f_cell(10, "FIB",   dgFib == 1 ? "✓" : dgFib == 0 ? "~" : "—", dgFib == 1 ? cUp : dgFib == 0 ? cGold : cMute)
        f_cell(11, "HTF",   dgHtf   ? "✓" : "—", dgHtf   ? cUp : cMute)

    f_cellD(12, "TP",  na(objPx)   ? "—" : f_px2(objPx),   na(objPx)   ? cMute : cGold)
    f_cellD(13, "SL",  na(stopAtr) ? "—" : f_px2(stopAtr), na(stopAtr) ? cMute : cDn)
    f_cellD(14, "R:R", na(rr) ? "—" : str.tostring(rr, "#.##"), na(rr) ? cMute : rr >= 2.0 ? cUp : rr >= 1.0 ? cGold : cDn)

    f_cell(15, "STATUS", stat, vc)

    // 16 — HTF BIAS : le regime, puis les trois votes individuels, comme sur
    // la reference. dirD / dirH4 / dirH1 existent deja (moteur multi-timeframe
    // en LECTURE SEULE) : rien de nouveau n'est calcule ici.
    string aD  = dirD  == 1 ? "↑" : dirD  == -1 ? "↓" : "–"
    string aH4 = dirH4 == 1 ? "↑" : dirH4 == -1 ? "↓" : "–"
    string aH1 = dirH1 == 1 ? "↑" : dirH1 == -1 ? "↓" : "–"
    f_cell(16, "HTF BIAS", "D1 " + aD + "   H4 " + aH4 + "   H1 " + aH1, ctxCol)
