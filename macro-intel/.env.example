# ============================================================
#  Macro-Intel — Variables d'environnement
#  Copiez ce fichier en `.env` et remplissez ce que vous avez.
#  TOUT est optionnel : sans clé, le système bascule sur des
#  sources gratuites (GDELT, RSS) et des données de secours.
# ============================================================

# --- Général ---
APP_ENV=development
LOG_LEVEL=INFO
# Jeton partagé exigé sur les endpoints entrants (webhook TradingView).
# Mettez une valeur longue et aléatoire en production.
API_SHARED_SECRET=change-me-please

# --- Base de données ---
# SQLite par défaut (aucune installation). Pour la prod :
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/macro
DATABASE_URL=sqlite:///./macro_intel.db

# --- Rafraîchissement temps réel (secondes) ---
REFRESH_MARKET_SECONDS=300        # DXY, rendements, taux réels
REFRESH_NEWS_SECONDS=600          # news + géopolitique
REFRESH_CALENDAR_SECONDS=3600     # calendrier économique

# --- Données de marché (drivers de l'or) ---
# FRED = gratuit, clé sur https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- News économiques ---
# Au choix : Finnhub (gratuit) ou NewsAPI/GNews. Sinon RSS gratuit.
FINNHUB_API_KEY=
NEWSAPI_KEY=

# --- Calendrier économique ---
# Financial Modeling Prep (FMP) ou Trading Economics. Sinon fallback.
FMP_API_KEY=
TRADING_ECONOMICS_KEY=

# --- IA (classification d'impact) ---
# Sans clé -> moteur de règles interne (mots-clés + pondérations).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# --- Notifications (sorties) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
