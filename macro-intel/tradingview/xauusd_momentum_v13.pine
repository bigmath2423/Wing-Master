//@version=6
// ============================================================
// XAU/USD — MOMENTUM v13 · SALLE DE MARCHE
// ------------------------------------------------------------
// REFONTE VISUELLE UNIQUEMENT.
//
// La logique de decision est reprise LIGNE POUR LIGNE de la v11 :
// alignLong / alignShort / trigLong / trigShort / buySignal / sellSignal
// sont identiques au caractere pres. Aucun element d'affichage ajoute ici
// n'est lu par une condition d'entree, de sortie ou de taille.
//
// Ce qui change : la hierarchie de l'information.
//   PLAN 1 (fond, discret)  — liquidite, volume, zones
//   PLAN 2 (structure)      — BOS / CHoCH, OB, FVG filtres
//   PLAN 3 (decision)       — panneau compact, multi-timeframe, verdict
//
// HONNETETE DE L'AFFICHAGE. Les modules ne se valent pas, et l'interface le
// dit. Mesure sur 827 trades et 6,3 ans :
//   DECIDENT reellement : biais D1/W1, tendance H1, VWAP de session, POC.
//   NE DECIDENT RIEN    : Order Blocks, FVG, liquidite EQH/EQL, CHoCH.
//     -> effet mesure dont le SIGNE S'INVERSE entre apprentissage et
//        validation, aucun significatif. Ils sont traces parce qu'ils aident
//        a LIRE le graphique, jamais parce qu'ils valident un trade.
// Le panneau separe donc visuellement ces deux familles. Un outil
// professionnel ne presente pas comme une confluence ce qui n'en est pas une.
// ============================================================
strategy("XAU/USD Momentum v13 — BACKTEST", shorttitle="XAU v13 BT", overlay=true,
     max_labels_count=500, max_lines_count=500, max_boxes_count=500, initial_capital=10000, currency=currency.USD,
     default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0,
     calc_on_every_tick=false, process_orders_on_close=true,
     margin_long=0, margin_short=0, commission_type=strategy.commission.percent,
     commission_value=0.0, slippage=0)

// ============================================================
// PARAMETRES
// ============================================================
grpS = "① Moteur (ne pas modifier sans mesure)"
swingLen  = input.int(10,  "Longueur de detection des swings", minval=2, group=grpS, display=display.none)
atrLen    = input.int(14,  "Longueur ATR", minval=2, group=grpS, display=display.none)
htfTf     = input.timeframe("60", "Unite de temps superieure", group=grpS, display=display.none)
htfEmaLen = input.int(50,  "EMA de l'unite superieure", minval=2, group=grpS, display=display.none)
cooldown  = input.int(10,  "Barres minimum entre deux signaux", minval=0, group=grpS, display=display.none)

grpF = "② Filtres de decision (mesures)"
useStruct = input.bool(true, "Tendance de structure alignee", group=grpF, tooltip="TAUTOLOGIE avec le declencheur BOS : la tendance est mise a jour PAR le BOS, donc la condition est toujours vraie quand elle est testee. Le retirer ne change rien (615 trades et PF 1.329 avec comme sans). Ne mord qu'avec le declencheur Donchian.", display=display.none)
useHtf    = input.bool(true, "Tendance H1 alignee", group=grpF, tooltip="Effet mesure : +0.016 / +0.096.", display=display.none)
useVwap   = input.bool(true, "Bon cote du VWAP de session", group=grpF, tooltip="Effet mesure : +0.044 / +0.161.", display=display.none)
useBias   = input.bool(true, "Biais journalier + hebdomadaire aligne", group=grpF, tooltip="LE module qui porte le systeme. Esperance +0.064 -> +0.130 R, PF 1.13 -> 1.28, drawdown -28.8 -> -18.8 R.", display=display.none)
biasDLen  = input.int(20, "Biais D1 — EMA", minval=2, group=grpF, display=display.none)
biasWLen  = input.int(10, "Biais W1 — EMA", minval=2, group=grpF, display=display.none)
biasMode  = input.string("D1 EMA20 + W1 EMA10 (actuel)", "Forme du biais journalier", options=["D1 EMA20 + W1 EMA10 (actuel)", "Ruban D1 (5/20/50)"], group=grpF, tooltip="Les deux mesurent la MEME chose : correlation +0.819, recouvrement 86.6 %, ecart d'esperance +0.003 R (p = 0.96). Le ruban le dit en une condition au lieu de deux et laisse passer 38 % de trades en plus. Pas confronte a 2020-2022.", display=display.none)
ribF      = input.int(5,  "Ruban D1 — rapide", minval=2, group=grpF, display=display.none)
ribM      = input.int(20, "Ruban D1 — moyenne", minval=3, group=grpF, display=display.none)
ribS      = input.int(50, "Ruban D1 — lente", minval=5, group=grpF, display=display.none)
useImb    = input.bool(false,"Accepter aussi le displacement seul", group=grpF, tooltip="MESURE : degrade le systeme. PF 1.13 -> 1.08 et stabilite 4/4 -> 2/4. Laisse desactive.", display=display.none)
trigMode  = input.string("BOS (actuel)", "Declencheur", options=["BOS (actuel)", "Cassure Donchian"], group=grpF, tooltip="Les deux mesurent le meme evenement : ecart d'esperance +0.011 R, p = 0.89. Le Donchian l'exprime en une ligne au lieu d'une machine a etats.", display=display.none)
donLen    = input.int(48, "Donchian — nombre de bougies", minval=12, maxval=200, group=grpF, display=display.none)
vUsePoc   = input.bool(true, "Exiger d'etre du bon cote du POC", group=grpF, tooltip="Seul concept de liquidite qui ameliore le systeme. Gain surtout sur le drawdown : -18.8 -> -16.0 R.", display=display.none)

grpMTF = "③ Multi-timeframe (LECTURE SEULE)"
mtfShow = input.bool(true, "Panneau multi-timeframe", group=grpMTF, tooltip="Les unites inferieures (M15, M5) ne creent AUCUN biais et ne declenchent aucun signal. Mesure : le M5 a ete rejete quatre fois par quatre methodes independantes. Elles servent uniquement a savoir si le contexte est aligne au moment ou tu executes.", display=display.none)
mtfEmaF = input.int(50,  "EMA rapide", minval=5, group=grpMTF, display=display.none)
mtfEmaS = input.int(200, "EMA lente", minval=20, group=grpMTF, display=display.none)
mtfStrLen = input.int(20, "Structure — fenetre du milieu de canal", minval=5, group=grpMTF, display=display.none)

grpV = "④ Volume et zones"
vShow    = input.bool(true, "POC et Value Area de la veille", group=grpV, display=display.none)
vBins    = input.int(50, "Finesse du profil", minval=10, maxval=100, group=grpV, display=display.none)
vVaPct   = input.float(70, "Value Area (% du volume)", minval=50, maxval=95, step=5, group=grpV, display=display.none)

grpZ = "⑤ Zones SMC (LECTURE — ne filtrent rien)"
obShow    = input.bool(true, "Order Block — derniere impulsion", group=grpZ, tooltip="AFFICHAGE SEUL. Effet mesure : -0.188 en apprentissage, +0.378 en validation — le signe s'inverse, aucun des deux n'est significatif.\n\nUN SEUL Order Block par cote : celui de la DERNIERE impulsion institutionnelle valide. Il doit remplir trois conditions cumulatives — un deplacement d'au moins obDispAtr derriere lui, une cassure de structure effectivement provoquee, et une zone jamais traversee en cloture. Les MECHES sont incluses : le vrai bord de la zone est l'extreme atteint, pas la limite du corps.", display=display.none)
obHistMax = input.int(12, "Order Blocks valides conserves par cote", minval=0, maxval=40, group=grpZ, tooltip="Un OB supplante par un nouveau CHoCH n'est pas invalide pour autant : il reste affiche tant que le prix ne l'a pas casse. Ce plafond borne l'historique. A 0, seul l'OB du dernier CHoCH est affiche. AFFICHAGE SEUL : le moteur de zones ne lit que l'OB actif.", display=display.none)
bkMax     = input.int(3, "Breaker Blocks conserves par cote", minval=0, maxval=10, group=grpZ, tooltip="Un Order Block casse par une cloture confirmee ne disparait pas : il devient un Breaker Block dans le sens INVERSE, memes bornes et meme bougie d'origine. Ce plafond borne l'historique conserve. A 0, les breakers ne sont pas affiches.", display=display.none)
bkConfBars = input.int(20, "Breaker — fenetre de confirmation (bougies)", minval=1, maxval=200, group=grpZ, tooltip="D2. Une zone cassee attend une cassure de structure DANS LE SENS de la cassure pendant ce nombre de bougies. Sans confirmation, elle expire au lieu de devenir un Breaker : mieux vaut aucun Breaker qu'un Breaker invente. AFFICHAGE SEUL.", display=display.none)
obDispAtr = input.float(1.2, "OB — deplacement minimum (x ATR)", minval=0.3, step=0.1, group=grpZ, display=display.none)
obContinuation = input.bool(true, "OB de continuation (BOS sans CHoCH)", group=grpZ, tooltip="Un CHoCH est un BOS qui inverse la tendance. Tant que la creation d'OB etait conditionnee au seul CHoCH, TOUS les Order Blocks laisses par les impulsions de continuation restaient invisibles -- c'est le gros des OB en tendance etablie. Cet interrupteur ouvre la seconde voie. Meme recherche de bougie source, meme seuil de deplacement, meme cycle de vie. ATTENTION : obBT est lu par le moteur de zones, donc le nombre de ZONES peut changer. Le backtest, lui, ne peut pas bouger : obBT n'apparait dans aucune condition d'entree, de sizing ou de stop.", display=display.none)
obNoiseAtr = input.float(0.15, "OB — corps minimum de la bougie source (x ATR)", minval=0.0, maxval=1.0, step=0.05, group=grpZ, tooltip="Le parcours s'arretait sur la PREMIERE bougie opposee quelle que soit sa taille : une micro-bougie de bruit a l'interieur de l'impulsion devenait l'Order Block, et la vraie bougie source, plus profonde, n'etait jamais examinee. Une bougie opposee n'arrete desormais le parcours que si son corps atteint ce seuil. A 0, l'ancien comportement revient exactement.", display=display.none)
fvgShow   = input.bool(true, "Fair Value Gaps significatifs", group=grpZ, tooltip="AFFICHAGE SEUL. Effet mesure : +0.134 puis -0.028, signe instable. Seuls les FVG avec un vrai deplacement derriere sont traces.", display=display.none)
fvgMinAtr = input.float(0.35, "FVG — taille minimum (x ATR)", minval=0.05, step=0.05, group=grpZ, display=display.none)
fvgDispAtr= input.float(1.0, "FVG — deplacement minimum (x ATR)", minval=0.3, step=0.1, group=grpZ, display=display.none)
fvgMax    = input.int(4, "FVG — nombre garde par cote", minval=1, maxval=8, group=grpZ, tooltip="MESURE DU 10 AOUT : plus de 800 FVG crees sur l'historique charge, et seulement DEUX vivants a l'instant T sur les quatre unites. Le moteur de zones doit apparier l'Order Block actif avec un FVG a moins de wzPairGapAtr : avec deux survivants la conjonction est quasi impossible, et le compteur ZONES affichait 0 sur M15/M5/M3 et 1 sur M1. Porte de 2 a 4, plafond releve a 8 pour laisser de la marge de test. AFFECTE LA CREATION DE ZONES.", display=display.none)
fvgMaxAge = input.int(200, "FVG — duree de vie (bougies)", minval=20, maxval=1000, group=grpZ, tooltip="Un ecart non comble depuis 200 bougies n'est plus un desequilibre, c'est un vestige. Il est retire meme s'il n'a jamais ete traverse.", display=display.none)
brkShow   = input.bool(true, "BOS / CHoCH", group=grpZ, display=display.none)
brkLabels = input.int(2, "Etiquettes sur les N dernieres cassures", minval=0, maxval=6, group=grpZ, display=display.none)

grpL = "⑥ Liquidite (LECTURE — ne filtre rien)"
liqShow   = input.bool(true, "Buy Side / Sell Side, EQH / EQL", group=grpL, tooltip="AFFICHAGE SEUL. Mesure du sweep comme filtre : -0.087 en apprentissage, -0.178 en validation. Il SELECTIONNE les mauvais trades. Trace pour lire ou sont les stops, jamais pour valider une entree.", display=display.none)
liqTolAtr = input.float(0.15, "Tolerance d'egalite (x ATR)", minval=0.02, step=0.05, group=grpL, display=display.none)
liqMax    = input.int(4, "Poches SUIVIES par cote (logique)", minval=1, maxval=8, group=grpL, tooltip="Nombre de poches que le moteur SUIT. Influence la detection des sweeps et les points de liquidite du score : ce n'est PAS un reglage d'affichage. Il avait ete baisse a 2 pour desencombrer le graphique, ce qui reduisait au passage le nombre de sweeps detectables -- un reglage visuel modifiait donc une decision. Remis a 4 ; la lisibilite est desormais geree par le reglage separe ci-dessous.", display=display.none)
liqShowMax = input.int(2, "Poches AFFICHEES par cote (visuel)", minval=1, maxval=8, group=grpL, tooltip="Nombre de poches tracees a l'ecran, les plus recentes. Purement visuel : le moteur continue d'en suivre liqMax. Changer ce reglage ne peut pas modifier un signal.", display=display.none)
sweepShow = input.bool(true, "Marquer les sweeps", group=grpL, display=display.none)
// D4 -- SEUILS DU SWEEP. Le test etait `high > niveau` : UN TICK au-dessus
// suffisait, d'ou les sweeps declenches par de simples meches de bruit. Ces
// deux seuils s'appliquent a la DETECTION, pas seulement a l'etiquette : ils
// reduisent donc volontairement le nombre de zones institutionnelles, le gate
// de creation commencant par `cSweep`. C'est le choix assume de moins de
// setups mais des sweeps reellement exploitables.
sweepMinPen = input.float(0.05, "Sweep — penetration minimum du niveau (x ATR)", minval=0.0, maxval=1.0, step=0.01, group=grpL, tooltip="La meche doit depasser le niveau de liquidite d'au moins cette distance. A 0, le comportement d'origine revient : un tick suffit. AFFECTE LA DETECTION, donc le nombre de zones.", display=display.none)
sweepReject = input.float(0.10, "Sweep — rejet minimum en cloture (x ATR)", minval=0.0, maxval=1.0, step=0.01, group=grpL, tooltip="Apres avoir pris la liquidite, la cloture doit revenir de l'autre cote du niveau d'au moins cette distance. Une cloture a un tick du niveau n'est pas un rejet. AFFECTE LA DETECTION.", display=display.none)
// FRAICHEUR DU SWEEP, decouplee de l'age d'ancre des zones.
// Cette valeur etait reprise de wzMaxAnchorAgeH, un reglage du groupe des
// zones hebdomadaires qui mesure tout autre chose : depuis quand l'OB ou le
// FVG qui porte une zone a ete cree. Deux concepts sans rapport partageaient
// donc un seul curseur, et regler l'un deplacait silencieusement l'autre.
// La valeur par defaut reste 72 h : le comportement est IDENTIQUE au premier
// chargement. Ce correctif separe deux reglages, il n'en change aucun -- il
// n'y a a ce jour aucune mesure qui justifierait une autre valeur, et en
// choisir une au jugé serait exactement le seuil arbitraire a eviter.
// Cette fenetre n'est plus le seul garde-fou depuis la regle de cycle
// (chochUpFresh) : elle ne sert que de plafond de dernier recours contre un
// sweep arbitrairement ancien qu'aucune cassure de structure n'aurait encore
// perime.
sweepMaxAgeH = input.int(72, "Sweep — fraicheur maximum (heures)", minval=1, maxval=720, group=grpL, tooltip="Au-dela de cette anciennete un sweep ne valide plus aucune chaine, et le panneau affiche SWEEP PERIME. Exprime en HEURES, donc coherent d'une unite de temps a l'autre : 72 h font 4320 bougies en M1 et 288 en M15. Etait auparavant repris de l'Age maximum de l'ancre OB/FVG du groupe 7, qui mesure une tout autre chose.", display=display.none)

grpW = "⑦ Weekly Institutional Zones (PLANIFICATION — ne declenche aucun trade)"
wzShow      = input.bool(true, "Zones institutionnelles hebdomadaires", group=grpW, tooltip="OUTIL DE PLANIFICATION. Chaque debut de semaine, le module publie le profil de volume de la semaine ECOULEE et en deduit au plus deux zones d'achat et deux zones de vente. Il n'entre dans AUCUNE condition d'entree : buySignal et sellSignal sont inchanges.\n\nCe que le module apporte : decider a l'avance ou tu regardes, ce qui est une discipline reelle. Ce qu'il n'apporte pas : une estimation de probabilite. Sur les 100 points de Confluence, 25 seulement (la structure) reposent sur un module dont l'avantage est mesure — le detail est dans le tableau.", display=display.none)
wzBins      = input.int(50, "Profil hebdomadaire — finesse", minval=20, maxval=100, group=grpW, display=display.none)
wzVaPct     = input.float(70, "Value Area hebdomadaire (%)", minval=50, maxval=95, step=5, group=grpW, display=display.none)
wzWidthAtr  = input.float(0.8, "Epaisseur des zones (x ATR)", minval=0.4, step=0.2, group=grpW, tooltip="Reduit de 1.6 a 0.8 : une zone de 1.6 ATR de haut n'est plus un niveau d'execution, c'est une region. AFFICHAGE SEUL -- les zones ne declenchent aucun trade, donc ce reglage ne change ni les signaux ni le backtest.", display=display.none)
wzMax       = input.int(1, "Zones maximum par cote", minval=1, maxval=3, group=grpW, tooltip="Reduit de 2 a 1 : une seule zone principale par cote. AFFICHAGE SEUL.", display=display.none)
wzMinScore  = input.int(70, "Confluence minimum pour AFFICHER", minval=50, maxval=95, group=grpW, tooltip="En dessous de ce seuil la zone n'est pas dessinee. 80-90 = premium, 70-80 = interessante. Ce chiffre COMPTE des elements presents ; ce n'est ni une qualite ni une probabilite.", display=display.none)
wzPairGapAtr = input.float(0.5, "Ecart maximum Order Block <-> FVG (x ATR)", minval=0.0, maxval=3.0, step=0.1, group=grpW, tooltip="L'Order Block et le FVG n'ont plus besoin de se chevaucher : il suffit qu'ils soient PROCHES. Dans une impulsion, l'OB precede le mouvement et le FVG est cree par le mouvement -- ils sont donc empiles, pas superposes. A 0, on revient a l'ancien comportement (chevauchement obligatoire).", display=display.none)
wzMaxHeightAtr = input.float(1.5, "Hauteur maximum d'une zone (x ATR)", minval=0.3, maxval=5.0, step=0.1, group=grpW, tooltip="Garde-fou contre les zones enormes. La zone etant l'UNION de l'OB et du FVG, une paire trop ecartee produirait un grand rectangle : au-dela de cette hauteur la paire est REJETEE plutot que dessinee. Mieux vaut aucune zone qu'une zone imprecise.", display=display.none)
wzMaxAnchorAgeH = input.int(72, "Age maximum de l'ancre OB/FVG (heures)", minval=4, maxval=720, group=grpW, tooltip="NON MESURE, valeur de depart raisonnable. Si l'OB ou le FVG qui a donne les 15 points de confluence SMC date de plus de N bougies par rapport a la bougie courante, la zone est retiree meme si techniquement encore intacte -- reponse au cas ou le setup arrive trop tard apres l'impulsion qui l'a cree.", display=display.none)
wzFarAtr    = input.float(3.0, "Distance avant mise en sourdine (x ATR)", minval=1.0, step=0.5, group=grpW, tooltip="NON MESURE, valeur de depart raisonnable. Au-dela de cette distance au prix, la zone reste affichee mais tres transparente -- elle n'est pas supprimee, juste dé-priorisee visuellement.", display=display.none)
wzPlan      = input.bool(true, "Tableau de planification", group=grpW, display=display.none)

grpX = "③ Sortie (la partie qui compte le plus)"
slAtr       = input.float(2.5, "Stop-loss (x ATR)", minval=0.5, step=0.1, group=grpX, tooltip="2.5 ATR mesure. Un stop plus serre (1.5 ATR) rendait le systeme negatif sur 2 sous-periodes sur 4.", display=display.none)
// NON MESURE comme alternative complete -- seule la comparaison ATR vs
// 1.5xATR existe (voir tooltip ci-dessus). "Structurel" utilise le dernier
// swing low/high confirme (deja calcule pour l'affichage, jamais utilise
// comme stop reel jusqu'ici) au lieu d'un multiple fixe d'ATR. Desactive par
// defaut : la reference du systeme (PF 1.212, 19 ans) reste calculee avec
// le stop ATR seul tant que ce mode n'a pas ete compare en Strategy Tester.
slMode = input.string("ATR (actuel)", "Mode de calcul du SL", options=["ATR (actuel)", "Structurel (dernier swing)"], group=grpX, tooltip="A COMPARER TOI-MEME : bascule ce reglage et regarde le Strategy Tester avant/apres. 'Structurel' place le stop juste sous/sur le dernier swing low/high confirme plutot qu'a un multiple fixe d'ATR -- distance variable au lieu de constante, jamais mesure sur ce systeme.", display=display.none)
trailStartR = input.float(1.5, "Trailing : activation (x R)", minval=0.1, step=0.1, group=grpX, tooltip="MESURE (audit des sorties). Armer a 1.0 R avec un suivi de 1.0 R plaçait le stop exactement au point mort : un trade touchant +1 R ne rapportait rien. Armer plus tard et suivre plus serre corrige ce defaut structurel. 1.5 / 0.3 : PF 1.30 -> 1.41, esperance +0.140 -> +0.221 R, drawdown -15.0 -> -13.6 %, pour 2 % de trades en moins. Ancienne valeur : 1.0.", display=display.none)
trailDistR  = input.float(0.3, "Trailing : distance suivie (x R)", minval=0.1, step=0.1, group=grpX, tooltip="Voir le tooltip de l'activation. Le gradient mesure est LISSE et MONOTONE sur les quatre sous-periodes (plus l'armement est tardif, plus le PF monte, quelle que soit la distance) : c'est la signature d'un effet reel, pas d'un pic d'optimisation. Ancienne valeur : 1.0.", display=display.none)
riskPct     = input.float(1.0, "Risque par trade (% du capital)", minval=0.01, step=0.1, group=grpX, display=display.none)

// --- Mode de sortie. Le trailing est le mode VALIDE ; le TP fixe existe parce
// que la mesure a montre qu'il achete un win rate eleve, et qu'il faut pouvoir
// le constater soi-meme plutot que de le croire sur parole.
exitMode = input.string("Trailing (valide)", "Mode de sortie", options=["Trailing (valide)", "TP fixe"], group=grpX, tooltip="MESURE EXACTE sur 783 trades, 2020-2026, dont 200 trades hors echantillon (2020-2022).\n\nTrailing : WR 42.9 %, PF 1.231, esperance +0.144 R, drawdown -26.7 R, jusqu'a 11 pertes d'affilee.\nTP fixe a 0.50 R : WR 66.9 %, PF 1.190, esperance +0.053 R, drawdown -12.3 R, 4 pertes d'affilee au maximum.\n\nLe win rate monte de 24 points et tient hors echantillon (70.0 % sur 2020-2022). Le drawdown est divise par deux et la pire serie de pertes passe de 11 a 4. Le PRIX est l'esperance : -0.091 R par trade, soit environ -11 % de capital par an a 1 % de risque.\n\nAucun reglage ne donne un PF de 2 : sur 56 combinaisons stop x TP balayees, le maximum atteint est 1.545.", display=display.none)
tpFixedR    = input.float(0.5, "TP fixe (x R)", minval=0.1, maxval=3.0, step=0.05, group=grpX, tooltip="N'agit que si le mode de sortie est 'TP fixe'. A 0.50 R la simulation est EXACTE (aucune hypothese) : toute sortie en trailing du systeme actuel a depasse 0.65 R, et l'excursion favorable enregistree tranche pour les trades stoppes. Au-dela de 0.65 R le chiffrage devient une approximation optimiste.", display=display.none)
maxLev      = input.float(5.0, "Levier maximum (notionnel / capital)", minval=0.5, step=0.5, group=grpX, tooltip="SECURITE. Plafonne la taille de position pour que le notionnel ne depasse jamais ce multiple du capital. Sans ce plafond, un symbole dont la volatilite affichee est anormalement faible produit des tailles enormes : sur TVC:GOLD le levier atteignait 20x (128x au pire) et une perte coutait 2.72 % du capital au lieu de 1 %. Si le compteur de levier du panneau reste colle a cette valeur, c'est que le symbole fausse le calcul : change de symbole plutot que d'augmenter le plafond.", display=display.none)

grpU = "⑨ Interface"
panShow  = input.bool(true, "Panneau de decision", group=grpU, display=display.none)
panPos   = input.string("top_right", "Position", options=["top_left","top_right","bottom_left","bottom_right"], group=grpU, display=display.none)
uiTint   = input.bool(true, "Teinte de fond selon le biais", group=grpU, tooltip="Le seul dispositif qui donne le biais sans aucun deplacement du regard. Volontairement a la limite du perceptible.", display=display.none)
showLvls = input.bool(true, "Entree / Stop / Objectifs du setup en cours", group=grpU, display=display.none)
fibShow = input.bool(true, "Niveaux Fibonacci de la zone active", group=grpU, tooltip="Trace 50 / 61.8 / 70.5 / 78.6 sur le swing d'impulsion FIGE dans la zone -- celui que le moteur a reellement utilise pour la juger, pas un swing recalcule a l'affichage. Le niveau 50 % marque la separation premium / discount.", display=display.none)
diagShow = input.bool(true, "Diagnostic du setup (conditions + raison du refus)", group=grpU, tooltip="Affiche l'etat de chaque condition de creation de zone et, quand aucune zone n'existe, la raison exacte du refus. Sert a comprendre un graphique vide sans relire le code.", display=display.none)
zoneMaxBars = input.int(15, "Projection des zones vers la droite (bougies)", minval=0, maxval=100, group=grpU, tooltip="CORRECTIF VISUEL. Une boite etait dessinee depuis sa bougie d'origine jusqu'a maintenant : un FVG vieux de 200 bougies faisait 200 bougies de large, une zone hebdomadaire creee lundi en faisait ~480 le vendredi en M15. Les BORNES DE PRIX etaient deja exactes (le FVG va bien de high[2] a low, l'OB est le high/low d'une seule bougie) -- seule la largeur etait absurde. CORRECTIF DU CORRECTIF : le bord GAUCHE n'est plus tronque du tout, c'etait lui qui detachait les rectangles de leur bougie d'origine. Ce reglage ne commande QUE la projection AU-DELA de la bougie courante : une zone active va deja de sa bougie source jusqu'a maintenant, ce nombre s'y ajoute. Il ne commande donc pas la largeur des zones -- celle-ci est l'AGE de la zone, gouverne par obHistMax pour les OB et par fvgMax / fvgMaxAge pour les FVG. AFFICHAGE SEUL.", display=display.none)

// ============================================================
// ⑨ MODE DEBUG — OBSERVATION PURE
// Cet interrupteur ne commande que l'AFFICHAGE du tableau. Les compteurs
// tournent en permanence : brancher le comptage sur un reglage visuel ferait
// dependre une mesure d'un reglage d'affichage, exactement l'erreur deja
// corrigee sur sweepShow. Aucun compteur n'est lu par une condition.
// ============================================================
dbgOn = input.bool(false, "DEBUG MODE — tableau de mesure", group="⑨ Debug (observation seule)", tooltip="Compte les evenements REELLEMENT rencontres sur l'historique charge : Order Blocks, FVG, poches de liquidite, sweeps, chaine Sweep -> CHoCH -> BOS. Aucune estimation, aucune regle modifiee. Le tableau s'affiche en bas a gauche.", display=display.none)
dbgPage = input.string("① MOTEUR", "PAGE affichee", options=["① MOTEUR", "② ZONES", "③ CYCLE", "④ SWEEP", "⑤ SIMPLE", "⑥ OB"], group="⑨ Debug (observation seule)", tooltip="Le tableau complet fait plus de cinquante lignes : il deborde de l'ecran en haut comme en bas et les dernieres sections deviennent invisibles. Il est donc decoupe en six pages de vingt lignes au maximum. Choix d'affichage uniquement : les compteurs tournent tous en permanence, quelle que soit la page selectionnee.", display=display.none)

// --- palette : sombre, deux accents, le reste en gris ---
// Les 8 constantes pilotent TOUT l'habillage (panneau, zones, lignes,
// labels) -- changer ces huit valeurs suffit, aucun autre endroit du fichier
// n'a besoin d'y toucher.
// A ASSOCIER au fond de graphique SOMBRE de TradingView (le theme par
// defaut). Variante creme, si besoin de repasser en clair :
//   cUp=rgb(21,128,61) cDn=rgb(191,54,48) cGold=rgb(163,118,22)
//   cBlue=rgb(43,98,165) cPurp=rgb(120,74,156) cMute=rgb(133,124,110)
//   cBg=rgb(250,246,237) cTxt=rgb(42,38,32)
cUp   = color.rgb(38, 166, 109)
cDn   = color.rgb(214, 69, 69)
cGold = color.rgb(212, 175, 55)
cBlue = color.rgb(58, 122, 196)
cPurp = color.rgb(142, 92, 189)
cMute = color.rgb(128, 134, 145)
cBg   = color.rgb(16, 19, 26)
cTxt  = color.rgb(228, 231, 237)

// ============================================================
// MODULES — calcul identique a la v11
// ============================================================
atrV = ta.atr(atrLen)

// --- Structure : swings confirmes puis cassure sur niveau STABLE ---
float ph = ta.pivothigh(high, swingLen, swingLen)
float pl = ta.pivotlow(low, swingLen, swingLen)

// ---- BOUGIE DE CONFIRMATION DU DERNIER PIVOT ----------------------------
// Sert uniquement de marqueur de CYCLE STRUCTUREL au module Order Block (voir
// la porte de cycle plus bas). Deux variables independantes du module de
// liquidite, qui memorise deja des pivots pour un usage different : les
// melanger creerait un couplage entre deux modules qui n'ont rien a partager.
// Non repeint : ta.pivothigh/pivotlow ne renvoient une valeur qu'a la bougie
// de confirmation, swingLen bougies APRES l'extreme reel.
var int lastPhIdx = na
var int lastPlIdx = na
if not na(ph)
    lastPhIdx := bar_index
if not na(pl)
    lastPlIdx := bar_index

// ---- COMPTEURS DEBUG ----------------------------------------------------
// Tous incrementes sous barstate.isconfirmed : un evenement = une bougie
// close, jamais un tick intermediaire. Aucun n'ecrit dans un tableau du
// moteur ni ne participe a une condition.
var int dbgBars     = 0
var int dbgChoch    = 0
var int dbgBos      = 0
var int dbgObCand   = 0
var int dbgObMade   = 0
var int dbgObNoDsp  = 0
var int dbgObNoCnd  = 0
var int dbgObMadeC  = 0
var int dbgObMadeB  = 0
var int dbgObDup    = 0
var int dbgObCycle  = 0
var int dbgObStruct = 0

// ---- POURQUOI AUCUNE ZONE : UN COMPTEUR PAR MOTIF DE REFUS --------------
// dgRej porte deja, a chaque bougie, la PREMIERE condition bloquante selon la
// hierarchie de diagnostic. Mais l'information etait perdue des la bougie
// suivante : le panneau montrait l'INSTANT, jamais la DISTRIBUTION. On ne
// pouvait donc pas savoir lequel des motifs tue les zones -- il fallait le
// deduire, et c'est exactement ce raisonnement indirect qui a produit un
// diagnostic faux sur fvgMax.
// Purement observationnel : aucun de ces compteurs n'est lu par une condition.
var int dgcSwMiss  = 0
var int dgcSwOld   = 0
var int dgcSwCyc   = 0
var int dgcChMiss  = 0
var int dgcChSeq   = 0
var int dgcBoMiss  = 0
var int dgcBoSeq   = 0
var int dgcObMiss  = 0
var int dgcFvMiss  = 0
var int dgcObCyc   = 0
var int dgcFvCyc   = 0
var int dgcFar     = 0
var int dgcFib     = 0
var int dgcPd      = 0
var int dgcHtf     = 0
var int dgcScore   = 0
var int dgcBetter  = 0
var int dgcSame    = 0
var int dgcOk      = 0

// ---- SWEEPS PAR DIRECTION ------------------------------------------------
// CONVENTION, jamais melangee : la liquidite SELL-SIDE (sous les EQL) est
// prise puis rejetee -> retournement HAUSSIER -> elle alimente les setups BUY
// via swpDnIdx. La liquidite BUY-SIDE (au-dessus des EQH) alimente les setups
// SELL via swpUpIdx. Les compteurs Ss* portent donc sur le cote SELL-SIDE et
// servent la chaine BUY ; les Bs* sur le cote BUY-SIDE et servent SELL.
var int dbgSsCand  = 0
var int dbgSsOk    = 0
var int dbgSsNoPen = 0
var int dbgSsNoRej = 0
var int dbgBsCand  = 0
var int dbgBsOk    = 0
var int dbgBsNoPen = 0
var int dbgBsNoRej = 0

// ---- CHAINE PAR DIRECTION ------------------------------------------------
// Comptes par BOUGIE CONFIRMEE, exclusifs entre eux pour les trois premiers :
// chaque bougie tombe dans exactement un de SwNone / SwOld / SwOk.
var int dbgBuySwNone  = 0
var int dbgBuySwOld   = 0
var int dbgBuySwOk    = 0
var int dbgBuyFreshOk = 0
var int dbgBuyFreshKo = 0
var int dbgBuyBosOk   = 0
var int dbgSellSwNone  = 0
var int dbgSellSwOld   = 0
var int dbgSellSwOk    = 0
var int dbgSellFreshOk = 0
var int dbgSellFreshKo = 0
var int dbgSellBosOk   = 0

// ---- CHOCH / CYCLE : COMPTES PAR EVENEMENT, PAS PAR BOUGIE ---------------
// Les compteurs ci-dessus comptent des BOUGIES. Un chochUpFresh faux le reste
// pendant des centaines de bougies : "87 % des bougies" ne dit donc rien du
// taux d'echec REEL des CHoCH. Ceux-ci ne sont incrementes que sur la bougie
// meme d'un bullChoch / bearChoch confirme -- un evenement, un increment.
// CONSERVATION : Ko = KoN + KoB exactement, et freshOK = Tot - Ko.
// KoO (sweep perime) est une DIMENSION SUPPLEMENTAIRE, pas une categorie
// exclusive : la peremption n'entre pas dans le calcul de chochUpFresh, elle
// est testee a part par f_seqSweep. KoO recoupe donc KoB, il ne s'y ajoute pas.
var int dbgEvBTot  = 0   // A : bullChoch confirmes
var int dbgEvBKo   = 0   // B : parmi A, chochUpFresh FAUX
var int dbgEvBKoB  = 0   // C : parmi B, bosUpIdx >= swpDnIdx  (le proxy accuse)
var int dbgEvBKoO  = 0   // D : parmi B, sweep perime (non exclusif de C)
var int dbgEvBKoN  = 0   // E : parmi B, sweep absent
var int dbgEvBOkO  = 0   // parmi A-B (fresh OK), sweep deja perime
var int dbgEvBDone = 0   // parmi A, chaine deja complete pour ce sweep
var int dbgEvSTot  = 0
var int dbgEvSKo   = 0
var int dbgEvSKoB  = 0
var int dbgEvSKoO  = 0
var int dbgEvSKoN  = 0
var int dbgEvSOkO  = 0
var int dbgEvSDone = 0

// ---- SUIVI DU CYCLE PAR SWEEP -------------------------------------------
// Compter "combien de sweeps atteignent le BOS" exige de se souvenir, POUR LE
// SWEEP COURANT, jusqu'ou il est alle. Les six registres du moteur ne le
// disent pas : ils ne gardent que la derniere occurrence de chaque evenement.
// Les trois variables dbgCur* ci-dessous portent cet etat.
// CE NE SONT PAS swpDnUsed / swpUpUsed : AUCUNE condition du moteur ne les
// lit. Elles n'apparaissent que dans des increments dbg* et dans le tableau
// debug. Retirer le bloc debug les rendrait orphelines sans changer un signal.
var bool dbgCurBCh  = false   // le sweep sell-side courant a produit un CHoCH
var bool dbgCurBBos = false   // ... puis un BOS posterieur -> chaine complete
var int  dbgCurBChI = na      // bougie du PREMIER CHoCH post-sweep
var bool dbgCurSCh  = false
var bool dbgCurSBos = false
var int  dbgCurSChI = na
var int dbgSwBTot  = 0   // sweeps sell-side enregistres
var int dbgSwBCh   = 0   // ... ayant produit au moins un CHoCH haussier
var int dbgSwBBos  = 0   // ... ayant atteint sweep -> CHoCH -> BOS
var int dbgSwBRepl = 0   // ... remplaces par un nouveau sweep avant la chaine
var int dbgEvBKoT  = 0   // refus proxy AVEC chaine reellement complete (juste)
var int dbgEvBKoF  = 0   // refus proxy SANS chaine complete (refus abusif)
var int dbgSwSTot  = 0
var int dbgSwSCh   = 0
var int dbgSwSBos  = 0
var int dbgSwSRepl = 0

// ---- ENTONNOIR DU SWEEP : PAR EVENEMENT ET PAR COTE ---------------------
// L'unite d'evenement retenue ici est LA POCHE, pas la bougie. Une poche est
// creee une fois et meurt une fois : c'est le seul compteur qui se conserve.
// dbgSsCand / dbgBsCand, eux, comptent des BOUGIES -- une bougie qui traverse
// deux poches ne compte qu'une fois. Les deux mesures repondent a des
// questions differentes et ne doivent pas etre additionnees.
// CONSERVATION : poches creees = evincees + mortes en sweep + tuees sans
//                rejet + encore vivantes.
var int dbgPrH   = 0   // paires de pivots HAUTS reellement comparees
var int dbgPrL   = 0   // paires de pivots BAS
var int dbgPkEvH = 0   // poche EQH evincee par liqMax, sans jamais servir
var int dbgPkEvL = 0
var int dbgPkSwH = 0   // poche EQH morte EN PRODUISANT un sweep
var int dbgPkSwL = 0
var int dbgPkKiH = 0   // poche EQH penetree mais NON rejetee : detruite quand
var int dbgPkKiL = 0   // meme, sans sweep. array.remove est hors du test de
                       // rejet dans la boucle reelle -- c'est une fuite que
                       // rien ne mesurait jusqu'ici.
// Cote du biais A L'INSTANT du sweep, lu avec f_ctxAllow, la fonction meme du
// gate de creation de zone. Un sweep sell-side sert un setup BUY.
var int dbgSwBSideOk = 0
var int dbgSwBSideKo = 0
var int dbgSwSSideOk = 0
var int dbgSwSSideKo = 0
// Sort des sweeps acceptes qui n'aboutissent pas.
var int dbgSwBNoCh  = 0   // mort remplace sans avoir jamais produit de CHoCH
var int dbgSwBChOld = 0   // 1er CHoCH arrive AU-DELA de seqMaxBars
var int dbgSwSNoCh  = 0
var int dbgSwSChOld = 0

// ---- SENSIBILITE DE liqTolAtr : LES CINQ SEUILS EN UN SEUL PASSAGE ------
// Balayer 0.10 / 0.15 / 0.20 / 0.25 / 0.30 en rechargeant l'indicateur cinq
// fois par timeframe demande vingt captures. Le meme ecart de pivots peut
// etre teste contre les cinq seuils sur la MEME bougie : un seul passage
// suffit pour obtenir la courbe complete du nombre de poches.
// Comptes CUMULES : chaque compteur retient les paires dont l'ecart est
// INFERIEUR OU EGAL a son seuil, donc la suite est croissante par
// construction. AUTO-CONTROLE : la colonne 0.15 doit egaler exactement
// dbgPockL / dbgPockH tant que liqTolAtr vaut 0.15. Si les deux different,
// l'instrumentation est fausse et rien ne doit en etre conclu.
// AUCUNE poche n'est creee ici, aucun tableau du moteur n'est lu ni ecrit :
// ces compteurs ne disent que ce que le moteur AURAIT apparie. Ils ne
// disent rien des sweeps, qui demandent, eux, un vrai passage du moteur.
var int dbgTL10 = 0
var int dbgTL15 = 0
var int dbgTL20 = 0
var int dbgTL25 = 0
var int dbgTL30 = 0
var int dbgTH10 = 0
var int dbgTH15 = 0
var int dbgTH20 = 0
var int dbgTH25 = 0
var int dbgTH30 = 0

// ---- SWING SIMPLE BRANCHE AU MOTEUR : COMPTEURS D'OBSERVATION ----------
// Unite : LE NIVEAU. Un niveau entre une fois et sort une fois.
// CONSERVATION : ajoutes = sweep + penetres sans rejet + evinces + purges
//                          + vivants.
// "rejete par penetration" n'est pas un sort de niveau : une bougie qui
// touche sans penetrer assez laisse le niveau intact. dbgPvNoPen compte donc
// des BOUGIES, pas des niveaux, et n'entre pas dans la conservation.
var int dbgPvAddH = 0   // pivots hauts entres dans la liste moteur
var int dbgPvAddL = 0
var int dbgPvDupH = 0   // ecartes a l'entree : deja couverts par une poche
var int dbgPvDupL = 0
var int dbgPvPurH = 0   // purges apres coup : une poche est venue les couvrir
var int dbgPvPurL = 0
var int dbgPvSwH  = 0   // ont produit un sweep
var int dbgPvSwL  = 0
var int dbgPvKiH  = 0   // penetres sans rejet suffisant -> detruits sans sweep
var int dbgPvKiL  = 0
var int dbgPvEvH  = 0   // evinces par liqMax sans avoir servi
var int dbgPvEvL  = 0
var int dbgPvNoPenH = 0 // BOUGIES touchant un niveau sans penetration suffisante
var int dbgPvNoPenL = 0

// ---- POURQUOI UN OB EXISTANT EST DIT HORS CYCLE -------------------------
// obSameCycle = not na(obCr) and not na(chIdx) and obCr >= chIdx
//                                            and (na(pvIdx) or pvIdx <= obCr)
// Trois facons d'echouer, et une seule combinaison possible d'echec :
//   obCr < chIdx  -- l'OB est ne AVANT le dernier CHoCH du sens ;
//   pvIdx > obCr  -- un pivot OPPOSE s'est confirme depuis sa creation ;
//   une des deux ancres est na.
// Il n'existe PAS de quatrieme cas : si les deux inegalites sont satisfaites
// et qu'aucune ancre n'est na, obSameCycle est vrai par construction. Le
// "satisfont les deux mais echouent autrement" demande est donc vide, ce
// n'est pas une limite de mesure mais une propriete de l'expression.
// Les deux premiers ne sont PAS exclusifs : dbgOsBoth mesure leur
// recouvrement, il ne s'ajoute pas.
// CONSERVATION : dbgOsNa + dbgOsCh + dbgOsPv - dbgOsBoth = dgcObCyc, car
// l'increment est place au point EXACT ou "OB HORS DU CYCLE COURANT" est
// affecte, sous la meme garde hierarchique.
var int dbgOsTot  = 0   // evaluations de obSameCycle, cote du biais courant
var int dbgOsOk   = 0   // ... dont vraies
var int dbgOsNa   = 0   // refus : obCr ou chIdx vaut na
var int dbgOsCh   = 0   // refus : obCr < chIdx
var int dbgOsPv   = 0   // refus : pvIdx > obCr
var int dbgOsBoth = 0   // refus : les deux a la fois (recouvrement)
var int dbgEvSKoT  = 0
var int dbgEvSKoF  = 0
var int dbgObEvict  = 0
var int dbgObBrk    = 0
var int dbgBkMade   = 0
var int dbgFvCand   = 0
var int dbgFvOk     = 0
var int dbgFvNoGap  = 0
var int dbgFvNoBod  = 0
var int dbgFvOther  = 0
var int dbgFvEvict  = 0
var int dbgFvAge    = 0
var int dbgEqPair   = 0
var int dbgPockH    = 0
var int dbgPockL    = 0
var int dbgFvFill   = 0
var int dbgPockUse  = 0
var int dbgPockExp  = 0
var int dbgSwCand   = 0
var int dbgSwOk     = 0
var int dbgSwNoPen  = 0
var int dbgSwNoRej  = 0
var int dbgSwSingle = 0
var int dbgSeqSC    = 0
var int dbgSeqCB    = 0
var int dbgSeqFull  = 0
var int dbgZone     = 0

var float swingHigh = na
var float swingLow  = na
var int   swingHighBar = na
var int   swingLowBar  = na
if not na(ph)
    swingHigh := ph
    swingHighBar := bar_index - swingLen
if not na(pl)
    swingLow := pl
    swingLowBar := bar_index - swingLen

crossUp = ta.crossover(close, swingHigh) and swingHigh == swingHigh[1]
crossDn = ta.crossunder(close, swingLow) and swingLow == swingLow[1]

var int trend = 0
bullBos = not na(swingHigh) and crossUp
bearBos = not na(swingLow) and crossDn
// GARDE ANTI-REPAINT. trend est un var : une fois ecrit, rien ne le fait
// revenir en arriere tout seul. Sans le garde barstate.isconfirmed, une meche
// intrabougie qui franchit swingHigh puis repart avant la cloture pouvait
// forcer trend a la mauvaise valeur en direct (graphique temps reel), et
// cette corruption survivait a la bougie suivante. En backtest, aucun
// changement : le simulateur n'evalue jamais de bougie non confirmee, donc
// barstate.isconfirmed y est deja toujours vrai au moment ou le script
// s'execute -- ce garde ne change que le comportement live.
if bullBos and barstate.isconfirmed
    trend := 1
if bearBos and barstate.isconfirmed
    trend := -1

// CHoCH : il faut la tendance AVANT sa mise a jour, donc trend[1].
bullChoch = bullBos and trend[1] == -1
bearChoch = bearBos and trend[1] == 1

// --- Displacement : corps de bougie >= 1.5 ATR ---
bullImb = (close - open) >= 1.5 * atrV
bearImb = (open - close) >= 1.5 * atrV

// --- Tendance de l'unite superieure (bougies CLOTUREES) ---
htfClose = request.security(syminfo.tickerid, htfTf, close[1], lookahead=barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen)[1], lookahead=barmerge.lookahead_off)
htfBull  = not na(htfEma) and htfClose > htfEma
htfBear  = not na(htfEma) and htfClose < htfEma

// --- VWAP de session ---
vwapV     = ta.vwap(hlc3)
aboveVwap = not na(vwapV) and close > vwapV
belowVwap = not na(vwapV) and close < vwapV

// --- Biais journalier et hebdomadaire (bougies CLOTUREES) ---
// L'ECART est renvoye en flottant, pas un booleen : Pine n'accepte pas na()
// sur un booleen issu de request.security, et le flottant propage l'absence
// de donnee tant que l'EMA n'est pas formee. Le SIGNE donne le biais.
biasD = request.security(syminfo.tickerid, "D", close[1] - ta.ema(close, biasDLen)[1], lookahead=barmerge.lookahead_off)
biasW = request.security(syminfo.tickerid, "W", close[1] - ta.ema(close, biasWLen)[1], lookahead=barmerge.lookahead_off)
// Ruban journalier : trois EMA sur les CLOTURES D1, lues sur la bougie
// journaliere precedente. Aucune valeur future, aucun repaint.
ribA = request.security(syminfo.tickerid, "D", ta.ema(close, ribF)[1], lookahead=barmerge.lookahead_off)
ribB = request.security(syminfo.tickerid, "D", ta.ema(close, ribM)[1], lookahead=barmerge.lookahead_off)
ribC = request.security(syminfo.tickerid, "D", ta.ema(close, ribS)[1], lookahead=barmerge.lookahead_off)
bool useRib   = biasMode == "Ruban D1 (5/20/50)"
bool ribReady = not na(ribA) and not na(ribB) and not na(ribC)
biasReady = useRib ? ribReady : (not na(biasD) and not na(biasW))
biasBull  = useRib ? (ribReady and ribA > ribB and ribB > ribC) : (biasReady and biasD > 0 and biasW > 0)
biasBear  = useRib ? (ribReady and ribA < ribB and ribB < ribC) : (biasReady and biasD < 0 and biasW < 0)
biasTxt  = not biasReady ? "—" : biasBull ? "HAUSSIER" : biasBear ? "BAISSIER" : "DIVERGENT"

// --- Profil de volume de la journee PRECEDENTE (POC + Value Area) ---
// Le profil se construit pendant la journee et n'est publie qu'a sa cloture :
// on ne lit jamais que des donnees passees. Aucun repaint.
var array<float> vPx  = array.new<float>()
var array<float> vVol = array.new<float>()
var float pocPrev = na
var float vahPrev = na
var float valPrev = na
var float pdhPrev = na
var float pdlPrev = na
var float dayHi   = na
var float dayLo   = na

newDay = ta.change(time("D")) != 0
if newDay
    if array.size(vPx) > 5
        float lo = array.min(vPx)
        float hi = array.max(vPx)
        if hi > lo
            float step = (hi - lo) / vBins
            array<float> acc = array.new<float>(vBins, 0.0)
            for i = 0 to array.size(vPx) - 1
                int k = math.min(vBins - 1, math.max(0, int((array.get(vPx, i) - lo) / step)))
                array.set(acc, k, array.get(acc, k) + array.get(vVol, i))
            int kMax = 0
            float vMax = -1.0
            float tot = 0.0
            for k = 0 to vBins - 1
                float w = array.get(acc, k)
                tot += w
                if w > vMax
                    vMax := w
                    kMax := k
            pocPrev := lo + (kMax + 0.5) * step
            int a1 = kMax
            int b1 = kMax
            float cum = vMax
            while cum < tot * vVaPct / 100.0 and (a1 > 0 or b1 < vBins - 1)
                float up = b1 < vBins - 1 ? array.get(acc, b1 + 1) : -1.0
                float dn = a1 > 0 ? array.get(acc, a1 - 1) : -1.0
                if up >= dn and b1 < vBins - 1
                    b1 += 1
                    cum += up
                else if a1 > 0
                    a1 -= 1
                    cum += dn
                else
                    break
            vahPrev := lo + (b1 + 1) * step
            valPrev := lo + a1 * step
    pdhPrev := dayHi
    pdlPrev := dayLo
    array.clear(vPx)
    array.clear(vVol)
    dayHi := high
    dayLo := low
else
    dayHi := na(dayHi) ? high : math.max(dayHi, high)
    dayLo := na(dayLo) ? low  : math.min(dayLo, low)
array.push(vPx, hl2)
array.push(vVol, na(volume) ? 1.0 : volume)

abovePoc = not na(pocPrev) and close > pocPrev
belowPoc = not na(pocPrev) and close < pocPrev

// ============================================================
// DECISION — identique a la v11, au caractere pres
// ============================================================
alignLong  = (not useStruct or trend == 1)  and (not useHtf or htfBull) and (not useVwap or aboveVwap) and (not useBias or biasBull) and (not vUsePoc or abovePoc)
alignShort = (not useStruct or trend == -1) and (not useHtf or htfBear) and (not useVwap or belowVwap) and (not useBias or biasBear) and (not vUsePoc or belowPoc)
bool donUp = close > ta.highest(high, donLen)[1]
bool donDn = close < ta.lowest(low, donLen)[1]
bool useDon = trigMode == "Cassure Donchian"
trigLong   = useDon ? donUp : (bullBos or (useImb and bullImb))
trigShort  = useDon ? donDn : (bearBos or (useImb and bearImb))

var int lastLong  = -99999
var int lastShort = -99999
rawLong  = trigLong  and alignLong  and not na(atrV) and atrV > 0
rawShort = trigShort and alignShort and not na(atrV) and atrV > 0
buySignal  = rawLong  and (bar_index - lastLong)  > cooldown and barstate.isconfirmed
sellSignal = rawShort and (bar_index - lastShort) > cooldown and barstate.isconfirmed
if buySignal
    lastLong := bar_index
if sellSignal
    lastShort := bar_index

// --- Percentile ADX : MESURE SEULE, aucune condition ne le lit.
// Il est inscrit dans le commentaire de chaque entree (suffixe "A") pour que
// la liste de trades exportee permette de re-tester des hypotheses de regime
// sans jamais modifier le systeme.
[fDiP, fDiM, fAdxV] = ta.dmi(14, 14)
fAdxPct  = ta.percentrank(fAdxV, 500)

f_score(bool isLong) =>
    float s = 0.0
    s += (isLong ? bullBos : bearBos) ? 44.9 : 0.0
    s += (isLong ? bullImb : bearImb) ? 33.5 : 0.0
    s += (isLong ? trend == 1 : trend == -1) ? 7.2 : 0.0
    s += (isLong ? htfBull : htfBear) ? 7.3 : 0.0
    s += (isLong ? aboveVwap : belowVwap) ? 7.0 : 0.0
    s

// ================= EXECUTION =================
var float ePx = na
var float sPx = na
var float rPx = na
var bool  eLong = false

// PLAFOND DE LEVIER — securite ajoutee apres un incident reel.
// Sur TVC:GOLD, la taille calculee atteignait 20x le capital (128x au pire) :
// une perte coutait 2.72 % du capital au lieu du 1 % configure, et TOUS les
// resultats etaient gonfles d'un facteur ~2.7 dans les deux sens. Le stop, lui,
// se declenchait exactement ou il devait (excursion adverse = perte realisee).
// La cause : syminfo.pointvalue n'a pas la meme signification sur un INDICE non
// negociable que sur un symbole broker, ce qui fausse la conversion risque ->
// quantite. Le plafond ci-dessous rend cette erreur impossible, quel que soit
// le symbole : le notionnel ne peut jamais depasser maxLev fois le capital.
f_qty(float risk) =>
    float pv = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue
    float q = risk > 0 ? math.max(0.0, strategy.equity * riskPct / 100.0) / (risk * pv) : 0.0
    float qMax = close > 0 ? maxLev * strategy.equity / close : 0.0
    math.min(q, qMax)

// SL structurel : distance au dernier swing low/high confirme, + un petit
// coussin de 0.15 ATR (meme marge que la reference structurelle affichee
// dans le panneau). N'utilise QUE swingLow/swingHigh, deja calcules a ce
// stade du script -- les tableaux OB/liquidite ne le sont pas encore ici,
// les utiliser aurait exige de reorganiser tout l'ordre de calcul du fichier
// pour un gain non demontre. Repli sur le stop ATR si le swing n'existe pas
// encore ou si la distance resultante est degeneree (<= 0).
f_slRisk(bool isLong) =>
    float structDist = isLong ? (na(swingLow) ? na : close - swingLow + atrV * 0.15) : (na(swingHigh) ? na : swingHigh - close + atrV * 0.15)
    slMode == "ATR (actuel)" ? slAtr * atrV : (not na(structDist) and structDist > 0 ? structDist : slAtr * atrV)

// Le percentile ADX du moment est inscrit dans le commentaire de chaque
// entree (suffixe "A"), UNIQUEMENT pour apparaitre dans la liste de trades
// exportee. Il ne conditionne rien. But : le test en avant des six prochains
// mois sert alors aussi de test hors echantillon du filtre de regime, sans
// qu'il faille l'activer et donc sans rien risquer.
if buySignal and strategy.position_size == 0
    risk = f_slRisk(true)
    qty = f_qty(risk)
    if qty > 0
        ePx := close
        rPx := risk
        sPx := close - risk
        eLong := true
        strategy.entry("L", strategy.long, qty=qty, comment="BUY " + str.tostring(math.round(f_score(true))) + " A" + str.tostring(math.round(nz(fAdxPct, -1))))

if sellSignal and strategy.position_size == 0
    risk = f_slRisk(false)
    qty = f_qty(risk)
    if qty > 0
        ePx := close
        rPx := risk
        sPx := close + risk
        eLong := false
        strategy.entry("S", strategy.short, qty=qty, comment="SELL " + str.tostring(math.round(f_score(false))) + " A" + str.tostring(math.round(nz(fAdxPct, -1))))

// Sortie unique en trailing : aucune prise partielle. Mesure : les sorties
// partielles coutaient 0.061 R par trade contre 0.028 R, soit 2.9 fois
// l'esperance de l'ancien systeme.
if strategy.position_size != 0 and not na(rPx) and rPx > 0
    bool isL = strategy.position_size > 0
    float act = isL ? ePx + trailStartR * rPx : ePx - trailStartR * rPx
    float off = math.max(1.0, trailDistR * rPx / syminfo.mintick)
    float tpP = isL ? ePx + tpFixedR * rPx : ePx - tpFixedR * rPx
    bool  fixe = exitMode == "TP fixe"
    if isL
        if fixe
            strategy.exit("X", from_entry="L", stop=sPx, limit=tpP, comment_loss="SL", comment_profit="TP")
        else
            strategy.exit("X", from_entry="L", stop=sPx, trail_price=act, trail_offset=off, comment_loss="SL", comment_trailing="Trailing")
    else
        if fixe
            strategy.exit("X", from_entry="S", stop=sPx, limit=tpP, comment_loss="SL", comment_profit="TP")
        else
            strategy.exit("X", from_entry="S", stop=sPx, trail_price=act, trail_offset=off, comment_loss="SL", comment_trailing="Trailing")

// ============================================================
// MOTEUR MULTI-TIMEFRAME — LECTURE SEULE
// ------------------------------------------------------------
// Trois votes par unite de temps : prix vs EMA rapide, EMA rapide vs EMA
// lente, et position dans le canal de structure (milieu du plus haut / plus
// bas sur N bougies). Deux votes concordants suffisent a qualifier la tendance.
//
// Tout est lu sur la bougie CLOTUREE de chaque unite ([1] partout) : aucune
// valeur future, aucun repaint. Et surtout : AUCUNE de ces valeurs n'entre
// dans buySignal / sellSignal. Le M5 et le M15 ne creent pas de biais — la
// mesure a rejete le M5 quatre fois par quatre methodes independantes.
// ============================================================
f_mtfScore() =>
    float ef = ta.ema(close, mtfEmaF)[1]
    float es = ta.ema(close, mtfEmaS)[1]
    float c1 = close[1]
    float mid = (ta.highest(high, mtfStrLen)[1] + ta.lowest(low, mtfStrLen)[1]) / 2
    float v1 = na(ef) ? 0.0 : (c1 > ef ? 1.0 : -1.0)
    float v2 = na(ef) or na(es) ? 0.0 : (ef > es ? 1.0 : -1.0)
    float v3 = na(mid) ? 0.0 : (c1 > mid ? 1.0 : -1.0)
    float ok = (na(ef) or na(es) or na(mid)) ? 0.0 : 1.0
    [v1 + v2 + v3, ok]

// PLAFOND INTRABAR — correctif d'un defaut grave de la version precedente.
// Demander une unite INFERIEURE a celle du graphique declenche une requete
// intra-bougie, et TradingView plafonne le total a ~100 000 intra-bougies pour
// TOUT le script. Sur un graphique 1 h, une seule requete M5 coute 12
// intra-bougies par bougie : l'historique entier tombe a 8 333 bougies, soit
// 347 jours. Mesure reelle sur l'export : 331 jours au lieu de 6,3 ans. Le
// backtest etait ampute de 85 % de son historique SANS AUCUN AVERTISSEMENT.
//
// On ne demande donc jamais une unite plus fine que le graphique : dans ce cas
// on interroge le graphique lui-meme (cout nul) et la ligne est marquee comme
// non disponible. Lire le M5 depuis un graphique 1 h coute cinq ans d'historique
// pour une information que le systeme n'utilise pas — le marche n'est pas assez
// genereux pour payer ce prix.
f_tfSafe(string tf) => timeframe.in_seconds(tf) < timeframe.in_seconds() ? timeframe.period : tf
bool m15Avail = timeframe.in_seconds("15") >= timeframe.in_seconds()
bool m5Avail  = timeframe.in_seconds("5")  >= timeframe.in_seconds()

[sD, okD]   = request.security(syminfo.tickerid, f_tfSafe("D"),   f_mtfScore(), lookahead=barmerge.lookahead_off)
[sH4, okH4] = request.security(syminfo.tickerid, f_tfSafe("240"), f_mtfScore(), lookahead=barmerge.lookahead_off)
[sH1, okH1] = request.security(syminfo.tickerid, f_tfSafe("60"),  f_mtfScore(), lookahead=barmerge.lookahead_off)
[sM15, okM15] = request.security(syminfo.tickerid, f_tfSafe("15"), f_mtfScore(), lookahead=barmerge.lookahead_off)
[sM5, okM5]   = request.security(syminfo.tickerid, f_tfSafe("5"),  f_mtfScore(), lookahead=barmerge.lookahead_off)

f_mtfDir(float s, float ok) => na(s) or na(ok) or ok < 0.5 ? 0 : (s >= 2 ? 1 : s <= -2 ? -1 : 0)
dirD   = f_mtfDir(sD,   okD)
dirH4  = f_mtfDir(sH4,  okH4)
dirH1  = f_mtfDir(sH1,  okH1)
dirM15 = m15Avail ? f_mtfDir(sM15, okM15) : 0
dirM5  = m5Avail  ? f_mtfDir(sM5,  okM5)  : 0

f_dirTxt(int d) => d == 1 ? "Bullish" : d == -1 ? "Bearish" : "Neutre"
f_dirCol(int d) => d == 1 ? cUp : d == -1 ? cDn : cMute

// Alignement : on compte les unites qui vont dans le sens du BIAIS PRINCIPAL
// (D1/W1), jamais l'inverse. Une unite basse ne peut pas retourner le biais,
// elle peut seulement confirmer ou non.
int biasDir = biasBull ? 1 : biasBear ? -1 : 0
// L'alignement ne compte que les unites REELLEMENT disponibles : afficher
// 3/5 parce que deux lignes sont inaccessibles serait un faux negatif.
int mtfTot   = 3 + (m15Avail ? 1 : 0) + (m5Avail ? 1 : 0)
int mtfAgree = (dirD == biasDir and biasDir != 0 ? 1 : 0) + (dirH4 == biasDir and biasDir != 0 ? 1 : 0) + (dirH1 == biasDir and biasDir != 0 ? 1 : 0) + (m15Avail and dirM15 == biasDir and biasDir != 0 ? 1 : 0) + (m5Avail and dirM5 == biasDir and biasDir != 0 ? 1 : 0)
string mtfVerdict = biasDir == 0 ? "PAS DE BIAIS" : mtfAgree == mtfTot ? "ALIGNEMENT COMPLET" : mtfAgree >= mtfTot - 1 ? "ALIGNEMENT PARTIEL" : "CONFLUENCE FAIBLE"
color  mtfVCol    = biasDir == 0 ? cMute : mtfAgree == mtfTot ? cUp : mtfAgree >= mtfTot - 1 ? cGold : cDn

// ============================================================
// CONTEXTE DE MARCHE — cinq regimes, LECTURE SEULE
// ------------------------------------------------------------
// Ce classement ne declenche rien. Il ne fait qu'une chose : decider ce qu'il
// est RAISONNABLE d'afficher. Montrer une zone de vente pendant que le marche
// monte franchement, c'est proposer un trade que le systeme ne prendra jamais
// — et c'est exactement ce qui pousse a devier du plan.
//
// Quatre votes, ponderes par ce que la mesure a montre :
//   biais D1+W1  : poids DOUBLE — c'est le module qui porte le systeme
//                  (esperance +0.064 -> +0.130 R a lui seul)
//   tendance H1  : poids 1
//   structure    : poids 1
//   tendance D1  : poids 1
// Somme de -5 a +5.
int ctxScore = (biasBull ? 2 : biasBear ? -2 : 0) + (htfBull ? 1 : htfBear ? -1 : 0) + (trend == 1 ? 1 : trend == -1 ? -1 : 0) + (dirD == 1 ? 1 : dirD == -1 ? -1 : 0)
int ctxCode = ctxScore >= 4 ? 2 : ctxScore >= 2 ? 1 : ctxScore <= -4 ? -2 : ctxScore <= -2 ? -1 : 0
string ctxTxt = ctxCode == 2 ? "STRONG BULLISH" : ctxCode == 1 ? "BULLISH" : ctxCode == -1 ? "BEARISH" : ctxCode == -2 ? "STRONG BEARISH" : "RANGE"
color  ctxCol = ctxCode == 2 ? cUp : ctxCode == 1 ? color.new(cUp, 30) : ctxCode == -1 ? color.new(cDn, 30) : ctxCode == -2 ? cDn : cMute

// Regle d'affichage des zones, deduite du regime :
//   STRONG BULLISH / BULLISH  -> aucune zone de vente
//   RANGE                     -> les deux cotes passent normalement
//   BEARISH / STRONG BEARISH  -> aucune zone d'achat
//
// DURCI cette session : l'ancienne regle ne bloquait qu'au niveau extreme
// (STRONG), avec un simple malus de 15 pts au niveau intermediaire. Un
// rallye rapide reste souvent classe "BULLISH" (pas encore "STRONG") tant que
// les moyennes mobiles qui construisent ctxCode n'ont pas rattrape le
// mouvement -- une zone SELL pouvait donc rester affichee, legale au sens du
// code, en pleine acceleration haussiere. Le malus ne suffisait pas a
// l'empecher, il la rendait juste un peu plus dure a creer. Desormais
// "BULLISH" bloque deja les zones SELL, pas seulement "STRONG BULLISH" --
// f_ctxMalus n'a donc plus de cas ou l'agir : supprime.
f_ctxAllow(bool isBuy) => isBuy ? ctxCode >= 0 : ctxCode <= 0

// ============================================================
// PLAN 1 — LE FOND : liquidite, volume, zones
// Tout ce plan reste en arriere du prix : traits fins, forte transparence,
// aucun bloc opaque. Il doit se lire du coin de l'oeil, jamais capter l'attention.
// ============================================================

// --- Poches de liquidite : EQH / EQL -------------------------------------
// Deux sommets (ou deux creux) quasi egaux : les stops s'y empilent. Une poche
// disparait des qu'elle est prise. AFFICHAGE SEUL — mesure du sweep comme
// filtre : -0.087 apprentissage / -0.178 validation, il selectionne les
// mauvais trades.
var array<float> eqhL = array.new<float>()
var array<int>   eqhB = array.new<int>()
var array<float> eqlL = array.new<float>()
var array<int>   eqlB = array.new<int>()

// ---- SECONDE SOURCE DE LIQUIDITE : LE SWING SIMPLE ----------------------
// Un pivot confirme par ta.pivothigh/pivotlow(swingLen) domine swingLen
// bougies de chaque cote : c'est deja, par definition, un swing clair.
// Aucun seuil supplementaire n'est introduit pour le qualifier.
// pvHL porte la liquidite ACHETEUSE au-dessus des sommets -> setups SELL,
// pvLL la liquidite VENDEUSE sous les creux -> setups BUY. Meme mapping que
// eqhL / eqlL, et comme pour elles la direction est portee par la boucle qui
// teste le niveau, jamais par le niveau lui-meme.
// Plafond liqMax, identique aux poches. Le module DEBUG dbgPvH / dbgPvL, qui
// plafonne a 8, reste separe et inchange : il continue de mesurer le
// majorant, pas ce que le moteur suit.
var array<float> pvHL = array.new<float>()
var array<int>   pvHB = array.new<int>()
var array<float> pvLL = array.new<float>()
var array<int>   pvLB = array.new<int>()
var array<line>  liqLn = array.new<line>()
var array<label> liqLb = array.new<label>()
var array<label> swLb  = array.new<label>()

// CORRECTIF. La version precedente comparait `ph` a `ph[1]`, c'est-a-dire le
// pivot de CETTE bougie a celui de la bougie PRECEDENTE. Or ta.pivothigh ne
// renvoie une valeur que sur la bougie de confirmation et `na` partout
// ailleurs : il aurait fallu deux pivots sur deux bougies consecutives, ce qui
// n'arrive jamais avec swingLen = 10. La condition n'etait JAMAIS vraie et
// aucune poche de liquidite n'apparaissait.
// On memorise donc les DEUX DERNIERES VALEURS de pivot, pas les deux dernieres
// bougies.
var float phA = na
var float phB = na
var int   phAbar = na
var float plA = na
var float plB = na
var int   plAbar = na
if not na(ph)
    phB := phA
    phA := ph
    phAbar := bar_index - swingLen
if not na(pl)
    plB := plA
    plA := pl
    plAbar := bar_index - swingLen

float liqTol = atrV * liqTolAtr
if not na(ph) and not na(phB) and not na(liqTol)
    if math.abs(phA - phB) <= liqTol
        array.push(eqhL, math.max(phA, phB))
        array.push(eqhB, phAbar)
        if array.size(eqhL) > liqMax
            array.shift(eqhL)
            array.shift(eqhB)
            dbgPockExp += 1
            dbgPkEvH += 1
if not na(pl) and not na(plB) and not na(liqTol)
    if math.abs(plA - plB) <= liqTol
        array.push(eqlL, math.min(plA, plB))
        array.push(eqlB, plAbar)
        if array.size(eqlL) > liqMax
            array.shift(eqlL)
            array.shift(eqlB)
            dbgPockExp += 1
            dbgPkEvL += 1

// ---- ALIMENTATION DE LA LISTE DES SWINGS SIMPLES -----------------------
// Place APRES la creation des poches : une poche nee sur cette bougie est
// donc visible du test de couverture ci-dessous.
// ANTI-REPAINT : entree sous barstate.isconfirmed. Un pivot ne rejoint la
// liste qu'une fois la bougie close, jamais sur un tick intermediaire.
// DEDOUBLONNAGE, SEUIL EMPRUNTE : liqTol = atrV * liqTolAtr est deja, dans
// ce script, la distance en dessous de laquelle deux prix sont "le meme
// niveau". Aucun parametre nouveau n'est cree.
//   sens 1 -- un pivot n'entre pas s'il est deja couvert par une poche ;
//   sens 2 -- un niveau simple deja en liste est purge si une poche nee plus
//             tard vient le couvrir. Sans ce second sens, un pivot entre seul
//             puis apparie existerait en double et pourrait produire deux
//             sweeps sur DEUX bougies differentes -- le booleen unique ne
//             protege que du double sur la MEME bougie.
if barstate.isconfirmed and not na(liqTol)
    if array.size(pvHL) > 0 and array.size(eqhL) > 0
        for i = array.size(pvHL) - 1 to 0
            float sv = array.get(pvHL, i)
            bool cov = false
            for j = 0 to array.size(eqhL) - 1
                if math.abs(array.get(eqhL, j) - sv) <= liqTol
                    cov := true
                    break
            if cov
                array.remove(pvHL, i)
                array.remove(pvHB, i)
                dbgPvPurH += 1
    if array.size(pvLL) > 0 and array.size(eqlL) > 0
        for i = array.size(pvLL) - 1 to 0
            float sv = array.get(pvLL, i)
            bool cov = false
            for j = 0 to array.size(eqlL) - 1
                if math.abs(array.get(eqlL, j) - sv) <= liqTol
                    cov := true
                    break
            if cov
                array.remove(pvLL, i)
                array.remove(pvLB, i)
                dbgPvPurL += 1
    if not na(ph)
        bool covH = false
        if array.size(eqhL) > 0
            for i = 0 to array.size(eqhL) - 1
                if math.abs(array.get(eqhL, i) - ph) <= liqTol
                    covH := true
                    break
        if covH
            dbgPvDupH += 1
        else
            array.push(pvHL, ph)
            array.push(pvHB, bar_index - swingLen)
            dbgPvAddH += 1
            if array.size(pvHL) > liqMax
                array.shift(pvHL)
                array.shift(pvHB)
                dbgPvEvH += 1
    if not na(pl)
        bool covL = false
        if array.size(eqlL) > 0
            for i = 0 to array.size(eqlL) - 1
                if math.abs(array.get(eqlL, i) - pl) <= liqTol
                    covL := true
                    break
        if covL
            dbgPvDupL += 1
        else
            array.push(pvLL, pl)
            array.push(pvLB, bar_index - swingLen)
            dbgPvAddL += 1
            if array.size(pvLL) > liqMax
                array.shift(pvLL)
                array.shift(pvLB)
                dbgPvEvL += 1

// Une poche prise disparait. Si la cloture revient de l'autre cote, c'est un sweep.
//
// CORRECTIF DU SWEEP. Le drapeau hebdomadaire etait leve 244 lignes plus bas,
// par une seconde boucle qui re-parcourait eqhL/eqlL a la recherche de
// `low < niveau and close > niveau`. Or la poche est RETIREE du tableau ici
// meme, sur cette bougie, des que `low < lv`. Quand la seconde boucle
// s'executait, la poche n'existait plus : la condition ne pouvait jamais etre
// vraie et wzSweepDn / wzSweepUp restaient definitivement faux. Le gate de
// creation de zone commencant par `cSweep and ...`, AUCUNE zone ne pouvait
// naitre. Les etiquettes "sweep" s'affichaient malgre tout, puisqu'elles sont
// dessinees ici, avant la suppression -- d'ou la contradiction visible a
// l'ecran entre le graphique et le diagnostic.
//
// Le sweep est donc constate ICI, la ou la poche existe encore. Deux booleens
// de bougie portent l'information jusqu'au bloc hebdomadaire.
//
// Note : le constat ne depend plus de `sweepShow`. Cet interrupteur ne commande
// que l'etiquette ; le laisser conditionner la detection aurait fait dependre
// une decision d'un reglage d'affichage.
// Un seul marqueur SWEEP par bougie et par sens. La boucle parcourt TOUTES
// les poches : une bougie qui en traverse deux proches -- ce qui arrive, les
// poches etant memorisees avec une tolerance -- creait deux etiquettes sur la
// meme bougie, au meme prix a quelques ticks pres. D'ou les doublons.
// L'ancrage, lui, etait deja juste : bar_index est bien la bougie du sweep, et
// high/low bien la meche qui prend la liquidite.
var int swBarUp = na
var int swBarDn = na
bool sweepUpBar = false
bool sweepDnBar = false

// D4 -- UN VRAI SWEEP, PAS UNE MECHE DE BRUIT.
// Trois conditions cumulatives remplacent l'ancien `high > lv` / `close < lv` :
//   1. PENETRATION  -- la meche depasse le niveau d'au moins sweepMinPen x ATR ;
//   2. REJET        -- la cloture revient de l'autre cote d'au moins
//                      sweepReject x ATR, et non d'un tick ;
//   3. CONSOMMATION -- la poche n'est retiree que si la penetration est REELLE.
// Le point 3 est un choix a expliciter : auparavant un simple effleurement d'un
// tick consommait la poche de liquidite. Elle disparaissait alors sans qu'aucun
// sweep n'ait eu lieu, et le vrai sweep qui serait survenu plus tard sur ce
// meme niveau ne pouvait plus etre detecte. Un effleurement n'est ni un sweep
// ni une prise de liquidite : la poche survit.
//
// SENS : sweepUpBar = la liquidite ACHETEUSE au-dessus des EQH est prise puis
// rejetee -- signal baissier. sweepDnBar = la liquidite VENDEUSE sous les EQL
// est prise puis rejetee -- signal haussier. Ce mapping etait deja correct.
//
// D5 -- L'ETIQUETTE EST POSEE AU NIVEAU REELLEMENT PRIS (lv), plus a
// l'extremite de la meche, et porte ce niveau dans son texte : le sweep est
// ainsi rattache visuellement a la liquidite qu'il vient de consommer.
//
// Un seul marqueur SWEEP par bougie et par sens : la boucle parcourt TOUTES les
// poches, et une bougie qui en traverse deux proches -- ce qui arrive, les
// poches etant memorisees avec une tolerance -- creait deux etiquettes.
// --- DEBUG : appariement des pivots en poches de liquidite ---------------
// dbgEqPair est le DENOMINATEUR : le nombre de fois ou deux valeurs de pivot
// consecutives ont pu etre comparees. dbgPocket est le numerateur : celles
// assez proches pour former une poche. Le rapport des deux mesure directement
// la rarete du motif EQH/EQL sur lequel repose tout le moteur de sweep.
if barstate.isconfirmed and not na(liqTol)
    if not na(ph) and not na(phB)
        dbgEqPair += 1
        dbgPrH += 1
        if math.abs(phA - phB) <= liqTol
            dbgPockH += 1
        // SENSIBILITE : le meme ecart, confronte aux cinq seuils.
        float dH = math.abs(phA - phB)
        if dH <= atrV * 0.10
            dbgTH10 += 1
        if dH <= atrV * 0.15
            dbgTH15 += 1
        if dH <= atrV * 0.20
            dbgTH20 += 1
        if dH <= atrV * 0.25
            dbgTH25 += 1
        if dH <= atrV * 0.30
            dbgTH30 += 1
    if not na(pl) and not na(plB)
        dbgEqPair += 1
        dbgPrL += 1
        if math.abs(plA - plB) <= liqTol
            dbgPockL += 1
        float dL = math.abs(plA - plB)
        if dL <= atrV * 0.10
            dbgTL10 += 1
        if dL <= atrV * 0.15
            dbgTL15 += 1
        if dL <= atrV * 0.20
            dbgTL20 += 1
        if dL <= atrV * 0.25
            dbgTL25 += 1
        if dL <= atrV * 0.30
            dbgTL30 += 1

// --- DEBUG : pourquoi un sweep est accepte ou rejete ---------------------
// Rejoue le test sur les MEMES poches, AVANT que le bloc reel ne les consomme.
// Comptage par BOUGIE et non par poche : un evenement = une bougie.
if barstate.isconfirmed and not na(atrV)
    float dPen = atrV * sweepMinPen
    float dRej = atrV * sweepReject
    bool dCand = false
    bool dPent = false
    bool dOk   = false
    // Drapeaux PAR COTE, poses a cote des drapeaux globaux existants. Les
    // conditions testees sont rigoureusement les memes : aucune detection
    // nouvelle, seulement une ventilation.
    bool bCand = false
    bool bPent = false
    bool bOk   = false
    bool sCand = false
    bool sPent = false
    bool sOk   = false
    if array.size(eqhL) > 0
        for i = 0 to array.size(eqhL) - 1
            float lv = array.get(eqhL, i)
            if high > lv
                dCand := true
                bCand := true
                if high >= lv + dPen
                    dPent := true
                    bPent := true
                    if close <= lv - dRej
                        dOk := true
                        bOk := true
    if array.size(eqlL) > 0
        for i = 0 to array.size(eqlL) - 1
            float lv = array.get(eqlL, i)
            if low < lv
                dCand := true
                sCand := true
                if low <= lv - dPen
                    dPent := true
                    sPent := true
                    if close >= lv + dRej
                        dOk := true
                        sOk := true
    if dCand
        dbgSwCand += 1
        if dOk
            dbgSwOk += 1
        else if dPent
            dbgSwNoRej += 1
        else
            dbgSwNoPen += 1
    // BUY-SIDE : liquidite au-dessus des EQH -> alimente les setups SELL.
    if bCand
        dbgBsCand += 1
        if bOk
            dbgBsOk += 1
        else if bPent
            dbgBsNoRej += 1
        else
            dbgBsNoPen += 1
    // SELL-SIDE : liquidite sous les EQL -> alimente les setups BUY.
    if sCand
        dbgSsCand += 1
        if sOk
            dbgSsOk += 1
        else if sPent
            dbgSsNoRej += 1
        else
            dbgSsNoPen += 1

float swPen = na(atrV) ? na : atrV * sweepMinPen
float swRej = na(atrV) ? na : atrV * sweepReject
if array.size(eqhL) > 0 and not na(swPen) and not na(swRej)
    for i = array.size(eqhL) - 1 to 0
        float lv = array.get(eqhL, i)
        if high >= lv + swPen
            if close <= lv - swRej
                sweepUpBar := true
                if sweepShow and array.size(swLb) < 40 and barstate.isconfirmed and (na(swBarUp) or swBarUp != bar_index)
                    swBarUp := bar_index
                    array.push(swLb, label.new(bar_index, lv, "SWEEP " + str.tostring(lv, format.mintick), style=label.style_label_down, color=color.new(cBg, 100), textcolor=color.new(cDn, 20), size=size.tiny))
            array.remove(eqhL, i)
            array.remove(eqhB, i)
            dbgPockUse += 1
            // DEBUG : la poche vient d'etre detruite. A-t-elle produit un
            // sweep, ou a-t-elle seulement ete penetree ? Le test rejoue la
            // condition de rejet a l'identique, sur le meme lv, sans la
            // modifier ni la deplacer.
            if barstate.isconfirmed
                if close <= lv - swRej
                    dbgPkSwH += 1
                else
                    dbgPkKiH += 1
if array.size(eqlL) > 0 and not na(swPen) and not na(swRej)
    for i = array.size(eqlL) - 1 to 0
        float lv = array.get(eqlL, i)
        if low <= lv - swPen
            if close >= lv + swRej
                sweepDnBar := true
                if sweepShow and array.size(swLb) < 40 and barstate.isconfirmed and (na(swBarDn) or swBarDn != bar_index)
                    swBarDn := bar_index
                    array.push(swLb, label.new(bar_index, lv, "SWEEP " + str.tostring(lv, format.mintick), style=label.style_label_up, color=color.new(cBg, 100), textcolor=color.new(cUp, 20), size=size.tiny))
            array.remove(eqlL, i)
            array.remove(eqlB, i)
            dbgPockUse += 1
            if barstate.isconfirmed
                if close >= lv + swRej
                    dbgPkSwL += 1
                else
                    dbgPkKiL += 1
// ---- SWEEP SUR SWING SIMPLE : LA SECONDE SOURCE ------------------------
// Meme test, mot pour mot, que les deux boucles EQH/EQL ci-dessus : meme
// swPen, meme swRej, meme consommation du niveau des qu'il est PENETRE --
// array.remove hors du test de rejet, exactement comme pour les poches.
// sweepUpBar et sweepDnBar sont des booleens : les allumer depuis deux
// sources sur la meme bougie ne peut pas produire deux sweeps. Le pipeline
// aval (swpUpIdx / swpDnIdx -> f_seqSweep -> CHoCH -> BOS -> zones) est
// inchange et ne sait pas de quelle source vient le sweep.
// Aucune etiquette n'est dessinee : l'affichage reste celui d'aujourd'hui.
bool pvTouchH = false
bool pvTouchL = false
if array.size(pvHL) > 0 and not na(swPen) and not na(swRej)
    for i = array.size(pvHL) - 1 to 0
        float lv = array.get(pvHL, i)
        if high > lv
            if high >= lv + swPen
                if close <= lv - swRej
                    sweepUpBar := true
                    if barstate.isconfirmed
                        dbgPvSwH += 1
                else
                    if barstate.isconfirmed
                        dbgPvKiH += 1
                array.remove(pvHL, i)
                array.remove(pvHB, i)
            else
                pvTouchH := true
if array.size(pvLL) > 0 and not na(swPen) and not na(swRej)
    for i = array.size(pvLL) - 1 to 0
        float lv = array.get(pvLL, i)
        if low < lv
            if low <= lv - swPen
                if close >= lv + swRej
                    sweepDnBar := true
                    if barstate.isconfirmed
                        dbgPvSwL += 1
                else
                    if barstate.isconfirmed
                        dbgPvKiL += 1
                array.remove(pvLL, i)
                array.remove(pvLB, i)
            else
                pvTouchL := true
if barstate.isconfirmed
    if pvTouchH
        dbgPvNoPenH += 1
    if pvTouchL
        dbgPvNoPenL += 1

if array.size(swLb) > 6
    label.delete(array.shift(swLb))

// --- DEBUG : les sweeps de SWING SIMPLE que la logique EQH/EQL ne voit pas -
// Detecteur fantome. Il applique exactement les memes seuils de penetration et
// de rejet, mais a des pivots ISOLES au lieu de paires EQH/EQL. Un comptage
// eleve ici est la mesure directe de la critique n°1 de l'audit : la liquidite
// prise sur un swing propre non apparie est invisible pour le moteur.
// Ces tableaux ne sont lus par rien d'autre. Le niveau est consomme des qu'il
// est penetre, pour ne jamais compter deux fois le meme.
var array<float> dbgPvH = array.new<float>()
var array<float> dbgPvL = array.new<float>()
if barstate.isconfirmed and not na(atrV)
    float sPen = atrV * sweepMinPen
    float sRej = atrV * sweepReject
    bool sHit = false
    if array.size(dbgPvH) > 0
        for i = array.size(dbgPvH) - 1 to 0
            float lv = array.get(dbgPvH, i)
            if high >= lv + sPen
                if close <= lv - sRej
                    sHit := true
                array.remove(dbgPvH, i)
    if array.size(dbgPvL) > 0
        for i = array.size(dbgPvL) - 1 to 0
            float lv = array.get(dbgPvL, i)
            if low <= lv - sPen
                if close >= lv + sRej
                    sHit := true
                array.remove(dbgPvL, i)
    if sHit and not sweepUpBar and not sweepDnBar
        dbgSwSingle += 1
    if not na(ph)
        array.push(dbgPvH, ph)
        if array.size(dbgPvH) > 8
            array.shift(dbgPvH)
    if not na(pl)
        array.push(dbgPvL, pl)
        if array.size(dbgPvL) > 8
            array.shift(dbgPvL)

// --- Order Blocks : trois conditions cumulatives --------------------------
// 1. deplacement significatif derriere la zone,
// 2. cassure de structure provoquee (BOS ou CHoCH),
// 3. zone jamais traversee en cloture depuis.
// Sans ces trois filtres, un graphique se couvre de dizaines d'OB sans valeur.
var array<float> obBT = array.new<float>()
var array<float> obBB = array.new<float>()
var array<int>   obBX = array.new<int>()
var array<float> obST = array.new<float>()
var array<float> obSB = array.new<float>()
var array<int>   obSX = array.new<int>()

// D3 -- IDENTITE DE LA ZONE.
// obB*X est la bougie d'ORIGINE : celle qui CONSTITUE l'Order Block, celle a
// laquelle le rectangle est ancre. obB*Cr est la bougie de CREATION : celle du
// CHoCH qui l'a fait naitre. Les deux different toujours et servent a des
// choses differentes -- X ancre le dessin, Cr date l'evenement et sert de
// garde a la mitigation (voir D1 plus bas).
var array<int>   obBCr = array.new<int>()
var array<int>   obSCr = array.new<int>()

// D3 -- ETAT : 0 = FRESH, 1 = MITIGATED, 2 = TESTED.
//   MITIGATED : une MECHE est entree dans la zone.
//   TESTED    : une bougie a CLOTURE a l'interieur sans la casser.
// Les deux etats restants du cycle -- PENDING BREAK et BREAKER -- ne sont
// volontairement PAS des valeurs de ce tableau, mais des tableaux distincts
// (pb*, bk*). Une zone cassee n'est plus un Order Block : elle ne peut donc pas
// porter un etat d'Order Block. L'appartenance au tableau EST l'etat, ce qui
// supprime par construction toute possibilite de contradiction entre les deux.
// Aucun de ces etats n'est lu par une condition de trading : rendu uniquement.
var array<int>   obBSt = array.new<int>()
var array<int>   obSSt = array.new<int>()

// BREAKER BLOCKS, dans des tableaux SEPARES de obB*/obS*. C'est delibere :
// le moteur de zones lit array.get(obBT, 0) et array.size(obBT). Y verser les
// breakers les ferait apparier comme des Order Blocks et modifierait la
// creation des zones -- donc le trading. Separes, le moteur voit exactement ce
// qu'il voyait avant, et aucun CHoCH ulterieur ne peut effacer un breaker
// puisque array.clear ne porte que sur obB*/obS*.
// bkS* = breaker BAISSIER, ne d'un OB haussier casse par le bas (resistance).
// bkB* = breaker HAUSSIER, ne d'un OB baissier casse par le haut (support).
// bk*Tr = bougie de TRANSFORMATION en breaker (D3, identite).
var array<float> bkST = array.new<float>()
var array<float> bkSB = array.new<float>()
var array<int>   bkSX = array.new<int>()
var array<int>   bkSCr = array.new<int>()
var array<int>   bkSTr = array.new<int>()
var array<float> bkBT = array.new<float>()
var array<float> bkBB = array.new<float>()
var array<int>   bkBX = array.new<int>()
var array<int>   bkBCr = array.new<int>()
var array<int>   bkBTr = array.new<int>()

// D2 -- PENDING BREAK : zone cassee, en attente de confirmation structurelle.
// Une cassure ne fabrique plus un Breaker a elle seule. La zone cassee attend
// ICI une cassure de structure DANS LE SENS de la cassure ; sans elle, elle
// expire au bout de bkConfBars bougies sans jamais devenir Breaker.
// pbS* = ex-OB haussier casse par le bas  -> candidat breaker BAISSIER.
// pbB* = ex-OB baissier casse par le haut -> candidat breaker HAUSSIER.
// pb*Bk = bougie de CASSURE (D3, identite ; borne aussi la fenetre d'attente).
var array<float> pbST = array.new<float>()
var array<float> pbSB = array.new<float>()
var array<int>   pbSX = array.new<int>()
var array<int>   pbSCr = array.new<int>()
var array<int>   pbSBk = array.new<int>()
var array<float> pbBT = array.new<float>()
var array<float> pbBB = array.new<float>()
var array<int>   pbBX = array.new<int>()
var array<int>   pbBCr = array.new<int>()
var array<int>   pbBBk = array.new<int>()

// HISTORIQUE DES ORDER BLOCKS ENCORE VALIDES, AFFICHAGE SEUL.
// obBT/obST ne contiennent qu'UN element : celui du dernier CHoCH. C'est ce
// que le moteur de zones lit (array.get(obBT, 0), array.size(obBT)) et cela ne
// doit pas changer -- garder plusieurs elements ferait de l'indice 0 le PLUS
// ANCIEN et modifierait l'appariement OB/FVG, donc le trading.
// Un OB supplante par un nouveau CHoCH n'est pourtant pas invalide : il rejoint
// ces tableaux au lieu d'etre detruit par array.clear, et y poursuit son cycle
// de vie complet (mitigation, test, cassure, attente, transformation).
var array<float> ohBT = array.new<float>()
var array<float> ohBB = array.new<float>()
var array<int>   ohBX = array.new<int>()
var array<int>   ohBCr = array.new<int>()
var array<int>   ohBSt = array.new<int>()
var array<float> ohST = array.new<float>()
var array<float> ohSB = array.new<float>()
var array<int>   ohSX = array.new<int>()
var array<int>   ohSCr = array.new<int>()
var array<int>   ohSSt = array.new<int>()

// UN SEUL Order Block par cote : celui de la derniere impulsion valide.
// Empiler des dizaines d'OB ne renseigne sur rien — seul le dernier a encore
// un sens operationnel. On remplace donc au lieu d'ajouter.
// Les MECHES sont incluses : le bord reel de la zone est l'extreme atteint.
// L'Order Block est fige a l'impulsion qui a produit le CHoCH, c'est-a-dire a
// l'ORIGINE du mouvement.
//
// DEPLACEMENT MESURE SUR L'IMPULSION, plus sur la seule bougie de CHoCH.
// L'accumulation se fait dans la boucle de recherche elle-meme, et non dans une
// boucle imbriquee `for k = 0 to i - 1` : cette forme-la faisait echouer le
// script, la profondeur d'historique de `close[k]` dependant du compteur d'une
// autre boucle. Ici `close[i]` reste borne par swingLen, un input.
// Quantite calculee strictement identique : quand l'OB est trouve a l'indice i,
// les bougies 1..i-1 sont haussieres par construction, donc le maximum
// accumule est bien celui des corps 0..i-1.
// ---- DECLENCHEURS : RETOURNEMENT *ET* CONTINUATION -----------------------
// L'ancienne condition etait `if bullChoch and not na(atrV)`, rien d'autre.
// Or bullChoch = bullBos and trend[1] == -1 : un CHoCH est un BOS qui inverse
// la tendance. Conditionner la creation au seul CHoCH rendait donc invisible
// TOUT Order Block laisse par une impulsion de CONTINUATION -- c'est-a-dire
// le gros des OB en tendance etablie, ou la structure enchaine les BOS dans
// le meme sens sans jamais repasser par un retournement.
// obContinuation ouvre la seconde voie. Tout le reste est identique : meme
// recherche de bougie source, meme seuil de deplacement, meme ancrage
// high/low meches incluses, meme cycle de vie, meme historique.
// ---- PORTE DE CYCLE STRUCTUREL ------------------------------------------
// CAUSE DE L'EXPLOSION D'OB, et c'est une erreur de conception de l'anti-
// doublon precedent : il comparait la BOUGIE SOURCE, alors que l'invariant
// necessaire porte sur la JAMBE.
// Mecanisme : swingHigh est reecrit des qu'un nouveau pivot haut se confirme,
// et en jambe haussiere soutenue il s'en confirme un tous les ~swingLen
// bougies. Chaque nouveau franchissement produit donc un nouveau bullBos, qui
// remonte depuis SA PROPRE bougie et trouve une bougie source DIFFERENTE. Le
// bx differait, l'anti-doublon ne se declenchait pas, et une seule impulsion
// fabriquait une chaine d'Order Blocks empiles.
//
// L'invariant correct : un nouvel OB de continuation exige un NOUVEAU CYCLE,
// c'est-a-dire un vrai pullback. Traduit en structure : un pivot confirme EN
// SENS OPPOSE doit etre apparu depuis la creation du dernier OB de ce cote.
// Un creux structurel pour un OB haussier, un sommet pour un OB baissier.
// A l'interieur d'une impulsion continue, aucun pivot oppose ne se confirme :
// la chaine s'effondre a un seul Order Block, celui de l'origine.
//
// Choix deliberes :
//   - AUCUN nouveau seuil ATR. L'invariant est purement structurel et
//     reutilise ta.pivothigh/pivotlow, deja calcules et deja non repeints.
//   - La voie CHoCH n'est PAS soumise a cette porte : un retournement est par
//     definition un nouveau cycle. Les OB de retournement sont donc
//     rigoureusement inchanges.
//   - Si aucun OB actif n'existe de ce cote -- au demarrage, ou apres une
//     invalidation qui a vide le tableau -- la porte est ouverte : un nouveau
//     cycle est alors legitime par construction.
bool cycleB = array.size(obBCr) == 0 or (not na(lastPlIdx) and lastPlIdx > array.get(obBCr, 0))
bool cycleS = array.size(obSCr) == 0 or (not na(lastPhIdx) and lastPhIdx > array.get(obSCr, 0))
// ---- FILTRE STRUCTUREL : BOS STRUCTUREL vs MICRO-BOS --------------------
// Le code ne distinguait NULLE PART un BOS majeur d'une cassure interne :
// bullBos est un booleen unique, et une cassure de deux ticks d'un pivot
// mineur produisait la meme valeur qu'une cassure decisive.
// swingHigh et swingLow sont les deux derniers pivots confirmes : leur ecart
// EST la structure en cours, deja presente dans le code. Un BOS n'est retenu
// comme STRUCTUREL que si cette amplitude atteint le seuil deja exige du
// deplacement de l'impulsion. Aucun reglage nouveau n'est introduit, et la
// justification n'est pas arbitraire : une jambe trop courte pour contenir le
// deplacement minimum ne peut pas etre une structure majeure.
bool structOk = not na(swingHigh) and not na(swingLow) and not na(atrV) and (swingHigh - swingLow) >= atrV * obDispAtr

// ---- IDENTITE DU MOUVEMENT STRUCTUREL -----------------------------------
// C'est le NIVEAU CASSE qui identifie le mouvement. Si le meme swingHigh a
// deja produit un Order Block, la cassure appartient au meme mouvement et ne
// doit rien creer -- cas du prix qui repasse sous le niveau puis le refranchit
// sans qu'aucun nouveau pivot ne se soit confirme, ce qui rearme crossover.
// Deux scalaires suffisent, il n'y a qu'un OB actif par cote : les tableaux du
// cycle de vie ne sont pas touches et restent en lockstep.
var float obBLvlUsed = na
var float obSLvlUsed = na
bool newMoveB = na(obBLvlUsed) or swingHigh != obBLvlUsed
bool newMoveS = na(obSLvlUsed) or swingLow != obSLvlUsed

// ---- DECLENCHEURS ------------------------------------------------------
// CORRECTIF PRINCIPAL : la porte de cycle s'applique desormais AUSSI a la voie
// CHoCH. Elle en etait exclue, et c'etait la fuite principale : trend est mis
// a 1 par tout bullBos et a -1 par tout bearBos, donc en marche sans direction
// -- le regime le plus frequent sur XAUUSD M5 -- les BOS alternent, chaque BOS
// a trend[1] oppose, et CHAQUE BOS est donc un CHoCH. La voie CHoCH creait un
// OB a chaque cassure sans aucun filtre.
// Un CHoCH haussier suit par construction une phase baissiere, ou les pivots
// bas abondent : la porte ne le penalise pas dans son cas legitime.
bool obTrigB = structOk and newMoveB and cycleB and (bullChoch or (obContinuation and bullBos))
bool obTrigS = structOk and newMoveS and cycleS and (bearChoch or (obContinuation and bearBos))

// Comptage des refus. Ils n'entrent pas dans le bloc de creation, il faut donc
// les compter ici. Ordre de priorite : structure, puis cycle -- on attribue le
// refus a la premiere cause qui s'applique.
if barstate.isconfirmed
    bool cndB = bullChoch or (obContinuation and bullBos)
    bool cndS = bearChoch or (obContinuation and bearBos)
    if cndB and not (structOk and newMoveB)
        dbgObStruct += 1
    else if cndB and not cycleB
        dbgObCycle += 1
    if cndS and not (structOk and newMoveS)
        dbgObStruct += 1
    else if cndS and not cycleS
        dbgObCycle += 1

// FILTRE DE BRUIT SUR LA BOUGIE SOURCE.
// Le parcours s'arretait (`break`) sur la PREMIERE bougie opposee, quelle que
// soit sa taille. Une micro-bougie de bruit a l'interieur de l'impulsion
// devenait donc l'Order Block, et la vraie bougie source -- plus profonde,
// celle qui est reellement a l'origine du mouvement -- n'etait jamais
// examinee. Une bougie opposee n'arrete desormais le parcours que si son
// CORPS atteint obNoiseAtr x ATR ; les micro-bougies sont traversees et leur
// corps, negatif dans le sens de l'impulsion, ne perturbe pas `disp`.
// La premiere bougie opposee SIGNIFICATIVE rencontree en remontant est bien
// la DERNIERE avant l'impulsion : c'est exactement la definition voulue.
//
// Le calcul reste dans UNE seule boucle bornee par swingLen. Extraire la
// recherche dans une fonction puis ecrire `high[src]` aurait rendu la
// profondeur d'historique dependante d'une valeur runtime -- ce que Pine ne
// peut pas dimensionner, et qui avait deja casse le script au commit 6609a10.
if obTrigB and not na(atrV)
    float disp = close - open
    bool  found = false
    for i = 1 to swingLen
        bool  opp  = close[i] < open[i]
        float body = open[i] - close[i]
        if opp and body >= atrV * obNoiseAtr
            found := true
            // ANTI-DOUBLON. Un meme mouvement structurel produit plusieurs BOS
            // successifs qui pointent tous vers la MEME bougie source. Sans ce
            // garde-fou, le meme Order Block serait recree a chaque BOS de la
            // jambe et chasserait son propre exemplaire vers l'historique, qui
            // se remplirait de copies. La comparaison porte sur la bougie
            // d'ORIGINE et non sur la bougie de creation : c'est l'origine qui
            // identifie un Order Block.
            int  bx  = bar_index - i
            bool dup = array.size(obBX) > 0 and array.get(obBX, 0) == bx
            if not dup and array.size(ohBX) > 0
                for j = 0 to array.size(ohBX) - 1
                    if array.get(ohBX, j) == bx
                        dup := true
            if barstate.isconfirmed
                dbgObCand += 1
            if disp < atrV * obDispAtr
                if barstate.isconfirmed
                    dbgObNoDsp += 1
            else if dup
                if barstate.isconfirmed
                    dbgObDup += 1
            else
                if barstate.isconfirmed
                    dbgObMade += 1
                    if bullChoch
                        dbgObMadeC += 1
                    else
                        dbgObMadeB += 1
                // L'OB precedent n'est pas detruit : il passe a l'historique.
                if array.size(obBT) > 0
                    array.push(ohBT, array.get(obBT, 0))
                    array.push(ohBB, array.get(obBB, 0))
                    array.push(ohBX, array.get(obBX, 0))
                    array.push(ohBCr, array.get(obBCr, 0))
                    array.push(ohBSt, array.get(obBSt, 0))
                array.clear(obBT)
                array.clear(obBB)
                array.clear(obBX)
                array.clear(obBCr)
                array.clear(obBSt)
                array.push(obBT, high[i])
                array.push(obBB, low[i])
                array.push(obBX, bx)
                array.push(obBCr, bar_index)
                array.push(obBSt, 0)
                // Le niveau structurel vient d'etre consomme par cet OB.
                obBLvlUsed := swingHigh
            break
        disp := math.max(disp, close[i] - open[i])
    if not found and barstate.isconfirmed
        dbgObNoCnd += 1

// Miroir baissier strict du bloc ci-dessus.
if obTrigS and not na(atrV)
    float disp = open - close
    bool  found = false
    for i = 1 to swingLen
        bool  opp  = close[i] > open[i]
        float body = close[i] - open[i]
        if opp and body >= atrV * obNoiseAtr
            found := true
            int  bx  = bar_index - i
            bool dup = array.size(obSX) > 0 and array.get(obSX, 0) == bx
            if not dup and array.size(ohSX) > 0
                for j = 0 to array.size(ohSX) - 1
                    if array.get(ohSX, j) == bx
                        dup := true
            if barstate.isconfirmed
                dbgObCand += 1
            if disp < atrV * obDispAtr
                if barstate.isconfirmed
                    dbgObNoDsp += 1
            else if dup
                if barstate.isconfirmed
                    dbgObDup += 1
            else
                if barstate.isconfirmed
                    dbgObMade += 1
                    if bearChoch
                        dbgObMadeC += 1
                    else
                        dbgObMadeB += 1
                if array.size(obST) > 0
                    array.push(ohST, array.get(obST, 0))
                    array.push(ohSB, array.get(obSB, 0))
                    array.push(ohSX, array.get(obSX, 0))
                    array.push(ohSCr, array.get(obSCr, 0))
                    array.push(ohSSt, array.get(obSSt, 0))
                array.clear(obST)
                array.clear(obSB)
                array.clear(obSX)
                array.clear(obSCr)
                array.clear(obSSt)
                array.push(obST, high[i])
                array.push(obSB, low[i])
                array.push(obSX, bx)
                array.push(obSCr, bar_index)
                array.push(obSSt, 0)
                obSLvlUsed := swingLow
            break
        disp := math.max(disp, open[i] - close[i])
    if not found and barstate.isconfirmed
        dbgObNoCnd += 1

// --- DEBUG : structure ----------------------------------------------------
if barstate.isconfirmed
    if bullBos or bearBos
        dbgBos += 1
    if bullChoch or bearChoch
        dbgChoch += 1

// ---- CYCLE DE VIE DES ORDER BLOCKS -------------------------------------
// D1 -- UN OB N'EST JAMAIS MITIGE SUR SA PROPRE BOUGIE DE CREATION.
// Le test porte sur le range de la bougie COURANTE, et ce bloc s'execute sur la
// MEME bougie que la creation, juste au-dessus. L'Order Block se trouvant a une
// a trois bougies en arriere, la bougie de CHoCH chevauchait presque toujours
// la zone qu'elle venait de creer : l'OB naissait deja "mitige" et l'etat FRESH
// n'existait pratiquement jamais a l'ecran. La garde `bar_index > obBCr` ferme
// cette porte sans rien changer d'autre.
//
// MITIGATION (etat 1) : une meche entre dans la zone.
// TEST       (etat 2) : une bougie CLOTURE a l'interieur sans la casser.
// Ni l'un ni l'autre n'est une invalidation. Aucun des deux ne retire l'OB :
// il reste affiche et actif, seule sa transparence change.
if array.size(obBB) > 0
    for i = 0 to array.size(obBB) - 1
        if bar_index > array.get(obBCr, i)
            float t = array.get(obBT, i)
            float b = array.get(obBB, i)
            if low <= t and high >= b and array.get(obBSt, i) < 1
                array.set(obBSt, i, 1)
            if close <= t and close >= b and barstate.isconfirmed and array.get(obBSt, i) < 2
                array.set(obBSt, i, 2)
if array.size(obSB) > 0
    for i = 0 to array.size(obSB) - 1
        if bar_index > array.get(obSCr, i)
            float t = array.get(obST, i)
            float b = array.get(obSB, i)
            if low <= t and high >= b and array.get(obSSt, i) < 1
                array.set(obSSt, i, 1)
            if close <= t and close >= b and barstate.isconfirmed and array.get(obSSt, i) < 2
                array.set(obSSt, i, 2)

// INVALIDATION : cloture CONFIRMEE au-dela du bord oppose. Une meche qui
// traverse ne suffit pas -- le test porte sur close, jamais sur low/high.
//
// D2 -- LA CASSURE NE FABRIQUE PLUS UN BREAKER DIRECTEMENT. La zone quitte
// obB*/obS* exactement au meme instant et sous exactement la meme condition
// qu'avant : c'est ce que lit le moteur de zones, il ne voit donc aucun
// changement. Mais elle atterrit en ATTENTE (pb*), pas en Breaker.
if array.size(obBB) > 0
    for i = array.size(obBB) - 1 to 0
        if close < array.get(obBB, i) and barstate.isconfirmed
            array.push(pbST, array.get(obBT, i))
            array.push(pbSB, array.get(obBB, i))
            array.push(pbSX, array.get(obBX, i))
            array.push(pbSCr, array.get(obBCr, i))
            array.push(pbSBk, bar_index)
            array.remove(obBT, i)
            array.remove(obBB, i)
            array.remove(obBX, i)
            array.remove(obBCr, i)
            array.remove(obBSt, i)
            dbgObBrk += 1
if array.size(obST) > 0
    for i = array.size(obST) - 1 to 0
        if close > array.get(obST, i) and barstate.isconfirmed
            array.push(pbBT, array.get(obST, i))
            array.push(pbBB, array.get(obSB, i))
            array.push(pbBX, array.get(obSX, i))
            array.push(pbBCr, array.get(obSCr, i))
            array.push(pbBBk, bar_index)
            array.remove(obST, i)
            array.remove(obSB, i)
            array.remove(obSX, i)
            array.remove(obSCr, i)
            array.remove(obSSt, i)
            dbgObBrk += 1

// D2 -- PROMOTION EN BREAKER, seulement apres confirmation structurelle.
// Un OB haussier casse par le bas ne devient une resistance que si la structure
// confirme le sens de la cassure : il faut un BOS ou un CHoCH BAISSIER
// POSTERIEUR a la bougie de cassure (bar_index > bkBar, strictement). Une
// simple bougie qui traverse ne suffit plus, et un retournement de tendance
// sans cassure prealable de la zone ne transforme jamais rien -- c'est
// exactement le cas "un OB bullish ne devient pas bearish parce que la tendance
// devient bearish".
// Sans confirmation dans la fenetre, la zone EXPIRE : elle ne devient pas
// Breaker, elle disparait. Mieux vaut aucun Breaker qu'un Breaker invente.
if array.size(pbST) > 0
    for i = array.size(pbST) - 1 to 0
        int bkBar = array.get(pbSBk, i)
        bool conf = (bearBos or bearChoch) and bar_index > bkBar
        bool aged = (bar_index - bkBar) > bkConfBars
        if barstate.isconfirmed and (conf or aged)
            if conf
                array.push(bkST, array.get(pbST, i))
                array.push(bkSB, array.get(pbSB, i))
                array.push(bkSX, array.get(pbSX, i))
                array.push(bkSCr, array.get(pbSCr, i))
                array.push(bkSTr, bar_index)
                dbgBkMade += 1
            array.remove(pbST, i)
            array.remove(pbSB, i)
            array.remove(pbSX, i)
            array.remove(pbSCr, i)
            array.remove(pbSBk, i)
if array.size(pbBT) > 0
    for i = array.size(pbBT) - 1 to 0
        int bkBar = array.get(pbBBk, i)
        bool conf = (bullBos or bullChoch) and bar_index > bkBar
        bool aged = (bar_index - bkBar) > bkConfBars
        if barstate.isconfirmed and (conf or aged)
            if conf
                array.push(bkBT, array.get(pbBT, i))
                array.push(bkBB, array.get(pbBB, i))
                array.push(bkBX, array.get(pbBX, i))
                array.push(bkBCr, array.get(pbBCr, i))
                array.push(bkBTr, bar_index)
                dbgBkMade += 1
            array.remove(pbBT, i)
            array.remove(pbBB, i)
            array.remove(pbBX, i)
            array.remove(pbBCr, i)
            array.remove(pbBBk, i)
while array.size(pbST) > bkMax
    array.shift(pbST)
    array.shift(pbSB)
    array.shift(pbSX)
    array.shift(pbSCr)
    array.shift(pbSBk)
while array.size(pbBT) > bkMax
    array.shift(pbBT)
    array.shift(pbBB)
    array.shift(pbBX)
    array.shift(pbBCr)
    array.shift(pbBBk)

// MORT DU BREAKER : un breaker baissier est une resistance, il meurt sur une
// cloture confirmee AU-DESSUS ; le breaker haussier est un support, il meurt
// sur une cloture SOUS. Plafond d'historique pour eviter l'accumulation.
if array.size(bkST) > 0
    for i = array.size(bkST) - 1 to 0
        if close > array.get(bkST, i) and barstate.isconfirmed
            array.remove(bkST, i)
            array.remove(bkSB, i)
            array.remove(bkSX, i)
            array.remove(bkSCr, i)
            array.remove(bkSTr, i)
if array.size(bkBT) > 0
    for i = array.size(bkBT) - 1 to 0
        if close < array.get(bkBB, i) and barstate.isconfirmed
            array.remove(bkBT, i)
            array.remove(bkBB, i)
            array.remove(bkBX, i)
            array.remove(bkBCr, i)
            array.remove(bkBTr, i)
while array.size(bkST) > bkMax
    array.shift(bkST)
    array.shift(bkSB)
    array.shift(bkSX)
    array.shift(bkSCr)
    array.shift(bkSTr)
while array.size(bkBT) > bkMax
    array.shift(bkBT)
    array.shift(bkBB)
    array.shift(bkBX)
    array.shift(bkBCr)
    array.shift(bkBTr)

// ---- MEME CYCLE DE VIE POUR LES OB DE L'HISTORIQUE ---------------------
// Mitigation, test, cassure vers l'attente, puis plafond. Identique a l'OB
// actif : un OB supplante n'est ni fige ni oublie, il continue simplement sa
// vie hors du champ du moteur de zones. La garde de creation (D1) s'applique
// aussi, meme si elle est toujours vraie ici : la coherence prime.
if array.size(ohBB) > 0
    for i = 0 to array.size(ohBB) - 1
        if bar_index > array.get(ohBCr, i)
            float t = array.get(ohBT, i)
            float b = array.get(ohBB, i)
            if low <= t and high >= b and array.get(ohBSt, i) < 1
                array.set(ohBSt, i, 1)
            if close <= t and close >= b and barstate.isconfirmed and array.get(ohBSt, i) < 2
                array.set(ohBSt, i, 2)
if array.size(ohSB) > 0
    for i = 0 to array.size(ohSB) - 1
        if bar_index > array.get(ohSCr, i)
            float t = array.get(ohST, i)
            float b = array.get(ohSB, i)
            if low <= t and high >= b and array.get(ohSSt, i) < 1
                array.set(ohSSt, i, 1)
            if close <= t and close >= b and barstate.isconfirmed and array.get(ohSSt, i) < 2
                array.set(ohSSt, i, 2)
if array.size(ohBB) > 0
    for i = array.size(ohBB) - 1 to 0
        if close < array.get(ohBB, i) and barstate.isconfirmed
            array.push(pbST, array.get(ohBT, i))
            array.push(pbSB, array.get(ohBB, i))
            array.push(pbSX, array.get(ohBX, i))
            array.push(pbSCr, array.get(ohBCr, i))
            array.push(pbSBk, bar_index)
            array.remove(ohBT, i)
            array.remove(ohBB, i)
            array.remove(ohBX, i)
            array.remove(ohBCr, i)
            array.remove(ohBSt, i)
            dbgObBrk += 1
if array.size(ohST) > 0
    for i = array.size(ohST) - 1 to 0
        if close > array.get(ohST, i) and barstate.isconfirmed
            array.push(pbBT, array.get(ohST, i))
            array.push(pbBB, array.get(ohSB, i))
            array.push(pbBX, array.get(ohSX, i))
            array.push(pbBCr, array.get(ohSCr, i))
            array.push(pbBBk, bar_index)
            array.remove(ohST, i)
            array.remove(ohSB, i)
            array.remove(ohSX, i)
            array.remove(ohSCr, i)
            array.remove(ohSSt, i)
            dbgObBrk += 1
while array.size(ohBT) > obHistMax
    array.shift(ohBT)
    array.shift(ohBB)
    array.shift(ohBX)
    array.shift(ohBCr)
    array.shift(ohBSt)
    dbgObEvict += 1
while array.size(ohST) > obHistMax
    array.shift(ohST)
    array.shift(ohSB)
    array.shift(ohSX)
    array.shift(ohSCr)
    array.shift(ohSSt)
    dbgObEvict += 1

// --- Fair Value Gaps : taille ET deplacement ------------------------------
// Un FVG n'est retenu que si l'ecart depasse fvgMinAtr ET que la bougie qui
// l'a cree porte un vrai corps directionnel. Les micro-gaps sont ignores.
var array<float> fvBT = array.new<float>()
var array<float> fvBB = array.new<float>()
var array<int>   fvBX = array.new<int>()
var array<float> fvST = array.new<float>()
var array<float> fvSB = array.new<float>()
var array<int>   fvSX = array.new<int>()

float gapUp = low - high[2]
float gapDn = low[2] - high
bool  bodyOk = not na(atrV) and math.abs(close[1] - open[1]) >= atrV * fvgDispAtr
if not na(atrV) and gapUp > atrV * fvgMinAtr and bodyOk and close[1] > open[1]
    array.push(fvBT, low)
    array.push(fvBB, high[2])
    array.push(fvBX, bar_index - 2)
    if array.size(fvBT) > fvgMax
        array.shift(fvBT)
        array.shift(fvBB)
        array.shift(fvBX)
        dbgFvEvict += 1
if not na(atrV) and gapDn > atrV * fvgMinAtr and bodyOk and close[1] < open[1]
    array.push(fvST, low[2])
    array.push(fvSB, high)
    array.push(fvSX, bar_index - 2)
    if array.size(fvST) > fvgMax
        array.shift(fvST)
        array.shift(fvSB)
        array.shift(fvSX)
        dbgFvEvict += 1

// --- DEBUG : pourquoi un FVG est retenu ou rejete ------------------------
// Un "candidat" est un ecart de 3 bougies non nul, avant tout seuil. La
// repartition entre les trois motifs de rejet dit lequel des deux seuils
// (ecart ou corps de la bougie centrale) elimine reellement les FVG.
if barstate.isconfirmed and not na(atrV)
    if gapUp > 0
        dbgFvCand += 1
        if not (gapUp > atrV * fvgMinAtr)
            dbgFvNoGap += 1
        else if not bodyOk
            dbgFvNoBod += 1
        else if not (close[1] > open[1])
            dbgFvOther += 1
        else
            dbgFvOk += 1
    if gapDn > 0
        dbgFvCand += 1
        if not (gapDn > atrV * fvgMinAtr)
            dbgFvNoGap += 1
        else if not bodyOk
            dbgFvNoBod += 1
        else if not (close[1] < open[1])
            dbgFvOther += 1
        else
            dbgFvOk += 1
// Un FVG disparait quand il est COMBLE (cloture au travers) ou quand il est
// simplement trop vieux : un desequilibre que le marche ignore depuis 200
// bougies n'est plus un desequilibre.
// --- DEBUG : pourquoi un FVG disparait — comblement ou anciennete ---------
// Le bloc reel supprime sur "cloture au travers OU age > fvgMaxAge". On rejoue
// la meme condition AVANT lui et dans le MEME ordre de priorite, pour
// attribuer chaque disparition a sa vraie cause. Lecture seule.
if barstate.isconfirmed
    if array.size(fvBB) > 0
        for i = 0 to array.size(fvBB) - 1
            if close < array.get(fvBB, i)
                dbgFvFill += 1
            else if (bar_index - array.get(fvBX, i)) > fvgMaxAge
                dbgFvAge += 1
    if array.size(fvST) > 0
        for i = 0 to array.size(fvST) - 1
            if close > array.get(fvST, i)
                dbgFvFill += 1
            else if (bar_index - array.get(fvSX, i)) > fvgMaxAge
                dbgFvAge += 1

if array.size(fvBB) > 0
    for i = array.size(fvBB) - 1 to 0
        if close < array.get(fvBB, i) or (bar_index - array.get(fvBX, i)) > fvgMaxAge
            array.remove(fvBT, i)
            array.remove(fvBB, i)
            array.remove(fvBX, i)
if array.size(fvST) > 0
    for i = array.size(fvST) - 1 to 0
        if close > array.get(fvST, i) or (bar_index - array.get(fvSX, i)) > fvgMaxAge
            array.remove(fvST, i)
            array.remove(fvSB, i)
            array.remove(fvSX, i)

// ---- PLAFOND DES COORDONNEES DE DESSIN ----------------------------------
// Pine resout toute coordonnee x exprimee en bar_index via le TAMPON
// D'HISTORIQUE. Demander une bougie plus ancienne que ce tampon leve
// "The requested historical offset (N) is beyond the historical buffer's
// limit (M)" et arrete le script. C'est un plafond de DESSIN, pas d'analyse.
//
// Trois sources d'ancres arbitrairement vieilles existent :
//   - ohB*/ohS* (OB de l'historique), pb* (zones cassees en attente) et bk*
//     (breakers) sont plafonnes EN NOMBRE mais pas EN AGE. Un Order Block
//     jamais mitige ni casse y reste indefiniment ; c'est lui qui a leve
//     l'erreur a 4480 bougies, sur l'appel f_zone(ohST...) ;
//   - l'ancre des zones institutionnelles (zX/zBar), bornee par
//     wzMaxAnchorAgeH : 72 h par defaut, soit deja 4320 bougies en M1, et
//     jusqu'a 43200 au reglage maximum ;
//   - le pivot d'origine d'un trait de BOS/CHoCH (fromBar).
// Les trois passent par la meme porte et meritent la meme protection.
//
// RIEN N'EST SUPPRIME et aucune regle ne change : seul le BORD GAUCHE DESSINE
// est plafonne. Une boite dont l'origine depasse le plafond conserve ses
// bornes de prix exactes et reste affichee -- elle commence simplement a
// DRAW_MAX_OFF bougies en arriere au lieu de son origine reelle, soit 2 jours
// en M1, 10 en M5, 31 en M15. Tres au-dela de ce qui tient a l'ecran.
//
// Le plafond est fixe a 3000 et non a la limite observee : la valeur du tampon
// varie d'un graphique a l'autre, une marge large est le seul moyen d'etre
// robuste sans la connaitre. Aucun `max_bars_back` n'est declare : forcer
// 5000 sur TOUTES les series couterait de la memoire sur chaque serie du
// script, alors que borner la demande la supprime a la source.
int DRAW_MAX_OFF = 3000
f_xL(int b) =>
    // int() explicite : box.new/line.new exigent un `series int` pour la
    // coordonnee x et Pine ne convertit PAS float -> int implicitement. Si
    // math.max resolvait la surcharge flottante, le script ne compilerait pas.
    // Le cast supprime la question.
    int(na(b) ? bar_index : math.max(b, bar_index - DRAW_MAX_OFF))

// ============================================================
// PLAN 2 — LA STRUCTURE : BOS / CHoCH
// Un trait du niveau casse jusqu'a la bougie qui le casse, une pastille sur
// cette bougie, et une etiquette uniquement sur les dernieres cassures. Le
// trait suffit a lire la structure ; au-dela, l'ecran se salit.
// ============================================================
var array<line>  brkLn = array.new<line>()
var array<label> brkLb = array.new<label>()

f_break(bool up, bool choch, float lvl, int fromBar) =>
    if brkShow and not na(lvl) and not na(fromBar)
        // Le CHoCH est un RETOURNEMENT : trait plein et epais, en or.
        // Le BOS est une CONTINUATION : trait fin, dans la couleur du sens.
        color col = choch ? cGold : (up ? cUp : cDn)
        line ln = line.new(f_xL(fromBar), lvl, bar_index, lvl, color=color.new(col, choch ? 0 : 30), width=choch ? 2 : 1, style=choch ? line.style_solid : line.style_dashed)
        array.push(brkLn, ln)
        if array.size(brkLn) > 14
            line.delete(array.shift(brkLn))
        // CORRECTIF : l'etiquette etait placee sous la bougie, donc detachee de
        // son trait. Elle est desormais AU BOUT du trait, a la hauteur du
        // niveau casse : le trait et son nom se lisent d'un seul regard.
        // La pastille label.style_circle est retiree : meme en size.tiny elle
        // dessine un disque plein tres visible, qui ecrasait le prix. Le trait
        // se termine deja au niveau casse ; un simple point dans le texte
        // marque l'endroit sans rien recouvrir.
        label tag = label.new(bar_index, lvl, choch ? " • CHoCH" : " • BOS", style=label.style_label_left, color=color.new(cBg, 100), textcolor=col, size=size.tiny)
        array.push(brkLb, tag)
        while array.size(brkLb) > math.max(1, brkLabels)
            label.delete(array.shift(brkLb))

if bullBos
    f_break(true,  bullChoch, swingHigh, na(swingHighBar) ? bar_index - swingLen : swingHighBar)
if bearBos
    f_break(false, bearChoch, swingLow,  na(swingLowBar)  ? bar_index - swingLen : swingLowBar)

// ============================================================
// WEEKLY INSTITUTIONAL ZONES — PLANIFICATION ET CONFIRMATION
// ------------------------------------------------------------
// CE MODULE NE GENERE AUCUN TRADE. Aucune de ses variables n'apparait dans
// alignLong / alignShort / trigLong / trigShort / buySignal / sellSignal.
// Il prepare la semaine et affiche l'etat des confirmations ; c'est le systeme
// SMC existant qui decide, comme avant.
//
// ABSENCE DE REPAINT — trois garanties.
//   1. Le profil hebdomadaire est celui de la semaine N-1. Il est publie a la
//      bascule de semaine et ne bouge plus. Un profil en cours de construction
//      changerait a chaque bougie : la zone dessinee lundi ne ressemblerait pas
//      a elle-meme vendredi.
//   2. Le score de Confluence est FIGE a la creation de la zone. Les
//      confirmations SMC (sweep, CHoCH, FVG/OB) evoluent en cours de semaine :
//      elles sont donc affichees a part, comme un ETAT, jamais comme une
//      composante du score.
//   3. Aucune unite de temps inferieure au graphique n'est interrogee.
//
// PERFORMANCE — le profil n'est calcule qu'UNE FOIS par semaine, a la bascule.
// Budget de dessin : 4 zones au maximum, soit 8 objets sur les 500 disponibles.
//
// LE MOT "CONFLUENCE" EST CHOISI. Ce n'est ni une qualite ni une probabilite :
// c'est un COMPTE d'elements presents. Sur les 100 points, 25 seulement (la
// structure) reposent sur un module dont l'avantage est mesure ; les 75 autres
// comptent des elements dont la mesure sur 6,3 ans ne montre aucun pouvoir
// predictif. Le tableau le dit explicitement, ligne par ligne.
// ============================================================
var array<float> wPx  = array.new<float>()
var array<float> wVol = array.new<float>()
var float wPoc = na
var float wVah = na
var float wVal = na
var float wHvnHi = na
var float wHvnLo = na
var float wHi = na
var float wLo = na
var float wHiPrev = na
var float wLoPrev = na
var int   wBias = 0

// Memoire des pivots recents : sert a savoir si le prix a DEJA reagi sur une zone.
var array<float> pvLvl = array.new<float>()
if not na(ph)
    array.push(pvLvl, ph)
    if array.size(pvLvl) > 24
        array.shift(pvLvl)
if not na(pl)
    array.push(pvLvl, pl)
    if array.size(pvLvl) > 24
        array.shift(pvLvl)

// Les zones de la semaine : bornes, score fige, cote, bougie de creation.
// zSmcType/zSmcTop/zSmcBot memorisent EXACTEMENT quel OB ou FVG a donne les 15
// points de confluence SMC, pour pouvoir detecter sa disparition plus tard —
// sans ca, "OB casse" ou "FVG comble" ne seraient pas detectables individuellement.
var array<float> zTop  = array.new<float>()
var array<float> zBot  = array.new<float>()
var array<float> zScr  = array.new<float>()
var array<int>   zSide = array.new<int>()
var array<int>   zBar  = array.new<int>()
var array<int>   zSmcType = array.new<int>()
var array<float> zSmcTop  = array.new<float>()
var array<float> zSmcBot  = array.new<float>()
var array<int>   zSmcBar  = array.new<int>()
// Le swing d'impulsion sur lequel le Fibonacci de CETTE zone est calcule,
// FIGE a sa creation. impHi/impLo sont des trackers glissants qui repartent a
// chaque nouveau pivot : les lire au moment de l'affichage ferait bouger les
// niveaux Fibonacci d'une zone deja creee, donc repeindrait son analyse. En
// les recopiant ici une fois pour toutes, les niveaux affiches restent ceux
// que le systeme a reellement utilises pour juger la zone.
var array<float> zFibHi   = array.new<float>()
var array<float> zFibLo   = array.new<float>()
var array<box>   zBox  = array.new<box>()
var array<label> zLab  = array.new<label>()

newWeek = ta.change(time("W")) != 0

// ---- CHAINE SWEEP -> CHoCH -> BOS, AVEC ORDRE CHRONOLOGIQUE --------------
// POURQUOI DES INDICES DE BOUGIE ET NON DES BOOLEENS.
//
// Dans le code, un CHoCH EST un BOS : bullChoch = bullBos and trend[1] == -1.
// C'est la definition juste -- le CHoCH est la PREMIERE cassure contre la
// tendance etablie, le BOS une cassure DANS le sens de la tendance -- mais
// elle implique que toute bougie de CHoCH allume aussi le drapeau BOS. Avec de
// simples booleens "l'evenement a-t-il eu lieu cette semaine", exiger
// `cChoch and cBos` etait donc une tautologie : le second n'ajoutait
// strictement rien au premier, et le BOS ne confirmait rien du tout.
//
// La sequence demandee est CHRONOLOGIQUE :
//     liquidite prise  ->  PUIS changement de caractere  ->  PUIS confirmation
// On memorise donc la BOUGIE de chaque evenement et on impose un ordre STRICT.
// Comme la bougie du CHoCH inscrit le meme indice dans chochIdx et dans bosIdx,
// l'inegalite stricte `bosIdx > chochIdx` force une SECONDE cassure, posterieure
// -- celle qui confirme reellement la nouvelle structure. Le BOS redevient une
// information distincte du CHoCH, et la sequence du cahier des charges est
// respectee au lieu d'etre seulement affichee.
//
// La fenetre hebdomadaire est remplacee par une FRAICHEUR en heures, desormais
// portee par son propre reglage sweepMaxAgeH et non plus empruntee a
// wzMaxAnchorAgeH. Effet de bord voulu : plus de point mort le lundi matin, ou
// les drapeaux repartaient tous de zero quel que soit ce que le marche venait
// de faire.
// seqMaxBars est declare ici et non plus sous les registres. AUCUN changement
// de valeur : il ne depend que de l'input sweepMaxAgeH et du timeframe, donc
// rien entre les deux positions ne l'influence. Il est remonte pour que
// l'instrumentation du bloc de registres puisse tester la peremption du sweep
// en REUTILISANT la formule du moteur au lieu d'en ecrire une seconde.
int seqMaxBars = math.max(1, int(sweepMaxAgeH * 3600 / timeframe.in_seconds()))
var int swpDnIdx   = na   // sell side prise -> prerequis d'un setup ACHAT
var int swpUpIdx   = na   // buy side prise  -> prerequis d'un setup VENTE
var int chochUpIdx = na
var int chochDnIdx = na
var int bosUpIdx   = na
var int bosDnIdx   = na

// FRAICHEUR DU SWEEP : un sweep est CONSOMME par le cycle qu'il a ouvert.
// Les six registres ci-dessus sont de simples "derniere occurrence" : rien
// n'invalidait jamais un sweep, et la chaine ne verifiait que l'ORDRE entre
// les trois valeurs les plus recentes. Un sweep pouvait donc valider un cycle
// ulterieur qui n'avait lui-meme pris aucune liquidite.
// Regle structurelle : au moment ou un CHoCH haussier survient, le dernier
// BOS haussier connu doit etre ANTERIEUR au sweep. S'il lui est posterieur,
// c'est que le sweep a deja produit son mouvement -- son energie est
// depensee, et ce CHoCH appartient a un nouveau cycle qui doit avoir son
// propre sweep.
// Aucun parametre, aucun seuil, aucune duree : la regle compte des EVENEMENTS
// structurels, elle est donc identique en M1, M3, M5 et M15 par construction.
var bool chochUpFresh = false
var bool chochDnFresh = false
if barstate.isconfirmed
    if sweepDnBar
        // DEBUG : solder le sweep sortant AVANT que swpDnIdx soit ecrase.
        // S'il n'avait pas atteint le BOS, il est mort remplace.
        if not na(swpDnIdx) and not dbgCurBBos
            dbgSwBRepl += 1
            if not dbgCurBCh
                dbgSwBNoCh += 1
        swpDnIdx := bar_index
        dbgSwBTot  += 1
        // COTE DU BIAIS a l'instant du sweep. f_ctxAllow est la fonction du
        // gate de creation de zone : on lit le meme contexte que lui, on n'en
        // definit pas un second.
        if f_ctxAllow(true)
            dbgSwBSideOk += 1
        else
            dbgSwBSideKo += 1
        dbgCurBCh  := false
        dbgCurBBos := false
        dbgCurBChI := na
    if sweepUpBar
        if not na(swpUpIdx) and not dbgCurSBos
            dbgSwSRepl += 1
            if not dbgCurSCh
                dbgSwSNoCh += 1
        swpUpIdx := bar_index
        dbgSwSTot  += 1
        if f_ctxAllow(false)
            dbgSwSSideOk += 1
        else
            dbgSwSSideKo += 1
        dbgCurSCh  := false
        dbgCurSBos := false
        dbgCurSChI := na
    // ORDRE CRITIQUE : ce bloc s'execute AVANT l'ecriture de bosUpIdx/bosDnIdx
    // plus bas. bosUpIdx contient donc encore le BOS haussier PRECEDENT, ce
    // qui est exactement la valeur a comparer. Ne pas deplacer ces blocs.
    if bullChoch
        // evChPrevB : le CHoCH haussier PRECEDENT, capture avant ecrasement.
        // Lecture seule, a usage exclusif du debug evenementiel plus bas.
        int evChPrevB = chochUpIdx
        chochUpIdx := bar_index
        chochUpFresh := not na(swpDnIdx) and (na(bosUpIdx) or bosUpIdx < swpDnIdx)
        // --- DEBUG EVENEMENTIEL (aucune ecriture hors compteurs dbg*) -----
        // On est au seul instant ou les trois valeurs utiles coexistent :
        // swpDnIdx courant, bosUpIdx encore PRECEDENT, chochUpIdx precedent.
        dbgEvBTot += 1
        bool evOldB = not na(swpDnIdx) and (bar_index - swpDnIdx) > seqMaxBars
        if chochUpFresh
            if evOldB
                dbgEvBOkO += 1
        else
            dbgEvBKo += 1
            if na(swpDnIdx)
                dbgEvBKoN += 1
            else
                dbgEvBKoB += 1
                // LE POINT DECISIF. Le proxy refuse parce qu'un BOS haussier
                // est posterieur au sweep. Mais un BOS peut survenir sans
                // qu'aucun CHoCH ne l'ait precede depuis le sweep (simple
                // continuation quand trend valait deja 1). dbgCurBBos dit si
                // la chaine sweep -> CHoCH -> BOS a VRAIMENT ete parcourue.
                if dbgCurBBos
                    dbgEvBKoT += 1
                else
                    dbgEvBKoF += 1
            if evOldB
                dbgEvBKoO += 1
        // CHAINE DEJA COMPLETE pour le sweep courant : le CHoCH precedent est
        // posterieur au sweep, et un BOS lui est posterieur. C'est exactement
        // le discriminant que testerait un sweep "consomme", mesure ici SANS
        // creer d'etat ni changer un comportement. BORNE BASSE ASSUMEE : si
        // une chaine complete a ete suivie d'un autre CHoCH sans BOS,
        // chochUpIdx a ete ecrase et le cas n'est plus visible.
        if not na(swpDnIdx) and not na(evChPrevB) and evChPrevB > swpDnIdx and not na(bosUpIdx) and bosUpIdx > evChPrevB
            dbgEvBDone += 1
        // PROGRESSION DU SWEEP COURANT : premier CHoCH strictement posterieur
        // au sweep. Strict comme f_seqChoch (ch > sw) : un CHoCH sur la bougie
        // meme du sweep ne compte pas, exactement comme dans le moteur.
        if not na(swpDnIdx) and bar_index > swpDnIdx and not dbgCurBCh
            dbgCurBCh  := true
            dbgCurBChI := bar_index
            dbgSwBCh   += 1
            if (bar_index - swpDnIdx) > seqMaxBars
                dbgSwBChOld += 1
    if bearChoch
        int evChPrevS = chochDnIdx
        chochDnIdx := bar_index
        chochDnFresh := not na(swpUpIdx) and (na(bosDnIdx) or bosDnIdx < swpUpIdx)
        dbgEvSTot += 1
        bool evOldS = not na(swpUpIdx) and (bar_index - swpUpIdx) > seqMaxBars
        if chochDnFresh
            if evOldS
                dbgEvSOkO += 1
        else
            dbgEvSKo += 1
            if na(swpUpIdx)
                dbgEvSKoN += 1
            else
                dbgEvSKoB += 1
                if dbgCurSBos
                    dbgEvSKoT += 1
                else
                    dbgEvSKoF += 1
            if evOldS
                dbgEvSKoO += 1
        if not na(swpUpIdx) and not na(evChPrevS) and evChPrevS > swpUpIdx and not na(bosDnIdx) and bosDnIdx > evChPrevS
            dbgEvSDone += 1
        if not na(swpUpIdx) and bar_index > swpUpIdx and not dbgCurSCh
            dbgCurSCh  := true
            dbgCurSChI := bar_index
            dbgSwSCh   += 1
            if (bar_index - swpUpIdx) > seqMaxBars
                dbgSwSChOld += 1
    if bullBos
        bosUpIdx := bar_index
        // Cloture de la chaine du sweep courant. Strict comme f_seqBos
        // (bo > ch) : la bougie de CHoCH allume aussi bullBos, elle ne peut
        // donc pas se confirmer elle-meme.
        if dbgCurBCh and not dbgCurBBos and not na(dbgCurBChI) and bar_index > dbgCurBChI
            dbgCurBBos := true
            dbgSwBBos  += 1
    if bearBos
        bosDnIdx := bar_index
        if dbgCurSCh and not dbgCurSBos and not na(dbgCurSChI) and bar_index > dbgCurSChI
            dbgCurSBos := true
            dbgSwSBos  += 1

f_seqSweep(bool isBuy) =>
    int sw = isBuy ? swpDnIdx : swpUpIdx
    not na(sw) and (bar_index - sw) <= seqMaxBars
f_seqChoch(bool isBuy) =>
    int sw = isBuy ? swpDnIdx : swpUpIdx
    int ch = isBuy ? chochUpIdx : chochDnIdx
    f_seqSweep(isBuy) and not na(ch) and ch > sw and (isBuy ? chochUpFresh : chochDnFresh)
f_seqBos(bool isBuy) =>
    int ch = isBuy ? chochUpIdx : chochDnIdx
    int bo = isBuy ? bosUpIdx : bosDnIdx
    f_seqChoch(isBuy) and not na(bo) and bo > ch

// --- DEBUG : la chaine Sweep -> CHoCH -> BOS ----------------------------
// Les sequences completes sont comptees en TRANSITION (faux -> vrai) et non
// par bougie : sans cela, une chaine valide pendant 300 bougies compterait 300
// fois. dbgBars est incremente ici, il sert de denominateur a tout le tableau.
var bool dbgPrevB = false
var bool dbgPrevS = false
if barstate.isconfirmed
    dbgBars += 1
    if bullChoch or bearChoch
        if f_seqSweep(bullChoch)
            dbgSeqSC += 1
    if bullBos or bearBos
        int chX = bullBos ? chochUpIdx : chochDnIdx
        if not na(chX) and chX < bar_index
            dbgSeqCB += 1
    bool fB = f_seqBos(true)
    bool fS = f_seqBos(false)
    if fB and not dbgPrevB
        dbgSeqFull += 1
    if fS and not dbgPrevS
        dbgSeqFull += 1
    dbgPrevB := fB
    dbgPrevS := fS

    // --- DEBUG : la chaine, VENTILEE PAR DIRECTION ----------------------
    // La chaine BUY ne lit que swpDnIdx / chochUpIdx / bosUpIdx /
    // chochUpFresh. La chaine SELL ne lit que swpUpIdx / chochDnIdx /
    // bosDnIdx / chochDnFresh. Les deux registres ne se croisent jamais.
    // Les trois premiers compteurs de chaque sens sont EXCLUSIFS : chaque
    // bougie confirmee tombe dans exactement un de absent / perime / frais,
    // donc leur somme vaut dbgBars pour chaque sens. C'est le controle de
    // coherence de cette section.
    if na(swpDnIdx)
        dbgBuySwNone += 1
    else if (bar_index - swpDnIdx) > seqMaxBars
        dbgBuySwOld += 1
    else
        dbgBuySwOk += 1
        if not na(chochUpIdx) and chochUpIdx > swpDnIdx
            if chochUpFresh
                dbgBuyFreshOk += 1
            else
                dbgBuyFreshKo += 1
    if fB
        dbgBuyBosOk += 1
    if na(swpUpIdx)
        dbgSellSwNone += 1
    else if (bar_index - swpUpIdx) > seqMaxBars
        dbgSellSwOld += 1
    else
        dbgSellSwOk += 1
        if not na(chochDnIdx) and chochDnIdx > swpUpIdx
            if chochDnFresh
                dbgSellFreshOk += 1
            else
                dbgSellFreshKo += 1
    if fS
        dbgSellBosOk += 1

// ---- IMPULSION DU BOS : la plage sur laquelle le Fibonacci est calcule ----
// Le module existant appelait "fib" un test a 50 % sur le haut/bas de la
// SEMAINE precedente. C'est une mesure de premium/discount du dealing range,
// pas un retracement d'impulsion -- et sur une meme plage, "fib 50 %" et
// "premium/discount" sont litteralement le meme nombre. Les compter tous les
// deux serait une redondance pure.
// On garde donc l'ancien test tel quel pour le PREMIUM/DISCOUNT (plage
// hebdomadaire), et on calcule le Fibonacci sur une plage DIFFERENTE :
// l'impulsion qui a produit le BOS. Deux plages, deux informations.
//
// BUY  : bas = dernier swing low confirme (le creux d'apres le sweep)
//        haut = plus haut atteint depuis ce creux (le sommet de l'impulsion)
// SELL : miroir.
// Anti-repaint : ancre sur des pivots CONFIRMES (ta.pivotlow/high, decalage
// fixe de swingLen) ; l'extreme court ne fait que progresser, il ne revient
// jamais en arriere sur une bougie deja fermee.
var float impLo = na
var float impHi = na
if not na(pl)
    impLo := pl
    impHi := high
else if not na(impLo)
    impHi := na(impHi) ? high : math.max(impHi, high)

var float impHiS = na
var float impLoS = na
if not na(ph)
    impHiS := ph
    impLoS := low
else if not na(impHiS)
    impLoS := na(impLoS) ? low : math.min(impLoS, low)

// Etat du retracement pour un niveau donne : 1 VALID, 0 NEUTRAL, -1 INVALID.
// VALID   = 0.50 a 0.786 -- la poche ou FVG et OB tombent le plus souvent.
// NEUTRAL = 0.382-0.50 et 0.786-0.886 : plausible, sans confluence marquee.
// INVALID = moins de 0.382 (entree trop haute, aucun escompte) ou plus de
//           0.886 (l'impulsion est quasi entierement effacee).
// Volontairement une BANDE et non le point 61.8 exact : exiger le niveau au
// tick pres rejetterait presque tous les setups.
f_fibRetr(bool isBuy, float lvl) =>
    float hi = isBuy ? impHi : impHiS
    float lo = isBuy ? impLo : impLoS
    not na(hi) and not na(lo) and hi > lo and not na(lvl) ? (isBuy ? (hi - lvl) / (hi - lo) : (lvl - lo) / (hi - lo)) : na

f_fibState(bool isBuy, float lvl) =>
    float hi = isBuy ? impHi : impHiS
    float lo = isBuy ? impLo : impLoS
    int st = 0
    if not na(hi) and not na(lo) and hi > lo and not na(lvl)
        float r = isBuy ? (hi - lvl) / (hi - lo) : (lvl - lo) / (hi - lo)
        st := r >= 0.50 and r <= 0.786 ? 1 : (r >= 0.382 and r < 0.50) or (r > 0.786 and r <= 0.886) ? 0 : -1
    st


if newWeek
    // ---- Profil de la semaine ECOULEE : POC, Value Area, noeud de volume ----
    if array.size(wPx) > 20
        float lo = array.min(wPx)
        float hi = array.max(wPx)
        if hi > lo
            float st = (hi - lo) / wzBins
            array<float> acc = array.new<float>(wzBins, 0.0)
            for i = 0 to array.size(wPx) - 1
                int k = math.min(wzBins - 1, math.max(0, int((array.get(wPx, i) - lo) / st)))
                array.set(acc, k, array.get(acc, k) + array.get(wVol, i))
            float mx = array.max(acc)
            int kP = array.indexof(acc, mx)
            float tot = array.sum(acc)
            wPoc := lo + (kP + 0.5) * st
            int a1 = kP
            int b1 = kP
            float cum = mx
            while cum < tot * wzVaPct / 100.0 and (a1 > 0 or b1 < wzBins - 1)
                float u = b1 < wzBins - 1 ? array.get(acc, b1 + 1) : -1.0
                float d = a1 > 0 ? array.get(acc, a1 - 1) : -1.0
                if u >= d and b1 < wzBins - 1
                    b1 += 1
                    cum += u
                else if a1 > 0
                    a1 -= 1
                    cum += d
                else
                    break
            wVah := lo + (b1 + 1) * st
            wVal := lo + a1 * st
            // Noeuds de volume hors Value Area : le HVN bas sert aux zones
            // d'achat, le HVN haut aux zones de vente.
            float mLo = -1.0
            int   iLo = -1
            float mHi = -1.0
            int   iHi = -1
            for k = 0 to wzBins - 1
                float w = array.get(acc, k)
                if k < a1 and w > mLo
                    mLo := w
                    iLo := k
                if k > b1 and w > mHi
                    mHi := w
                    iHi := k
            wHvnLo := iLo >= 0 ? lo + (iLo + 0.5) * st : na
            wHvnHi := iHi >= 0 ? lo + (iHi + 0.5) * st : na
    wHiPrev := wHi
    wLoPrev := wLo
    array.clear(wPx)
    array.clear(wVol)
    wHi := high
    wLo := low
else
    wHi := na(wHi) ? high : math.max(wHi, high)
    wLo := na(wLo) ? low  : math.min(wLo, low)
array.push(wPx, hl2)
array.push(wVol, na(volume) ? 1.0 : volume)

// Biais hebdomadaire, lu sur la semaine CLOTUREE.
wBias := biasBull ? 1 : biasBear ? -1 : 0

// ---- Construction des zones : confluence Order Block x FVG ----------------
// CHANGEMENT DE DECLENCHEUR (affichage uniquement, explique ci-dessous).
//
// AVANT : `if newWeek` -- la zone ne pouvait naitre QU'A la bascule de semaine,
// ancree sur la Value Area hebdomadaire. Sur ~480 bougies M15 par semaine, le
// moteur n'avait donc qu'UNE occasion de creer une zone ; si a cet instant
// precis fibOk + reacted + contexte + score >= seuil n'etaient pas tous vrais
// simultanement, il n'existait aucune zone pendant toute la semaine. C'est la
// raison pour laquelle le panneau affichait "BUY Zone —" et "SELL Zone —" en
// permanence sur M1, M5 et M15 : il n'y avait rien a styliser, le probleme
// n'etait pas visuel.
//
// MAINTENANT : evaluation a CHAQUE bougie cloturee, et la zone naît de la
// confluence reelle Order Block x FVG. Ses bornes sont l'INTERSECTION des deux
// boites -- compacte par construction, et posee exactement la ou le prix est
// attendu pour l'execution. Sans chevauchement OB/FVG, aucune zone n'est
// dessinee : mieux vaut ne rien montrer que relier deux objets sans rapport.
//
// CE BLOC NE TOUCHE AUCUN SIGNAL. Aucune variable de zone n'apparait dans
// alignLong / alignShort / trigLong / trigShort / rawLong / rawShort /
// buySignal / sellSignal, ni dans f_slRisk / f_qty / strategy.entry / exit.
// Anti-repaint : barstate.isconfirmed, et le score est fige a la creation.
bool isBuyBiasNow = biasDir >= 0

var bool   dgSweep = false
var bool   dgChoch = false
var bool   dgBos   = false
var bool   dgFvg   = false
var bool   dgOb    = false
var int    dgFib   = 0
var float  dgFibR  = na
var bool   dgHtf   = false
var bool   dgPd    = false
var float  dgScore = na
var string dgRej   = ""

if wzShow and barstate.isconfirmed and not na(atrV) and atrV > 0
    // Remise a zero du diagnostic : sans OB ou sans FVG on n'entre jamais dans
    // la boucle, et l'ecran garderait sinon l'etat d'un setup deja disparu.
    if isBuyBiasNow
        dgFvg := array.size(fvBT) > 0
        dgOb  := array.size(obBT) > 0
    else
        dgFvg := array.size(fvST) > 0
        dgOb  := array.size(obST) > 0
    // ---- COCHES DU PANNEAU : ETAT COURANT, PLUS DERNIER SUCCES ----------
    // dgSweep/dgChoch/dgBos/dgFib/dgFibR/dgHtf/dgPd n'etaient ecrits qu'au
    // bloc de fin, sous `if not na(zT)` -- c'est-a-dire UNIQUEMENT quand
    // l'appariement OB x FVG avait abouti. Comme cela n'arrive presque jamais,
    // ces `var` conservaient un instantane fige du dernier succes, parfois
    // vieux de milliers de bougies, pendant que dgRej, lui, etait recalcule a
    // chaque bougie. Le panneau melangeait donc deux horloges : cinq coches
    // decrivant le passe, un statut decrivant l'instant.
    //
    // On reinitialise ici, dans le bloc deja recalcule a chaque bougie
    // confirmee, avec EXACTEMENT les fonctions que le gate utilise --
    // f_seqSweep/f_seqChoch/f_seqBos sont litteralement ce que cSweep/cChoch/
    // cBos valent plus bas, et f_ctxAllow est celle du gate. Aucune detection
    // nouvelle, aucune logique parallele.
    //
    // FIB et PREMIUM/DISCOUNT font exception, et c'est une limite reelle :
    // f_fibState et fibOk portent sur les bornes zT/zB d'une zone CANDIDATE.
    // Sans candidat elles n'ont pas de valeur, et en fabriquer une sur un
    // autre support serait precisement la logique parallele a eviter. Elles
    // sont donc remises a "non evalue" -- dgFib = -1 affiche un tiret. Le bloc
    // de fin les renseigne ensuite, sur la MEME bougie, si un candidat existe.
    dgSweep := f_seqSweep(isBuyBiasNow)
    dgChoch := f_seqChoch(isBuyBiasNow)
    dgBos   := f_seqBos(isBuyBiasNow)
    dgHtf   := f_ctxAllow(isBuyBiasNow)
    dgFib   := -1
    dgFibR  := na
    dgPd    := false
    // ---- DIAGNOSTIC : HIERARCHIE UNIQUE, NIVEAUX 1 A 5 ------------------
    // Le statut etait ecrit a trois endroits sans ordre de priorite, et les
    // deux premiers masquaient le troisieme : la chaine structurelle
    // (SWEEP/CHOCH/BOS) n'etait evaluee QUE si l'appariement OB x FVG avait
    // reussi, puisqu'elle vivait dans `if not na(zT)`. Un sweep absent restait
    // donc invisible des que l'appariement echouait.
    //
    // f_seqSweep / f_seqChoch / f_seqBos ne lisent que des index persistants
    // -- swpDnIdx, chochUpIdx, bosUpIdx, tous figes bien avant ce point. Les
    // appeler ici rend EXACTEMENT les memes valeurs que cSweep/cChoch/cBos
    // plus bas : aucune regle n'est dupliquee, seule la LECTURE est avancee.
    // Rien de ce bloc n'est lu par une condition de creation de zone.
    //
    // Effet de bord voulu : quand chochUpIdx vaut na, f_seqChoch est faux et
    // "CHOCH MANQUANT" se declenche ICI. Le statut "OB HORS DU CYCLE COURANT",
    // qui exige lui aussi un CHoCH, ne peut donc plus etre affiche a sa place.
    // ---- ETATS EXPLICITES DU SWEEP ET DE LA STRUCTURE -------------------
    // f_seqSweep melange DEUX notions -- l'EXISTENCE du sweep et sa FRAICHEUR
    // temporelle -- et ne permet donc pas de dire laquelle des deux bloque.
    // L'echelle les separe en lisant directement les registres. Ces variables
    // ne sont consultees QUE par le statut : aucune condition de creation de
    // zone ne les lit.
    //
    // EQUIVALENCE PROUVEE, et c'est ce qui garantit qu'aucun refus ne reste
    // sans message : l'echelle atteint "" si et seulement si
    //   na(dSw) faux ET (bar_index-dSw) <= seqMaxBars   ==  f_seqSweep
    //   ET not na(dCh) ET dCh > dSw ET dSwFresh         ==  f_seqChoch
    //   ET not na(dBo) ET dBo > dCh                     ==  f_seqBos
    //   ET dgOb ET dgFvg
    // soit exactement les conditions testees plus bas. Aucune divergence
    // possible entre le diagnostic et le moteur.
    //
    // ORDRE : "SWEEP HORS CYCLE" ne peut PAS etre teste avant l'existence du
    // CHoCH. chochUpFresh est une propriete DU CHoCH, evaluee au moment ou il
    // survient ; tant qu'aucun CHoCH n'a eu lieu elle vaut false par
    // initialisation, et l'afficher alors ferait exactement l'erreur que
    // l'etape precedente a corrigee. Il est donc place apres CHOCH MANQUANT et
    // CHOCH HORS SEQUENCE, seule position ou il est vrai.
    int  dSw = isBuyBiasNow ? swpDnIdx : swpUpIdx
    int  dCh = isBuyBiasNow ? chochUpIdx : chochDnIdx
    int  dBo = isBuyBiasNow ? bosUpIdx : bosDnIdx
    bool dSwFresh = isBuyBiasNow ? chochUpFresh : chochDnFresh
    dgRej := na(dSw) ? "SWEEP MANQUANT" : (bar_index - dSw) > seqMaxBars ? "SWEEP PERIME" : na(dCh) ? "CHOCH MANQUANT" : dCh <= dSw ? "CHOCH HORS SEQUENCE" : not dSwFresh ? "SWEEP HORS CYCLE" : na(dBo) ? "BOS MANQUANT" : dBo <= dCh ? "BOS HORS SEQUENCE" : not dgOb ? "OB MANQUANT" : not dgFvg ? "FVG MANQUANT" : ""
    if dgRej != ""
        dgScore := na
    // ---- REFERENCE PREMIUM / DISCOUNT : STRUCTURELLE, PLUS CALENDAIRE ----
    // Le gate combine DEUX tests Fibonacci qui, en ICT, sont legitimement
    // distincts et n'ont pas la meme reference :
    //   fibNotInvalid -> RETRACEMENT, mesure sur l'IMPULSION (impHi/impLo) ;
    //   fibOk         -> PREMIUM/DISCOUNT, mesure sur le DEALING RANGE.
    // Avoir deux references n'est donc pas l'erreur. L'erreur etait que la
    // seconde etait CALENDAIRE : rgLo/rgHi valaient le bas et le haut de la
    // SEMAINE PRECEDENTE (repli sur la Value Area), un decoupage sans aucun
    // rapport avec le cycle structurel en cours -- exactement la classe de
    // probleme corrigee partout ailleurs dans cette chaine.
    // Pathologie concrete : dans une semaine fortement directionnelle, le prix
    // reste des jours au-dessus du milieu de la semaine ecoulee, `zB <= mid`
    // est faux pour TOUTE zone d'achat, et le cote acheteur se trouve bloque
    // par une date plutot que par la structure.
    // swingLow/swingHigh sont les deux derniers pivots CONFIRMES : c'est la
    // definition meme du dealing range, la reference deja utilisee par le BOS,
    // non repeinte, et coherente d'une unite de temps a l'autre. Aucun nouveau
    // parametre.
    // La garde rgHi > rgLo couvre le cas degenere ou le dernier pivot haut
    // serait sous le dernier pivot bas ; mid vaut alors na et le test passe,
    // comme il le faisait deja quand la semaine precedente etait indisponible.
    float rgLo = swingLow
    float rgHi = swingHigh
    float mid  = na(rgHi) or na(rgLo) or rgHi <= rgLo ? na : (rgHi + rgLo) / 2.0

    for side = 0 to 1
        bool isBuy = side == 0
        int want = isBuy ? 1 : -1
        int nOb = isBuy ? array.size(obBT) : array.size(obST)
        int nFv = isBuy ? array.size(fvBT) : array.size(fvST)
        if nOb > 0 and nFv > 0
            float obT = isBuy ? array.get(obBT, 0) : array.get(obST, 0)
            float obB = isBuy ? array.get(obBB, 0) : array.get(obSB, 0)
            int   obX = isBuy ? array.get(obBX, 0) : array.get(obSX, 0)
            // ---- APPARTENANCE AU MEME CYCLE STRUCTUREL ----------------------
            // La chaine cSweep/cChoch/cBos ne verifiait l'ordre QU'ENTRE ses
            // trois index. L'Order Block et le FVG, eux, n'etaient compares a
            // aucun d'eux : le moteur pouvait valider une chaine
            // sweep@100 < choch@120 < bos@300 tout en appariant un OB ne vers
            // la bougie 130 et un FVG de la 140, donc un cycle anterieur.
            //
            // L'ancre retenue est obBCr, la bougie de l'EVENEMENT STRUCTUREL
            // qui a cree l'OB -- a ne pas confondre avec obBX, qui est sa
            // bougie SOURCE. bosUpIdx ne peut pas servir d'ancre : il avance a
            // chaque micro-BOS, y compris ceux que les trois verrous rejettent
            // pour la creation d'OB, et c'est precisement cette derive qui
            // produit la fausse confluence.
            //
            //   1. obCr >= chIdx  : l'OB est ne DANS la chaine, pas avant elle.
            //   2. pvIdx <= obCr  : aucun pivot oppose confirme depuis, donc
            //      aucun nouveau cycle n'a commence -- meme invariant que celui
            //      qui gouverne deja la creation des Order Blocks.
            //   3. fX >= obX      : le FVG appartient a l'impulsion de l'OB
            //      (teste dans la boucle d'appariement plus bas).
            //
            // L'ordre entre OB/FVG et BOS n'est JAMAIS impose : seule
            // l'appartenance au cycle l'est. Trois comparaisons d'entiers,
            // aucun nouveau parametre, aucun seuil.
            int  obCr  = isBuy ? array.get(obBCr, 0) : array.get(obSCr, 0)
            int  chIdx = isBuy ? chochUpIdx : chochDnIdx
            int  pvIdx = isBuy ? lastPlIdx : lastPhIdx
            bool obSameCycle = not na(obCr) and not na(chIdx) and obCr >= chIdx and (na(pvIdx) or pvIdx <= obCr)
            // DEBUG : taux de base, sur le seul cote du biais courant pour
            // rester comparable aux compteurs de motif. Le bloc englobant
            // porte deja barstate.isconfirmed.
            if isBuy == isBuyBiasNow
                dbgOsTot += 1
                if obSameCycle
                    dbgOsOk += 1

            // ---- APPARIEMENT ORDER BLOCK <-> FVG -------------------------
            // La version precedente exigeait un CHEVAUCHEMENT STRICT
            // (intersection non vide). Or dans une impulsion haussiere, l'Order
            // Block est la derniere bougie baissiere AVANT le mouvement et le
            // FVG est le gap CREE PAR ce mouvement : ils sont typiquement
            // EMPILES, pas superposes. Exiger l'intersection eliminait donc la
            // configuration ICT normale -- c'etait le second verrou apres le
            // bug du sweep.
            //
            // Desormais les deux doivent seulement etre PROCHES, et la zone est
            // leur UNION : une seule zone qui fusionne les deux, comme demande.
            // Deux garde-fous contre les zones enormes :
            //   - wzPairGapAtr : ecart maximum entre les deux boites ;
            //   - wzMaxHeightAtr : hauteur maximale de l'union. Au-dela, la
            //     paire est REJETEE plutot que dessinee trop large -- mieux
            //     vaut aucune zone qu'une zone imprecise.
            // Parmi tous les FVG candidats, on retient celui qui donne l'union
            // la PLUS SERREE (auparavant : le premier trouve, arbitraire).
            float zT = na
            float zB = na
            int   zX = na
            float bestH = na
            // Vrai des qu'un FVG au moins appartient a l'impulsion de l'OB.
            // Sert UNIQUEMENT a distinguer, dans le diagnostic, "FVG hors du
            // cycle" de "OB et FVG trop eloignes". N'entre dans aucune
            // condition d'appariement ni de creation.
            bool anyFvCycle = false
            for j = 0 to nFv - 1
                float fT = isBuy ? array.get(fvBT, j) : array.get(fvST, j)
                float fB = isBuy ? array.get(fvBB, j) : array.get(fvSB, j)
                int   fX = isBuy ? array.get(fvBX, j) : array.get(fvSX, j)
                // Ecart entre les deux boites, nul si elles se chevauchent.
                float gap = math.max(0.0, math.max(obB - fT, fB - obT))
                float uT  = math.max(obT, fT)
                float uB  = math.min(obB, fB)
                float uH  = uT - uB
                if fX >= obX
                    anyFvCycle := true
                if obSameCycle and fX >= obX and gap <= atrV * wzPairGapAtr and uH <= atrV * wzMaxHeightAtr
                    if na(bestH) or uH < bestH
                        bestH := uH
                        zT := uT
                        zB := uB
                        zX := math.min(obX, fX)

            // Diagnostic : OB et FVG presents mais jamais appariables.
            // NIVEAUX 6 A 8. La garde `dgRej == ""` est ce qui rend la
            // hierarchie stricte : si la structure ou la presence d'un OB/FVG
            // bloquait deja, ce statut-ci ne peut plus recouvrir le vrai motif.
            if na(zT) and isBuy == isBuyBiasNow and dgRej == ""
                dgRej := not obSameCycle ? "OB HORS DU CYCLE COURANT" : not anyFvCycle ? "FVG HORS DU CYCLE COURANT" : "OB ET FVG TROP ELOIGNES"
                dgScore := na
                // DEBUG : ventilation exacte du motif OB HORS DU CYCLE
                // COURANT. Place ICI et non au calcul de obSameCycle, pour que
                // la somme egale dgcObCyc exactement -- meme garde, meme
                // hierarchie, meme instant.
                if not obSameCycle
                    if na(obCr) or na(chIdx)
                        dbgOsNa += 1
                    else
                        bool fCh = obCr < chIdx
                        bool fPv = not na(pvIdx) and pvIdx > obCr
                        if fCh
                            dbgOsCh += 1
                        if fPv
                            dbgOsPv += 1
                        if fCh and fPv
                            dbgOsBoth += 1

            if not na(zT)
                // Epaisseur plancher : une union de quelques ticks
                // serait invisible a l'ecran. wzWidthAtr sert desormais de
                // MINIMUM, plus de largeur imposee.
                float minH = atrV * wzWidthAtr * 0.25
                if zT - zB < minH
                    float ctr = (zT + zB) / 2.0
                    zT := ctr + minH / 2.0
                    zB := ctr - minH / 2.0

                // ---- SCORE DE CONFLUENCE, fige ici et jamais recalcule ------
                // 30 — Volume Profile : la zone tombe dans la Value Area.
                // 30 / 15 / 0 au lieu de 30 / 0. La version tout-ou-rien
                // creait une falaise : une zone a un tick SOUS la VAL marquait
                // 0, la meme zone a un tick au-dessus marquait 30. Ce n'est pas
                // une distinction reelle. Pire, elle rendait le seuil quasi
                // inatteignable : le gate fibOk pousse la zone dans la moitie
                // DISCOUNT de la semaine, donc souvent sous la VAL, et sans ces
                // 30 points le maximum possible tombait a 25+20+15+10 = 70,
                // c'est-a-dire EXACTEMENT le seuil -- il fallait la perfection
                // sur les quatre autres composantes ou rien.
                // Le palier intermediaire recompense le CHEVAUCHEMENT de la
                // Value Area, qui est une condition plus faible mais reelle.
                // ---- FALAISE DE SCORE : PALIER INTERMEDIAIRE SUR sVp ----
                // Arithmetique du probleme : sSt 25 + sLq 20 + sSmc 15 + sMtf 10
                // font exactement 70, soit wzMinScore. Des que sVp vaut 0, le
                // maximum atteignable EGALE le seuil : la zone doit alors etre
                // parfaite sur les quatre autres criteres simultanement, et le
                // moindre manque la tue. Ce n'est pas un choix de conception,
                // c'est une coincidence d'addition que rien ne signalait.
                //
                // sVp est aussi la composante la plus lourde ET la seule
                // calculee sur un artefact de CALENDRIER : wVal/wVah sont la
                // Value Area de la SEMAINE PRECEDENTE. Une zone se retrouvait
                // donc sans marge selon sa position dans le range hebdomadaire,
                // pas selon la qualite du setup -- meme defaut que celui
                // corrige sur premium/discount.
                //
                // Un palier est ajoute entre "chevauche la Value Area" et
                // "dehors" : la zone est hors du noeud de volume mais reste
                // DANS le range de la semaine ecoulee, donc en territoire
                // effectivement negocie. Le maximum passe alors a 77 et la
                // marge revient. Le cas a 0 subsiste pour une zone hors du
                // range hebdomadaire entier -- situation extreme, ou l'absence
                // de marge se defend.
                //
                // wHiPrev/wLoPrev etaient deja calcules et sont devenus
                // inutilises depuis que premium/discount est passe au dealing
                // range structurel : aucun calcul nouveau.
                //
                // A DIRE CLAIREMENT : la valeur 7 n'est PAS mesuree. Elle
                // reprend le palier intermediaire de sSmc (15/7/0), seule
                // convention deja presente dans le fichier. Le couple
                // ponderations/seuil n'a jamais ete valide ensemble, et ce
                // commit ne le valide pas davantage -- il supprime seulement
                // une falaise que personne n'avait voulue.
                float sVp = 0.0
                if not na(wVal) and not na(wVah)
                    bool vaIn   = zB >= wVal and zT <= wVah
                    bool vaOver = zT >= wVal and zB <= wVah
                    bool wkIn   = not na(wHiPrev) and not na(wLoPrev) and zT <= wHiPrev and zB >= wLoPrev
                    sVp := vaIn ? 30.0 : vaOver ? 15.0 : wkIn ? 7.0 : 0.0
                // 25 — Structure alignee.
                float sSt = (isBuy ? trend == 1 : trend == -1) ? 25.0 : 0.0
                // 20 — Liquidite non prise AU-DELA de la zone.
                float sLq = 0.0
                if isBuy and array.size(eqlL) > 0
                    for i = 0 to array.size(eqlL) - 1
                        if array.get(eqlL, i) < zB
                            sLq := 20.0
                            break
                if not isBuy and array.size(eqhL) > 0
                    for i = 0 to array.size(eqhL) - 1
                        if array.get(eqhL, i) > zT
                            sLq := 20.0
                            break
                // 15 — FIBONACCI de l'impulsion du BOS, mesure au niveau
                //      d'execution de la zone (haut pour un achat, bas pour une
                //      vente). Ces 15 points etaient auparavant "Zone SMC" -- une
                //      CONSTANTE depuis que la zone EST l'union OB x FVG :
                //      15 points toujours accordes, qui ne discriminaient donc
                //      jamais rien. Ils sont reaffectes ici a une mesure qui,
                //      elle, varie. L'echelle reste sur 100, sans inflation.
                int fibSt = f_fibState(isBuy, isBuy ? zT : zB)
                float sSmc = fibSt == 1 ? 15.0 : fibSt == 0 ? 7.0 : 0.0
                // 10 — Multi-timeframe.
                float sMtf = ((dirD == want ? 1 : 0) + (dirH4 == want ? 1 : 0) + (dirH1 == want ? 1 : 0)) / 3.0 * 10.0
                float score = sVp + sSt + sLq + sSmc + sMtf

                // Discount pour acheter, premium pour vendre.
                bool fibOk = na(mid) or (isBuy ? zB <= mid : zT >= mid)

                // UNE seule zone par cote, remplacee uniquement par MEILLEURE.
                int exI = -1
                if array.size(zSide) > 0
                    for q = 0 to array.size(zSide) - 1
                        if array.get(zSide, q) == want
                            exI := q
                bool same   = exI >= 0 and array.get(zTop, exI) == zT and array.get(zBot, exI) == zB
                bool better = exI < 0 or score > array.get(zScr, exI)

                // ---- LES TROIS CONFIRMATIONS OBLIGATOIRES ------------------
                // Repond directement aux TEST 2/3/4 : jusqu'ici le gate ne
                // contenait NI sweep, NI CHoCH, NI BOS -- une zone pouvait donc
                // naitre sans aucun des trois. Desormais les trois sont exiges,
                // dans le bon sens :
                //   BUY  : sell side liquidity sweepee + CHoCH haussier + BOS haussier
                //   SELL : buy side liquidity sweepee + CHoCH baissier + BOS baissier
                // Ces trois drapeaux sont hebdomadaires et derivent de pivots
                // CONFIRMES (+ trend garde par barstate.isconfirmed) : aucun
                // lookahead, aucun repaint.
                bool cSweep = f_seqSweep(isBuy)
                bool cChoch = f_seqChoch(isBuy)
                bool cBos   = f_seqBos(isBuy)
                // FIB INVALID rejette : c'est la definition meme de INVALID
                // ("le prix est dans une zone de retracement incompatible").
                // NEUTRAL passe, avec moins de points -- le Fibonacci ameliore
                // la selection, il ne bloque pas tout.
                bool fibNotInvalid = fibSt >= 0

                // ---- DIAGNOSTIC : etat de chaque condition + raison du refus --
                // Renseigne pour le cote qui correspond au biais affiche, afin
                // que le panneau puisse expliquer POURQUOI aucune zone n'existe.
                if isBuy == (biasDir >= 0)
                    dgSweep := cSweep
                    dgChoch := cChoch
                    dgBos   := cBos
                    dgFvg   := true
                    dgOb    := true
                    dgFib   := fibSt
                    dgFibR  := f_fibRetr(isBuy, isBuy ? zT : zB)
                    dgHtf   := f_ctxAllow(isBuy)
                    dgPd    := fibOk
                    dgScore := score
                    // NIVEAUX 9 A 14. Meme garde : ce statut n'ecrase jamais un motif
                    // de rang superieur.
                    // "ZONE DEJA AFFICHEE" ferme le dernier angle mort du
                    // diagnostic : le gate exige `better and not same`, alors que
                    // l'echelle ne couvrait que `not better`. Une zone de bornes
                    // STRICTEMENT IDENTIQUES mais de score superieur passait donc
                    // `better`, echouait sur `not same`, et le statut restait vide
                    // -- un refus sans message. Le cas est rare mais atteignable :
                    // les composantes du score bougent d'une bougie a l'autre alors
                    // que zT et zB, eux, peuvent ne pas changer.
                    // Il est place APRES "ZONE EXISTANTE MEILLEURE" : si le score
                    // est inferieur, c'est cette raison-la qui prime, que les bornes
                    // soient identiques ou non.
                    // de rang superieur. Les trois premieres branches sont desormais
                    // inatteignables ici -- si dgRej vaut "", la chaine est validee --
                    // mais elles sont conservees comme filet : en cas de divergence
                    // elles rendraient le bon motif plutot qu'un motif faux.
                    if dgRej == ""
                        dgRej := not cSweep ? "SWEEP MANQUANT" : not cChoch ? "CHOCH MANQUANT" : not cBos ? "BOS MANQUANT" : not fibNotInvalid ? "FIBONACCI INVALIDE" : not fibOk ? "CONFLIT PREMIUM/DISCOUNT" : not f_ctxAllow(isBuy) ? "CONTEXTE HTF OPPOSE" : score < wzMinScore ? "CONFLUENCE " + str.tostring(int(math.round(score))) + " < " + str.tostring(wzMinScore) : not better ? "ZONE EXISTANTE MEILLEURE" : same ? "ZONE DEJA AFFICHEE" : ""

                if cSweep and cChoch and cBos and fibNotInvalid and fibOk and f_ctxAllow(isBuy) and score >= wzMinScore and better and not same
                    dbgZone += 1
                    if exI >= 0
                        box.delete(array.get(zBox, exI))
                        label.delete(array.get(zLab, exI))
                        array.remove(zTop, exI)
                        array.remove(zBot, exI)
                        array.remove(zScr, exI)
                        array.remove(zSide, exI)
                        array.remove(zBar, exI)
                        array.remove(zSmcType, exI)
                        array.remove(zSmcTop, exI)
                        array.remove(zSmcBot, exI)
                        array.remove(zSmcBar, exI)
                        array.remove(zFibHi, exI)
                        array.remove(zFibLo, exI)
                        array.remove(zBox, exI)
                        array.remove(zLab, exI)
                    color bord = isBuy ? color.new(cUp, 25) : color.new(cDn, 25)
                    color fill = isBuy ? color.new(cUp, 90) : color.new(cDn, 90)
                    box   zb = box.new(f_xL(zX), zT, bar_index, zB, border_color=bord, border_width=2, bgcolor=fill)
                    label zl = label.new(bar_index, isBuy ? zB : zT, (isBuy ? "BUY ZONE  " : "SELL ZONE  ") + str.tostring(int(math.round(score))) + "/100", style=isBuy ? label.style_label_up : label.style_label_down, color=color.new(cBg, 100), textcolor=isBuy ? cUp : cDn, size=size.tiny)
                    array.push(zTop, zT)
                    array.push(zBot, zB)
                    array.push(zScr, score)
                    array.push(zSide, want)
                    array.push(zBar, zX)
                    array.push(zSmcType, 1)
                    array.push(zSmcTop, obT)
                    array.push(zSmcBot, obB)
                    array.push(zSmcBar, obX)
                    array.push(zFibHi, isBuy ? impHi : impHiS)
                    array.push(zFibLo, isBuy ? impLo : impLoS)
                    array.push(zBox, zb)
                    array.push(zLab, zl)

    // ---- COMPTAGE CUMULE DU MOTIF DE REFUS ------------------------------
    // Place APRES les trois points d'ecriture de dgRej et apres la boucle
    // `for side` : on compte donc la valeur FINALE, exactement celle que le
    // panneau affiche, ni avant ni apres. Le bloc englobant porte deja
    // barstate.isconfirmed.
    // Un seul compteur s'incremente par bougie : la somme des 19 vaut le
    // nombre de bougies confirmees ou le moteur a tourne. Si elle ne boucle
    // pas, c'est l'instrumentation qu'il faut corriger, pas le moteur.
    if dgRej == "SWEEP MANQUANT"
        dgcSwMiss += 1
    else if dgRej == "SWEEP PERIME"
        dgcSwOld += 1
    else if dgRej == "SWEEP HORS CYCLE"
        dgcSwCyc += 1
    else if dgRej == "CHOCH MANQUANT"
        dgcChMiss += 1
    else if dgRej == "CHOCH HORS SEQUENCE"
        dgcChSeq += 1
    else if dgRej == "BOS MANQUANT"
        dgcBoMiss += 1
    else if dgRej == "BOS HORS SEQUENCE"
        dgcBoSeq += 1
    else if dgRej == "OB MANQUANT"
        dgcObMiss += 1
    else if dgRej == "FVG MANQUANT"
        dgcFvMiss += 1
    else if dgRej == "OB HORS DU CYCLE COURANT"
        dgcObCyc += 1
    else if dgRej == "FVG HORS DU CYCLE COURANT"
        dgcFvCyc += 1
    else if dgRej == "OB ET FVG TROP ELOIGNES"
        dgcFar += 1
    else if dgRej == "FIBONACCI INVALIDE"
        dgcFib += 1
    else if dgRej == "CONFLIT PREMIUM/DISCOUNT"
        dgcPd += 1
    else if dgRej == "CONTEXTE HTF OPPOSE"
        dgcHtf += 1
    else if str.startswith(dgRej, "CONFLUENCE")
        dgcScore += 1
    else if dgRej == "ZONE EXISTANTE MEILLEURE"
        dgcBetter += 1
    else if dgRej == "ZONE DEJA AFFICHEE"
        dgcSame += 1
    else
        dgcOk += 1
    while array.size(zScr) > wzMax * 2
        box.delete(array.shift(zBox))
        label.delete(array.shift(zLab))
        array.shift(zTop)
        array.shift(zBot)
        array.shift(zScr)
        array.shift(zSide)
        array.shift(zBar)
        array.shift(zSmcType)
        array.shift(zSmcTop)
        array.shift(zSmcBot)
        array.shift(zSmcBar)
        array.shift(zFibHi)
        array.shift(zFibLo)

// ---- INVALIDATION CONTINUE DES ZONES ----------------------------------
// Regle : une condition n'invalide QUE si elle etait vraie — ou garantie —
// au moment de la creation, et qu'un evenement post-creation la rend fausse.
// Rien n'est juge sur un standard qu'il n'a jamais eu a respecter.
//   CONSOMMEE — le prix l'a traversee de part en part : le desequilibre a ete
//               absorbe, il n'y a plus rien a y chercher.
//   CASSEE    — le prix a cloture au-dela de la zone, dans le mauvais sens.
//   OB/FVG    — l'element SMC precis qui a donne les 15 points a disparu
//               (mitige ou trop vieux) : verifiable, puisque sa presence a
//               ete constatee et enregistree au moment meme de la creation.
//   ANCIENNE  — l'ancre OB/FVG date de plus de wzMaxAnchorAgeH heures : le
//               setup arrive trop tard apres l'impulsion qui l'a cree.
//   PERIMEE   — le contexte HTF, qui etait EXIGE favorable a la creation
//               (garde-fou f_ctxAllow), est devenu defavorable depuis.
// Ecarte volontairement : l'alignement de `trend` n'est qu'un BONUS de score
// a la creation (25 pts, non exige) — une zone peut naitre sans lui. Le
// retenir comme cause d'invalidation la jugerait retroactivement sur une
// condition qu'elle n'a jamais eu a remplir. Retire suite a observation en
// backtest : des zones disparaissaient a la bougie suivant leur creation.
var string lastInvReason = "—"
var int    lastInvSide   = 0
var float  lastInvScore  = na
// Vrai UNIQUEMENT sur la bougie ou une zone vient d'etre retiree. Sert au
// verdict "INVALIDE" du panneau, qui doit etre un etat instantane et non un
// souvenir permanent.
bool zInvNow = false

if array.size(zTop) > 0
    for i = array.size(zTop) - 1 to 0
        bool  isB = array.get(zSide, i) == 1
        float tp  = array.get(zTop, i)
        float bt  = array.get(zBot, i)
        int   sT  = array.get(zSmcType, i)
        float sTp = array.get(zSmcTop, i)
        float sBt = array.get(zSmcBot, i)
        int   sBar = array.get(zSmcBar, i)

        bool consommee  = isB ? (low <= bt and close > tp) : (high >= tp and close < bt)
        bool cassee     = isB ? close < bt : close > tp
        bool ancienne   = sT != 0 and not na(sBar) and (bar_index - sBar) * timeframe.in_seconds() / 3600.0 > wzMaxAnchorAgeH
        bool perimee    = not f_ctxAllow(isB)

        bool smcGone = false
        if sT == 1
            smcGone := true
            if isB and array.size(obBB) > 0
                for j = 0 to array.size(obBB) - 1
                    if array.get(obBT, j) == sTp and array.get(obBB, j) == sBt
                        smcGone := false
            if not isB and array.size(obST) > 0
                for j = 0 to array.size(obST) - 1
                    if array.get(obST, j) == sTp and array.get(obSB, j) == sBt
                        smcGone := false
        else if sT == 2
            smcGone := true
            if isB and array.size(fvBB) > 0
                for j = 0 to array.size(fvBB) - 1
                    if array.get(fvBT, j) == sTp and array.get(fvBB, j) == sBt
                        smcGone := false
            if not isB and array.size(fvST) > 0
                for j = 0 to array.size(fvST) - 1
                    if array.get(fvST, j) == sTp and array.get(fvSB, j) == sBt
                        smcGone := false

        string reason = consommee ? "zone consommee" : cassee ? "cloture au travers" : smcGone ? (sT == 1 ? "OB casse" : "FVG comble") : ancienne ? "ancre trop ancienne" : perimee ? "contexte HTF change" : ""

        if reason != ""
            zInvNow := true
            lastInvReason := reason
            lastInvSide   := array.get(zSide, i)
            lastInvScore  := array.get(zScr, i)
            box.delete(array.get(zBox, i))
            label.delete(array.get(zLab, i))
            array.remove(zTop, i)
            array.remove(zBot, i)
            array.remove(zScr, i)
            array.remove(zSide, i)
            array.remove(zBar, i)
            array.remove(zSmcType, i)
            array.remove(zSmcTop, i)
            array.remove(zSmcBot, i)
            array.remove(zSmcBar, i)
            array.remove(zFibHi, i)
            array.remove(zFibLo, i)
            array.remove(zBox, i)
            array.remove(zLab, i)

// Les zones survivantes s'etirent jusqu'a la bougie courante : c'est ce qui
// rend visible, en un coup d'oeil, qu'une zone est TOUJOURS active. Le bord
// GAUCHE est tronque a zoneMaxBars -- sans ca une zone creee lundi couvrait
// ~480 bougies M15 le vendredi. Le label suit le bord droit : il restait
// colle a la bougie de creation, donc hors ecran des le mardi.
if array.size(zBox) > 0
    for i = 0 to array.size(zBox) - 1
        box.set_left(array.get(zBox, i), f_xL(array.get(zBar, i)))
        box.set_right(array.get(zBox, i), bar_index + zoneMaxBars)
        label.set_x(array.get(zLab, i), bar_index + zoneMaxBars)

// Zone trop loin du prix : mise en sourdine, pas supprimee -- l'information
// qu'elle existe reste disponible, mais elle cesse d'attirer l'oeil en
// premier. Repond a "elle est trop eloignee du prix" (section 7) sans
// perdre la trace de la zone comme le ferait une suppression pure.
if array.size(zBox) > 0 and not na(atrV) and atrV > 0
    for i = 0 to array.size(zBox) - 1
        float mid  = (array.get(zTop, i) + array.get(zBot, i)) / 2.0
        float dist = math.abs(close - mid) / atrV
        bool  isB  = array.get(zSide, i) == 1
        bool  far  = dist > wzFarAtr
        box.set_border_color(array.get(zBox, i), isB ? color.new(cUp, far ? 85 : 45) : color.new(cDn, far ? 85 : 45))
        box.set_bgcolor(array.get(zBox, i), isB ? color.new(cUp, far ? 97 : 93) : color.new(cDn, far ? 97 : 93))

// ---- Etat des confirmations SMC. Calcule EN CONTINU, jamais dans le score.
// Une zone atteinte ne suffit pas : le systeme attend le sweep, la cassure et
// la zone SMC. Et meme les trois reunis ne declenchent rien — c'est buySignal
// et sellSignal qui decident, et eux seuls.
int  zHit  = 0
int  zHitI = -1
if array.size(zTop) > 0
    for i = 0 to array.size(zTop) - 1
        if close <= array.get(zTop, i) and close >= array.get(zBot, i)
            zHit  := array.get(zSide, i)
            zHitI := i

bool wzCfSweep = zHit == 1 ? f_seqSweep(true) : zHit == -1 ? f_seqSweep(false) : false
bool wzCfStruc = zHit == 1 ? (bullBos or bullChoch) : zHit == -1 ? (bearBos or bearChoch) : false
bool wzCfSmc   = zHit == 1 ? (array.size(obBB) > 0 or array.size(fvBB) > 0) : zHit == -1 ? (array.size(obST) > 0 or array.size(fvST) > 0) : false
int  wzCfN     = (wzCfSweep ? 1 : 0) + (wzCfStruc ? 1 : 0) + (wzCfSmc ? 1 : 0)
// Le plan est "arme" quand les trois confirmations sont la. Cela reste un ETAT
// AFFICHE : le trade, lui, n'existe que si buySignal ou sellSignal est vrai.
bool wzArmed = zHit != 0 and wzCfN == 3

// ---- SEQUENCE NUMEROTEE DE LA ZONE ACTIVE (1 a 9) --------------------
// Raconte l'histoire de LA zone touchee par le prix en ce moment (zHitI),
// et seulement elle : aucun lien artificiel entre des evenements de zones
// differentes. Une zone qui n'est plus touchee revient a son texte simple
// au bar suivant (voir boucle plus bas) -- rien ne reste mis en avant apres
// que le prix l'ait quittee ou qu'elle ait ete invalidee.
bool step1Liq = false
if zHitI >= 0
    bool sIsB = array.get(zSide, zHitI) == 1
    float sTop = array.get(zTop, zHitI)
    float sBot = array.get(zBot, zHitI)
    if sIsB and array.size(eqlL) > 0
        for i = 0 to array.size(eqlL) - 1
            if array.get(eqlL, i) < sBot
                step1Liq := true
    if not sIsB and array.size(eqhL) > 0
        for i = 0 to array.size(eqhL) - 1
            if array.get(eqhL, i) > sTop
                step1Liq := true
bool step2Sweep = wzCfSweep
bool step3Choch = zHit == 1 ? f_seqChoch(true) : zHit == -1 ? f_seqChoch(false) : false
bool step4Bos   = zHit == 1 ? f_seqBos(true)   : zHit == -1 ? f_seqBos(false)   : false

// Texte de chaque zone : numerote 1-2-3-4-6 pour celle touchee par le prix,
// texte simple pour toutes les autres -- recalcule CHAQUE bougie, donc une
// zone qui cesse d'etre touchee (prix reparti, ou zone invalidee et retiree
// du tableau) ne garde jamais sa numerotation.
if array.size(zLab) > 0
    for i = 0 to array.size(zLab) - 1
        bool  lIsB = array.get(zSide, i) == 1
        string plainTxt = (lIsB ? "BUY  " : "SELL  ") + str.tostring(int(math.round(array.get(zScr, i)))) + "/100"
        if i == zHitI
            string seqTxt = (step1Liq ? "✓1" : "✗1") + " " + (step2Sweep ? "✓2" : "✗2") + " " + (step3Choch ? "✓3" : "✗3") + " " + (step4Bos ? "✓4" : "✗4")
            label.set_text(array.get(zLab, i), "6. " + plainTxt + "\n" + seqTxt)
        else
            label.set_text(array.get(zLab, i), plainTxt)

// ============================================================
// OBJECTIF ET DOUBLE REFERENCE DE STOP — LECTURE SEULE
// ------------------------------------------------------------
// AUCUN ORDRE NE SORT D'ICI. La sortie reelle reste le trailing mesure
// (armement 1.5 R, distance 0.3 R), qui bat les 56 combinaisons stop x TP
// testees. Ce bloc repond a une autre question : « si ca marche, ou est-ce
// que ca peut aller, et ou aurais-je vraiment tort ? »
//
// Pourquoi l'objectif n'est PAS le TP. Mesure sur 1101 journees : au premier
// retour du prix sur un POC, une VAH, une VAL ou une poche de liquidite,
// AUCUN de ces niveaux ne bat un niveau de controle place a la meme distance
// (p entre 0.34 et 0.56). En faire une cible d'ordre reviendrait a troquer un
// mecanisme mesure contre un reperage sans pouvoir d'attraction demontre.
// En revanche, savoir ou se trouve le prochain obstacle aide a decider.
int   objDir = biasBull ? 1 : biasBear ? -1 : 0
float objPx  = na
string objSrc = ""
if objDir != 0 and not na(atrV)
    // On cherche le premier obstacle DEVANT le prix, dans le sens du biais.
    float best = na
    string src = ""
    // liquidite opposee : c'est la que les stops sont empiles
    if objDir == 1 and array.size(eqhL) > 0
        for i = 0 to array.size(eqhL) - 1
            float lv = array.get(eqhL, i)
            if lv > close and (na(best) or lv < best)
                best := lv
                src := "liquidite"
    if objDir == -1 and array.size(eqlL) > 0
        for i = 0 to array.size(eqlL) - 1
            float lv = array.get(eqlL, i)
            if lv < close and (na(best) or lv > best)
                best := lv
                src := "liquidite"
    // POC de la veille et POC hebdomadaire
    if not na(pocPrev) and (objDir == 1 ? pocPrev > close : pocPrev < close) and (na(best) or (objDir == 1 ? pocPrev < best : pocPrev > best))
        best := pocPrev
        src := "POC veille"
    if not na(wPoc) and (objDir == 1 ? wPoc > close : wPoc < close) and (na(best) or (objDir == 1 ? wPoc < best : wPoc > best))
        best := wPoc
        src := "POC hebdo"
    // zone institutionnelle opposee
    if array.size(zTop) > 0
        for i = 0 to array.size(zTop) - 1
            if array.get(zSide, i) == -objDir
                float lv = objDir == 1 ? array.get(zBot, i) : array.get(zTop, i)
                if (objDir == 1 ? lv > close : lv < close) and (na(best) or (objDir == 1 ? lv < best : lv > best))
                    best := lv
                    src := "zone hebdo"
    objPx := best
    objSrc := src

// --- Les deux references de stop, cote a cote ---
// ATR : c'est le stop du systeme, celui qui passe les ordres. Mesure : plateau
//       2.0-3.0 ATR ; a 1.5 ATR le systeme devient negatif sur 2 sous-periodes
//       sur 4. Il ne bouge pas.
// STRUCTUREL : le point ou l'idee est vraiment fausse — sous le dernier creux,
//       sous l'Order Block, sous la liquidite prise. Il n'est PAS utilise comme
//       ordre parce qu'il varie de 0.8 a 5 ATR selon le hasard du dernier
//       Order Block, ce qui fait sortir du plateau sans prevenir.
// L'ECART entre les deux est l'information reelle : quand le stop ATR est
// DEVANT l'invalidation, le trade a une chance elevee d'etre coupe avant
// d'avoir eu tort. Aucun indicateur grand public ne le dit.
float stopAtr = na
float stopStr = na
if objDir != 0 and not na(atrV) and atrV > 0
    stopAtr := objDir == 1 ? close - slAtr * atrV : close + slAtr * atrV
    float prot = objDir == 1 ? swingLow : swingHigh
    if objDir == 1
        if array.size(obBB) > 0
            prot := na(prot) ? array.get(obBB, 0) : math.min(prot, array.get(obBB, 0))
        if array.size(eqlL) > 0
            for i = 0 to array.size(eqlL) - 1
                float lv = array.get(eqlL, i)
                if lv < close
                    prot := na(prot) ? lv : math.min(prot, lv)
    else
        if array.size(obST) > 0
            prot := na(prot) ? array.get(obST, 0) : math.max(prot, array.get(obST, 0))
        if array.size(eqhL) > 0
            for i = 0 to array.size(eqhL) - 1
                float lv = array.get(eqhL, i)
                if lv > close
                    prot := na(prot) ? lv : math.max(prot, lv)
    stopStr := na(prot) ? na : (objDir == 1 ? prot - atrV * 0.15 : prot + atrV * 0.15)

float riskAtr = na(stopAtr) ? na : math.abs(close - stopAtr)
float riskStr = na(stopStr) ? na : math.abs(close - stopStr)
float rr      = na(objPx) or na(riskAtr) or riskAtr <= 0 ? na : math.abs(objPx - close) / riskAtr
// Le stop du systeme est-il DEVANT le point d'invalidation reelle ?
bool stopDevant = not na(riskStr) and not na(riskAtr) and riskStr > riskAtr * 1.15

// ============================================================
// RENDU — tout ce qui suit est redessine sur la DERNIERE bougie uniquement.
// Cout nul sur l'historique, et surtout : aucune de ces valeurs n'est lue par
// une condition. C'est du dessin, rien d'autre.
// ============================================================
var array<box>   dBx = array.new<box>()
var array<line>  dLn = array.new<line>()
var array<label> dLb = array.new<label>()

f_clear() =>
    if array.size(dBx) > 0
        for i = 0 to array.size(dBx) - 1
            box.delete(array.get(dBx, i))
        array.clear(dBx)
    if array.size(dLn) > 0
        for i = 0 to array.size(dLn) - 1
            line.delete(array.get(dLn, i))
        array.clear(dLn)
    if array.size(dLb) > 0
        for i = 0 to array.size(dLb) - 1
            label.delete(array.get(dLb, i))
        array.clear(dLb)

// Trait COURT, pour la liquidite : elle doit se lire pres du prix sans
// balayer tout l'ecran comme le fait f_lvl (60 bougies).
f_liq(float y, color col, string txt) =>
    if not na(y)
        line l = line.new(bar_index - 18, y, bar_index + 4, y, color=col, width=1, style=line.style_solid)
        array.push(dLn, l)
        label lb = label.new(bar_index + 4, y, txt, style=label.style_label_left, color=color.new(cBg, 100), textcolor=col, size=size.tiny)
        array.push(dLb, lb)

f_lvl(float y, color col, string txt, string sty) =>
    if not na(y)
        line l = line.new(bar_index - 60, y, bar_index + 4, y, color=col, width=1, style=sty)
        array.push(dLn, l)
        if txt != ""
            label lb = label.new(bar_index + 4, y, txt, style=label.style_label_left, color=color.new(cBg, 100), textcolor=col, size=size.tiny)
            array.push(dLb, lb)

// Le bord gauche est tronque a zoneMaxBars : une boite garde son origine
// reelle tant qu'elle est recente, et cesse de balayer tout l'ecran quand
// elle vieillit. Les bornes de PRIX (top/bot) ne sont jamais touchees.
// Une boite OB/FVG appartient-elle au setup en cours ? Vraie si elle
// CHEVAUCHE une zone active. Comme la zone EST l'union OB x FVG, les
// deux ancres de cette zone la chevauchent forcement -- un seul test suffit
// donc pour les deux types, sans avoir a memoriser le FVG separement.
f_nearZone(float t, float b) =>
    bool r = false
    if array.size(zTop) > 0
        for q = 0 to array.size(zTop) - 1
            if math.min(t, array.get(zTop, q)) > math.max(b, array.get(zBot, q))
                r := true
    r

// ANCRAGE AUX BOUGIES. Le bord gauche etait tronque a
// `bar_index - zoneMaxBars` (25) : un Order Block cree 100 bougies plus tot
// voyait son rectangle DEMARRER 25 bougies en arriere au lieu de sa bougie
// d'origine. D'ou l'impression de rectangle flottant, sans rapport visible
// avec les bougies. Ce plafond avait ete ajoute contre les rectangles
// geants ; la bonne reponse etait de borner la PROJECTION A DROITE, pas
// d'amputer l'ancrage a gauche.
// La boite part desormais EXACTEMENT de la bougie qui l'a creee et se
// prolonge vers la droite tant qu'elle reste valide.
// BORD DROIT SELON L'ETAT DE LA ZONE.
// `right` = -1  -> zone ACTIVE : le bord droit suit la bougie courante et la
//                  depasse de zoneMaxBars. La boite s'allonge donc a chaque
//                  bougie, exactement comme une zone SMC projetee.
// `right` >= 0  -> zone FIGEE a cette bougie : son extension s'arrete au
//                  moment de son invalidation et n'avance plus jamais.
// Le sentinel -1 est utilise plutot que na pour eviter toute question de
// typage sur un argument entier.
//
// La largeur n'a JAMAIS ete bridee : le bord droit valait deja
// bar_index + zoneMaxBars, donc une boite ancienne etait large. Si les zones
// paraissaient de petits carres, c'est qu'elles etaient JEUNES -- voir
// obHistMax. Le present bloc ne corrige donc pas une troncature inexistante,
// il ajoute la seule chose qui manquait vraiment : l'arret a l'invalidation.
//
// f_xL protege les DEUX bords : le gauche comme le droit peuvent etre
// anciens, et une coordonnee hors tampon d'historique arrete le script.
// math.max(..., + 1) garantit une boite non degeneree si les deux bords sont
// rabattus sur le meme plafond.
f_zone(float top, float bot, int left, int right, color bord, color fill, string txt, color txtc, string bsty) =>
    if not na(top) and not na(bot) and top > bot
        int xl = f_xL(left)
        int xr = right < 0 ? bar_index + zoneMaxBars : math.max(f_xL(right), xl + 1)
        box b = box.new(xl, top, xr, bot, border_color=bord, border_width=1, border_style=bsty, bgcolor=fill, text=txt, text_color=txtc, text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_top)
        array.push(dBx, b)

if barstate.islast
    f_clear()

    // ---- Liquidite : traits FINS, en arriere-plan, jamais de bloc ----
    // Sommets egaux = BUY SIDE (les stops d'achat sont AU-DESSUS).
    // Creux egaux  = SELL SIDE (les stops de vente sont EN DESSOUS).
    // La version precedente inversait les deux.
    if liqShow
        // Seules les liqShowMax poches les plus RECENTES sont tracees. Le
        // moteur, lui, en suit liqMax : le plafond visuel ne peut donc plus
        // amputer la detection des sweeps ni le score de liquidite.
        if array.size(eqhL) > 0
            for i = math.max(0, array.size(eqhL) - liqShowMax) to array.size(eqhL) - 1
                f_liq(array.get(eqhL, i), color.new(cBlue, 45), "BSL")
        if array.size(eqlL) > 0
            for i = math.max(0, array.size(eqlL) - liqShowMax) to array.size(eqlL) - 1
                f_liq(array.get(eqlL, i), color.new(cDn, 45), "SSL")

    // ---- Profil de la veille : le POC est le SEUL element saillant du fond ----
    if vShow
        // Reference de contexte, pas element de decision : nettement attenues
        // pour cesser de concurrencer les zones et les OB/FVG a l'oeil.
        f_lvl(pocPrev, color.new(cGold, 55), "POC", line.style_solid)
        f_lvl(vahPrev, color.new(cMute, 60), "VAH", line.style_dashed)
        f_lvl(valPrev, color.new(cMute, 60), "VAL", line.style_dashed)

    // ---- Order Blocks retenus ----
    // DEUX COUCHES INDEPENDANTES. Les Order Blocks et les FVG sont des elements
    // de LECTURE du marche : ils s'affichent des que obShow / fvgShow sont
    // coches, qu'ils appartiennent ou non a une zone institutionnelle. La
    // BUY/SELL ZONE est une couche SUPERIEURE de confluence, commandee
    // separement par wzShow.
    // Un reglage "zoneOnly" masquait auparavant tout OB/FVG n'appartenant pas a
    // une zone active. Comme les zones sont rares par conception -- et le sont
    // devenues davantage depuis que l'Order Block est fige au CHoCH -- les deux
    // effets se cumulaient et le graphique se vidait. Le reglage est supprime.
    // Le prefixe "5. " reste, mais il ne fait plus que METTRE EN VALEUR l'OB
    // ancre de la zone active : il ne conditionne plus l'affichage.
    if obShow
        // D3 -- L'ETAT SE LIT DANS LE TEXTE, la palette et les deux niveaux de
        // transparence d'origine sont conserves tels quels.
        //   "OB"    = FRESH, jamais retouche
        //   "OB ·"  = MITIGATED, une meche est entree
        //   "OB ··" = TESTED, une bougie a cloture dedans sans casser
        // Un OB mitige ou teste reste ACTIF et VISIBLE : seule sa transparence
        // change. Il ne disparait que casse, et meme alors il ne disparait pas
        // vraiment -- il passe en attente (voir plus bas).
        if array.size(obBT) > 0
            for i = 0 to array.size(obBT) - 1
                bool obActive = f_nearZone(array.get(obBT, i), array.get(obBB, i))
                int  obSt  = array.get(obBSt, i)
                bool obMit = obSt >= 1
                string obTx = (obActive ? "5. OB" : "OB") + (obSt >= 2 ? " ··" : obSt >= 1 ? " ·" : "")
                f_zone(array.get(obBT, i), array.get(obBB, i), array.get(obBX, i), -1, color.new(cBlue, obMit ? 55 : 40), color.new(cBlue, obMit ? 90 : 85), obTx, color.new(cBlue, 25), line.style_solid)
        if array.size(obST) > 0
            for i = 0 to array.size(obST) - 1
                bool obActive = f_nearZone(array.get(obST, i), array.get(obSB, i))
                int  obSt  = array.get(obSSt, i)
                bool obMit = obSt >= 1
                string obTx = (obActive ? "5. OB" : "OB") + (obSt >= 2 ? " ··" : obSt >= 1 ? " ·" : "")
                f_zone(array.get(obST, i), array.get(obSB, i), array.get(obSX, i), -1, color.new(cPurp, obMit ? 55 : 40), color.new(cPurp, obMit ? 90 : 85), obTx, color.new(cPurp, 25), line.style_solid)

        // Historique : memes couleurs et meme style que l'OB actif -- un OB
        // valide reste un OB valide, qu'il porte ou non le setup en cours.
        if array.size(ohBT) > 0
            for i = 0 to array.size(ohBT) - 1
                int  ohSt  = array.get(ohBSt, i)
                bool ohMit = ohSt >= 1
                f_zone(array.get(ohBT, i), array.get(ohBB, i), array.get(ohBX, i), -1, color.new(cBlue, ohMit ? 55 : 40), color.new(cBlue, ohMit ? 90 : 85), "OB" + (ohSt >= 2 ? " ··" : ohSt >= 1 ? " ·" : ""), color.new(cBlue, 25), line.style_solid)
        if array.size(ohST) > 0
            for i = 0 to array.size(ohST) - 1
                int  ohSt  = array.get(ohSSt, i)
                bool ohMit = ohSt >= 1
                f_zone(array.get(ohST, i), array.get(ohSB, i), array.get(ohSX, i), -1, color.new(cPurp, ohMit ? 55 : 40), color.new(cPurp, ohMit ? 90 : 85), "OB" + (ohSt >= 2 ? " ··" : ohSt >= 1 ? " ·" : ""), color.new(cPurp, 25), line.style_solid)

        // D2 -- ZONES CASSEES EN ATTENTE DE CONFIRMATION. Couleurs du futur
        // Breaker, mais contour POINTILLE et texte "BB?" : la zone est cassee,
        // elle n'est pas encore un Breaker et ne le sera peut-etre jamais.
        // Aucune couleur nouvelle n'est introduite.
        if array.size(pbST) > 0
            for i = 0 to array.size(pbST) - 1
                f_zone(array.get(pbST, i), array.get(pbSB, i), array.get(pbSX, i), array.get(pbSBk, i), color.new(cPurp, 55), color.new(cDn, 93), "BB?", color.new(cPurp, 40), line.style_dashed)
        if array.size(pbBT) > 0
            for i = 0 to array.size(pbBT) - 1
                f_zone(array.get(pbBT, i), array.get(pbBB, i), array.get(pbBX, i), array.get(pbBBk, i), color.new(cBlue, 55), color.new(cUp, 93), "BB?", color.new(cBlue, 40), line.style_dashed)

        // BREAKER BLOCKS CONFIRMES. Meme zone, meme origine, sens inverse.
        // Baissier (ex-OB haussier casse) : contour violet, fond rouge.
        // Haussier (ex-OB baissier casse) : contour bleu, fond vert.
        if array.size(bkST) > 0
            for i = 0 to array.size(bkST) - 1
                f_zone(array.get(bkST, i), array.get(bkSB, i), array.get(bkSX, i), -1, color.new(cPurp, 35), color.new(cDn, 88), "BB", color.new(cPurp, 20), line.style_solid)
        if array.size(bkBT) > 0
            for i = 0 to array.size(bkBT) - 1
                f_zone(array.get(bkBT, i), array.get(bkBB, i), array.get(bkBX, i), -1, color.new(cBlue, 35), color.new(cUp, 88), "BB", color.new(cBlue, 20), line.style_solid)

    // ---- Fair Value Gaps retenus ----
    if fvgShow
        if array.size(fvBT) > 0
            for i = 0 to array.size(fvBT) - 1
                bool fvActive = f_nearZone(array.get(fvBT, i), array.get(fvBB, i))
                f_zone(array.get(fvBT, i), array.get(fvBB, i), array.get(fvBX, i), -1, color.new(cUp, 55), color.new(cUp, 87), (fvActive ? "5. FVG" : "FVG"), color.new(cUp, 30), line.style_dashed)
        if array.size(fvST) > 0
            for i = 0 to array.size(fvST) - 1
                bool fvActive = f_nearZone(array.get(fvST, i), array.get(fvSB, i))
                f_zone(array.get(fvST, i), array.get(fvSB, i), array.get(fvSX, i), -1, color.new(cDn, 55), color.new(cDn, 87), (fvActive ? "5. FVG" : "FVG"), color.new(cDn, 30), line.style_dashed)

    // ---- FIBONACCI DE LA ZONE ACTIVE -------------------------------------
    // Traces a partir du swing FIGE dans la zone, jamais du tracker glissant :
    // les niveaux d'une zone deja creee ne bougent donc plus. Uniquement les
    // quatre niveaux qui servent au jugement (50 / 61.8 / 70.5 / 78.6), plus
    // l'equilibre qui separe premium et discount. Rien d'autre : un eventail
    // complet noierait le graphique pour aucune information supplementaire.
    if fibShow and array.size(zTop) > 0
        for i = 0 to array.size(zTop) - 1
            float fHi = array.get(zFibHi, i)
            float fLo = array.get(zFibLo, i)
            if not na(fHi) and not na(fLo) and fHi > fLo
                bool fIsB = array.get(zSide, i) == 1
                float rng = fHi - fLo
                f_lvl(fIsB ? fHi : fLo,                             color.new(cMute, 80), "0",    line.style_dotted)
                f_lvl(fIsB ? fHi - rng * 0.382 : fLo + rng * 0.382, color.new(cMute, 72), "0.382", line.style_dotted)
                f_lvl(fIsB ? fHi - rng * 0.50  : fLo + rng * 0.50,  color.new(cMute, 62), "0.5",   line.style_dashed)
                f_lvl(fIsB ? fHi - rng * 0.618 : fLo + rng * 0.618, color.new(cGold, 15), "0.618", line.style_solid)
                f_lvl(fIsB ? fHi - rng * 0.705 : fLo + rng * 0.705, color.new(cGold, 15), "0.705", line.style_solid)
                f_lvl(fIsB ? fHi - rng * 0.786 : fLo + rng * 0.786, color.new(cGold, 62), "0.786", line.style_dotted)
                f_lvl(fIsB ? fLo : fHi,                             color.new(cMute, 80), "1",    line.style_dotted)

    // ---- ENTREE PLANIFIEE : le bord de la zone ou l'on attend le prix ----
    // Repond a "l'Entry doit etre DANS ou au bord logique de la zone" -- mais
    // SANS mentir sur l'execution. Ce sont deux choses differentes, donc deux
    // libelles differents :
    //   "ENTRY (plan)" = le bord de la zone active, la ou l'on ATTEND le prix.
    //                    Trace des que la zone existe, avant que le prix y soit.
    //   "7. ENTRY"     = le prix REEL d'execution (close de la bougie de
    //                    signal), trace uniquement quand le signal existe.
    // Melanger les deux afficherait un prix auquel la strategie n'entre jamais.
    if showLvls and not (rawLong or rawShort) and array.size(zTop) > 0
        for i = 0 to array.size(zTop) - 1
            bool pIsB = array.get(zSide, i) == 1
            f_lvl(pIsB ? array.get(zTop, i) : array.get(zBot, i), color.new(pIsB ? cUp : cDn, 45), "ENTRY (plan)", line.style_dotted)

    // ---- Niveaux du setup en cours ----
    if showLvls and (rawLong or rawShort) and not na(atrV)
        // Noms locaux evites : dans la version strategie, ePx et sPx sont des
        // variables GLOBALES du bloc d'execution ; les redeclarer ici les
        // masquerait et Pine refuserait de compiler.
        // Le stop du systeme et le point d'invalidation structurelle sont
        // traces ENSEMBLE, chacun avec sa raison — c'est l'ECART entre les
        // deux qui informe, pas leur valeur prise isolement.
        // "7./8./9." ne prefixent CES niveaux que si le signal du moment
        // appartient reellement a la zone numerotee 1-6 (meme cote, prix
        // dedans) -- un signal qui se declenche hors de toute zone garde ses
        // etiquettes simples, jamais un lien invente avec une zone etrangere.
        bool tiedToZone = zHitI >= 0 and ((rawLong and array.get(zSide, zHitI) == 1) or (rawShort and array.get(zSide, zHitI) == -1))
        f_lvl(close, color.new(cTxt, 30), (tiedToZone ? "7. " : "") + "Entree", line.style_dotted)
        f_lvl(stopAtr, color.new(cDn, 5), (tiedToZone ? "8. " : "") + "SL " + str.tostring(slAtr, "#.#") + " ATR", line.style_solid)
        if not na(stopStr)
            f_lvl(stopStr, color.new(cDn, 55), stopDevant ? "Invalidation ⚠" : "Invalidation", line.style_dashed)
        if not na(objPx)
            f_lvl(objPx, color.new(cUp, 25), (tiedToZone ? "9. " : "") + "TP · Objectif (" + objSrc + ")" + (na(rr) ? "" : "  " + str.tostring(rr, "#.#") + "R"), line.style_dashed)

// --- Teinte de fond : le biais sans aucun deplacement du regard ---
bgcolor(uiTint ? (biasBull ? color.new(cUp, 96) : biasBear ? color.new(cDn, 96) : na) : na, title="Biais D1+W1")

// --- Fleches d'entree : les seuls marqueurs opaques du graphique ---
plotshape(buySignal,  title="BUY",  style=shape.triangleup,   location=location.belowbar, color=cUp, size=size.small)
plotshape(sellSignal, title="SELL", style=shape.triangledown, location=location.abovebar, color=cDn, size=size.small)

// ============================================================
// PLAN 3 — LE PANNEAU DE DECISION
// Ordre de lecture impose : biais, multi-timeframe, contexte, verdict.
// Trois familles visuellement separees, parce qu'elles n'ont pas le meme
// statut : ce qui DECIDE, ce qui n'est que CONTEXTE, et la conclusion.
// ============================================================

// ============================================================
// PANNEAU — VERDICT / BIAS / CONFLUENCE / VALIDATION / PLAN
// ------------------------------------------------------------
// Pas de legende a part sur le graphique : chaque zone/OB/FVG porte deja
// son propre texte ("OB", "FVG", "BUY 82/100"...), un decodeur separe
// serait un aveu d'echec de la lisibilite directe.
// Pas de barre basse : elle dupliquait ces memes lignes.
// Chaque ligne repond a une question, dans l'ordre ou elle se pose.
// ============================================================
var table pan = table.new(panPos == "top_left" ? position.top_left : panPos == "top_right" ? position.top_right : panPos == "bottom_left" ? position.bottom_left : position.bottom_right, 2, 17, border_width=0)

// f_cell = ligne CONTEXTE (affichee, ne decide rien). f_cellD = ligne DECIDE
// (participe reellement a buySignal/sellSignal) : meme contenu, fond legerement
// teinte pour separer les deux familles au coup d'oeil, sans reordonner les
// lignes ni toucher a une seule condition.
f_cell(int r, string k, string v, color vc) =>
    table.cell(pan, 0, r, "  " + k, text_color=color.new(cTxt, 35), text_size=size.small, text_halign=text.align_left,  bgcolor=color.new(cBg, 6))
    table.cell(pan, 1, r, v + "  ", text_color=vc, text_size=size.small, text_halign=text.align_right, bgcolor=color.new(cBg, 6))

f_cellD(int r, string k, string v, color vc) =>
    table.cell(pan, 0, r, "  " + k, text_color=color.new(cTxt, 25), text_size=size.small, text_halign=text.align_left,  bgcolor=color.new(cGold, 93))
    table.cell(pan, 1, r, v + "  ", text_color=vc, text_size=size.small, text_halign=text.align_right, bgcolor=color.new(cGold, 93))

f_px2(float p) => na(p) ? "—" : str.tostring(p, format.mintick)

if barstate.islast and panShow
    // 0 — LE VERDICT. La seule ligne a lire si tu n'as que deux secondes.
    bool sL = rawLong
    bool sS = rawShort
    bool dL = biasDir >= 0

    // GRADE A+/A/B/INVALID (voir SETUP_GRADING.md). Calcule ICI, avant le
    // verdict, pour etre affichable a la fois en ligne 0 (resume) et en
    // ligne 3 (detail). Reprend terme a terme alignLong/alignShort, y
    // compris leurs interrupteurs useX : un filtre desactive compte comme
    // satisfait, exactement comme dans alignLong.
    bool gC1 = not useStruct or (dL ? trend == 1 : trend == -1)
    bool gC2 = not useHtf    or (dL ? htfBull : htfBear)
    bool gC3 = not useVwap   or (dL ? aboveVwap : belowVwap)
    bool gC4 = not useBias   or (dL ? biasBull : biasBear)
    bool gC5 = not vUsePoc   or (dL ? abovePoc : belowPoc)
    int gradeN = (gC1 ? 1 : 0) + (gC2 ? 1 : 0) + (gC3 ? 1 : 0) + (gC4 ? 1 : 0) + (gC5 ? 1 : 0)
    bool trigOk = dL ? trigLong : trigShort
    bool exclOk = not na(atrV) and atrV > 0 and barstate.isconfirmed and (dL ? (bar_index - lastLong) > cooldown : (bar_index - lastShort) > cooldown)
    string grade = not trigOk or not exclOk ? "INVALID" : gradeN == 5 ? "A+" : gradeN == 4 ? "A" : gradeN == 3 ? "B" : "INVALID"
    color gradeCol = grade == "A+" ? cUp : grade == "A" ? cGold : grade == "B" ? color.new(cGold, 40) : cMute

    // QUATRE ETATS EXCLUSIFS, dans cet ordre de priorite. Le grade
    // n'accompagne QUE "ENTRER" : ailleurs il produisait des libelles
    // contradictoires du type "ATTENDRE · INVALID" -- deux concepts
    // differents (l'etat du setup, et la note des 5 conditions) colles dans
    // la meme phrase.
    //   ENTRER       : les conditions d'entree sont reunies (rawLong/rawShort)
    //   INVALIDE     : une zone vient d'etre retiree sur CETTE bougie
    //   ATTENDRE     : au moins une zone active existe, mais pas de signal
    //   PAS DE SETUP : aucune zone qualifiee
    int nZ = array.size(zTop)
    // ---- DASHBOARD ------------------------------------------------------
    // Une ligne = une information, un libelle a gauche, une valeur a droite.
    // Le diagnostic detaille, qui occupait cinq lignes denses, est reduit a une
    // ligne STATUS ; le detail des conditions devient une colonne de coches.
    string stat = sL ? "BUY SETUP" : sS ? "SELL SETUP" : zInvNow ? "ZONE INVALIDEE" : nZ > 0 ? "ZONE ACTIVE" : (diagShow and dgRej != "" ? dgRej : "WAITING FOR SETUP")
    color  vc   = sL ? cUp : sS ? cDn : zInvNow ? cDn : nZ > 0 ? cGold : cMute

    // 0 — En-tete.
    table.cell(pan, 0, 0, "  SMC PRO", text_color=color.rgb(12, 14, 18), text_size=size.normal, text_halign=text.align_left, bgcolor=vc)
    table.cell(pan, 1, 0, (sL or sS ? grade + "  " : "  "), text_color=color.rgb(12, 14, 18), text_size=size.small, text_halign=text.align_right, bgcolor=vc)

    f_cell(1, "BIAS", ctxTxt, ctxCol)

    float confScore = na
    if array.size(zTop) > 0
        for i = 0 to array.size(zTop) - 1
            if array.get(zSide, i) == (dL ? 1 : -1)
                confScore := array.get(zScr, i)
                break
    f_cell(2, "SCORE", na(confScore) ? "—" : str.tostring(int(math.round(confScore))) + "/100", na(confScore) ? cMute : (dL ? cUp : cDn))

    int nBuyZ  = 0
    int nSellZ = 0
    if array.size(zSide) > 0
        for i = 0 to array.size(zSide) - 1
            if array.get(zSide, i) == 1
                nBuyZ += 1
            else
                nSellZ += 1
    f_cell(3, "BUY ZONE",  nBuyZ  > 0 ? "✓" : "—", nBuyZ  > 0 ? cUp : cMute)
    f_cell(4, "SELL ZONE", nSellZ > 0 ? "✓" : "—", nSellZ > 0 ? cDn : cMute)

    // Colonne de conditions : une par ligne, verte si remplie, grise sinon.
    // Masquable par diagShow pour un panneau encore plus court.
    if diagShow
        f_cell(5,  "SWEEP", dgSweep ? "✓" : "—", dgSweep ? cUp : cMute)
        f_cell(6,  "CHoCH", dgChoch ? "✓" : "—", dgChoch ? cUp : cMute)
        f_cell(7,  "BOS",   dgBos   ? "✓" : "—", dgBos   ? cUp : cMute)
        f_cell(8,  "OB",    dgOb    ? "✓" : "—", dgOb    ? cUp : cMute)
        f_cell(9,  "FVG",   dgFvg   ? "✓" : "—", dgFvg   ? cUp : cMute)
        f_cell(10, "FIB",   dgFib == 1 ? "✓" : dgFib == 0 ? "~" : "—", dgFib == 1 ? cUp : dgFib == 0 ? cGold : cMute)
        f_cell(11, "HTF",   dgHtf   ? "✓" : "—", dgHtf   ? cUp : cMute)

    f_cellD(12, "TP",  na(objPx)   ? "—" : f_px2(objPx),   na(objPx)   ? cMute : cGold)
    f_cellD(13, "SL",  na(stopAtr) ? "—" : f_px2(stopAtr), na(stopAtr) ? cMute : cDn)
    f_cellD(14, "R:R", na(rr) ? "—" : str.tostring(rr, "#.##"), na(rr) ? cMute : rr >= 2.0 ? cUp : rr >= 1.0 ? cGold : cDn)

    f_cell(15, "STATUS", stat, vc)

    // 16 — HTF BIAS : le regime, puis les trois votes individuels, comme sur
    // la reference. dirD / dirH4 / dirH1 existent deja (moteur multi-timeframe
    // en LECTURE SEULE) : rien de nouveau n'est calcule ici.
    string aD  = dirD  == 1 ? "↑" : dirD  == -1 ? "↓" : "–"
    string aH4 = dirH4 == 1 ? "↑" : dirH4 == -1 ? "↓" : "–"
    string aH1 = dirH1 == 1 ? "↑" : dirH1 == -1 ? "↓" : "–"
    f_cell(16, "HTF BIAS", "D1 " + aD + "   H4 " + aH4 + "   H1 " + aH1, ctxCol)

// ============================================================
// TABLEAU DE VALIDATION — statistiques sur les trades EXECUTES
// ------------------------------------------------------------
// Purement descriptif : ces chiffres sont LUS depuis les trades deja fermes.
// Aucune condition d'entree, de sortie ou de taille ne les consulte.
//
// PERFORMANCE. La boucle parcourt tous les trades fermes, mais UNE SEULE FOIS,
// sur la derniere bougie. Le faire a chaque bougie serait quadratique et
// rendrait le backtest inutilisable sur 19 ans et 2000 trades.
//
// POURQUOI CE TABLEAU EXISTE. Le Strategy Tester de TradingView ne donne ni la
// serie maximale de GAINS, ni le R:R moyen reellement realise, ni la
// repartition par session. Ce sont exactement les trois chiffres qu'il faut
// comparer d'un actif a l'autre pour savoir si un systeme est structurel ou
// ajuste a un seul marche.
// ============================================================
statShow = input.bool(true, "Tableau de validation", group=grpU, display=display.none)
statPos  = input.string("bottom_left", "Position du tableau", options=["top_left","top_right","bottom_left","bottom_right"], group=grpU, display=display.none)

var table st = table.new(statPos == "top_left" ? position.top_left : statPos == "top_right" ? position.top_right : statPos == "bottom_left" ? position.bottom_left : position.bottom_right, 4, 8, border_width=0)

f_st(int c, int r, string t, color col, bool head) =>
    table.cell(st, c, r, t, text_color=col, text_size=size.tiny, text_halign=c % 2 == 0 ? text.align_left : text.align_right, bgcolor=head ? color.new(cBg, 0) : color.new(cBg, 8))

var array<float> sesP = array.new<float>(4, 0.0)
var array<int>   sesN = array.new<int>(4, 0)

if barstate.islast and statShow and strategy.closedtrades > 0
    int   n = strategy.closedtrades
    float sumW = 0.0
    float sumL = 0.0
    int   nW = 0
    int   nL = 0
    int   curW = 0
    int   curL = 0
    int   maxW = 0
    int   maxL = 0
    array.fill(sesP, 0.0)
    array.fill(sesN, 0)
    for i = 0 to n - 1
        float p = strategy.closedtrades.profit(i)
        if p > 0
            nW += 1
            sumW += p
            curW += 1
            curL := 0
            maxW := math.max(maxW, curW)
        else
            nL += 1
            sumL += p
            curL += 1
            curW := 0
            maxL := math.max(maxL, curL)
        // Session de l'ENTREE, en UTC. Rappel de mesure : aucun filtre de
        // session n'a survecu a la correction de tests multiples. Ces chiffres
        // DECRIVENT ou le systeme gagne, ils ne justifient aucun filtre.
        int h = hour(strategy.closedtrades.entry_time(i), "UTC")
        int k = h < 7 ? 0 : h < 12 ? 1 : h < 16 ? 2 : 3
        array.set(sesN, k, array.get(sesN, k) + 1)
        array.set(sesP, k, array.get(sesP, k) + p)

    float avgW = nW > 0 ? sumW / nW : 0.0
    float avgL = nL > 0 ? sumL / nL : 0.0
    float pf   = sumL < 0 ? sumW / math.abs(sumL) : na
    // R:R moyen REALISE : rapport du gain moyen a la perte moyenne. Ce n'est
    // pas le R:R vise a l'entree, c'est celui que le marche a effectivement
    // laisse — la seule version qui ait un sens pour comparer deux actifs.
    float rrM  = avgL < 0 ? avgW / math.abs(avgL) : na

    f_st(0, 0, "  VALIDATION", cGold, true)
    f_st(1, 0, "", cGold, true)
    f_st(2, 0, "  SESSIONS (UTC)", cGold, true)
    f_st(3, 0, "", cGold, true)
    f_st(0, 1, "  Trades", color.new(cTxt, 35), false)
    f_st(1, 1, str.tostring(n) + "  ", cTxt, false)
    f_st(0, 2, "  Win rate", color.new(cTxt, 35), false)
    f_st(1, 2, str.tostring(100.0 * nW / n, "#.#") + " %  ", cTxt, false)
    f_st(0, 3, "  Profit Factor", color.new(cTxt, 35), false)
    f_st(1, 3, (na(pf) ? "—" : str.tostring(pf, "#.###")) + "  ", na(pf) ? cMute : pf >= 1.20 ? cUp : pf >= 1.00 ? cGold : cDn, false)
    f_st(0, 4, "  Drawdown max", color.new(cTxt, 35), false)
    f_st(1, 4, str.tostring(strategy.max_drawdown_percent, "#.#") + " %  ", cDn, false)
    f_st(0, 5, "  Gain / perte moy.", color.new(cTxt, 35), false)
    f_st(1, 5, str.tostring(avgW, "#") + " / " + str.tostring(avgL, "#") + "  ", cTxt, false)
    f_st(0, 6, "  R:R moyen realise", color.new(cTxt, 35), false)
    f_st(1, 6, (na(rrM) ? "—" : str.tostring(rrM, "#.##")) + "  ", cTxt, false)
    f_st(0, 7, "  Series max  G / P", color.new(cTxt, 35), false)
    f_st(1, 7, str.tostring(maxW) + " / " + str.tostring(maxL) + "  ", maxL >= 10 ? cDn : cTxt, false)

    f_st(2, 1, "  Asie      00-07", color.new(cTxt, 35), false)
    f_st(3, 1, str.tostring(array.get(sesP, 0), "#") + "  (" + str.tostring(array.get(sesN, 0)) + ")  ", array.get(sesP, 0) > 0 ? cUp : cDn, false)
    f_st(2, 2, "  Londres   07-12", color.new(cTxt, 35), false)
    f_st(3, 2, str.tostring(array.get(sesP, 1), "#") + "  (" + str.tostring(array.get(sesN, 1)) + ")  ", array.get(sesP, 1) > 0 ? cUp : cDn, false)
    f_st(2, 3, "  Chevauch. 12-16", color.new(cTxt, 35), false)
    f_st(3, 3, str.tostring(array.get(sesP, 2), "#") + "  (" + str.tostring(array.get(sesN, 2)) + ")  ", array.get(sesP, 2) > 0 ? cUp : cDn, false)
    f_st(2, 4, "  New York  16-24", color.new(cTxt, 35), false)
    f_st(3, 4, str.tostring(array.get(sesP, 3), "#") + "  (" + str.tostring(array.get(sesN, 3)) + ")  ", array.get(sesP, 3) > 0 ? cUp : cDn, false)
    f_st(2, 5, "", cMute, false)
    f_st(3, 5, "", cMute, false)
    // Les deux dernieres lignes sont la pour le test multi-actifs : elles
    // rappellent la reference et le seuil au-dela duquel on peut parler
    // d'avantage structurel plutot que d'ajustement a un seul marche.
    f_st(2, 6, "  Reference XAUUSD", color.new(cMute, 20), false)
    f_st(3, 6, "PF 1.212 · 19 ans  ", color.new(cMute, 20), false)
    f_st(2, 7, "  Robuste si", color.new(cMute, 20), false)
    f_st(3, 7, "PF > 1.10 partout  ", color.new(cMute, 20), false)


// ============================================================
// TABLEAU DEBUG — OBSERVATION SEULE
// Aucune valeur affichee ici n'est lue par une condition. Le tableau compte
// des evenements deja survenus sur l'historique charge : rien n'est estime,
// rien n'est extrapole.
//
// COMPACITE : les compteurs sont regroupes par ligne (a / b / c) plutot
// qu'etales sur une ligne chacun. 27 lignes au lieu de 43 -- le tableau
// informe sans masquer le graphique.
//
// PAS DE REPAINT. Deux familles de compteurs, gardees differemment, et c'est
// voulu :
//   - les compteurs d'ANALYSE (CHoCH, BOS, candidats OB/FVG/sweep, chaine)
//     sont incrementes sous barstate.isconfirmed : une bougie close = un
//     evenement, jamais un tick intermediaire ;
//   - les compteurs d'EVENEMENT MOTEUR (poche consommee ou evincee, OB casse
//     ou evince, FVG evince, zone creee) sont poses JUSTE APRES l'action du
//     moteur qu'ils comptent, sans garde propre. Les garder separement les
//     desynchroniserait de l'evenement : si l'action a lieu, le compteur doit
//     bouger avec elle, ni avant ni apres.
// Dans les deux cas il n'y a pas de repaint : ce sont des `var int`, et Pine
// annule les ecritures `var` a chaque tick de la bougie en cours puis rejoue
// depuis l'etat clos precedent. La valeur retenue est donc toujours celle de
// la bougie close, exactement comme pour les tableaux du moteur.
// PAS DE RISQUE DE TAMPON : le seul acces historique du code debug est
// close[i]/open[i] dans f_dbgScan, borne par swingLen exactement comme la
// boucle reelle ; et le tableau n'utilise aucune coordonnee bar_index.
// ============================================================
var table dbgT = table.new(position.middle_left, 2, 20, border_width=0)
f_dbgH(int r, string t) =>
    table.cell(dbgT, 0, r, t, text_color=cGold, text_size=size.tiny, text_halign=text.align_left, bgcolor=color.new(cGold, 88))
    table.cell(dbgT, 1, r, "", bgcolor=color.new(cGold, 88))
f_dbgR(int r, string k, string v) =>
    table.cell(dbgT, 0, r, "  " + k, text_color=color.new(cTxt, 30), text_size=size.tiny, text_halign=text.align_left, bgcolor=color.new(cBg, 8))
    table.cell(dbgT, 1, r, v + "  ", text_color=cTxt, text_size=size.tiny, text_halign=text.align_right, bgcolor=color.new(cBg, 8))

if barstate.islast and dbgOn
    int obAct = array.size(obBT) + array.size(obST) + array.size(ohBT) + array.size(ohST)
    int obMitN = 0
    if array.size(obBSt) > 0
        for i = 0 to array.size(obBSt) - 1
            if array.get(obBSt, i) >= 1
                obMitN += 1
    if array.size(obSSt) > 0
        for i = 0 to array.size(obSSt) - 1
            if array.get(obSSt, i) >= 1
                obMitN += 1
    if array.size(ohBSt) > 0
        for i = 0 to array.size(ohBSt) - 1
            if array.get(ohBSt, i) >= 1
                obMitN += 1
    if array.size(ohSSt) > 0
        for i = 0 to array.size(ohSSt) - 1
            if array.get(ohSSt, i) >= 1
                obMitN += 1
    string sl = "/"

    // timeframe.period renvoie "1", "3", "15", "240"... Libelle en clair pour
    // que quatre captures M1/M3/M5/M15 soient identifiables sans ambiguite.
    string tfLbl = timeframe.isseconds ? "S" + str.tostring(timeframe.multiplier) : timeframe.isminutes ? (timeframe.multiplier >= 60 and timeframe.multiplier % 60 == 0 ? "H" + str.tostring(int(timeframe.multiplier / 60)) : "M" + str.tostring(timeframe.multiplier)) : timeframe.isdaily ? "D1" : timeframe.isweekly ? "W1" : timeframe.ismonthly ? "MN" : timeframe.period
    // Le tableau est repagine : au-dela d'une vingtaine de lignes il deborde
    // du graphique en haut ET en bas, et les sections du bas ne sont tout
    // simplement jamais rendues visibles. table.clear efface la page
    // precedente, sans quoi les cellules d'une page persisteraient sous la
    // suivante -- les cellules d'un tableau var survivent d'une bougie a
    // l'autre tant qu'on ne les reecrit pas.
    table.clear(dbgT, 0, 0, 1, 19)

    if dbgPage == "① MOTEUR"
        f_dbgH(0, "DEBUG ① MOTEUR  ·  TF " + tfLbl + "  ·  " + str.tostring(dbgBars) + " BARS")
        f_dbgR(1, "swing " + str.tostring(swingLen) + " · fvgAge " + str.tostring(fvgMaxAge) + " · bkConf " + str.tostring(bkConfBars), "cool " + str.tostring(cooldown) + " · seq " + str.tostring(seqMaxBars))

        f_dbgH(2, "STRUCTURE")
        f_dbgR(3, "CHoCH " + sl + " BOS",                str.tostring(dbgChoch) + " " + sl + " " + str.tostring(dbgBos))
        f_dbgR(4, "Sweep>CHoCH " + sl + " CHoCH>BOS",    str.tostring(dbgSeqSC) + " " + sl + " " + str.tostring(dbgSeqCB))
        f_dbgR(5, "sequences COMPLETES",                 str.tostring(dbgSeqFull))

        f_dbgH(6, "ORDER BLOCK")
        f_dbgR(7,  "potentiels " + sl + " crees",        str.tostring(dbgObCand) + " " + sl + " " + str.tostring(dbgObMade))
        f_dbgR(8,  "rej. dep " + sl + " dbl " + sl + " cyc " + sl + " struct", str.tostring(dbgObNoDsp) + " " + sl + " " + str.tostring(dbgObDup) + " " + sl + " " + str.tostring(dbgObCycle) + " " + sl + " " + str.tostring(dbgObStruct))
        f_dbgR(9,  "non trouves — impulsion > swingLen", str.tostring(dbgObNoCnd))
        f_dbgR(10, "crees CHoCH " + sl + " CONTINUATION", str.tostring(dbgObMadeC) + " " + sl + " " + str.tostring(dbgObMadeB))
        f_dbgR(11, "actifs " + sl + " mitiges",          str.tostring(obAct) + " " + sl + " " + str.tostring(obMitN))
        f_dbgR(12, "invalides " + sl + " evinces",       str.tostring(dbgObBrk) + " " + sl + " " + str.tostring(dbgObEvict))
        f_dbgR(13, "breakers confirmes",                 str.tostring(dbgBkMade))

        f_dbgH(14, "FVG")
        f_dbgR(15, "potentiels " + sl + " crees",        str.tostring(dbgFvCand) + " " + sl + " " + str.tostring(dbgFvOk))
        f_dbgR(16, "rejetes — taille " + sl + " corps",  str.tostring(dbgFvNoGap) + " " + sl + " " + str.tostring(dbgFvNoBod))
        f_dbgR(17, "rejetes — autre condition",          str.tostring(dbgFvOther))
        f_dbgR(18, "combles " + sl + " ages " + sl + " evinces", str.tostring(dbgFvFill) + " " + sl + " " + str.tostring(dbgFvAge) + " " + sl + " " + str.tostring(dbgFvEvict))
        f_dbgR(19, "actifs",                             str.tostring(array.size(fvBT) + array.size(fvST)))

    else if dbgPage == "② ZONES"
        f_dbgH(0, "DEBUG ② ZONES  ·  TF " + tfLbl + "  ·  " + str.tostring(dbgBars) + " BARS")

        f_dbgH(1, "LIQUIDITE " + sl + " SWEEP")
        f_dbgR(2, "paires evaluees",                    str.tostring(dbgEqPair))
        f_dbgR(3, "poches EQH " + sl + " EQL",          str.tostring(dbgPockH) + " " + sl + " " + str.tostring(dbgPockL))
        f_dbgR(4, "sweeps cand. > acceptes " + sl + " rejetes", str.tostring(dbgSwCand) + " > " + str.tostring(dbgSwOk) + " " + sl + " " + str.tostring(dbgSwNoPen + dbgSwNoRej))
        f_dbgR(5, "   dont penetration " + sl + " rejet", str.tostring(dbgSwNoPen) + " " + sl + " " + str.tostring(dbgSwNoRej))
        f_dbgR(6, "poches consommees " + sl + " expirees", str.tostring(dbgPockUse) + " " + sl + " " + str.tostring(dbgPockExp))
        f_dbgR(7, "SWING SIMPLE non vus  |  ZONES",     str.tostring(dbgSwSingle) + "  |  " + str.tostring(dbgZone))

        f_dbgH(8, "POURQUOI PAS DE ZONE  (motif bloquant)")
        f_dbgR(9,  "sweep manq " + sl + " perime " + sl + " h.cycle", str.tostring(dgcSwMiss) + " " + sl + " " + str.tostring(dgcSwOld) + " " + sl + " " + str.tostring(dgcSwCyc))
        f_dbgR(10, "choch manq " + sl + " h.seq " + sl + " bos manq " + sl + " h.seq", str.tostring(dgcChMiss) + " " + sl + " " + str.tostring(dgcChSeq) + " " + sl + " " + str.tostring(dgcBoMiss) + " " + sl + " " + str.tostring(dgcBoSeq))
        f_dbgR(11, "OB manq " + sl + " FVG manq " + sl + " OB h.cyc " + sl + " FVG h.cyc", str.tostring(dgcObMiss) + " " + sl + " " + str.tostring(dgcFvMiss) + " " + sl + " " + str.tostring(dgcObCyc) + " " + sl + " " + str.tostring(dgcFvCyc))
        f_dbgR(12, "eloignes " + sl + " fib " + sl + " prem/disc " + sl + " htf", str.tostring(dgcFar) + " " + sl + " " + str.tostring(dgcFib) + " " + sl + " " + str.tostring(dgcPd) + " " + sl + " " + str.tostring(dgcHtf))
        f_dbgR(13, "score<70 " + sl + " meilleure " + sl + " deja aff. " + sl + " RIEN", str.tostring(dgcScore) + " " + sl + " " + str.tostring(dgcBetter) + " " + sl + " " + str.tostring(dgcSame) + " " + sl + " " + str.tostring(dgcOk))

        f_dbgH(14, "SWEEP PAR DIRECTION  (cand " + sl + " ok " + sl + " r.pen " + sl + " r.rej)")
        f_dbgR(15, "SELL-SIDE  (sert les BUY)", str.tostring(dbgSsCand) + " " + sl + " " + str.tostring(dbgSsOk) + " " + sl + " " + str.tostring(dbgSsNoPen) + " " + sl + " " + str.tostring(dbgSsNoRej))
        f_dbgR(16, "BUY-SIDE   (sert les SELL)", str.tostring(dbgBsCand) + " " + sl + " " + str.tostring(dbgBsOk) + " " + sl + " " + str.tostring(dbgBsNoPen) + " " + sl + " " + str.tostring(dbgBsNoRej))

        f_dbgH(17, "SENSIBILITE liqTolAtr — POCHES si le seuil valait…")
        f_dbgR(18, "EQL  .10 " + sl + " .15 " + sl + " .20 " + sl + " .25 " + sl + " .30", str.tostring(dbgTL10) + " " + sl + " " + str.tostring(dbgTL15) + " " + sl + " " + str.tostring(dbgTL20) + " " + sl + " " + str.tostring(dbgTL25) + " " + sl + " " + str.tostring(dbgTL30))
        f_dbgR(19, "EQH  .10 " + sl + " .15 " + sl + " .20 " + sl + " .25 " + sl + " .30", str.tostring(dbgTH10) + " " + sl + " " + str.tostring(dbgTH15) + " " + sl + " " + str.tostring(dbgTH20) + " " + sl + " " + str.tostring(dbgTH25) + " " + sl + " " + str.tostring(dbgTH30))

    else if dbgPage == "③ CYCLE"
        f_dbgH(0, "DEBUG ③ CYCLE  ·  TF " + tfLbl + "  ·  " + str.tostring(dbgBars) + " BARS")

        f_dbgH(1, "CHAINE PAR BOUGIE  (BUY lit swpDnIdx)")
        f_dbgR(2, "BUY  sw absent " + sl + " perime " + sl + " frais", str.tostring(dbgBuySwNone) + " " + sl + " " + str.tostring(dbgBuySwOld) + " " + sl + " " + str.tostring(dbgBuySwOk))
        f_dbgR(3, "   fresh OK " + sl + " fresh KO " + sl + " BOS OK", str.tostring(dbgBuyFreshOk) + " " + sl + " " + str.tostring(dbgBuyFreshKo) + " " + sl + " " + str.tostring(dbgBuyBosOk))
        f_dbgR(4, "SELL sw absent " + sl + " perime " + sl + " frais", str.tostring(dbgSellSwNone) + " " + sl + " " + str.tostring(dbgSellSwOld) + " " + sl + " " + str.tostring(dbgSellSwOk))
        f_dbgR(5, "   fresh OK " + sl + " fresh KO " + sl + " BOS OK", str.tostring(dbgSellFreshOk) + " " + sl + " " + str.tostring(dbgSellFreshKo) + " " + sl + " " + str.tostring(dbgSellBosOk))
        f_dbgR(6, "age sweep SS " + sl + " BS (bougies)", (na(swpDnIdx) ? "—" : str.tostring(bar_index - swpDnIdx)) + " " + sl + " " + (na(swpUpIdx) ? "—" : str.tostring(bar_index - swpUpIdx)))

        f_dbgH(7, "CHOCH EVENT  (par CHoCH, pas par bougie)")
        f_dbgR(8,  "BUY  total " + sl + " fresh OK " + sl + " fresh KO", str.tostring(dbgEvBTot) + " " + sl + " " + str.tostring(dbgEvBTot - dbgEvBKo) + " " + sl + " " + str.tostring(dbgEvBKo))
        f_dbgR(9,  "   refus BOS>sw " + sl + " sw absent " + sl + " (dont perime)", str.tostring(dbgEvBKoB) + " " + sl + " " + str.tostring(dbgEvBKoN) + " " + sl + " (" + str.tostring(dbgEvBKoO) + ")")
        f_dbgR(10, "   chaine deja compl. " + sl + " freshOK mais perime", str.tostring(dbgEvBDone) + " " + sl + " " + str.tostring(dbgEvBOkO))
        f_dbgR(11, "SELL total " + sl + " fresh OK " + sl + " fresh KO", str.tostring(dbgEvSTot) + " " + sl + " " + str.tostring(dbgEvSTot - dbgEvSKo) + " " + sl + " " + str.tostring(dbgEvSKo))
        f_dbgR(12, "   refus BOS>sw " + sl + " sw absent " + sl + " (dont perime)", str.tostring(dbgEvSKoB) + " " + sl + " " + str.tostring(dbgEvSKoN) + " " + sl + " (" + str.tostring(dbgEvSKoO) + ")")
        f_dbgR(13, "   chaine deja compl. " + sl + " freshOK mais perime", str.tostring(dbgEvSDone) + " " + sl + " " + str.tostring(dbgEvSOkO))

        f_dbgH(14, "SWEEP -> CHAINE  (par SWEEP, pas par bougie)")
        f_dbgR(15, "BUY  sweeps " + sl + " > CHoCH " + sl + " > BOS", str.tostring(dbgSwBTot) + " " + sl + " " + str.tostring(dbgSwBCh) + " " + sl + " " + str.tostring(dbgSwBBos))
        f_dbgR(16, "   remplaces " + sl + " refus JUSTE " + sl + " refus FAUX", str.tostring(dbgSwBRepl) + " " + sl + " " + str.tostring(dbgEvBKoT) + " " + sl + " " + str.tostring(dbgEvBKoF))
        f_dbgR(17, "SELL sweeps " + sl + " > CHoCH " + sl + " > BOS", str.tostring(dbgSwSTot) + " " + sl + " " + str.tostring(dbgSwSCh) + " " + sl + " " + str.tostring(dbgSwSBos))
        f_dbgR(18, "   remplaces " + sl + " refus JUSTE " + sl + " refus FAUX", str.tostring(dbgSwSRepl) + " " + sl + " " + str.tostring(dbgEvSKoT) + " " + sl + " " + str.tostring(dbgEvSKoF))

    else if dbgPage == "④ SWEEP"
        int pkVivL = array.size(eqlL)
        int pkVivH = array.size(eqhL)
        f_dbgH(0, "DEBUG ④ SWEEP  ·  TF " + tfLbl + "  ·  " + str.tostring(dbgBars) + " BARS")

        f_dbgH(1, "SELL-SIDE : EQL " + sl + "> sweep bas " + sl + "> setups BUY")
        f_dbgR(2, "paires evaluees " + sl + " poches formees", str.tostring(dbgPrL) + " " + sl + " " + str.tostring(dbgPockL))
        f_dbgR(3, "poches: evincees " + sl + " sweep " + sl + " penetrees ss rejet", str.tostring(dbgPkEvL) + " " + sl + " " + str.tostring(dbgPkSwL) + " " + sl + " " + str.tostring(dbgPkKiL))
        f_dbgR(4, "bougies cand " + sl + " ok " + sl + " r.pen " + sl + " r.rej", str.tostring(dbgSsCand) + " " + sl + " " + str.tostring(dbgSsOk) + " " + sl + " " + str.tostring(dbgSsNoPen) + " " + sl + " " + str.tostring(dbgSsNoRej))
        f_dbgR(5, "SWEEPS acceptes " + sl + " bon cote " + sl + " mauvais cote", str.tostring(dbgSwBTot) + " " + sl + " " + str.tostring(dbgSwBSideOk) + " " + sl + " " + str.tostring(dbgSwBSideKo))
        f_dbgR(6, "sans CHoCH " + sl + " CHoCH perime " + sl + "> CHoCH " + sl + "> BOS", str.tostring(dbgSwBNoCh) + " " + sl + " " + str.tostring(dbgSwBChOld) + " " + sl + " " + str.tostring(dbgSwBCh) + " " + sl + " " + str.tostring(dbgSwBBos))

        f_dbgH(7, "BUY-SIDE : EQH " + sl + "> sweep haut " + sl + "> setups SELL")
        f_dbgR(8,  "paires evaluees " + sl + " poches formees", str.tostring(dbgPrH) + " " + sl + " " + str.tostring(dbgPockH))
        f_dbgR(9,  "poches: evincees " + sl + " sweep " + sl + " penetrees ss rejet", str.tostring(dbgPkEvH) + " " + sl + " " + str.tostring(dbgPkSwH) + " " + sl + " " + str.tostring(dbgPkKiH))
        f_dbgR(10, "bougies cand " + sl + " ok " + sl + " r.pen " + sl + " r.rej", str.tostring(dbgBsCand) + " " + sl + " " + str.tostring(dbgBsOk) + " " + sl + " " + str.tostring(dbgBsNoPen) + " " + sl + " " + str.tostring(dbgBsNoRej))
        f_dbgR(11, "SWEEPS acceptes " + sl + " bon cote " + sl + " mauvais cote", str.tostring(dbgSwSTot) + " " + sl + " " + str.tostring(dbgSwSSideOk) + " " + sl + " " + str.tostring(dbgSwSSideKo))
        f_dbgR(12, "sans CHoCH " + sl + " CHoCH perime " + sl + "> CHoCH " + sl + "> BOS", str.tostring(dbgSwSNoCh) + " " + sl + " " + str.tostring(dbgSwSChOld) + " " + sl + " " + str.tostring(dbgSwSCh) + " " + sl + " " + str.tostring(dbgSwSBos))

        f_dbgH(13, "CONSERVATION  (les deux nombres doivent etre egaux)")
        f_dbgR(14, "EQL creees  |  ev+sw+ki+vivantes", str.tostring(dbgPockL) + "  |  " + str.tostring(dbgPkEvL + dbgPkSwL + dbgPkKiL + pkVivL))
        f_dbgR(15, "EQH creees  |  ev+sw+ki+vivantes", str.tostring(dbgPockH) + "  |  " + str.tostring(dbgPkEvH + dbgPkSwH + dbgPkKiH + pkVivH))
        f_dbgR(16, "poches vivantes EQL " + sl + " EQH", str.tostring(pkVivL) + " " + sl + " " + str.tostring(pkVivH))
        f_dbgR(17, "SWING SIMPLE non vus (hors EQH" + sl + "EQL)", str.tostring(dbgSwSingle))
        f_dbgR(18, "liqMax " + str.tostring(liqMax) + " · pen " + str.tostring(sweepMinPen) + " · rej " + str.tostring(sweepReject), "seq " + str.tostring(seqMaxBars))

    else if dbgPage == "⑤ SIMPLE"
        int pvVivL = array.size(pvLL)
        int pvVivH = array.size(pvHL)
        f_dbgH(0, "DEBUG ⑤ SWING SIMPLE  ·  TF " + tfLbl + "  ·  " + str.tostring(dbgBars) + " BARS")

        f_dbgH(1, "SELL-SIDE : swing LOW simple " + sl + "> setups BUY")
        f_dbgR(2, "ajoutes " + sl + " dedoublonnes " + sl + " purges", str.tostring(dbgPvAddL) + " " + sl + " " + str.tostring(dbgPvDupL) + " " + sl + " " + str.tostring(dbgPvPurL))
        f_dbgR(3, "sweep " + sl + " penetres ss rejet " + sl + " evinces", str.tostring(dbgPvSwL) + " " + sl + " " + str.tostring(dbgPvKiL) + " " + sl + " " + str.tostring(dbgPvEvL))
        f_dbgR(4, "vivants  |  bougies penetration insuff.", str.tostring(pvVivL) + "  |  " + str.tostring(dbgPvNoPenL))

        f_dbgH(5, "BUY-SIDE : swing HIGH simple " + sl + "> setups SELL")
        f_dbgR(6, "ajoutes " + sl + " dedoublonnes " + sl + " purges", str.tostring(dbgPvAddH) + " " + sl + " " + str.tostring(dbgPvDupH) + " " + sl + " " + str.tostring(dbgPvPurH))
        f_dbgR(7, "sweep " + sl + " penetres ss rejet " + sl + " evinces", str.tostring(dbgPvSwH) + " " + sl + " " + str.tostring(dbgPvKiH) + " " + sl + " " + str.tostring(dbgPvEvH))
        f_dbgR(8, "vivants  |  bougies penetration insuff.", str.tostring(pvVivH) + "  |  " + str.tostring(dbgPvNoPenH))

        f_dbgH(9, "CONSERVATION  (les deux nombres doivent etre egaux)")
        f_dbgR(10, "LOW  ajoutes  |  sw+ki+ev+pur+vivants", str.tostring(dbgPvAddL) + "  |  " + str.tostring(dbgPvSwL + dbgPvKiL + dbgPvEvL + dbgPvPurL + pvVivL))
        f_dbgR(11, "HIGH ajoutes  |  sw+ki+ev+pur+vivants", str.tostring(dbgPvAddH) + "  |  " + str.tostring(dbgPvSwH + dbgPvKiH + dbgPvEvH + dbgPvPurH + pvVivH))

        f_dbgH(12, "LES DEUX SOURCES  (poches " + sl + " swing simple)")
        f_dbgR(13, "sweeps SELL-SIDE  EQL " + sl + " swing LOW", str.tostring(dbgPkSwL) + " " + sl + " " + str.tostring(dbgPvSwL))
        f_dbgR(14, "sweeps BUY-SIDE   EQH " + sl + " swing HIGH", str.tostring(dbgPkSwH) + " " + sl + " " + str.tostring(dbgPvSwH))
        f_dbgR(15, "SWEEPS acceptes   BUY " + sl + " SELL", str.tostring(dbgSwBTot) + " " + sl + " " + str.tostring(dbgSwSTot))
        f_dbgR(16, "BUY   > CHoCH " + sl + " > BOS", str.tostring(dbgSwBCh) + " " + sl + " " + str.tostring(dbgSwBBos))
        f_dbgR(17, "SELL  > CHoCH " + sl + " > BOS", str.tostring(dbgSwSCh) + " " + sl + " " + str.tostring(dbgSwSBos))
        f_dbgR(18, "ZONES  |  SWING SIMPLE non vus (debug)", str.tostring(dbgZone) + "  |  " + str.tostring(dbgSwSingle))

    else
        int obActN = array.size(obBT) + array.size(obST)
        int obHisN = array.size(ohBT) + array.size(ohST)
        int osKo   = dbgOsTot - dbgOsOk
        f_dbgH(0, "DEBUG ⑥ OB  ·  TF " + tfLbl + "  ·  " + str.tostring(dbgBars) + " BARS")

        f_dbgH(1, "obSameCycle — taux de base (cote du biais)")
        f_dbgR(2, "evaluations " + sl + " OK " + sl + " KO", str.tostring(dbgOsTot) + " " + sl + " " + str.tostring(dbgOsOk) + " " + sl + " " + str.tostring(osKo))

        f_dbgH(3, "OB HORS CYCLE — cause exacte")
        f_dbgR(4, "ancre na " + sl + " obCr<chIdx " + sl + " pvIdx>obCr", str.tostring(dbgOsNa) + " " + sl + " " + str.tostring(dbgOsCh) + " " + sl + " " + str.tostring(dbgOsPv))
        f_dbgR(5, "dont les DEUX a la fois (recouvrement)", str.tostring(dbgOsBoth))
        f_dbgR(6, "na+ch+pv-both  |  OB h.cyc (doit etre egal)", str.tostring(dbgOsNa + dbgOsCh + dbgOsPv - dbgOsBoth) + "  |  " + str.tostring(dgcObCyc))

        f_dbgH(7, "CREATION DES ORDER BLOCKS")
        f_dbgR(8,  "potentiels " + sl + " crees", str.tostring(dbgObCand) + " " + sl + " " + str.tostring(dbgObMade))
        f_dbgR(9,  "rejetes deplacement " + sl + " doublon", str.tostring(dbgObNoDsp) + " " + sl + " " + str.tostring(dbgObDup))
        f_dbgR(10, "refus cycle " + sl + " structure (avant recherche)", str.tostring(dbgObCycle) + " " + sl + " " + str.tostring(dbgObStruct))
        f_dbgR(11, "aucune bougie source dans swingLen", str.tostring(dbgObNoCnd))
        f_dbgR(12, "crees CHoCH " + sl + " CONTINUATION", str.tostring(dbgObMadeC) + " " + sl + " " + str.tostring(dbgObMadeB))
        f_dbgR(13, "actifs " + sl + " historique", str.tostring(obActN) + " " + sl + " " + str.tostring(obHisN))
        f_dbgR(14, "invalides " + sl + " evinces " + sl + " breakers", str.tostring(dbgObBrk) + " " + sl + " " + str.tostring(dbgObEvict) + " " + sl + " " + str.tostring(dbgBkMade))
        f_dbgR(15, "OB manquant  |  OB hors cycle", str.tostring(dgcObMiss) + "  |  " + str.tostring(dgcObCyc))
