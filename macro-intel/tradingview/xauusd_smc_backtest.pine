//@version=6
// ============================================================
// VERSION BACKTEST (strategy) de "XAUUSD SMC Confluence Signals"
// ------------------------------------------------------------
// Ce fichier est la conversion EXACTE de l'indicateur en STRATEGIE
// TradingView, afin de mesurer ses performances dans le Strategy Tester.
//
//   >>> AUCUNE logique de signal n'a ete modifiee. <<<
//   Les modules 1 a 12, le score /100, les regles eliminatoires, les
//   filtres, le Precision Engine, le Stop-Loss Engine, le buffer
//   d'execution, le TP Engine et tous les affichages sont repris
//   LIGNE POUR LIGNE. buySignal / sellSignal, l'entree, le SL et les
//   TP1 / TP2 / TP Final sont exactement ceux de l'indicateur.
//
//   Ce qui est AJOUTE (et uniquement cela) :
//     1. declaration `strategy(...)` a la place de `indicator(...)`
//     2. un groupe d'inputs "🔁 BACKTEST" (taille de position, ordres,
//        repartition des TP, break-even, periode testee, protections)
//     3. l'envoi des ordres : strategy.entry sur buySignal / sellSignal
//        et strategy.exit (TP1 / TP2 / TP Final + SL commun) sur la
//        position ouverte
//     4. la gestion des ordres limites en attente (expiration/annulation)
//
//   REGLE : mettre "Trader uniquement les signaux A+" sur OFF, le trailing
//   (I1) et le filtre de cout (I2) sur OFF reproduit exactement les fleches
//   BUY / SELL de l'indicateur, une position par fleche.
//
// ---- AMELIORATIONS I1 / I2 (mesurees sur M3, 2020-2026, 1 967 positions) ----
//   Le premier backtest donne une esperance de -0.009 R par trade (t-stat
//   -0.43 : indiscernable de zero) AVANT frais, et un compte souffle des que
//   le spread reel est applique. Deux leviers en decoulent, chacun activable
//   separement :
//     I1 (btTrailOn, ON) - la derniere tranche suit le prix au lieu de buter
//        sur le TP Final fixe. Mesure : les positions gagnantes atteignent
//        1.33 R de MFE mediane mais n'en realisent que 0.79 R, soit +0.75 R
//        abandonnes par trade ; 18 % des gagnants depassent 2 R de MFE.
//     I2 (btCostOn, ON) - refuse les signaux dont le stop est si court que le
//        cout d'execution mange plus de X % du risque. Mesure : l'esperance
//        BRUTE est plate quelle que soit la taille du stop, mais l'esperance
//        NETTE passe de -0.102 R (stops les plus serres) a -0.014 R (les plus
//        larges). Ce filtre se neutralise tout seul sur les grandes UT.
//   ECARTE volontairement, parce que les donnees le contredisent :
//     - resserrer le stop : 32 % des trades gagnants reculent au-dela de
//       -0.5 R avant de payer, un stop plus court les tuerait ;
//     - poser un time-stop : les perdants sont PLUS COURTS que les gagnants
//       (16 contre 31 barres de mediane) et les positions encore ouvertes
//       apres N barres ont une esperance POSITIVE.
//   ATTENTION : I1 et I2 ameliorent la STRUCTURE du resultat, ils ne creent
//   pas d'edge. Le score /100 ne discrimine rien (correlation score/resultat
//   -0.004), donc la rentabilite reste a demontrer, en priorite sur une unite
//   de temps plus grande ou le cout d'execution pese beaucoup moins lourd.
//
// ---- NOTES D'EXACTITUDE DU BACKTEST (a lire avant d'interpreter) ----
//   * Commission et slippage se reglent dans l'onglet Proprietes du
//     Strategy Tester (non codes en dur ici) : mets-y le spread + le
//     slippage reel de ton broker, sinon les resultats sont optimistes.
//   * process_orders_on_close = true : un ordre au marche est execute a
//     la cloture de la bougie du signal (pas a l'ouverture suivante).
//   * Mode d'entree "Limite" : TradingView ne peut attacher le SL/TP
//     qu'a partir de la bougie SUIVANT le remplissage de l'ordre limite
//     (limitation du moteur, pas du script). L'effet est globalement
//     legerement PESSIMISTE (sortie possiblement plus tardive). Le mode
//     "Marche" n'a pas cette limitation.
//   * Sans "Bar Magnifier" (abonnement Premium), quand SL et TP sont
//     touches dans la MEME bougie, TradingView suppose le pire cas.
//   * Le backtest suppose que chaque signal est pris : verifie que le
//     nombre de trades est statistiquement suffisant (> 100) avant de
//     conclure quoi que ce soit.
// ============================================================
strategy("XAUUSD SMC Confluence — BACKTEST", shorttitle="SMC Gold BT", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, initial_capital=10000, currency=currency.USD, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=true, close_entries_rule="ANY", margin_long=0, margin_short=0, commission_type=strategy.commission.percent, commission_value=0.0, slippage=0)

// ============================================================
// CARTE DE VALIDATION A/B  (backtests d'ablation - a valider avant de garder)
// Chaque amelioration est INDEPENDANTE : la mettre a sa valeur "baseline" ci-dessous
// restaure exactement le comportement d'origine. Tester une seule a la fois.
//
//   >>> BASELINE (comportement d'origine, tout desactive) :
//       sweepQualityOn=false | fvgMinAtr=0 | entryZoneGate=false
//       pePrecision=false | slSmartOn=false | slExecBufOn=false
//       newsAutoOn=false | chopFilterOn=false
//       (dxyOn/macroOn/newsOn = filtres macro pre-existants, ON par defaut)
//
//   AFFECTENT LES SIGNAUX (quels trades sont pris) :
//     - sweepQualityOn  : filtre les faux liquidity sweeps           (defaut ON)
//     - fvgMinAtr        : taille minimale des FVG (0 = off)          (defaut 0.10)
//     - entryZoneGate    : exige un retour en zone pour entrer        (defaut ON)
//     - newsAutoOn       : blocage auto NFP (si newsMode=Bloquer)     (defaut OFF)
//     - chopFilterOn     : anti-consolidation ADX (range = pas de trade) (defaut OFF)
//   AFFECTENT L'EXECUTION (entree / stop, pas quels trades) - EMPILEMENT :
//     - pePrecision      : entree limite + SL de precision           (defaut ON)
//     - slSmartOn        : SL structurel anti-chasse (par-dessus pePrecision) (defaut ON)
//     - slExecBufOn      : buffer d'execution compte reel sur le SL (TP rescales, R:R identique) (defaut ON)
//       -> ablation propre : baseline < +pePrecision < +slSmartOn < +slExecBufOn
//   AFFICHAGE UNIQUEMENT (zero impact sur les trades, ne pas backtester) :
//     - pzoOn (zones predictives) | azOn (zones d'anticipation)
//     - lwOn (avertissement "entree tardive" : info seule, ne bloque aucun signal)
// ============================================================
// ============================================================
// XAU/USD - SMART MONEY CONCEPTS CONFLUENCE SIGNAL ENGINE
// BOS / CHoCH + Fair Value Gaps + Order Blocks + Liquidity Sweeps + Momentum Oscillator
// v3 : fix accumulation d'objets graphiques (v1/v2 laissaient tous les anciens
//      boxes/labels s'empiler a l'infini -> chart illisible). Chaque zone/label
//      ne garde maintenant que sa version la plus recente.
// v4 : Order Block se cree maintenant aussi sur CHoCH (pas seulement BOS) ->
//      un retournement de structure peut de nouveau generer un signal.
//      Le toggle "Show Order Block zones" ne controle plus QUE l'affichage
//      (avant, le decocher desactivait aussi le scoring et les entrees, contrairement au FVG).
//      bullSignalFired/bearSignalFired se reinitialisent aussi sur CHoCH.
// v5 : migration Pine Script v6 (aucune logique de signal modifiee) +
//      MODULE 1 - MARKET STRUCTURE INSTITUTIONNELLE :
//        - labels HH / HL / LH / LL sur les swings confirmes
//        - historique optionnel des BOS / CHoCH (avant : seul le dernier restait)
//        - analyse de structure multi-timeframe (H1 contexte / M15 structure /
//          M5 execution) via request.security sur barres CLOTUREES -> zero repaint
//        - panneau dedie : Tendance H1 / Structure M15 / Signal M5 / structure chart
// v6 : MODULE 2 - LIQUIDITY ENGINE :
//        - zones de liquidite : Equal Highs / Equal Lows (pivots quasi-egaux,
//          tolerance en fraction d'ATR), Previous Day High/Low, Previous Week
//          High/Low (uniquement sur periodes cloturees -> zero repaint)
//        - sweeps de ces zones : meche au-dela + cloture de retour, label avec
//          la source (EQH/EQL/PDH/PDL/PWH/PWL), le sens (haussier/baissier)
//          et la mention (rejet) si la bougie cloture dans la moitie opposee
//        - regle "sweep -> BOS/CHoCH" : un BOS/CHoCH precede d'un sweep recent
//          est marque d'un losange ; option +1 point de confluence (defaut ON,
//          le score max passe alors a 5) et option filtre STRICT (defaut OFF :
//          aucun signal sans cassure adossee a un sweep)
// v7 : MODULE 3 - SMART MONEY CONCEPTS :
//        - Breaker Blocks : un Order Block invalide devient une zone breaker
//          inversee (OB haussier casse -> breaker baissier et vice-versa)
//        - Imbalances : bougies de displacement (corps >= ATR x seuil)
//        - Premium / Discount : range = dernier swing high / swing low,
//          equilibre a 50%, zones affichees + filtre optionnel (defaut OFF :
//          BUY seulement en discount / SELL seulement en premium)
//        - Setup A+ : sweep de liquidite -> BOS/CHoCH -> retour dans OB/FVG,
//          marque "A+" sur le signal (les OB et FVG existants sont inchanges)
// v8 : MODULE 4 - WYCKOFF :
//        - detection de range : aucune cassure de structure pendant N barres
//          -> range borne par les derniers swings confirmes (boite grise)
//        - classification de phase : tendance precedente baissiere ->
//          "Accumulation ?", haussiere -> "Distribution ?", puis confirmation
//          par les figures : Spring / SOS -> Accumulation (ou Reaccumulation
//          si la tendance precedente etait haussiere), Upthrust / SOW ->
//          Distribution (ou Redistribution si tendance precedente baissiere)
//        - sortie de range : cloture au-dela des bornes ou BOS/CHoCH ->
//          phase "Markup" / "Markdown"
//        - filtre de contexte (defaut ON) : bloque uniquement les signaux
//          CONTRAIRES a la phase (ex : pas de SELL en accumulation) ; hors
//          range, aucun blocage
//        - setup fort "WY+" : phase + figure + sweep->BOS/CHoCH alignes
//          (ex : Accumulation + Spring + Sweep + CHoCH = achat fort)
// v9 : MODULE 5 - FILTRES PRO :
//        - Volume : ratio volume/SMA memorise sur chaque BOS/CHoCH ; une
//          cassure sous le seuil est etiquetee "FAKE?" et (filtre ON par
//          defaut) les signaux issus de cette cassure sont bloques
//        - VWAP session : trace + biais dans le dashboard ; filtre optionnel
//          (OFF par defaut) BUY au-dessus / SELL en dessous uniquement
//        - ATR : filtre de volatilite (ON par defaut) qui ne bloque que les
//          marches trop calmes (ATR < moyenne x seuil)
//        - Sessions : Londres / New York / Kill Zones surlignees ; filtre
//          optionnel (OFF par defaut) : signaux uniquement en session ou
//          uniquement en kill zone
//        Chaque filtre laisse passer si la donnee est indisponible (volume
//        absent, VWAP na...) pour ne jamais supprimer de bonnes opportunites.
// v10 : MODULE 6 - MOTEUR DE DECISION PROFESSIONNEL (score /100) :
//        - plus aucun signal base sur un seul indicateur : 8 composants notes
//          et additionnes -> Liquidite 20 + BOS/CHoCH 20 + OB/FVG 15 +
//          Wyckoff 15 + Tendance HTF 10 + Volume 5 + VWAP 5 +
//          ATR/Session 10 = 100 points
//        - 2 regles ELIMINATOIRES : aucun signal sans sweep de liquidite
//          recent, aucun signal sans confirmation structurelle (BOS/CHoCH)
//        - niveaux : 90-100 = signal A+ (affiche + alerte TradingView) /
//          80-89 = affichage uniquement, pas d'alerte / <80 = aucun signal
//        - chaque signal affiche : BUY/SELL, score /100, raisons detaillees
//          (points de chaque composant) et niveau de confiance
//        - remplace l'ancien score de confluence /4-5 (inputs minConfluence,
//          useOscFilter, oscLookback et liqLookback retires ; la validite du
//          sweep est desormais "Sweep validity for decision" du module 6 ;
//          l'oscillateur reste visible dans le dashboard). Les anciens
//          filtres binaires ON/OFF (EMA, HTF,
//          Premium/Discount, Wyckoff, volume, VWAP, ATR, sessions) ne
//          bloquent plus les signaux : leur information est desormais
//          integree au score. Les composants dont la donnee est indisponible
//          (volume absent, VWAP na...) recoivent une note neutre partielle.
//        - l'ancien marqueur "A+" (sweep -> BOS/CHoCH -> OB/FVG) est renomme
//          "SMC+" pour ne pas le confondre avec le niveau A+ du score
// v11 : RETRAIT COMPLET DU MODULE 13 (Gold Futures GC1! / COMEX) :
//        - TradingView refusait la CREATION d'alerte tant que le script
//          contenait une reference au symbole COMEX:GC1! (abonnement CME requis),
//          meme le module desactive. Le module etant OFF par defaut, il est
//          desormais ENTIEREMENT retire du code :
//            * suppression des inputs gcOn / gcSym / gcRes / gcMode et de la
//              requete request.security vers le Gold Futures ;
//            * suppression des filtres gcBuyOk / gcSellOk sur les signaux ;
//            * suppression de l'option "Volume reel GC1! (COMEX)" (input
//              pfVolSource) et de la requete de volume GC1! -> le filtre volume
//              utilise le volume natif du symbole affiche ;
//            * suppression de la ligne "Gold GC1!" du tableau de bord.
//        - AUCUNE logique de trading modifiee par rapport au baseline : le
//          module etant OFF par defaut, aucune confirmation inter-marche
//          n'etait active. Le score /100, les regles eliminatoires, les seuils
//          et les entrees/SL/TP restent identiques. Plus aucune reference COMEX
//          -> l'alerte se cree sans aucun abonnement aux donnees CME.
// v12 : BUFFER D'EXECUTION COMPTE REEL sur le STOP-LOSS (fiabilite en reel) :
//        - probleme : en execution reelle, un SL trop proche de l'entree se fait
//          sortir par le spread, le slippage ou une petite meche, avant que le
//          trade parte au TP. Ajout d'un buffer INTELLIGENT et ADAPTATIF :
//            buffer = max( ATR x mult (composante volatilite, plafonnee) ,
//                          plancher spread/slippage fixe configurable )
//          -> se resserre en marche calme, s'elargit en marche volatil, sans
//          jamais descendre sous le cout d'execution reel du broker.
//        - les TAKE-PROFITS sont AUTOMATIQUEMENT recalcules : le multiple R de
//          chaque TP est memorise avant l'elargissement du SL puis reprojete sur
//          le nouveau risque -> le ratio R:R reste EXACTEMENT identique (aucune
//          degradation risque/rendement, seule la distance absolue augmente).
//        - AUCUN signal touche : le buffer s'applique APRES le declenchement du
//          signal, uniquement sur les niveaux d'execution (SL/TP). Le score /100,
//          les regles eliminatoires, les seuils, les conditions d'entree et le
//          prix d'entree sont STRICTEMENT inchanges.
//        - nouveaux inputs (groupe "Buffer d'execution compte reel") :
//          slExecBufOn (ON par defaut), x ATR adaptatif (0.10), plancher spread
//          (0.0, a regler selon le broker), plafond x ATR (0.5). slExecBufOn=OFF
//          restaure le SL d'origine exact.
// v13 : AVERTISSEMENT "ENTREE TARDIVE" (filtre secondaire, INFO seule) :
//        - detecte les signaux techniquement valides mais potentiellement pris
//          TROP TARD (prix deja en fin d'impulsion) et affiche un avertissement
//          "⚠️ Trade a risque - Entree tardive". Ne bloque JAMAIS le trade, ne
//          modifie NI le signal, NI le score, NI l'entree, NI les filtres.
//        - INDEPENDANT du score : un signal a 85-90 % peut rester affiche ET
//          recevoir l'avertissement s'il est sur-etendu.
//        - trois axes (aucun ne touche au score) : sur-extension du mouvement en
//          cours vs ATR ; distance a la derniere structure (plus bas/haut recent) ;
//          achat en premium profond / vente en discount profond (position dans le
//          range). Le signal est juge tardif si l'un des axes depasse son seuil.
//        - affichage : plotshape "⚠️ Tardif" sur la fleche, ligne ajoutee dans
//          l'etiquette de trade, ligne "Contexte" dans le tableau de bord, et
//          mention " | ⚠️ ENTREE TARDIVE" dans l'alerte. OFF (lwOn) = rien affiche.
//        - nouveaux inputs (groupe "Avertissement entree tardive") : lwOn (ON),
//          fenetre d'impulsion, seuil sur-extension (ATR), seuil premium/discount.
//        - CALIBRAGE AUTO PAR TIMEFRAME (lwAutoTf, ON par defaut) : les 3 seuils
//          s'adaptent a l'UT du graphique (presets calibres or) -> M1: 30/3.5/80,
//          M5: 25/4.0/78, M15: 20/4.5/75, M30: 18/5.0/73, H1: 15/5.5/70
//          (fenetre barres / sur-extension ATR / premium %). UT hors liste =
//          preset le plus proche. OFF = valeurs manuelles. Purement d'affichage,
//          zero impact backtest.
// A tester en demo / backtest avant tout usage en reel.
// ============================================================

// ================= INPUTS =================
// ================= ⓪ AMELIORATIONS (audit) — interrupteurs A/B =================
// Chaque amelioration issue de l'audit est INDEPENDANTE et reversible. Mettre TOUS
// les toggles de ce groupe a leur valeur "baseline" (indiquee) reproduit EXACTEMENT
// le comportement de xauusd_smc_v14_baseline.pine. Tester une amelioration a la fois.
grpAudit = "⓪ AMELIORATIONS (audit) — interrupteurs A/B"
// B1 : corrige le faux BOS/CHoCH declenche quand le niveau de swing vient de changer
//      (ta.crossover sur un niveau MOBILE). Baseline = false.
fixBreakOn = input.bool(true, "B1 · Anti faux BOS/CHoCH (niveau de swing stable)", group=grpAudit, tooltip="ON : une cassure n'est validee que si le niveau de swing casse etait DEJA en place a la barre precedente (niveau stable). Elimine les faux BOS/CHoCH provoques par la simple mise a jour d'un pivot sous le prix. OFF (false) = comportement d'origine exact (baseline).")
// B2 : le toggle d'AFFICHAGE showLiq ne doit plus gater la DETECTION des sweeps de
//      swing (qui alimente le score et le verrou eliminatoire). Baseline = false.
fixSweepGateOn = input.bool(true, "B2 · Detection des sweeps de swing independante de l'affichage", group=grpAudit, tooltip="ON : les sweeps de swing (liqSweepLow/High) sont TOUJOURS detectes pour le score et les verrous, meme si 'Mark liquidity sweeps' (affichage) est decoche. Seul le label a l'ecran reste controle par l'affichage. OFF (false) = comportement d'origine (decocher l'affichage desactivait aussi la detection).")
// B3 : garder les TP sur leur niveau STRUCTUREL apres l'elargissement du SL par le
//      buffer d'execution (au lieu de les re-projeter en multiples R purs, ce qui
//      les eloigne de la liquidite visee). ARBITRAGE (hit-rate vs R:R) -> baseline
//      = false (defaut OFF, incertain, a valider par backtest).
fixTpSnapOn = input.bool(false, "B3 · Garder les TP sur la structure (ne pas rescaler apres buffer SL)", group=grpAudit, tooltip="ON : quand le buffer d'execution elargit le SL, les TP RESTENT sur les niveaux structurels calcules par le TP Engine (liquidite/swings) au lieu d'etre repousses pour conserver le meme R:R. Le R:R affiche baisse legerement mais les cibles restent sur la vraie structure (meilleur hit-rate potentiel). OFF (false) = comportement d'origine (R:R strictement conserve, TP repousses). Incertain : mesurer en backtest.")
// S1 : confiance affichee CALIBREE. AFFICHAGE UNIQUEMENT (zero impact signaux/score/
//      seuils/alertes). Le score /100 garde ~25 pts structurellement pre-acquis par
//      tout signal eligible (verrous : sweep 10 + structure 15) -> la "Probabilite"
//      brute = score surestime. On rescale au-dela de ce plancher. Baseline = false.
scoreRealistOn = input.bool(false, "S1 · Confiance affichee calibree (affichage seul)", group=grpAudit, tooltip="ON : la valeur 'Probabilite' du panneau est recalculee au-dessus du plancher structurel (points garantis par les verrous eliminatoires) pour ne plus surestimer la confiance. N'affecte NI le score /100, NI les seuils, NI les signaux, NI les alertes : purement d'affichage. OFF (false) = affichage d'origine (Probabilite = score brut).")
scoreFloorPts  = input.int(25, "S1 · Plancher structurel du score (pts garantis)", minval=0, maxval=60, group=grpAudit, tooltip="Points qu'un signal eligible possede DEJA par construction (verrous : sweep recent 10 + cassure structurelle 15 = 25). La confiance calibree mappe [plancher..100] du score sur [1..99] %. Ajustable pour ne pas figer une constante cachee. Utilise seulement si S1 est ON.")
// B1b : meme correctif que B1 mais sur la structure MULTI-TIMEFRAME (f_msStructure),
//       qui alimente le score via msCtxTrend/msCtxEvent. Toggle SEPARE car il touche
//       le module de score. Baseline = false (defaut OFF, a valider par backtest).
fixBreakMtfOn = input.bool(false, "B1b · Anti faux BOS/CHoCH sur la structure multi-timeframe", group=grpAudit, tooltip="Applique la garde de stabilite du niveau (comme B1) a la detection de cassure MTF (H1/M15/M5) utilisee par le tableau Market Structure et le score HTF. OFF (false) = comportement d'origine. Defaut OFF car il modifie une entree du score : a activer et backtester separement de B1.")
// C1 : n'emet un signal (fleche, label, TP, alerte) que sur une barre CLOTUREE ->
//      supprime le repaint intrabar de la fleche sur la barre en cours. Sur les
//      barres historiques barstate.isconfirmed est toujours vrai -> BACKTEST IDENTIQUE.
//      Seul le temps reel change (plus de fleche qui apparait/disparait avant cloture).
//      Baseline (effet) = identique en historique. Defaut ON (ameliore le reel, neutre en backtest).
sigConfirmOn = input.bool(true, "C1 · Signaux confirmes en cloture (anti-repaint intrabar)", group=grpAudit, tooltip="ON : un signal BUY/SELL n'apparait qu'une fois la barre CLOTUREE, jamais pendant sa formation -> la fleche ne peut plus apparaitre puis disparaitre en temps reel. Sur l'historique, aucun changement (les barres y sont deja cloturees) : le backtest est IDENTIQUE. OFF (false) = comportement d'origine (fleche evaluee a chaque tick sur la barre en cours).")

// ================= 🔁 BACKTEST — EXECUTION DES ORDRES =================
// SEULE partie ajoutee par rapport a l'indicateur. Elle ne touche NI aux
// signaux, NI au score, NI aux niveaux Entry/SL/TP : elle se contente de
// TRANSMETTRE au Strategy Tester les trades que l'indicateur affiche.
grpBT = "🔁 BACKTEST — Execution des ordres"

// ---- Quels signaux sont tradés ----
btOnlyAPlus = input.bool(false, "Trader uniquement les signaux A+ (ceux qui declenchent l'alerte)", group=grpBT, tooltip="OFF (defaut) : chaque fleche BUY/SELL affichee par l'indicateur (score >= seuil d'affichage) ouvre une position -> le backtest reproduit EXACTEMENT l'indicateur. ON : seuls les signaux dont le score atteint le seuil A+ (celui qui declenche l'alerte TradingView) sont tradés -> moins de trades, en principe de meilleure qualite.")

// ---- Taille de position ----
btSizeMode = input.string("Risque % du capital", "Taille de position", options=["Risque % du capital", "Quantite fixe"], group=grpBT, tooltip="Risque % du capital : la quantite est calculee pour que la distance Entree->Stop Loss corresponde exactement au pourcentage de capital choisi (gestion de risque professionnelle, la taille s'adapte a chaque SL). Quantite fixe : toujours le meme nombre de contrats/onces.")
btRiskPct   = input.float(1.0, "Risque par trade (% du capital)", minval=0.01, maxval=100.0, step=0.1, group=grpBT, tooltip="Pourcentage du capital perdu si le Stop Loss est touche a 100 % de la position. 1 % = standard institutionnel.")
btFixedQty  = input.float(1.0, "Quantite fixe (si mode Quantite fixe)", minval=0.0, step=0.1, group=grpBT)
btMaxQty    = input.float(0.0, "Quantite maximum (0 = illimitee)", minval=0.0, step=0.1, group=grpBT, tooltip="Plafonne la taille calculee par le risque %, pour eviter des positions absurdes quand le Stop Loss est tres serre. 0 = aucun plafond.")

// ---- Type d'ordre d'entree ----
btEntryMode = input.string("Limite (prix de precision)", "Ordre d'entree", options=["Limite (prix de precision)", "Marche (cloture du signal)"], group=grpBT, tooltip="Limite : place un ordre au prix d'entree calcule par le Precision Engine (bord d'Order Block / milieu de FVG) -> fidele a la strategie, mais certains signaux ne seront jamais remplis, et TradingView n'attache le SL/TP qu'a partir de la bougie suivant le remplissage. Marche : entre a la cloture de la bougie du signal -> tous les signaux sont pris et le SL/TP est actif immediatement (execution la plus fidele pour le moteur de backtest).")
btLimitBars = input.int(10, "Validite de l'ordre limite (barres)", minval=1, maxval=200, group=grpBT, tooltip="Si l'ordre limite n'est pas rempli dans ce nombre de barres, il est annule (le setup est considere comme perime).")

// ---- Sorties : repartition des Take Profits ----
btTp1Pct = input.float(50.0, "Part fermee au TP1 (%)", minval=0.0, maxval=100.0, step=5.0, group=grpBT, tooltip="Pourcentage de la position initiale cloturee au TP1. 0 = pas de sortie partielle a TP1.")
btTp2Pct = input.float(30.0, "Part fermee au TP2 (%)", minval=0.0, maxval=100.0, step=5.0, group=grpBT, tooltip="Pourcentage de la position initiale cloturee au TP2. Le RESTE (100 - TP1 - TP2) est ferme au TP Final. La somme TP1+TP2 est automatiquement bornee a 95 % pour toujours laisser un residu sur le TP Final.")
btBeOn      = input.bool(true, "Passer le Stop Loss au Break Even apres TP1", group=grpBT, tooltip="Reproduit la gestion affichee par l'indicateur ('TP1 · SL au Break Even'). Une fois le TP1 touche, le stop du reliquat est ramene au prix d'entree (plus la marge ci-dessous).")
btBeOffAtr  = input.float(0.05, "Marge du Break Even (x ATR)", minval=0.0, step=0.05, group=grpBT, tooltip="Petite marge au-dela de l'entree pour couvrir le spread/les frais lors du passage au Break Even. 0 = strictement au prix d'entree.")

// ---- Signal opposé pendant une position ouverte ----
btOppMode = input.string("Ignorer le signal oppose", "Signal oppose en cours de position", options=["Ignorer le signal oppose", "Fermer sans inverser", "Inverser la position"], group=grpBT, tooltip="Ignorer (defaut) : la position en cours est geree UNIQUEMENT par son SL et ses TP, comme l'indicateur le propose. Fermer : un signal contraire solde la position sans en ouvrir de nouvelle. Inverser : un signal contraire solde la position ET ouvre la position opposee.")

// ---- AMELIORATIONS issues de l'analyse du backtest M3 2020-2026 (1 967 positions) ----
// Deux leviers, chacun justifie par une mesure et desactivable pour revenir au
// comportement precedent. Ce qui a ete ECARTE, parce que les donnees le
// contredisent : resserrer le stop (32 % des trades gagnants reculent au-dela
// de -0.5 R avant de payer) et poser un time-stop (les perdants sont PLUS
// COURTS que les gagnants, 16 contre 31 barres de mediane).

// I1 : laisser courir la derniere tranche. Mesure : les positions gagnantes
// atteignent 1.33 R de MFE mediane mais n'en realisent que 0.79 R -> +0.75 R
// abandonnes en moyenne, et 18 % des gagnants depassent 2 R de MFE. Le TP Final
// fixe est ce qui plafonne le gain a ~1.33 R alors qu'un perdant coute 1 R plein.
btTrailOn     = input.bool(true, "TP Final : laisser courir avec un trailing stop", group=grpBT, tooltip="ON : la derniere tranche n'est plus fermee sur le TP Final fixe ; elle suit le prix avec un trailing stop, sans cible plafond. Justification mesuree : les trades gagnants abandonnent +0.75 R en moyenne entre leur meilleur point et leur sortie. OFF = TP Final fixe du TP Engine (comportement de l'indicateur).")
btTrailStartR = input.float(1.0, "Trailing — activation a X R de profit", minval=0.1, step=0.1, group=grpBT, tooltip="Le trailing ne s'arme qu'une fois ce multiple du risque atteint, pour ne pas etre sorti par le bruit initial.")
btTrailDistR  = input.float(0.5, "Trailing — distance suivie (X R)", minval=0.1, step=0.1, group=grpBT, tooltip="Distance conservee sous le plus haut atteint (BUY) / au-dessus du plus bas (SELL), en multiples du risque. Plus petit = capture plus de gain mais sort plus tot.")

// I2 : filtre de cout d'execution. Mesure : l'esperance BRUTE est plate quelle
// que soit la taille du stop, mais l'esperance NETTE se degrade lineairement
// quand le stop se resserre (quintile de stop le plus serre : -0.102 R net,
// quintile le plus large : -0.014 R net, spread 0.30 $/oz). Un stop trop court
// rend le trade mathematiquement invendable, quel que soit le signal.
btCostOn      = input.bool(true, "Refuser les trades ou le cout d'execution pese trop lourd", group=grpBT, tooltip="Bloque un signal quand la distance Entree->Stop Loss est si courte que le spread + slippage mange une part excessive du risque. Ce filtre s'auto-adapte au timeframe : il ne bloque presque rien en H1 et beaucoup en M1/M3, ou le cout devient structurellement ingerable.")
btCostPerUnit = input.float(0.30, "Cout d'execution estime, aller-retour (en prix)", minval=0.0, step=0.05, group=grpBT, tooltip="Spread + slippage typiques de ton broker, exprimes dans l'unite de prix du symbole (0.30 = 30 cents sur l'or). Doit correspondre a ce que tu renseignes dans l'onglet Proprietes du Strategy Tester.")
btCostMaxPctR = input.float(5.0, "Cout maximum tolere (% du risque)", minval=0.5, maxval=50.0, step=0.5, group=grpBT, tooltip="Un trade est refuse si le cout d'execution depasse ce pourcentage de la distance Entree->SL. 5 % avec un cout de 0.30 $ impose un stop d'au moins 6 $ : en dessous, le spread absorbe l'essentiel de l'esperance.")

// ---- Periode testee ----
btUseRange = input.bool(false, "Limiter la periode de backtest", group=grpBT, tooltip="ON : seuls les signaux compris dans la fenetre ci-dessous ouvrent des positions (utile pour tester in-sample / out-of-sample). Les positions encore ouvertes sont soldees a la fin de la fenetre.")
btFrom     = input.time(timestamp("2020-01-01 00:00 +0000"), "Debut du backtest", group=grpBT)
btTo       = input.time(timestamp("2030-01-01 00:00 +0000"), "Fin du backtest", group=grpBT)

// ---- Protections de compte (0 = desactive) ----
btMaxDayLossPct = input.float(0.0, "Protection : perte max par jour (% du capital, 0 = off)", minval=0.0, maxval=100.0, step=0.5, group=grpBT, tooltip="Arrete la strategie pour la journee quand la perte intraday atteint ce pourcentage du capital (regle de risque prop firm). 0 = desactive.")
btMaxTradesDay  = input.int(0, "Protection : nombre max de trades par jour (0 = off)", minval=0, maxval=100, group=grpBT, tooltip="Limite le nombre d'entrees par journee de trading. 0 = desactive.")

// Les fonctions strategy.risk.* doivent etre appelees au niveau global (jamais
// dans un bloc conditionnel) : on neutralise donc la regle avec une valeur qui
// ne peut pas se declencher plutot que de sauter l'appel.
strategy.risk.max_intraday_loss(btMaxDayLossPct > 0 ? btMaxDayLossPct : 100.0, strategy.percent_of_equity)
strategy.risk.max_intraday_filled_orders(btMaxTradesDay > 0 ? btMaxTradesDay : 9999)

